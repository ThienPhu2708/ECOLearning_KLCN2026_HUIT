# Visual Studio / ASP.NET MVC .gitignore

# Visual Studio files
.vs/
.vscode/
*.user
*.userosscache
*.suo
*.userlibraries

# Build outputs
[B|b]in/
[O|o]bj/
[P|p]ackages/
*.dll
*.exe
*.pdb
*.cache
*.log

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# SQL Server local db files in App_Data (if temporary)
App_Data/*.mdf
App_Data/*.ldf

# System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Video bài học do giáo viên tải lên (dung lượng lớn, không đưa lên Git)
assets/uploads/videos/
Uploads/Videos/

# Khóa bí mật (VNPay...), xem Secrets.config.example
Secrets.config

# cloudflared tải về để chạy Tools/chay_tunnel_api.bat (không đưa lên Git)
Tools/cloudflared*.exe

# Publish lên hosting (MonsterASP...): file cấu hình chứa mật khẩu deploy / chuỗi kết nối, không đưa lên Git
*.publishsettings
Properties/PublishProfiles/

# Nhật ký chẩn đoán (Services/AppLog.cs), không đưa lên Git
App_Data/logs/
# Video chờ nén / đẩy lên R2 và câu lệnh SQL chuyển video cũ (Admin > Lưu trữ video)
App_Data/video-tmp/
App_Data/r2-migration.sql
