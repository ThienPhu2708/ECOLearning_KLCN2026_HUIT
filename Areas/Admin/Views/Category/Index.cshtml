@model IEnumerable<ECOLearning.Areas.Admin.Models.CategoryViewModel>
@{
    ViewBag.Title = "Quản lý Danh mục Khóa học";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Quản Lý Danh Mục Khóa Học</h1>
        <p class="body-2" style="color: var(--text-secondary);">Thiết lập các nhóm chuyên ngành đào tạo và phân loại sản phẩm giáo dục</p>
    </div>
    <button class="btn btn-primary" onclick="openAddCategoryModal()">
        + Thêm danh mục mới
    </button>
</div>

<!-- CATEGORIES TABLE (UC14) -->
<div class="card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 140px;">Mã danh mục</th>
                    <th>Tên Danh Mục</th>
                    <th>Mô Tả Phân Loại</th>
                    <th>Số Khóa Học Trực Thuộc</th>
                    <th>Trạng Thái</th>
                    <th style="width: 180px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody id="category-table-body">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr data-cat-id="@item.MaDanhMuc" data-count="@item.SoKhoaHoc">
                            <td><code>@item.MaDanhMuc</code></td>
                            <td><strong>@item.TenDanhMuc</strong></td>
                            <td>@(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả" : item.MoTa)</td>
                            <td>
                                @if (item.SoKhoaHoc > 0)
                                {
                                    <span class="badge badge-primary">@item.SoKhoaHoc khóa học</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">0 khóa học</span>
                                }
                            </td>
                            <td>
                                @if (item.SoKhoaHoc > 0)
                                {
                                    <span class="badge badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Chưa có khóa</span>
                                }
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <button class="btn btn-secondary btn-sm"
                                            onclick="editCategory('@item.MaDanhMuc', '@JavaScriptEncode(item.TenDanhMuc)', '@JavaScriptEncode(item.MoTa)')">
                                        Sửa
                                    </button>
                                    <button class="btn btn-danger btn-sm"
                                            onclick="attemptDeleteCategory('@item.MaDanhMuc', '@JavaScriptEncode(item.TenDanhMuc)', @item.SoKhoaHoc, this)">
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 24px;">
                            Chưa có danh mục nào trong cơ sở dữ liệu.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION CONTAINER -->
    <div class="pagination-container">
        <div class="pagination-info">
            Hiển thị <strong>1 - @Model.Count()</strong> trên tổng số <strong>@Model.Count()</strong> danh mục
        </div>
        <ul class="pagination">
            <li class="page-item disabled"><button class="page-link"><i class="bi bi-chevron-left me-1"></i> Trước</button></li>
            <li class="page-item active"><button class="page-link">1</button></li>
            <li class="page-item disabled"><button class="page-link">Sau <i class="bi bi-chevron-right ms-1"></i></button></li>
        </ul>
    </div>
</div>

<!-- MODAL: ADD / EDIT CATEGORY (UC14) -->
<div class="modal-overlay" id="category-modal">
    <div class="modal-container">
        <div class="modal-header">
            <h3 class="h3" id="modal-cat-title">Thêm Danh Mục Khóa Học Mới</h3>
            <button class="btn btn-secondary btn-sm" data-modal-close><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <form id="category-form" onsubmit="handleSaveCategory(event)">
                @Html.AntiForgeryToken()
                <input type="hidden" id="cat-id-input" value="" />

                <div class="form-group">
                    <label class="form-label">Tên danh mục <span class="required">*</span></label>
                    <input type="text" id="cat-name-input" class="form-control" placeholder="Ví dụ: Khoa học Dữ liệu & AI" required>
                    <!-- Error feedback duplicate check compliant with UC14 -->
                    <div id="cat-name-error" class="form-feedback-error" style="display: none; color: var(--status-danger); margin-top: 6px; font-size: 13px;">
                        <i class="bi bi-exclamation-circle-fill me-1"></i> Tên danh mục đã tồn tại trên hệ thống! Vui lòng đặt tên khác.
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Mô tả phân loại</label>
                    <textarea id="cat-desc-input" class="form-control" rows="3"
                              placeholder="Mô tả phạm vi và nhóm kỹ năng của danh mục này..."></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px;">
                    <button type="button" class="btn btn-secondary" data-modal-close>Hủy</button>
                    <button type="submit" class="btn btn-primary" id="btn-submit-cat">Lưu danh mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public static string JavaScriptEncode(string value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        return HttpUtility.JavaScriptStringEncode(value);
    }
}

@section Scripts {
    <script>
        let currentEditId = '';

        function openAddCategoryModal() {
            currentEditId = '';
            document.getElementById('cat-id-input').value = '';
            document.getElementById('modal-cat-title').innerText = 'Thêm Danh Mục Khóa Học Mới';
            document.getElementById('cat-name-input').value = '';
            document.getElementById('cat-desc-input').value = '';
            document.getElementById('cat-name-error').style.display = 'none';
            if (window.openModal) openModal('category-modal');
            else document.getElementById('category-modal').classList.add('active');
        }

        function editCategory(id, name, desc) {
            currentEditId = id;
            document.getElementById('cat-id-input').value = id;
            document.getElementById('modal-cat-title').innerText = `Chỉnh sửa Danh Mục: ${id}`;
            document.getElementById('cat-name-input').value = name;
            document.getElementById('cat-desc-input').value = desc || '';
            document.getElementById('cat-name-error').style.display = 'none';
            if (window.openModal) openModal('category-modal');
            else document.getElementById('category-modal').classList.add('active');
        }

        function handleSaveCategory(e) {
            e.preventDefault();
            const id = document.getElementById('cat-id-input').value;
            const val = document.getElementById('cat-name-input').value.trim();
            const desc = document.getElementById('cat-desc-input').value.trim();
            const err = document.getElementById('cat-name-error');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const url = id ? '@Url.Action("Edit", "Category", new { area = "Admin" })' : '@Url.Action("Create", "Category", new { area = "Admin" })';
            const data = {
                __RequestVerificationToken: token,
                id: id,
                tenDanhMuc: val,
                moTa: desc
            };

            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                success: function (res) {
                    if (res.success) {
                        err.style.display = 'none';
                        if (window.closeModal) closeModal('category-modal');
                        else document.getElementById('category-modal').classList.remove('active');

                        if (window.showToast) showToast(res.message, 'success');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        err.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i> ' + res.message;
                        err.style.display = 'block';
                        if (window.showToast) showToast('Lỗi: ' + res.message, 'error');
                    }
                },
                error: function () {
                    err.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i> Có lỗi xảy ra trong quá trình xử lý!';
                    err.style.display = 'block';
                }
            });
        }

        function attemptDeleteCategory(id, name, courseCount, btn) {
            if (courseCount > 0) {
                alert(`[CẢNH BÁO QUY TRÌNH UC14]\nKhông thể xóa danh mục "${name}"!\nDanh mục này hiện đang có ${courseCount} khóa học trực thuộc đang sử dụng.`);
                if (window.showToast) showToast(`Không thể xóa danh mục đang có ${courseCount} khóa học sử dụng!`, 'error');
                return;
            }

            if (confirm(`Bạn có chắc chắn muốn xóa danh mục "${name}" (Mã: ${id})?`)) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                $.ajax({
                    url: '@Url.Action("Delete", "Category", new { area = "Admin" })',
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: token,
                        id: id
                    },
                    success: function (res) {
                        if (res.success) {
                            if (window.showToast) showToast(res.message, 'success');
                            btn.closest('tr').remove();
                        } else {
                            alert(`[CẢNH BÁO QUY TRÌNH UC14]\n${res.message}`);
                            if (window.showToast) showToast(res.message, 'error');
                        }
                    },
                    error: function () {
                        if (window.showToast) showToast('Lỗi kết nối CSDL khi xóa!', 'error');
                    }
                });
            }
        }
    </script>
}
