@model IEnumerable<ECOLearning.Areas.Admin.Models.PendingCourseItem>
@{
    ViewBag.Title = "Kiểm Duyệt Khóa Học";
    string currentStatus = ViewBag.StatusFilter as string ?? "Pending";
    string searchKeyword = ViewBag.Search as string ?? "";
    string selectedCategory = ViewBag.Category as string ?? "";
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";
    string sort = ViewBag.Sort as string ?? "newest";
    var categories = ViewBag.Categories as List<ECOLearning.Models.DanhMuc> ?? new List<ECOLearning.Models.DanhMuc>();
    bool hasExtraFilter = selectedCategory != "" || fromDate != "" || toDate != "" || sort != "newest";
}

<style>
    /* Đảm bảo Modal kiểm duyệt và Modal từ chối hiển thị mượt mà trên nền tối ưu */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.25s ease, visibility 0.25s ease;
        padding: 20px;
    }
    .modal-overlay.active {
        display: flex !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
    }
    .modal-overlay:not(.active) {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
    }
    .modal-overlay.active .modal-container {
        transform: scale(1) !important;
    }
    .modal-container {
        transform: scale(0.96);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
</style>

@Html.AntiForgeryToken()

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Hàng Đợi Kiểm Duyệt Khóa Học</h1>
        <p class="body-2" style="color: var(--text-secondary);">Rà soát chất lượng nội dung, xem trực tiếp video bài giảng và đề cương trước khi xuất bản</p>
    </div>
</div>

<!-- FILTER TABS & SEARCH BAR -->
<div class="card" style="margin-bottom: 24px; padding: 16px 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <!-- Status Filter Tabs -->
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <a href="@Url.Action("Index", "CourseApproval", new { area = "Admin", statusFilter = "Pending", search = searchKeyword, category = selectedCategory, fromDate = fromDate, toDate = toDate, sort = sort })"
               class="btn btn-sm @(currentStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline")" style="font-weight: 600;">
                Chờ duyệt <span class="badge badge-warning" style="margin-left: 6px;">@ViewBag.PendingCount</span>
            </a>
            <a href="@Url.Action("Index", "CourseApproval", new { area = "Admin", statusFilter = "Revisions", search = searchKeyword, category = selectedCategory, fromDate = fromDate, toDate = toDate, sort = sort })"
               class="btn btn-sm @(currentStatus.Equals("Revisions", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline")" style="font-weight:600;">
                Duyệt bản sửa <span class="badge badge-warning" style="margin-left:6px;">@ViewBag.PendingRevisions</span>
            </a>
            <a href="@Url.Action("Index", "CourseApproval", new { area = "Admin", statusFilter = "Approved", search = searchKeyword, category = selectedCategory, fromDate = fromDate, toDate = toDate, sort = sort })"
               class="btn btn-sm @(currentStatus.Equals("Approved", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline")" style="font-weight: 600;">
                Đã xuất bản <span class="badge badge-success" style="margin-left: 6px;">@ViewBag.ApprovedCount</span>
            </a>
            <a href="@Url.Action("Index", "CourseApproval", new { area = "Admin", statusFilter = "Rejected", search = searchKeyword, category = selectedCategory, fromDate = fromDate, toDate = toDate, sort = sort })"
               class="btn btn-sm @(currentStatus.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline")" style="font-weight: 600;">
                Cần sửa đổi <span class="badge badge-danger" style="margin-left: 6px;">@ViewBag.RejectedCount</span>
            </a>
            <a href="@Url.Action("Index", "CourseApproval", new { area = "Admin", statusFilter = "All", search = searchKeyword, category = selectedCategory, fromDate = fromDate, toDate = toDate, sort = sort })"
               class="btn btn-sm @(currentStatus.Equals("All", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline")" style="font-weight: 600;">
                Tất cả <span class="badge badge-secondary" style="margin-left: 6px;">@ViewBag.AllCount</span>
            </a>
        </div>

    </div>

    <!-- Tìm kiếm + lọc danh mục / ngày gửi + sắp xếp -->
    <form method="get" action="@Url.Action("Index", "CourseApproval", new { area = "Admin" })"
          style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-color);">
        <input type="hidden" name="statusFilter" value="@currentStatus" />
        <div style="display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 220px;">
            <label class="caption" style="font-weight: 600;">Tìm kiếm</label>
            <input type="text" name="search" value="@searchKeyword" class="form-control" placeholder="Tên khóa học, mã hoặc giáo viên..." style="height: 38px;">
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <label class="caption" style="font-weight: 600;">Danh mục</label>
            <select name="category" class="form-control" style="height: 38px; width: 200px;">
                <option value="">Tất cả danh mục</option>
                @foreach (var c in categories)
                {
                    <option value="@c.maDanhMuc" @(c.maDanhMuc == selectedCategory ? "selected" : "")>@c.tenDanhMuc</option>
                }
            </select>
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <label class="caption" style="font-weight: 600;">Gửi từ ngày</label>
            <input type="date" name="fromDate" value="@fromDate" class="form-control" style="height: 38px; width: 160px;">
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <label class="caption" style="font-weight: 600;">Đến ngày</label>
            <input type="date" name="toDate" value="@toDate" class="form-control" style="height: 38px; width: 160px;">
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <label class="caption" style="font-weight: 600;">Sắp xếp</label>
            <select name="sort" class="form-control" style="height: 38px; width: 170px;">
                <option value="newest" @(sort == "newest" ? "selected" : "")>Ngày gửi mới nhất</option>
                <option value="oldest" @(sort == "oldest" ? "selected" : "")>Ngày gửi cũ nhất</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm" style="height: 38px;">Lọc</button>
        @if (hasExtraFilter || searchKeyword != "")
        {
            <a href="@Url.Action("Index", "CourseApproval", new { area = "Admin", statusFilter = currentStatus })" class="btn btn-secondary btn-sm" style="height: 38px; display: inline-flex; align-items: center;">Bỏ lọc</a>
        }
    </form>
</div>

<!-- PENDING COURSES TABLE (UC15) -->
<div class="card" style="padding: 0; overflow: hidden; margin-bottom: 30px;">
    <div class="table-responsive">
        <table class="table" data-paginate="10">
            <thead>
                <tr>
                    <th>Tên Khóa Học</th>
                    <th>Giáo Viên Gửi Yêu Cầu</th>
                    <th>Danh Mục</th>
                    <th>Ngày Gửi</th>
                    <th>Nội Dung Kiểm Tra</th>
                    <th>Trạng Thái</th>
                    <th style="width: 140px; text-align: center;">Thao Tác</th>
                </tr>
            </thead>
            <tbody id="approval-queue-body">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr id="row-appr-@item.MaKhoaHoc">
                            <td>
                                <strong style="color: var(--text-heading); display: block;">@item.TenKhoaHoc</strong>
                                <div class="caption">Học phí: <strong style="color: #0D9488;">@item.HocPhi.ToString("#,##0 đ")</strong> • Mã: @item.MaKhoaHoc</div>
                            </td>
                            <td>
                                <strong>@item.TenGiaoVien</strong>
                            </td>
                            <td><span class="badge badge-primary">@item.TenDanhMuc</span></td>
                            <td>@(item.NgayGui.HasValue ? item.NgayGui.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa gửi")</td>
                            <td>@item.SoVideo video • @item.SoTaiLieu tệp tài liệu</td>
                            <td>
                                @if (item.TrangThai == "Đã xuất bản" || item.TrangThai == "Đã duyệt")
                                {
                                    <span class="badge badge-success" id="badge-status-@item.MaKhoaHoc">Đã xuất bản</span>
                                }
                                else if (item.TrangThai == "Cần sửa đổi" || item.TrangThai == "Từ chối")
                                {
                                    <span class="badge badge-danger" id="badge-status-@item.MaKhoaHoc">Cần sửa đổi</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning" id="badge-status-@item.MaKhoaHoc">Chờ duyệt</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (currentStatus.Equals("Revisions", StringComparison.OrdinalIgnoreCase)) {
                                    <a class="btn btn-primary btn-sm" href="@Url.Action("Details", "CourseRevision", new { id = item.MaKhoaHoc })">Kiểm duyệt bản sửa</a>
                                } else {
                                <button type="button" 
                                        class="btn btn-primary btn-sm btn-open-approval"
                                        data-id="@item.MaKhoaHoc"
                                        data-title="@item.TenKhoaHoc"
                                        data-instructor="@item.TenGiaoVien"
                                        onclick="handleOpenApproval(this)">
                                    Kiểm duyệt
                                </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; color: var(--text-secondary); padding: 32px;">
                            Không có khóa học nào trong hàng chờ tương ứng với bộ lọc này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- MODAL: DETAILED APPROVAL REVIEW (UC15) -->
<div class="modal-overlay" id="approval-detail-modal" style="z-index: 1050;">
    <div class="modal-container" style="max-width: 880px; width: 92%; background: #FFFFFF; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.25);">
        <div class="modal-header" style="padding: 20px 24px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; background: #F8FAFC;">
            <div>
                <h3 class="h3" id="modal-appr-title" style="margin: 0; font-size: 18px; font-weight: 800; color: #0F172A;">Kiểm duyệt khóa học</h3>
                <div class="caption" id="modal-appr-instructor" style="color: #64748B; font-size: 13px; margin-top: 4px;">Giảng viên: Đang tải...</div>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeApprovalModal()" style="border: none; background: #E2E8F0; color: #475569; font-size: 16px; border-radius: 8px; cursor: pointer; padding: 4px 10px;"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="modal-body" style="padding: 24px; max-height: 70vh; overflow-y: auto;">
            <!-- ALERT BOX IF PREVIOUSLY REJECTED -->
            <div id="modal-rejection-warning" style="display: none; padding: 12px 16px; background: #FEF2F2; border: 1px solid #FCA5A5; border-radius: 12px; margin-bottom: 20px; font-size: 13px; color: #991B1B;">
                <strong><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Lý do từ chối trước đó:</strong> <span id="modal-rejection-text"></span>
            </div>

            <!-- Tab navigation inside review -->
            <div class="tab-nav" style="display: flex; gap: 10px; border-bottom: 1px solid #E2E8F0; margin-bottom: 20px;">
                <button type="button" class="tab-btn btn btn-sm btn-primary active" id="btn-tab-video" onclick="switchApprTab('video')" style="font-weight: 700;"><i class="bi bi-camera-video-fill me-1"></i> Video Bài Giảng</button>
                <button type="button" class="tab-btn btn btn-sm btn-outline" id="btn-tab-curriculum" onclick="switchApprTab('curriculum')" style="font-weight: 700;"><i class="bi bi-journal-text me-1"></i> Đề Cương & Tài Nguyên</button>
                <button type="button" class="tab-btn btn btn-sm btn-outline" id="btn-tab-overview" onclick="switchApprTab('overview')" style="font-weight: 700;"><i class="bi bi-info-circle-fill me-1"></i> Thông Tin Tổng Quan</button>
            </div>

            <!-- TAB 1: VIDEO PREVIEW -->
            <div id="tab-appr-video" class="tab-content" style="display: block;">
                <!-- Video selector list -->
                <div id="video-select-box" style="margin-bottom: 14px; display: none;">
                    <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 6px;">Chọn bài học để phát video kiểm tra:</label>
                    <select id="video-lesson-selector" class="form-control" style="font-size: 13px; padding: 8px 12px; border-radius: 8px;" onchange="changePreviewVideo(this.value)">
                    </select>
                </div>

                <div id="video-preview-player-box" style="aspect-ratio: 16/9; background: #000; border-radius: 14px; overflow: hidden; position: relative; margin-bottom: 16px; display: flex; align-items: center; justify-content: center;">
                    <!-- Direct HTML5 video element (MP4/WebM) -->
                    <video id="video-preview-element" controls style="width: 100%; height: 100%; object-fit: contain; display: none;"></video>
                    
                    <!-- YouTube / External Embed Player -->
                    <iframe id="video-preview-iframe" style="width: 100%; height: 100%; border: none; display: none;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    
                    <!-- Fallback Cover Placeholder -->
                    <div id="video-fallback-cover" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative;">
                        <img id="course-preview-cover" src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&auto=format&fit=crop&q=80"
                             alt="Ảnh bìa khóa học"
                             style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6;">
                        <div style="position: absolute; text-align: center; color: #fff; padding: 20px; background: rgba(0,0,0,0.5); border-radius: 16px; backdrop-filter: blur(4px);">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: #0D9488; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; font-size: 22px;">
                                <i class="bi bi-play-fill text-white"></i>
                            </div>
                            <strong id="video-preview-title" style="font-size: 14px; display: block; max-width: 500px; margin: 0 auto;">Đang tải nội dung bài giảng...</strong>
                        </div>
                    </div>
                </div>

                <div class="caption" id="tech-status-box" style="color: #047857; font-weight: 600; background: #ECFDF5; padding: 12px 16px; border-radius: 10px; font-size: 13px;">
                    <i class="bi bi-check-circle-fill me-1"></i> Đạt chuẩn kỹ thuật: Kiểm định âm thanh và chất lượng video bài giảng.
                </div>
            </div>

            <!-- TAB 2: CURRICULUM -->
            <div id="tab-appr-curriculum" class="tab-content" style="display: none;">
                <div id="curriculum-content-list" style="font-size: 14px; display: flex; flex-direction: column; gap: 12px;">
                    <div style="padding: 16px; background: #F8FAFC; border-radius: 10px; color: #64748B;">Đang tải danh sách chương & bài học...</div>
                </div>
            </div>

            <!-- TAB 3: OVERVIEW -->
            <div id="tab-appr-overview" class="tab-content" style="display: none;">
                <div style="display: grid; grid-template-columns: 200px 1fr; gap: 20px; margin-bottom: 20px;">
                    <img id="overview-cover-img" src="" alt="Cover" style="width: 100%; height: 130px; object-fit: cover; border-radius: 12px; border: 1px solid #E2E8F0;" />
                    <div style="font-size: 13px; display: flex; flex-direction: column; gap: 8px;">
                        <div><strong>Học phí chính thức:</strong> <span id="overview-price" style="color: #0D9488; font-weight: 700; font-size: 16px;"></span></div>
                        <div><strong>Danh mục:</strong> <span id="overview-category" class="badge badge-primary"></span></div>
                        <div><strong>Email giảng viên:</strong> <span id="overview-instructor-email"></span></div>
                        <div><strong>Trạng thái hiện tại:</strong> <span id="overview-status" class="badge"></span></div>
                    </div>
                </div>
                <div style="font-size: 13px; color: #334155; line-height: 1.6;">
                    <h4 style="font-size: 14px; margin-bottom: 6px; color: #0F172A;">Mô tả ngắn:</h4>
                    <p id="overview-short-desc" style="background: #F8FAFC; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; white-space: pre-line;"></p>
                    
                    <h4 style="font-size: 14px; margin-bottom: 6px; color: #0F172A;">Mục tiêu đầu ra:</h4>
                    <p id="overview-outcomes" style="background: #F8FAFC; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; white-space: pre-line;"></p>

                    <h4 style="font-size: 14px; margin-bottom: 6px; color: #0F172A;">Mô tả chi tiết:</h4>
                    <div id="overview-full-desc" style="background: #F8FAFC; padding: 12px 16px; border-radius: 8px; max-height: 160px; overflow-y: auto; white-space: pre-line;"></div>
                </div>
            </div>
        </div>

        <!-- Decision buttons compliant with UC15 -->
        <div class="modal-footer" style="padding: 16px 24px; background: #F8FAFC; border-top: 1px solid #E2E8F0; display: flex; justify-content: space-between; gap: 12px;">
            <button type="button" class="btn" style="background: #EF4444; color: #FFFFFF; font-weight: 700; border-radius: 10px; border: none; padding: 10px 20px; font-size: 14px; display: inline-flex; align-items: center; gap: 6px;" onclick="openRejectPopup()">
                <i class="bi bi-x-circle-fill"></i> Từ chối & Nhập lý do
            </button>
            <div style="display: flex; gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="closeApprovalModal()" style="border-radius: 10px; font-weight: 600;">Đóng</button>
                <button type="button" class="btn" style="background: #10B981; color: white; font-weight: 700; border-radius: 10px; border: none; padding: 10px 24px; font-size: 14px; display: inline-flex; align-items: center; gap: 6px;" onclick="approveCourse()">
                    <i class="bi bi-check-circle-fill"></i> Phê duyệt & Xuất bản
                </button>
            </div>
        </div>
    </div>
</div>

<!-- POPUP REJECT REASON (UC15) -->
<div class="modal-overlay" id="reject-modal" style="z-index: 1060;">
    <div class="modal-container" style="max-width: 500px; width: 90%; background: #FFFFFF; border-radius: 20px; padding: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.25);">
        <div class="modal-header" style="margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
            <h3 class="h3" style="color: #991B1B; font-size: 18px; font-weight: 800; margin: 0;">Lý do từ chối kiểm duyệt</h3>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeRejectModal()" style="border: none; background: #F1F5F9; color: #64748B; border-radius: 8px;"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <p class="body-2" style="margin-bottom: 12px; font-size: 14px; color: #475569;">Nhập lý do chi tiết yêu cầu Giáo viên phải điều chỉnh hoặc bổ sung lại nội dung:</p>
            <textarea id="reject-reason-input" class="form-control" style="width: 100%; min-height: 120px; padding: 12px; border-radius: 10px; border: 1px solid #CBD5E1; font-size: 14px; box-sizing: border-box; resize: vertical;"
                      placeholder="Ví dụ: Âm thanh video bài 1.3 bị rè, thiếu tài liệu đính kèm hoặc nội dung không đạt chuẩn chất lượng..."></textarea>
        </div>
        <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
            <button type="button" class="btn btn-secondary" onclick="closeRejectModal()" style="border-radius: 10px; font-weight: 600;">Hủy bỏ</button>
            <button type="button" class="btn" style="background: #EF4444; color: #FFFFFF; font-weight: 700; border-radius: 10px; border: none; padding: 10px 20px;" onclick="confirmReject()">Gửi phản hồi cho Giáo viên</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentApproveCourseId = null;
    let loadedCourseData = null;
    let videoLessons = [];

    // Helper: trích xuất YouTube ID an toàn
    function extractYouTubeId(url) {
        if (!url) return null;
        const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
        return match ? match[1] : null;
    }

    // Helper: Escape an toàn cho HTML text
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Xử lý sự kiện click nút "Kiểm duyệt" từ bảng dữ liệu
    function handleOpenApproval(btn) {
        if (!btn) return;
        const courseId = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title') || '';
        const instructor = btn.getAttribute('data-instructor') || '';
        openApprovalModal(courseId, title, instructor);
    }

    // Mở modal kiểm duyệt khóa học
    function openApprovalModal(courseId, title, instructor) {
        if (!courseId) return;
        currentApproveCourseId = courseId;
        videoLessons = [];

        // Đặt tiêu đề ban đầu từ tham số truyền vào
        document.getElementById('modal-appr-title').textContent = title || 'Kiểm duyệt khóa học';
        document.getElementById('modal-appr-instructor').textContent = instructor ? ('Giảng viên: ' + instructor) : 'Giảng viên: Đang tải...';

        // Reset tabs và video players
        switchApprTab('video');
        document.getElementById('modal-rejection-warning').style.display = 'none';

        const playerElem = document.getElementById('video-preview-element');
        if (playerElem) {
            playerElem.style.display = 'none';
            try { playerElem.pause(); playerElem.src = ''; } catch (e) {}
        }

        const iframeElem = document.getElementById('video-preview-iframe');
        if (iframeElem) {
            iframeElem.style.display = 'none';
            iframeElem.src = '';
        }

        document.getElementById('video-fallback-cover').style.display = 'flex';
        document.getElementById('video-select-box').style.display = 'none';

        // Hiển thị modal với class active
        const modal = document.getElementById('approval-detail-modal');
        if (modal) {
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        // Fetch chi tiết khóa học từ backend
        fetch('@Url.Action("GetDetails", "CourseApproval", new { area = "Admin" })?id=' + encodeURIComponent(courseId))
            .then(res => {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json();
            })
            .then(res => {
                if (res.success && res.data) {
                    const data = res.data;
                    loadedCourseData = data;

                    document.getElementById('modal-appr-title').textContent = data.TenKhoaHoc || title || 'Kiểm duyệt khóa học';
                    document.getElementById('modal-appr-instructor').textContent = 'Giảng viên: ' + (data.TenGiaoVien || instructor || 'N/A');

                    // Cập nhật tab Overview
                    document.getElementById('overview-cover-img').src = data.AnhBia || 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&auto=format&fit=crop&q=80';
                    document.getElementById('overview-price').textContent = data.HocPhi ? Number(data.HocPhi).toLocaleString('vi-VN') + ' đ' : '0 đ';
                    document.getElementById('overview-category').textContent = data.TenDanhMuc || 'Chung';
                    document.getElementById('overview-instructor-email').textContent = data.EmailGiaoVien || 'N/A';
                    document.getElementById('overview-status').textContent = data.TrangThai || 'Chờ duyệt';
                    document.getElementById('overview-status').className = 'badge ' + (data.TrangThai === 'Đã xuất bản' ? 'badge-success' : (data.TrangThai === 'Cần sửa đổi' ? 'badge-danger' : 'badge-warning'));
                    document.getElementById('overview-short-desc').textContent = data.MoTaNgan || 'Chưa cập nhật mô tả ngắn.';
                    document.getElementById('overview-outcomes').textContent = data.MucTieuDauRa || 'Chưa cập nhật mục tiêu đầu ra.';
                    document.getElementById('overview-full-desc').innerHTML = data.MoTa || 'Chưa cập nhật mô tả chi tiết.';

                    // Hiển thị lý do từ chối nếu có
                    if (data.LyDoTuChoi) {
                        document.getElementById('modal-rejection-warning').style.display = 'block';
                        document.getElementById('modal-rejection-text').textContent = data.LyDoTuChoi;
                    }

                    if (data.AnhBia) {
                        document.getElementById('course-preview-cover').src = data.AnhBia;
                    }

                    // Xây dựng danh sách đề cương & gom video bài giảng
                    videoLessons = [];
                    let curriculumHtml = '';

                    if (data.ChuongHocs && data.ChuongHocs.length > 0) {
                        data.ChuongHocs.forEach((ch, idx) => {
                            curriculumHtml += `<div style="padding: 14px 16px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; margin-bottom: 10px;">
                                <strong style="color: #0F172A; font-size: 15px; display: block; margin-bottom: 8px;">Chương ${idx + 1}: ${escapeHtml(ch.TenChuong)} (${ch.BaiHocs ? ch.BaiHocs.length : 0} bài)</strong>`;

                            if (ch.BaiHocs && ch.BaiHocs.length > 0) {
                                curriculumHtml += `<div style="display: flex; flex-direction: column; gap: 8px; padding-left: 10px;">`;
                                ch.BaiHocs.forEach(bh => {
                                    let lessonIndex = -1;
                                    if (bh.VideoUrl && bh.VideoUrl.trim() !== '') {
                                        lessonIndex = videoLessons.length;
                                        videoLessons.push({
                                            title: bh.TenBaiHoc,
                                            url: bh.VideoUrl.trim(),
                                            chapter: ch.TenChuong
                                        });
                                    }

                                    let resourceText = '';
                                    if (bh.TaiNguyens && bh.TaiNguyens.length > 0) {
                                        resourceText = ' • <i class="bi bi-paperclip"></i> Tài liệu: ' + bh.TaiNguyens.map(t => `<a href="${escapeHtml(t.FileUrl)}" target="_blank" style="color:#0D9488; font-weight:600;">${escapeHtml(t.TenTaiNguyen)}</a>`).join(', ');
                                    }

                                    curriculumHtml += `<div style="font-size: 13px; color: #475569; display: flex; align-items: center; justify-content: space-between; background: #FFFFFF; padding: 8px 12px; border-radius: 8px; border: 1px solid #F1F5F9;">
                                        <div>
                                            <i class="bi bi-play-circle text-primary me-1"></i> <strong style="color:#1E293B;">${escapeHtml(bh.TenBaiHoc)}</strong> 
                                            <span style="color:#94A3B8; font-size:12px;">(${bh.ThoiLuong ? Math.round(bh.ThoiLuong / 60) + ' phút' : 'Video'})</span>
                                            ${resourceText}
                                        </div>
                                        ${lessonIndex >= 0 ? `<button type="button" class="btn btn-sm btn-outline" style="font-size:11px; padding: 2px 8px;" onclick="playLessonByIndex(${lessonIndex})">Phát video</button>` : `<span style="font-size:11px; color:#94A3B8;">Chưa có video</span>`}
                                    </div>`;
                                });
                                curriculumHtml += `</div>`;
                            }
                            curriculumHtml += `</div>`;
                        });
                    } else {
                        curriculumHtml = '<div style="padding: 20px; background: #F8FAFC; border-radius: 12px; color: #64748B; text-align: center;">Khóa học này chưa được khởi tạo chương và bài học.</div>';
                    }

                    document.getElementById('curriculum-content-list').innerHTML = curriculumHtml;

                    // Thiết lập danh sách chọn video
                    const selector = document.getElementById('video-lesson-selector');
                    selector.innerHTML = '';
                    if (videoLessons.length > 0) {
                        document.getElementById('video-select-box').style.display = 'block';
                        videoLessons.forEach((v, index) => {
                            const opt = document.createElement('option');
                            opt.value = v.url;
                            opt.textContent = `[${v.chapter}] - ${v.title}`;
                            selector.appendChild(opt);
                        });

                        // Tự động phát video đầu tiên
                        changePreviewVideo(videoLessons[0].url, videoLessons[0].title);
                    } else {
                        document.getElementById('video-select-box').style.display = 'none';
                        document.getElementById('video-preview-title').textContent = 'Khóa học: ' + (data.TenKhoaHoc || '') + ' (Chưa đăng tải video bài giảng)';
                        const techStatusBox = document.getElementById('tech-status-box');
                        if (techStatusBox) {
                            techStatusBox.style.background = '#FEF3C7';
                            techStatusBox.style.color = '#B45309';
                            techStatusBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Khóa học này chưa có video bài giảng. Quản trị viên có thể xem xét đề cương hoặc yêu cầu giảng viên bổ sung.';
                        }
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi nạp dữ liệu',
                        text: res.message || 'Không thể lấy thông tin chi tiết khóa học!',
                        confirmButtonColor: '#EF4444'
                    });
                }
            })
            .catch(err => {
                console.error('Lỗi nạp chi tiết khóa học:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối máy chủ',
                    text: 'Không thể nạp thông tin khóa học từ máy chủ. Vui lòng thử lại sau.',
                    confirmButtonColor: '#EF4444'
                });
            });
    }

    // Phát video qua index trong mảng bài học
    function playLessonByIndex(idx) {
        if (idx >= 0 && idx < videoLessons.length) {
            const item = videoLessons[idx];
            switchApprTab('video');
            const selector = document.getElementById('video-lesson-selector');
            if (selector) {
                selector.value = item.url;
            }
            changePreviewVideo(item.url, item.title);
        }
    }

    // Thay đổi video xem trước (hỗ trợ cả YouTube Embed lẫn MP4/WebM)
    function changePreviewVideo(url, title) {
        const player = document.getElementById('video-preview-element');
        const iframe = document.getElementById('video-preview-iframe');
        const fallback = document.getElementById('video-fallback-cover');
        const techStatusBox = document.getElementById('tech-status-box');

        if (!url || url.trim() === '') {
            if (player) { try { player.pause(); player.src = ''; } catch(e){} player.style.display = 'none'; }
            if (iframe) { iframe.src = ''; iframe.style.display = 'none'; }
            if (fallback) fallback.style.display = 'flex';
            return;
        }

        const ytId = extractYouTubeId(url);
        if (ytId) {
            // Nguồn là video YouTube
            if (player) { try { player.pause(); player.src = ''; } catch(e){} player.style.display = 'none'; }
            if (iframe) {
                iframe.src = `https://www.youtube.com/embed/${ytId}?autoplay=1&rel=0`;
                iframe.style.display = 'block';
            }
            if (fallback) fallback.style.display = 'none';

            if (techStatusBox) {
                techStatusBox.style.background = '#ECFDF5';
                techStatusBox.style.color = '#047857';
                techStatusBox.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Đang kiểm duyệt bài giảng (YouTube Embed): Video phát bình thường, âm thanh và hình ảnh rõ nét.';
            }
        } else {
            // Nguồn là MP4 / WebM / HTML5 direct link
            if (iframe) { iframe.src = ''; iframe.style.display = 'none'; }
            if (player) {
                player.src = url;
                player.style.display = 'block';
                player.play().catch(() => {});
            }
            if (fallback) fallback.style.display = 'none';

            if (techStatusBox) {
                techStatusBox.style.background = '#ECFDF5';
                techStatusBox.style.color = '#047857';
                techStatusBox.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Đang kiểm duyệt bài giảng: Video phát bình thường (1080p Full HD), âm thanh rõ nét.';
            }
        }
    }

    function playLessonVideoDirect(title, url) {
        switchApprTab('video');
        const selector = document.getElementById('video-lesson-selector');
        if (selector) {
            selector.value = url;
        }
        changePreviewVideo(url, title);
    }

    // Đóng modal kiểm duyệt khóa học
    function closeApprovalModal() {
        const player = document.getElementById('video-preview-element');
        if (player) {
            try { player.pause(); player.src = ''; } catch (e) {}
            player.style.display = 'none';
        }
        const iframe = document.getElementById('video-preview-iframe');
        if (iframe) {
            iframe.src = '';
            iframe.style.display = 'none';
        }
        const modal = document.getElementById('approval-detail-modal');
        if (modal) {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }
        currentApproveCourseId = null;
    }

    // Chuyển tab trong modal
    function switchApprTab(tabName) {
        document.getElementById('tab-appr-video').style.display = tabName === 'video' ? 'block' : 'none';
        document.getElementById('tab-appr-curriculum').style.display = tabName === 'curriculum' ? 'block' : 'none';
        document.getElementById('tab-appr-overview').style.display = tabName === 'overview' ? 'block' : 'none';

        document.getElementById('btn-tab-video').className = 'tab-btn btn btn-sm ' + (tabName === 'video' ? 'btn-primary active' : 'btn-outline');
        document.getElementById('btn-tab-curriculum').className = 'tab-btn btn btn-sm ' + (tabName === 'curriculum' ? 'btn-primary active' : 'btn-outline');
        document.getElementById('btn-tab-overview').className = 'tab-btn btn btn-sm ' + (tabName === 'overview' ? 'btn-primary active' : 'btn-outline');
    }

    // Phê duyệt và xuất bản khóa học
    function approveCourse() {
        if (!currentApproveCourseId) {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi xác định',
                text: 'Không tìm thấy mã khóa học!',
                confirmButtonColor: '#EF4444'
            });
            return;
        }

        Swal.fire({
            title: 'Phê duyệt khóa học?',
            html: 'Bạn có chắc chắn muốn <strong>PHÊ DUYỆT & XUẤT BẢN</strong> khóa học này ra trang chủ không?<br><span style="font-size:13px; color:#64748B; display:block; margin-top:6px;">Học viên trên toàn hệ thống có thể tìm kiếm, xem nội dung và đăng ký học ngay lập tức.</span>',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Phê duyệt & Xuất bản',
            cancelButtonText: 'Hủy bỏ',
            confirmButtonColor: '#10B981',
            cancelButtonColor: '#94A3B8',
            reverseButtons: true,
            focusConfirm: true
        }).then((result) => {
            if (result.isConfirmed) {
                // Hiển thị trạng thái đang xử lý
                Swal.fire({
                    title: 'Đang phê duyệt khóa học...',
                    text: 'Hệ thống đang xuất bản và cập nhật dữ liệu, vui lòng chờ trong giây lát.',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                fetch('@Url.Action("Approve", "CourseApproval", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: `id=${encodeURIComponent(currentApproveCourseId)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                })
                .then(async res => {
                    const contentType = res.headers.get('content-type') || '';
                    if (contentType.includes('application/json')) {
                        return res.json();
                    } else {
                        const errorHtml = await res.text();
                        console.error('Phản hồi không phải JSON:', errorHtml);
                        throw new Error('Máy chủ phản hồi mã ' + res.status + ' (' + (res.statusText || 'Lỗi xử lý') + ')');
                    }
                })
                .then(data => {
                    if (data.requireLogin) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Phiên làm việc hết hạn',
                            text: data.message || 'Phiên làm việc của Quản trị viên đã hết hạn. Vui lòng đăng nhập lại!',
                            confirmButtonColor: '#434CE8'
                        }).then(() => {
                            window.location.href = '@Url.Action("Login", "Account", new { area = "" })?returnUrl=' + encodeURIComponent(window.location.href);
                        });
                        return;
                    }

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Phê duyệt thành công!',
                            text: data.message,
                            confirmButtonColor: '#10B981',
                            timer: 2200,
                            timerProgressBar: true
                        }).then(() => {
                            const badge = document.getElementById('badge-status-' + currentApproveCourseId);
                            if (badge) {
                                badge.className = 'badge badge-success';
                                badge.textContent = 'Đã xuất bản';
                            }
                            closeApprovalModal();
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Không thể phê duyệt',
                            text: data.message,
                            confirmButtonColor: '#EF4444'
                        });
                    }
                })
                .catch(err => {
                    console.error('Lỗi khi phê duyệt:', err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi xử lý',
                        text: err.message || 'Không thể kết nối đến máy chủ. Vui lòng kiểm tra lại!',
                        confirmButtonColor: '#EF4444'
                    });
                });
            }
        });
    }

    // Mở popup từ chối
    function openRejectPopup() {
        document.getElementById('reject-reason-input').value = '';
        const modal = document.getElementById('reject-modal');
        if (modal) {
            modal.classList.add('active');
        }
    }

    // Đóng popup từ chối
    function closeRejectModal() {
        const modal = document.getElementById('reject-modal');
        if (modal) {
            modal.classList.remove('active');
        }
    }

    // Xác nhận từ chối và gửi lý do
    function confirmReject() {
        if (!currentApproveCourseId) {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi xác định',
                text: 'Không tìm thấy mã khóa học!',
                confirmButtonColor: '#EF4444'
            });
            return;
        }

        const reason = document.getElementById('reject-reason-input').value.trim();
        if (!reason) {
            Swal.fire({
                icon: 'warning',
                title: 'Thiếu lý do từ chối',
                text: 'Vui lòng nhập lý do cụ thể để yêu cầu Giáo viên điều chỉnh hoặc bổ sung lại nội dung!',
                confirmButtonColor: '#F59E0B'
            });
            return;
        }

        Swal.fire({
            title: 'Xác nhận từ chối kiểm duyệt?',
            html: 'Khóa học sẽ được chuyển về trạng thái <strong>Cần sửa đổi</strong> và thông báo lý do chi tiết tới Giáo viên.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Gửi từ chối',
            cancelButtonText: 'Quay lại',
            confirmButtonColor: '#EF4444',
            cancelButtonColor: '#94A3B8',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                // Hiển thị trạng thái đang xử lý
                Swal.fire({
                    title: 'Đang gửi phản hồi...',
                    text: 'Hệ thống đang cập nhật trạng thái kiểm duyệt, vui lòng chờ trong giây lát.',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                fetch('@Url.Action("Reject", "CourseApproval", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: `id=${encodeURIComponent(currentApproveCourseId)}&reason=${encodeURIComponent(reason)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                })
                .then(async res => {
                    const contentType = res.headers.get('content-type') || '';
                    if (contentType.includes('application/json')) {
                        return res.json();
                    } else {
                        const errorHtml = await res.text();
                        console.error('Phản hồi không phải JSON:', errorHtml);
                        throw new Error('Máy chủ phản hồi mã ' + res.status + ' (' + (res.statusText || 'Lỗi xử lý') + ')');
                    }
                })
                .then(data => {
                    if (data.requireLogin) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Phiên làm việc hết hạn',
                            text: data.message || 'Phiên làm việc của Quản trị viên đã hết hạn. Vui lòng đăng nhập lại!',
                            confirmButtonColor: '#434CE8'
                        }).then(() => {
                            window.location.href = '@Url.Action("Login", "Account", new { area = "" })?returnUrl=' + encodeURIComponent(window.location.href);
                        });
                        return;
                    }

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Đã gửi phản hồi từ chối!',
                            text: data.message,
                            confirmButtonColor: '#10B981',
                            timer: 2200,
                            timerProgressBar: true
                        }).then(() => {
                            const badge = document.getElementById('badge-status-' + currentApproveCourseId);
                            if (badge) {
                                badge.className = 'badge badge-danger';
                                badge.textContent = 'Cần sửa đổi';
                            }
                            closeRejectModal();
                            closeApprovalModal();
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thao tác thất bại',
                            text: data.message,
                            confirmButtonColor: '#EF4444'
                        });
                    }
                })
                .catch(err => {
                    console.error('Lỗi khi từ chối:', err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi xử lý',
                        text: err.message || 'Không thể kết nối đến máy chủ. Vui lòng thử lại!',
                        confirmButtonColor: '#EF4444'
                    });
                });
            }
        });
    }

    // Khởi tạo các sự kiện khi trang đã tải xong
    document.addEventListener('DOMContentLoaded', () => {
        // Đóng modal khi click ra ngoài vùng backdrop
        const apprModal = document.getElementById('approval-detail-modal');
        if (apprModal) {
            apprModal.addEventListener('click', (e) => {
                if (e.target === apprModal) {
                    closeApprovalModal();
                }
            });
        }

        const rejModal = document.getElementById('reject-modal');
        if (rejModal) {
            rejModal.addEventListener('click', (e) => {
                if (e.target === rejModal) {
                    closeRejectModal();
                }
            });
        }

        // Đóng khi nhấn phím Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const rejModal = document.getElementById('reject-modal');
                if (rejModal && rejModal.classList.contains('active')) {
                    closeRejectModal();
                    return;
                }
                const apprModal = document.getElementById('approval-detail-modal');
                if (apprModal && apprModal.classList.contains('active')) {
                    closeApprovalModal();
                }
            }
        });

        // Tự động mở modal nếu có SelectedCourseId trên URL
        const autoOpenId = '@(ViewBag.SelectedCourseId ?? "")';
        if (autoOpenId && autoOpenId.trim() !== '') {
            openApprovalModal(autoOpenId.trim());
        }
    });
</script>
}