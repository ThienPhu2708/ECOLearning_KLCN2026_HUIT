@helper ChamDo(string key, int soLuong, string donVi)
{
    <span class="sb-dot" data-pending="@key" data-unit="@donVi" title="@soLuong @donVi chờ xử lý" hidden="@(soLuong > 0 ? null : "hidden")"><span class="sb-sr">@soLuong @donVi chờ xử lý</span></span>
}
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewBag.Title | E-Learning Admin</title>
        <link rel="stylesheet" href="~/assets/css/variables.css">
        <link rel="stylesheet" href="~/assets/css/base.css">
        <link rel="stylesheet" href="~/assets/css/components.css">
        <link rel="stylesheet" href="~/assets/css/dashboard-tables.css?v=4">
        <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="~/assets/css/staff-ui.css?v=1.4">
        <link rel="stylesheet" href="@Url.Content("~/assets/css/admin-activity.css")?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/assets/css/admin-activity.css")).Ticks)" />
        <style>
            /* Chấm đỏ: mục có yêu cầu từ người dùng đang chờ Admin xử lý.
               Đặt tuyệt đối trong phần đệm bên phải của mục: không chiếm chỗ của chữ, mục giữ nguyên kích thước */
            .sidebar-item {
                position: relative;
            }

            .sidebar-item > svg,
            .sidebar-item > i {
                flex-shrink: 0;
            }

            .sidebar-menu {
                overflow-x: hidden;
            }

            .sb-dot {
                position: absolute;
                top: 50%;
                right: 5px;
                width: 8px;
                height: 8px;
                margin-top: -4px;
                border-radius: 50%;
                pointer-events: none;
                background: #EF4444;
                box-shadow: 0 0 0 2px #FFFFFF;
            }

            .sb-dot[hidden] {
                display: none;
            }

            .sb-dot::after {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: 50%;
                background: #EF4444;
                animation: sb-dot-pulse 1.8s ease-out infinite;
            }

            @@keyframes sb-dot-pulse {
                0% { transform: scale(1); opacity: .6; }
                100% { transform: scale(2); opacity: 0; }
            }

            @@media (prefers-reduced-motion: reduce) {
                .sb-dot::after { animation: none; }
            }

            .sb-sr {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0 0 0 0);
                white-space: nowrap;
            }
        </style>
    </head>
    <body class="staff-ui admin-ui">
        <div class="dashboard-layout">
            <!-- SIDEBAR -->
            <aside class="dashboard-sidebar" id="admin-sidebar" aria-label="Điều hướng quản trị">
                <div class="sidebar-logo">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="brand-logo">
                        <div class="logo-icon" style="width: 34px; height: 34px; background: #0F172A;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                                <path d="M2 17l10 5 10-5"></path>
                                <path d="M2 12l10 5 10-5"></path>
                            </svg>
                        </div>
                        <span class="logo-text" style="font-size: 18px;">Admin Hub<span>.</span></span>
                    </a>
                </div>

                @{
                string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
                var choXuLy = ViewBag.AdminPending as ECOLearning.Services.AdminPendingCounts ?? new ECOLearning.Services.AdminPendingCounts();
            }

            <nav class="sidebar-menu">
                <div class="sidebar-section">Tổng quan</div>
                <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="sidebar-item @(currentController == "Dashboard" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    Dashboard hệ thống
                </a>
                <div class="sidebar-section">Người dùng</div>
                <a href="@Url.Action("Index", "User", new { area = "Admin" })" class="sidebar-item @(currentController == "User" ? "active" : "")">
                    <i class="bi bi-people-fill" style="font-size: 17px; width: 18px; text-align: center;"></i>
                    Quản lý người dùng
                </a>
                <a href="@Url.Action("Index", "Administrator", new { area = "Admin" })" class="sidebar-item @(currentController == "Administrator" ? "active" : "")">
                    <i class="bi bi-shield-lock" style="font-size:17px;width:18px;text-align:center;" aria-hidden="true"></i>
                    Quản lý Admin
                </a>
                <a href="@Url.Action("Index", "Teacher", new { area = "Admin" })" class="sidebar-item @(currentController == "Teacher" ? "active" : "")">
                    <i class="bi bi-person-video3" style="font-size: 17px; width: 18px; text-align: center;"></i>
                    Quản lý giáo viên
                </a>
                <a href="@Url.Action("Index", "Marketing", new { area = "Admin" })" class="sidebar-item @(currentController == "Marketing" ? "active" : "")">
                    <i class="bi bi-megaphone-fill" style="font-size: 17px; width: 18px; text-align: center;"></i>
                    Giám sát Marketing
                </a>
                <div class="sidebar-section">Nội dung</div>
                <a href="@Url.Action("Index", "Category", new { area = "Admin" })" class="sidebar-item @(currentController == "Category" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    Quản lý danh mục
                </a>
                <a href="@Url.Action("Index", "CourseApproval", new { area = "Admin" })" class="sidebar-item @(currentController == "CourseApproval" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                    Kiểm duyệt khóa học
                    @ChamDo("courses", choXuLy.KhoaHoc, "khóa học")
                </a>
                <a href="@Url.Action("Index", "TeacherApproval", new { area = "Admin" })" class="sidebar-item @(currentController == "TeacherApproval" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <polyline points="17 11 19 13 23 9"></polyline>
                    </svg>
                    Duyệt hồ sơ Giáo viên
                    @ChamDo("teachers", choXuLy.GiaoVien, "hồ sơ")
                </a>
                <a href="@Url.Action("Index", "TeacherSpecialty", new { area = "Admin" })" class="sidebar-item @(currentController == "TeacherSpecialty" ? "active" : "")">
                    <i class="bi bi-patch-plus" style="font-size: 17px; width: 18px; text-align: center;"></i>
                    Yêu cầu bổ sung chuyên môn
                    @ChamDo("specialties", choXuLy.ChuyenMon, "yêu cầu")
                </a>
                <a href="@Url.Action("Index", "ViolationReport", new { area = "Admin" })" class="sidebar-item @(currentController == "ViolationReport" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                        <line x1="4" y1="22" x2="4" y2="15"></line>
                    </svg>
                    Báo cáo vi phạm
                    @ChamDo("violations", choXuLy.ViPham, "yêu cầu")
                </a>
                <div class="sidebar-section">Báo cáo & tài chính</div>
                <a href="@Url.Action("Index", "SystemReport", new { area = "Admin" })" class="sidebar-item @(currentController == "SystemReport" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    Báo cáo hệ thống
                </a>
                <a href="@Url.Action("Index", "RevenueReport", new { area = "Admin" })" class="sidebar-item @(currentController == "RevenueReport" ? "active" : "")">
                    <i class="bi bi-calendar-range" style="font-size: 17px; width: 18px; text-align: center;"></i>
                    Doanh thu theo ngày
                </a>
                <a href="@Url.Action("Index", "PayoutRequest", new { area = "Admin" })" class="sidebar-item @(currentController == "PayoutRequest" ? "active" : "")">
                    <i class="bi bi-cash-coin" style="font-size: 17px; width: 18px; text-align: center;"></i>
                    Chi trả giáo viên
                    @ChamDo("payouts", choXuLy.ChiTra, "phiếu chi")
                </a>
            </nav>

            <div class="sidebar-footer">
                <button type="button" class="btn btn-secondary btn-sm" style="width: 100%; cursor: pointer;" onclick="confirmAdminLogout()">Đăng xuất</button>
            </div>
        </aside>
        <button type="button" class="admin-menu-backdrop" id="admin-menu-backdrop" aria-label="Đóng menu" hidden></button>

        <!-- MAIN -->
        <main class="dashboard-main">
            <!-- TOP NAVIGATION BAR -->
            <header class="dashboard-topbar">
                <button type="button" class="staff-menu-btn" id="admin-menu-toggle" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Mở menu quản trị"><i class="bi bi-list" aria-hidden="true"></i></button>
                <nav class="breadcrumb-nav">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Admin</a>
                    @* Trang chi tiết (cấp 3): cấp giữa bấm được, quay về đúng trang danh sách vừa mở (giữ bộ lọc, trang số) *@
                    @if (ViewBag.BreadcrumbParent != null)
                    {
                        <span class="separator">/</span>
                        <a href="@ViewBag.BreadcrumbParentUrl" id="breadcrumb-parent">@ViewBag.BreadcrumbParent</a>
                    }
                    @if (ViewBag.BreadcrumbCurrent != null)
                    {
                        <span class="separator">/</span>
                        <span class="current">@ViewBag.BreadcrumbCurrent</span>
                    }
                </nav>
                <div class="topbar-actions">
                    <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline btn-sm">Về Trang chủ</a>
                </div>
            </header>

            <div class="admin-page-content">
                @RenderBody()
            </div>
        </main>
        <script>
            // Breadcrumb: trang danh sách ghi lại địa chỉ (kèm bộ lọc) và tên; trang chi tiết dùng làm cấp giữa để Admin
            // quay về đúng trang vừa bấm vào. Thao tác trên trang chi tiết (khóa, cảnh báo...) không ghi đè nên vẫn quay về đúng chỗ.
            (function () {
                var key = 'admin-breadcrumb-list';
                var parent = document.getElementById('breadcrumb-parent');
                try {
                    if (!parent) {
                        var title = '@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewBag.BreadcrumbCurrent as string ?? ""))';
                        if (title) sessionStorage.setItem(key, JSON.stringify({ url: location.pathname + location.search, title: title }));
                        return;
                    }
                    var last = JSON.parse(sessionStorage.getItem(key) || 'null');
                    if (last && last.url && last.title) { parent.href = last.url; parent.textContent = last.title; }
                } catch (e) { }
            })();
        </script>
    </div>

    <!-- MODAL XÁC NHẬN ĐĂNG XUẤT ADMIN -->
    <div class="modal-overlay" id="admin-logout-modal">
        <div class="modal-container" style="max-width: 420px; text-align: center; padding: 32px 24px; border-radius: 20px; background: #FFFFFF;">
            <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(239, 68, 68, 0.1); color: #EF4444; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </div>
            <h3 class="h3" style="margin-bottom: 8px;">Xác nhận đăng xuất</h3>
            <p class="body-2" style="color: var(--text-secondary); margin-bottom: 24px; font-size: 14px; line-height: 1.5;">
                Bạn có chắc chắn muốn kết thúc phiên làm việc Quản trị viên và quay về Trang chủ không?
            </p>
            <div style="display: flex; gap: 12px;">
                <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="closeAdminLogoutModal()">Hủy</button>
                <a href="@Url.Action("Logout", "Account", new { area = "" })" class="btn btn-danger" style="flex: 1; background: #EF4444; border-color: #EF4444; color: #ffffff; text-decoration: none; display: flex; align-items: center; justify-content: center; font-weight: 600;">Đăng xuất</a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/assets/js/charts.js?v=2"></script>
    <script src="~/assets/js/admin-charts.js?v=2"></script>
    <script src="~/assets/js/app.js"></script>
    <script src="~/assets/js/table-pagination.js?v=2"></script>
    <script src="~/assets/js/sweetalert2.all.min.js"></script>
    <script>
        if (typeof Swal === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"><\/script>');
        }
    </script>
    <style>
        /* Modern SweetAlert2 theme matching E-Learning Design System */
        .swal2-popup {
            border-radius: 20px !important;
            font-family: inherit !important;
            padding: 24px !important;
            box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25) !important;
        }
        .swal2-title {
            font-size: 20px !important;
            font-weight: 800 !important;
            color: #0F172A !important;
        }
        .swal2-html-container {
            font-size: 14px !important;
            color: #64748B !important;
            line-height: 1.6 !important;
        }
        .swal2-actions {
            gap: 12px !important;
            margin-top: 20px !important;
        }
        .swal2-actions button {
            border-radius: 12px !important;
            font-weight: 700 !important;
            font-size: 14px !important;
            padding: 10px 22px !important;
            box-shadow: none !important;
        }
    </style>
    <script>
        function confirmAdminLogout() {
            const modal = document.getElementById('admin-logout-modal');
            if (modal) {
                if (window.openModal) {
                    openModal('admin-logout-modal');
                } else {
                    modal.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            } else {
                if (confirm('Bạn có chắc chắn muốn đăng xuất khỏi phiên làm việc Quản trị viên không?')) {
                    window.location.href = '@Url.Action("Logout", "Account", new { area = "" })';
                }
            }
        }

        // Làm mới chấm đỏ khi Admin để trang mở lâu, quay lại tab, hoặc vừa duyệt / từ chối bằng AJAX
        (function () {
            var url = '@Url.Action("PendingCounts", "Dashboard", new { area = "Admin" })';
            var dangTai = false;

            function capNhat(data) {
                document.querySelectorAll('.sb-dot[data-pending]').forEach(function (dot) {
                    var n = parseInt(data[dot.getAttribute('data-pending')], 10) || 0;
                    var text = n + ' ' + dot.getAttribute('data-unit') + ' chờ xử lý';
                    dot.hidden = n === 0;
                    dot.title = text;
                    dot.firstElementChild.textContent = text;
                });
            }

            function taiLai() {
                if (dangTai || document.hidden) return;
                dangTai = true;
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin', cache: 'no-store' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) { if (data && data.success) capNhat(data); })
                    .catch(function () { })
                    .then(function () { dangTai = false; });
            }

            setInterval(taiLai, 60000);
            document.addEventListener('visibilitychange', function () { if (!document.hidden) taiLai(); });
            if (window.jQuery) {
                jQuery(document).ajaxSuccess(function (e, xhr, settings) {
                    if (settings.type && settings.type.toUpperCase() !== 'GET') setTimeout(taiLai, 300);
                });
            }
        })();

        function closeAdminLogoutModal() {
            const modal = document.getElementById('admin-logout-modal');
            if (modal) {
                if (window.closeModal) {
                    closeModal('admin-logout-modal');
                } else {
                    modal.classList.remove('active');
                    document.body.style.overflow = '';
                }
            }
        }
    </script>
    @Html.Partial("~/Views/Shared/_PhienDangNhap.cshtml")
    @RenderSection("Scripts", required: false)
    <link rel="stylesheet" href="@Url.Content("~/assets/css/admin-responsive.css")?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/assets/css/admin-responsive.css")).Ticks)" />
    <script src="@Url.Content("~/assets/js/admin-responsive.js?v=1")"></script>
</body>
</html>
