@model ECOLearning.Areas.Admin.Models.SystemReportPageViewModel
@*
    Báo cáo hệ thống (UC16). Mỗi card có bộ lọc riêng và lấy số liệu qua JSON (SystemReportController); rê chuột vào biểu đồ / thanh
    tỷ lệ để xem số liệu. Xuất Excel / PDF theo kỳ và năm đang chọn ở bảng số liệu theo kỳ. Cuối trang: card Lưu trữ video.
*@
@{
    ViewBag.Title = "Báo Cáo Thống Kê Toàn Hệ Thống";
    var v = Model.Video;
    int videoLoi = v.DangCho.Count(c => c.TrangThai == "Lỗi");
    Func<long, string> mb = b => b > 0 ? (b / 1048576d).ToString("#,##0.#") + " MB" : "—";
}

<link rel="stylesheet" href="~/assets/css/admin-report.css?v=1" />
<style>
    .sr-stat { display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--border-color); }
    .vs-badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .vs-facts { display: flex; gap: 18px; flex-wrap: wrap; font-size: 13.5px; color: var(--text-secondary); margin: 12px 0; }
    .vs-facts b { color: var(--text-heading); }
    .vs-alert { padding: 10px 14px; border-radius: 10px; background: #FEF2F2; border: 1px solid #FCA5A5; color: #991B1B; font-size: 13.5px; margin-bottom: 12px;
        display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
    .vs-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .vs-details summary { cursor: pointer; font-weight: 600; color: var(--text-heading); font-size: 13.5px; margin-top: 14px; }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 28px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Báo Cáo & Thống Kê Toàn Hệ Thống</h1>
        <p class="body-2" style="color: var(--text-secondary);">Tổng hợp doanh thu sàn, đơn hàng, giáo viên, khóa học và lưu trữ video</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a id="export-excel" href="@Url.Action("ExportExcel", "SystemReport", new { area = "Admin", period = "month" })" class="btn btn-outline" title="Theo kỳ và năm đang chọn ở bảng số liệu theo kỳ">
            <i class="bi bi-file-earmark-spreadsheet"></i> Xuất Excel
        </a>
        <a id="export-pdf" href="@Url.Action("ExportPdf", "SystemReport", new { area = "Admin", period = "month" })" class="btn btn-primary" title="Theo kỳ và năm đang chọn ở bảng số liệu theo kỳ">
            <i class="bi bi-file-earmark-pdf"></i> Xuất Báo Cáo PDF
        </a>
    </div>
</div>

@Html.Partial("_AdminFlash")

<!-- THỐNG KÊ GIÁO VIÊN & KHÓA HỌC THEO TRẠNG THÁI -->
<div class="grid-12" style="margin-bottom: 32px;">
    <div class="col-4">
        <div class="card" style="height: 100%;">
            <h3 class="h3" style="margin-bottom: 6px;">Thống Kê Giáo Viên</h3>
            <span class="caption" style="display: block; margin-bottom: 20px;">Số tài khoản có vai trò Giáo viên trên hệ thống</span>
            <div style="font-size: 40px; font-weight: 800; color: var(--primary); line-height: 1;">@Model.TotalInstructors.ToString("#,##0")</div>
            <div class="caption" style="color: var(--text-secondary); margin: 6px 0 20px;">giáo viên</div>
            <div class="sr-stat"><span>Có khóa học đang bán</span><strong>@Model.InstructorsWithPublishedCourse.ToString("#,##0")</strong></div>
            <div class="sr-stat"><span>Chưa có khóa học đang bán</span><strong>@((Model.TotalInstructors - Model.InstructorsWithPublishedCourse).ToString("#,##0"))</strong></div>
            <div class="sr-stat">
                <span>Hồ sơ đăng ký GV chờ duyệt</span>
                <a href="@Url.Action("Index", "TeacherApproval", new { area = "Admin", statusFilter = "Pending" })" style="font-weight: 700; color: var(--status-warning); text-decoration: none;">@Model.PendingTeacherApplications.ToString("#,##0")</a>
            </div>
        </div>
    </div>

    <div class="col-8">
        <div class="card" style="height: 100%;">
            <div class="ad-card-head">
                <div>
                    <h3 class="h3" style="margin-bottom: 6px;">Khóa Học Theo Trạng Thái</h3>
                    <span class="caption" id="status-caption">Đang tải…</span>
                </div>
                <div class="ad-card-filter">
                    <select id="status-category" aria-label="Danh mục">
                        <option value="">Tất cả danh mục</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Key">@c.Value</option>
                        }
                    </select>
                </div>
            </div>
            <table class="table" style="margin: 0;" data-paginate="10">
                <thead><tr><th>Trạng thái</th><th style="width: 110px; text-align: right;">Số khóa học</th><th style="width: 45%;">Tỷ lệ</th></tr></thead>
                <tbody id="status-body"><tr><td colspan="3" class="ad-empty">Đang tải…</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<!-- DOANH THU & ĐƠN HÀNG / CƠ CẤU THEO DANH MỤC -->
<div class="grid-12" style="margin-bottom: 32px;">
    <div class="col-8">
        <div class="card">
            <div class="ad-chart-head">
                <div>
                    <h3 class="h3">Doanh Thu & Đơn Hàng Đã Thanh Toán</h3>
                    <span class="caption" id="rev-caption">Doanh thu thực thu và số đơn đã thanh toán</span>
                </div>
                <div class="ad-filter">
                    <div class="ad-seg" id="rev-period" role="group" aria-label="Xem theo">
                        <button type="button" data-period="month" class="active">Tháng</button>
                        <button type="button" data-period="quarter">Quý</button>
                        <button type="button" data-period="year">Năm</button>
                    </div>
                    <select id="rev-year" aria-label="Năm">
                        @foreach (var y in Model.Years) { <option value="@y">@y</option> }
                    </select>
                </div>
            </div>
            <div class="ad-legend">
                <span><span class="ad-swatch" style="background: #434CE8;"></span> Doanh thu: <b id="rev-total">—</b></span>
                <span><span class="ad-swatch" style="background: #10B981;"></span> Đơn đã thanh toán: <b id="rev-orders">—</b></span>
            </div>
            <div class="ad-chart" id="rev-chart"><div class="ad-empty">Đang tải biểu đồ…</div></div>
        </div>
    </div>

    <div class="col-4">
        <div class="card" style="height: 100%;">
            <h3 class="h3" style="margin-bottom: 6px;">Cơ Cấu Theo Danh Mục</h3>
            <span class="caption" id="share-caption" style="display: block; margin-bottom: 12px;">Đang tải…</span>
            <div class="ad-card-filter" style="margin-bottom: 16px;">
                <select id="share-metric" aria-label="Tiêu chí">
                    <option value="revenue">Theo doanh thu</option>
                    <option value="enrollments">Theo lượt đăng ký</option>
                    <option value="courses">Theo số khóa học</option>
                </select>
                <select id="share-period" aria-label="Kỳ">
                    <option value="all">Toàn thời gian</option>
                    <option value="month">Theo tháng</option>
                    <option value="quarter">Theo quý</option>
                    <option value="year">Theo năm</option>
                </select>
                <select id="share-value" aria-label="Chọn kỳ" hidden></select>
            </div>
            <div id="share-donut"></div>
        </div>
    </div>
</div>

<!-- DOANH THU THEO GIÁO VIÊN -->
<div class="card" style="padding: 0; overflow: hidden; margin-bottom: 32px;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color);">
        <div class="ad-card-head" style="margin-bottom: 12px;">
            <div>
                <h3 class="h3" style="margin: 0;">Doanh thu theo giáo viên</h3>
                <span class="caption" id="teacher-caption">Đơn hàng đã thanh toán</span>
            </div>
        </div>
        <div class="ad-card-filter">
            <input type="search" id="teacher-search" placeholder="Tìm tên giáo viên" aria-label="Tìm tên giáo viên" style="width: 200px; max-width: 100%;" />
            <select id="teacher-period" aria-label="Kỳ">
                <option value="all">Toàn thời gian</option>
                <option value="month">Theo tháng</option>
                <option value="quarter">Theo quý</option>
                <option value="year">Theo năm</option>
            </select>
            <select id="teacher-value" aria-label="Chọn kỳ" hidden></select>
            <select id="teacher-sort" aria-label="Sắp xếp">
                <option value="revenue">Doanh thu cao nhất</option>
                <option value="orders">Nhiều đơn nhất</option>
                <option value="courses">Nhiều khóa học nhất</option>
                <option value="name">Tên A–Z</option>
            </select>
        </div>
    </div>
    <div class="table-responsive" style="border: none; border-radius: 0;">
        <table class="table" data-paginate="10">
            <thead>
                <tr>
                    <th>Giáo viên</th>
                    <th style="text-align: center;">Số khóa học</th>
                    <th style="text-align: center;">Đang bán</th>
                    <th style="text-align: center;">Số đơn</th>
                    <th style="text-align: right;">Doanh thu</th>
                    <th style="width: 28%;">Tỷ trọng</th>
                </tr>
            </thead>
            <tbody id="teacher-body"><tr><td colspan="6" class="ad-empty">Đang tải…</td></tr></tbody>
        </table>
    </div>
</div>

<!-- BẢNG SỐ LIỆU THEO KỲ -->
<div class="card" style="padding: 0; overflow: hidden; margin-bottom: 32px;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color);" class="ad-chart-head">
        <div>
            <h3 class="h3" style="margin: 0;">Bảng số liệu tổng hợp theo kỳ</h3>
            <span class="caption" id="period-caption">Doanh thu thuần, đơn hàng, học viên mua và tăng trưởng so với kỳ trước</span>
        </div>
        <div class="ad-filter">
            <div class="ad-seg" id="period-type" role="group" aria-label="Kỳ báo cáo">
                <button type="button" data-period="month" class="active">Tháng</button>
                <button type="button" data-period="quarter">Quý</button>
                <button type="button" data-period="year">Năm</button>
            </div>
            <select id="period-year" aria-label="Năm">
                @foreach (var y in Model.Years) { <option value="@y">@y</option> }
            </select>
        </div>
    </div>
    <div class="table-responsive" style="border: none; border-radius: 0;">
        <table class="table" data-paginate="10">
            <thead>
                <tr><th>Giai đoạn</th><th>Doanh thu thuần</th><th>Số đơn hàng</th><th>Giá trị đơn TB</th><th>Học viên mua</th><th>Tăng trưởng</th></tr>
            </thead>
            <tbody id="period-body"><tr><td colspan="6" class="ad-empty">Đang tải…</td></tr></tbody>
        </table>
    </div>
</div>

<!-- LƯU TRỮ VIDEO (Cloudflare R2 + ffmpeg) -->
<div class="card" id="luu-tru-video">
    <div class="ad-card-head" style="margin-bottom: 0;">
        <div>
            <h3 class="h3" style="margin-bottom: 4px;"><i class="bi bi-cloud-arrow-up"></i> Lưu trữ video</h3>
            <span class="caption">Video bài học được nén 720p rồi đưa lên Cloudflare R2@(v.R2DaCauHinh ? " · bucket " + v.TenBucket : "")</span>
        </div>
        <div class="vs-badges">
            <span class="badge @(v.R2DaCauHinh ? "badge-success" : "badge-danger")">R2: @(v.R2DaCauHinh ? "đã cấu hình" : "chưa cấu hình")</span>
            <span class="badge @(v.FfmpegSanSang ? "badge-success" : "badge-warning")" title="@v.FfmpegThongTin">Nén video: @(v.FfmpegSanSang ? "sẵn sàng" : "không dùng được")</span>
        </div>
    </div>
    <div class="vs-facts">
        <span><b>@v.BaiTrenR2</b> bài học dùng video trên R2</span>
        <span><b>@v.BaiTrenMayChu</b> bài còn video trên máy chủ</span>
        <span><b>@v.DangCho.Count</b> video đang chờ xử lý</span>
    </div>
    @if (!v.R2DaCauHinh)
    {
        <div class="vs-alert"><span>Chưa có khóa R2 trong Secrets.config: video mới đang lưu trên máy chủ.</span></div>
    }
    @if (!v.FfmpegSanSang)
    {
        <div class="caption" style="margin-bottom: 12px; color: #B45309;"><i class="bi bi-exclamation-triangle"></i> @v.FfmpegThongTin — video được đưa lên bản gốc, không nén.</div>
    }
    @if (videoLoi > 0)
    {
        <div class="vs-alert">
            <span><i class="bi bi-x-circle-fill"></i> @videoLoi video lỗi khi xử lý: @string.Join("; ", v.DangCho.Where(c => c.TrangThai == "Lỗi").Select(c => c.TenGoc + " (" + c.GhiChu + ")").Take(3))</span>
            @using (Html.BeginForm("ThuLai", "VideoStorage", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline btn-sm">Thử lại</button>
            }
        </div>
    }
    @if ((v.R2DaCauHinh && v.FileTrenMayChu > 0) || v.CoFileSql)
    {
        <div class="vs-actions">
            @if (v.R2DaCauHinh && v.FileTrenMayChu > 0)
            {
                using (Html.BeginForm("ChuyenVideoCu", "VideoStorage", new { area = "Admin" }, FormMethod.Post, new { onsubmit = "return confirm('Đưa " + v.FileTrenMayChu + " video cũ vào hàng đợi chuyển lên R2?');" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">Chuyển @v.FileTrenMayChu video cũ lên R2</button>
                }
            }
            @if (v.CoFileSql)
            {
                <a class="btn btn-outline btn-sm" href="@Url.Action("SqlChuyenDoi", "VideoStorage", new { area = "Admin" })" title="Câu lệnh đổi đường dẫn video để chạy trên CSDL hosting">Tải SQL cho hosting</a>
            }
        </div>
    }
    @if (v.DangCho.Any())
    {
        <div class="table-responsive" style="margin-top: 14px;">
            <table class="table" data-paginate="10">
                <thead><tr><th>Video đang chờ</th><th>Dung lượng gốc</th><th>Trạng thái</th><th>Ghi chú</th></tr></thead>
                <tbody>
                    @foreach (var cv in v.DangCho)
                    {
                        <tr>
                            <td><strong>@cv.TenGoc</strong><div class="ad-sub">@cv.TaoLuc.ToString("dd/MM/yyyy HH:mm")</div></td>
                            <td>@mb(cv.KichThuocGoc)</td>
                            <td><span class="badge @(cv.TrangThai == "Lỗi" ? "badge-danger" : cv.TrangThai == "Chờ xử lý" ? "badge-warning" : "badge-primary")">@cv.TrangThai</span></td>
                            <td class="ad-sub">@cv.GhiChu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (v.LichSu.Any())
    {
        <details class="vs-details">
            <summary>Lịch sử xử lý gần đây (@v.LichSu.Count video, từ lần khởi động gần nhất)</summary>
            <div class="table-responsive" style="margin-top: 10px;">
                <table class="table" data-paginate="10">
                    <thead><tr><th>Video</th><th>Gốc</th><th>Trên R2</th><th>Kết quả</th><th>Thời điểm</th></tr></thead>
                    <tbody>
                        @foreach (var kq in v.LichSu)
                        {
                            <tr>
                                <td><strong>@kq.TenGoc</strong></td>
                                <td>@mb(kq.KichThuocGoc)</td>
                                <td>@(kq.ThanhCong ? mb(kq.KichThuocLuu) : "—")</td>
                                <td>
                                    <span class="badge @(kq.ThanhCong ? "badge-success" : "badge-danger")">@(kq.ThanhCong ? (kq.DaNen ? "Đã nén" : "Bản gốc") : "Bỏ qua")</span>
                                    @if (!string.IsNullOrEmpty(kq.GhiChu)) { <div class="ad-sub">@kq.GhiChu</div> }
                                </td>
                                <td class="ad-sub">@kq.Luc.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</div>

@section Scripts {
<script>
(function () {
    var C = window.AdminCharts, fmtNum = C.fmtNum, fmtMoney = C.fmtMoney, esc = C.esc;
    var base = '@Url.Action("Index", "SystemReport", new { area = "Admin" })'.replace(/\/Index$/, '');
    var years = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Years));
    var now = new Date(), nowYear = now.getFullYear(), nowMonth = now.getMonth() + 1;

    function getJson(action, params) {
        var q = Object.keys(params).map(function (k) { return k + '=' + encodeURIComponent(params[k]); }).join('&');
        return fetch(base + '/' + action + '?' + q, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) { if (!d.success) throw new Error(); return d; });
    }
    function failRow(tbody, cols) { tbody.innerHTML = '<tr><td colspan="' + cols + '" class="ad-empty">Không tải được dữ liệu.</td></tr>'; }
    // Ô chọn kỳ cụ thể (tháng / quý / năm) đi kèm ô chọn loại kỳ; "Toàn thời gian" thì ẩn
    function periodPicker(typeSel, valueSel) {
        function fill() {
            var opts = [];
            years.forEach(function (y) {
                if (typeSel.value === 'month') for (var m = (y === nowYear ? nowMonth : 12); m >= 1; m--) opts.push([y + '-' + m, 'Tháng ' + m + '/' + y]);
                else if (typeSel.value === 'quarter') for (var q = (y === nowYear ? Math.ceil(nowMonth / 3) : 4); q >= 1; q--) opts.push([y + '-' + q, 'Quý ' + q + '/' + y]);
                else if (typeSel.value === 'year') opts.push([y + '-0', 'Năm ' + y]);
            });
            valueSel.innerHTML = opts.map(function (o) { return '<option value="' + o[0] + '">' + o[1] + '</option>'; }).join('');
            valueSel.hidden = !opts.length;
        }
        fill();
        return {
            refill: fill,
            params: function () {
                var v = (valueSel.value || (nowYear + '-' + nowMonth)).split('-');
                return { period: typeSel.value, year: v[0], index: v[1] };
            }
        };
    }
    function segControl(id, onChange) {
        var box = document.getElementById(id);
        box.querySelectorAll('button').forEach(function (btn) {
            btn.addEventListener('click', function () {
                box.querySelectorAll('button').forEach(function (b) { b.classList.toggle('active', b === btn); });
                onChange(btn.dataset.period);
            });
        });
    }
    function bar(percent, color, tip) {
        return '<div class="ad-bar-row" data-tip="' + esc(tip) + '"><div class="ad-bar"><div style="width:' + percent + '%;background:' + color + ';"></div></div>'
            + '<span class="caption" style="width:48px;text-align:right;">' + percent.toLocaleString('vi-VN') + '%</span></div>';
    }

    // ---- Khóa học theo trạng thái: lọc danh mục, rê chuột thanh tỷ lệ ----
    var statusCat = document.getElementById('status-category'), statusBody = document.getElementById('status-body');
    function loadStatus() {
        getJson('CourseStatusStats', { category: statusCat.value }).then(function (d) {
            document.getElementById('status-caption').innerHTML = 'Tổng số <strong>' + fmtNum(d.total) + '</strong> khóa học'
                + (statusCat.value ? ' thuộc ' + esc(statusCat.options[statusCat.selectedIndex].text) : ' trên hệ thống');
            if (!d.rows.length) { statusBody.innerHTML = '<tr><td colspan="3" class="ad-empty">Chưa có khóa học nào.</td></tr>'; return; }
            statusBody.innerHTML = d.rows.map(function (s) {
                return '<tr><td><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:' + s.color + ';margin-right:8px;"></span><strong>'
                    + esc(s.label) + '</strong></td><td style="text-align:right;"><strong>' + fmtNum(s.count) + '</strong></td><td>'
                    + bar(s.percent, s.color, '<strong>' + esc(s.label) + '</strong>' + fmtNum(s.count) + ' / ' + fmtNum(d.total) + ' khóa học · ' + s.percent.toLocaleString('vi-VN') + '%') + '</td></tr>';
            }).join('');
            C.tips(statusBody);
        }).catch(function () { failRow(statusBody, 3); });
    }
    statusCat.addEventListener('change', loadStatus);

    // ---- Doanh thu & đơn hàng: Tháng / Quý / Năm + năm, rê chuột từng điểm ----
    var revState = { period: 'month', year: document.getElementById('rev-year').value };
    var tenKy = { month: 'Theo tháng', quarter: 'Theo quý', year: 'Theo năm' };
    function loadRevenue() {
        getJson('RevenueChart', revState).then(function (d) {
            document.getElementById('rev-caption').textContent = tenKy[d.period] + ' · ' + d.range + ' · doanh thu thực thu và số đơn đã thanh toán';
            document.getElementById('rev-total').textContent = fmtMoney(d.totalRevenue);
            document.getElementById('rev-orders').textContent = fmtNum(d.totalOrders) + ' đơn';
            C.dualLine(document.getElementById('rev-chart'), {
                labels: d.labels,
                ariaLabel: 'Biểu đồ doanh thu và đơn hàng',
                title: function (i) { return d.labels[i] + (d.period === 'year' ? '' : ' / ' + d.year); },
                axes: [C.fmtShort, function (v) { return fmtNum(Math.round(v)); }],
                series: [
                    { name: 'Doanh thu', data: d.revenue, color: '#434CE8', fill: 'rgba(67,76,232,0.06)', format: fmtMoney },
                    { name: 'Đơn đã thanh toán', data: d.orders, color: '#10B981', dashed: true, format: function (v) { return fmtNum(v) + ' đơn'; } }
                ]
            });
        }).catch(function () { document.getElementById('rev-chart').innerHTML = '<div class="ad-empty">Không tải được biểu đồ.</div>'; });
    }
    segControl('rev-period', function (p) { revState.period = p; loadRevenue(); });
    document.getElementById('rev-year').addEventListener('change', function () { revState.year = this.value; loadRevenue(); });

    // ---- Cơ cấu theo danh mục: tiêu chí + kỳ, rê chuột phần màu / chú thích ----
    var shareMetric = document.getElementById('share-metric'), sharePeriod = document.getElementById('share-period');
    var sharePicker = periodPicker(sharePeriod, document.getElementById('share-value'));
    var tenTieuChi = { revenue: 'doanh thu', enrollments: 'lượt đăng ký', courses: 'số khóa học' };
    function loadShare() {
        var laKhoa = shareMetric.value === 'courses';
        sharePeriod.hidden = laKhoa;
        document.getElementById('share-value').hidden = laKhoa || sharePeriod.value === 'all';
        var p = sharePicker.params(); p.metric = shareMetric.value;
        getJson('CategoryShare', p).then(function (d) {
            document.getElementById('share-caption').textContent = 'Tỷ trọng % theo ' + tenTieuChi[d.metric] + (d.metric === 'courses' ? '' : ' · ' + d.range);
            var fmt = d.metric === 'revenue' ? fmtMoney : function (x) { return fmtNum(x) + ' ' + d.unit; };
            C.donut(document.getElementById('share-donut'), {
                segments: d.segments.map(function (s) { return { label: s.label, value: s.value, color: s.color, detail: fmt(s.amount) }; }),
                centerValue: d.metric === 'revenue' ? C.fmtShort(d.total) : fmtNum(d.total),
                centerLabel: d.metric === 'revenue' ? 'doanh thu' : d.unit,
                emptyText: 'Chưa có ' + tenTieuChi[d.metric] + ' trong kỳ này.'
            });
        }).catch(function () { document.getElementById('share-donut').innerHTML = '<div class="ad-empty">Không tải được dữ liệu.</div>'; });
    }
    shareMetric.addEventListener('change', loadShare);
    sharePeriod.addEventListener('change', function () { sharePicker.refill(); loadShare(); });
    document.getElementById('share-value').addEventListener('change', loadShare);

    // ---- Doanh thu theo giáo viên: kỳ (server), tìm tên + sắp xếp (trên trang) ----
    var teacherBody = document.getElementById('teacher-body'), teacherRows = [], teacherTotal = 0;
    var teacherPicker = periodPicker(document.getElementById('teacher-period'), document.getElementById('teacher-value'));
    function renderTeachers() {
        var q = document.getElementById('teacher-search').value.trim().toLowerCase();
        var sort = document.getElementById('teacher-sort').value;
        var rows = teacherRows.filter(function (r) { return !q || r.name.toLowerCase().indexOf(q) >= 0; });
        rows.sort(function (a, b) {
            if (sort === 'name') return a.name.localeCompare(b.name, 'vi');
            return (b[sort] - a[sort]) || (b.revenue - a.revenue) || a.name.localeCompare(b.name, 'vi');
        });
        if (!rows.length) { teacherBody.innerHTML = '<tr><td colspan="6" class="ad-empty">Không có giáo viên phù hợp.</td></tr>'; return; }
        teacherBody.innerHTML = rows.map(function (r) {
            return '<tr><td><a href="' + esc(r.url) + '" style="text-decoration:none;font-weight:700;color:var(--text-heading);">' + esc(r.name) + '</a></td>'
                + '<td style="text-align:center;">' + r.courses + '</td><td style="text-align:center;">' + r.published + '</td>'
                + '<td style="text-align:center;">' + r.orders + '</td>'
                + '<td style="text-align:right;"><strong style="color:var(--primary);">' + fmtMoney(r.revenue) + '</strong></td>'
                + '<td>' + bar(r.share, 'var(--primary)', '<strong>' + esc(r.name) + '</strong>' + fmtMoney(r.revenue) + ' / ' + fmtMoney(teacherTotal) + ' · ' + r.orders + ' đơn') + '</td></tr>';
        }).join('');
        C.tips(teacherBody);
    }
    function loadTeachers() {
        getJson('TeacherRevenue', teacherPicker.params()).then(function (d) {
            document.getElementById('teacher-caption').textContent = 'Đơn hàng đã thanh toán · ' + d.range + ' · tổng ' + fmtMoney(d.total);
            teacherRows = d.rows; teacherTotal = d.total;
            renderTeachers();
        }).catch(function () { failRow(teacherBody, 6); });
    }
    document.getElementById('teacher-period').addEventListener('change', function () { teacherPicker.refill(); loadTeachers(); });
    document.getElementById('teacher-value').addEventListener('change', loadTeachers);
    document.getElementById('teacher-sort').addEventListener('change', renderTeachers);
    document.getElementById('teacher-search').addEventListener('input', renderTeachers);

    // ---- Bảng số liệu theo kỳ (cũng là phạm vi của file Excel / PDF) ----
    var periodState = { period: 'month', year: document.getElementById('period-year').value };
    var periodBody = document.getElementById('period-body');
    function loadPeriod() {
        var exportQ = '?period=' + periodState.period + '&year=' + periodState.year;
        document.getElementById('export-excel').href = base + '/ExportExcel' + exportQ;
        document.getElementById('export-pdf').href = base + '/ExportPdf' + exportQ;
        getJson('PeriodTable', periodState).then(function (d) {
            document.getElementById('period-caption').textContent = tenKy[d.period] + (d.period === 'year' ? ' (tới năm ' + d.year + ')' : ' · năm ' + d.year)
                + ' · Xuất Excel / PDF theo kỳ này';
            periodBody.innerHTML = d.rows.map(function (r) {
                var g = r.growth === '-' ? '<span style="color:var(--text-secondary);">-</span>'
                    : '<span class="badge ' + (r.growth.charAt(0) === '-' ? 'badge-danger' : 'badge-success') + '">' + esc(r.growth) + '</span>';
                return '<tr><td><strong>' + esc(r.label) + '</strong></td><td><strong style="color:var(--primary);">' + fmtMoney(r.revenue) + '</strong></td>'
                    + '<td>' + fmtNum(r.orders) + ' đơn</td><td>' + fmtMoney(r.avg) + '</td><td>' + fmtNum(r.students) + '</td><td>' + g + '</td></tr>';
            }).join('') || '<tr><td colspan="6" class="ad-empty">Không có dữ liệu.</td></tr>';
        }).catch(function () { failRow(periodBody, 6); });
    }
    segControl('period-type', function (p) { periodState.period = p; loadPeriod(); });
    document.getElementById('period-year').addEventListener('change', function () { periodState.year = this.value; loadPeriod(); });

    loadStatus(); loadRevenue(); loadShare(); loadTeachers(); loadPeriod();

    @if (Request.QueryString["pdfError"] == "1")
    {
        <text>if (window.showToast) showToast('Không tạo được file PDF. Vui lòng thử lại!', 'error');</text>
    }
})();
</script>
}
