@model ECOLearning.Areas.Admin.Models.SystemReportViewModel
@{
ViewBag.Title = "Báo Cáo Thống Kê Toàn Hệ Thống";
bool isFiltered = Model.FilterCategory != "" || Model.FilterTeacherId.HasValue;
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Báo Cáo & Thống Kê Toàn Hệ Thống</h1>
        <p class="body-2" style="color: var(--text-secondary);">Tổng hợp số liệu doanh thu sàn, sản lượng đơn hàng và cơ cấu theo chuyên ngành</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a href="@Url.Action("ExportExcel", "SystemReport", new { area = "Admin", period = Model.Period, category = Model.FilterCategory, teacher = Model.FilterTeacherId })" class="btn btn-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Xuất Excel
        </a>
        <a href="@Url.Action("ExportPdf", "SystemReport", new { area = "Admin", period = Model.Period, category = Model.FilterCategory, teacher = Model.FilterTeacherId })" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Xuất Báo Cáo PDF
        </a>
    </div>
</div>

<!-- FILTER CONTROLS (UC16) -->
<div class="card" style="margin-bottom: 24px; padding: 16px 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <label class="caption" style="font-weight: 700; color: var(--text-heading);">Khoảng thời gian:</label>
            <div style="display: flex; gap: 8px;">
                <a href="@Url.Action("Index", "SystemReport", new { area = "Admin", period = "month", category = Model.FilterCategory, teacher = Model.FilterTeacherId })"
                class="btn btn-sm @(Model.Period == "month" ? "btn-primary" : "btn-secondary")">Theo Tháng</a>
                <a href="@Url.Action("Index", "SystemReport", new { area = "Admin", period = "quarter", category = Model.FilterCategory, teacher = Model.FilterTeacherId })"
                class="btn btn-sm @(Model.Period == "quarter" ? "btn-primary" : "btn-secondary")">Theo Quý</a>
                <a href="@Url.Action("Index", "SystemReport", new { area = "Admin", period = "year", category = Model.FilterCategory, teacher = Model.FilterTeacherId })"
                class="btn btn-sm @(Model.Period == "year" ? "btn-primary" : "btn-secondary")">Theo Năm</a>
            </div>
        </div>

        <!-- Phân tích dữ liệu: lọc theo danh mục / giáo viên -->
        <form method="get" action="@Url.Action("Index", "SystemReport", new { area = "Admin" })" style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <input type="hidden" name="period" value="@Model.Period" />
            <label class="caption" style="font-weight: 700; color: var(--text-heading);">Phân tích dữ liệu:</label>
            <select name="category" class="form-control" style="width: 200px; height: 38px; font-size: 13px;">
                <option value="">Tất cả danh mục</option>
                @foreach (var c in Model.CategoryOptions)
                {
                    <option value="@c.Value" @(c.Selected ? "selected" : "")>@c.Text</option>
                }
            </select>
            <select name="teacher" class="form-control" style="width: 200px; height: 38px; font-size: 13px;">
                <option value="">Tất cả giáo viên</option>
                @foreach (var t in Model.TeacherOptions)
                {
                    <option value="@t.Value" @(t.Selected ? "selected" : "")>@t.Text</option>
                }
            </select>
            <button type="submit" class="btn btn-primary btn-sm" style="height: 38px;">Áp dụng</button>
            @if (isFiltered)
            {
                <a href="@Url.Action("Index", "SystemReport", new { area = "Admin", period = Model.Period })" class="btn btn-secondary btn-sm" style="height: 38px; display: inline-flex; align-items: center;">Bỏ lọc</a>
            }
        </form>
    </div>
    @if (isFiltered)
    {
        <div style="margin-top: 12px;">
            <span class="badge badge-primary" style="font-size: 12px;"><i class="bi bi-funnel-fill"></i> Đang phân tích: @Model.FilterLabel</span>
            <span class="caption" style="color: var(--text-secondary); margin-left: 6px;">Toàn bộ số liệu, biểu đồ và file xuất Excel/PDF bên dưới chỉ tính trong phạm vi này.</span>
        </div>
    }
</div>

<!-- THỐNG KÊ GIÁO VIÊN & KHÓA HỌC THEO TRẠNG THÁI -->
<div class="grid-12" style="margin-bottom: 32px;">
    <div class="col-4">
        <div class="card" style="height: 100%;">
            <h3 class="h3" style="margin-bottom: 6px;">Thống Kê Giáo Viên</h3>
            <span class="caption" style="display: block; margin-bottom: 20px;">Số tài khoản có vai trò Giáo viên trên hệ thống</span>

            <div style="font-size: 40px; font-weight: 800; color: var(--primary); line-height: 1;">@Model.TotalInstructors.ToString("#,##0")</div>
            <div class="caption" style="color: var(--text-secondary); margin: 6px 0 20px;">giáo viên</div>

            <div style="display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--border-color);">
                <span>Có khóa học đang bán</span>
                <strong>@Model.InstructorsWithPublishedCourse.ToString("#,##0")</strong>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--border-color);">
                <span>Chưa có khóa học đang bán</span>
                <strong>@((Model.TotalInstructors - Model.InstructorsWithPublishedCourse).ToString("#,##0"))</strong>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--border-color);">
                <span>Hồ sơ đăng ký GV chờ duyệt</span>
                <a href="@Url.Action("Index", "TeacherApproval", new { area = "Admin", statusFilter = "Pending" })" style="font-weight: 700; color: var(--status-warning); text-decoration: none;">@Model.PendingTeacherApplications.ToString("#,##0")</a>
            </div>
        </div>
    </div>

    <div class="col-8">
        <div class="card" style="height: 100%;">
            <h3 class="h3" style="margin-bottom: 6px;">Khóa Học Theo Trạng Thái</h3>
            <span class="caption" style="display: block; margin-bottom: 20px;">Tổng số <strong>@Model.TotalCourses</strong> khóa học trên hệ thống</span>

            @if (Model.CourseStatusStats.Any())
            {
                <table class="table" style="margin: 0;">
                    <thead>
                        <tr>
                            <th>Trạng thái</th>
                            <th style="width: 110px; text-align: right;">Số khóa học</th>
                            <th style="width: 45%;">Tỷ lệ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.CourseStatusStats)
                        {
                            <tr>
                                <td>
                                    <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: @s.Color; margin-right: 8px;"></span>
                                    <strong>@s.Label</strong>
                                </td>
                                <td style="text-align: right;"><strong>@s.Count</strong></td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="flex: 1; height: 8px; background: #F1F5F9; border-radius: 4px; overflow: hidden;">
                                            <div style="width: @(s.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; background: @s.Color;"></div>
                                        </div>
                                        <span class="caption" style="width: 48px; text-align: right;">@s.Percent.ToString("0.#")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: var(--text-secondary); text-align: center; padding: 24px 0;">Chưa có khóa học nào trên hệ thống.</p>
            }
        </div>
    </div>
</div>

<!-- BIỂU ĐỒ ĐƯỜNG KÉP & DONUT CHART (UC16) -->
<div class="grid-12" style="margin-bottom: 32px;">

    <!-- Biểu đồ kép: Doanh thu & Đơn hàng hoàn tất -->
    <div class="col-8">
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <h3 class="h3">Tăng Trưởng Doanh Thu & Đơn Hàng Hoàn Tất</h3>
                    <span class="caption">Trục trái: doanh thu (triệu VNĐ) • Trục phải: số đơn thanh toán thành công</span>
                </div>
                <div style="display: flex; gap: 16px; font-size: 12px; font-weight: 700;">
                    <span style="display: flex; align-items: center; gap: 6px; color: var(--primary);">
                        <span style="width: 12px; height: 3px; background: var(--primary);"></span> Doanh thu
                    </span>
                    <span style="display: flex; align-items: center; gap: 6px; color: var(--status-success);">
                        <span style="width: 14px; height: 0; border-top: 3px dashed var(--status-success);"></span> Đơn hoàn tất
                    </span>
                </div>
            </div>

            <div id="dual-metrics-chart"></div>
        </div>
    </div>

    <!-- Biểu đồ tròn: Tỷ trọng doanh thu theo danh mục đào tạo (UC16) -->
    <div class="col-4">
        <div class="card">
            <h3 class="h3" style="margin-bottom: 6px;">@(Model.CategorySegmentsByCourse ? "Cơ Cấu Theo Khóa Học" : "Cơ Cấu Theo Danh Mục")</h3>
            <span class="caption" style="display: block; margin-bottom: 20px;">
                @(Model.CategorySegmentsByRevenue ? "Tỷ trọng % theo doanh thu" : "Chưa phát sinh doanh thu — tỷ trọng % theo số khóa học")
            </span>
            <div id="system-category-donut"></div>
        </div>
    </div>

</div>

<!-- DOANH THU THEO GIÁO VIÊN -->
<div class="card" style="padding: 0; overflow: hidden; margin-bottom: 32px;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color);">
        <h3 class="h3" style="margin: 0;">Doanh thu theo giáo viên</h3>
        <span class="caption" style="color: var(--text-secondary);">Tính trên các đơn hàng đã thanh toán trong phạm vi phân tích</span>
    </div>
    <div class="table-responsive" style="border: none; border-radius: 0;">
        <table class="table" data-paginate="10">
            <thead>
                <tr>
                    <th>Giáo viên</th>
                    <th style="text-align: center;">Số khóa học</th>
                    <th style="text-align: center;">Đang bán</th>
                    <th style="text-align: center;">Số đơn</th>
                    <th style="text-align: right;">Doanh thu</th>
                    <th style="width: 30%;">Tỷ trọng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TeacherRevenueRows.Any())
                {
                    foreach (var r in Model.TeacherRevenueRows)
                    {
                        double share = Model.TotalNetRevenue > 0 ? (double)(r.Revenue / Model.TotalNetRevenue * 100) : 0;
                        <tr>
                            <td>
                                <a href="@Url.Action("Index", "SystemReport", new { area = "Admin", period = Model.Period, category = Model.FilterCategory, teacher = r.TeacherId })" style="text-decoration: none; font-weight: 700; color: var(--text-heading);">@r.TeacherName</a>
                            </td>
                            <td style="text-align: center;">@r.CourseCount</td>
                            <td style="text-align: center;">@r.PublishedCourseCount</td>
                            <td style="text-align: center;">@r.Orders</td>
                            <td style="text-align: right;"><strong style="color: var(--primary);">@r.Revenue.ToString("#,##0 đ")</strong></td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="flex: 1; height: 8px; background: #F1F5F9; border-radius: 4px; overflow: hidden;">
                                        <div style="width: @(share.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; background: var(--primary);"></div>
                                    </div>
                                    <span class="caption" style="width: 48px; text-align: right;">@share.ToString("0.#")%</span>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 24px;">Không có giáo viên nào trong phạm vi phân tích.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SUMMARY REPORT TABLE -->
@{
int totalReports = Model.PeriodReports != null ? Model.PeriodReports.Count : 0;
int pageSize = Model.Period == "month" ? 6 : 10;
int totalPages = totalReports > 0 ? (int)Math.Ceiling((double)totalReports / pageSize) : 1;
int initialEnd = Math.Min(pageSize, totalReports);
}
<div class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <h3 class="h3" style="margin: 0;">Bảng số liệu tổng hợp chi tiết theo kỳ báo cáo (@(Model.Period == "month" ? "Theo Tháng" : (Model.Period == "year" ? "Theo Năm" : "Theo Quý")))</h3>
        @if (Model.Period == "month")
        {
            <span class="badge badge-primary" style="font-size: 12px; font-weight: 600;">Phân trang 6 tháng / trang</span>
        }
    </div>

    <div class="table-responsive">
        <table class="table" id="period-report-table">
            <thead>
                <tr>
                    <th>Giai Đoạn</th>
                    <th>Doanh Thu Thuần</th>
                    <th>Số Đơn Hàng</th>
                    <th>Giá Trị Đơn TB</th>
                    <th>Học Viên Mới</th>
                    <th>Tăng Trưởng</th>
                </tr>
            </thead>
            <tbody id="period-report-tbody">
                @if (Model.PeriodReports != null && Model.PeriodReports.Any())
                {
                    int rowIndex = 0;
                    foreach (var row in Model.PeriodReports)
                    {
                        int rowPage = (rowIndex / pageSize) + 1;
                        <tr class="report-row" data-page="@rowPage" style="@(rowPage > 1 ? "display: none;" : "")">
                        <td><strong>@row.GiaiDoan</strong></td>
                        <td><strong style="color: var(--primary);">@row.DoanhThu.ToString("#,##0 đ")</strong></td>
                        <td>@row.SoDonHang.ToString("#,##0") đơn</td>
                        <td>@row.GiaTriDonTrungBinh.ToString("#,##0 đ")</td>
                        <td>+@row.HocVienMoi.ToString("#,##0")</td>
                        <td>
                            @if (row.TangTruong == "-")
                            {
                                <span style="color: var(--text-secondary); font-weight: 500;">-</span>
                            }
                            else if (row.TangTruong.StartsWith("-"))
                            {
                                <span class="badge badge-danger">@row.TangTruong</span>
                            }
                            else
                            {
                                <span class="badge badge-success">@row.TangTruong</span>
                            }
                        </td>
                    </tr>
                    rowIndex++;
                }
            }
            else
            {
                <tr class="no-data-row">
                    <td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 24px;">
                        Không có dữ liệu báo cáo cho khoảng thời gian đã chọn.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- PAGINATION CONTAINER -->
<div class="pagination-container" id="report-pagination-container">
    <div class="pagination-info" id="report-pagination-info">
        Hiển thị <strong>@(totalReports > 0 ? 1 : 0) - @initialEnd</strong> trên tổng số <strong>@totalReports</strong> kỳ báo cáo
    </div>
    <ul class="pagination" id="report-pagination-list">
        <li class="page-item disabled" id="report-page-prev">
            <button class="page-link" type="button" onclick="changeReportPage(currentReportPage - 1)"><i class="bi bi-chevron-left me-1"></i> Trước</button>
        </li>
        @for (int p = 1; p <= totalPages; p++)
        {
            <li class="page-item @(p == 1 ? "active" : "")" data-page-item="@p">
                <button class="page-link" type="button" onclick="changeReportPage(@p)">@p</button>
            </li>
        }
        <li class="page-item @(totalPages <= 1 ? "disabled" : "")" id="report-page-next">
            <button class="page-link" type="button" onclick="changeReportPage(currentReportPage + 1)">Sau <i class="bi bi-chevron-right ms-1"></i></button>
        </li>
    </ul>
</div>
</div>

@section Scripts {
<script>
    let currentReportPage = 1;
    const reportPageSize = @pageSize;
    const reportTotalRows = @totalReports;
    const reportTotalPages = @totalPages;

    function changeReportPage(targetPage) {
    if (targetPage < 1 || targetPage > reportTotalPages) return;
    currentReportPage = targetPage;

    // Hiển thị/ẩn các hàng tương ứng với trang được chọn
    const rows = document.querySelectorAll('#period-report-tbody tr.report-row');
    rows.forEach(row => {
    const p = parseInt(row.getAttribute('data-page'), 10);
    if (p === currentReportPage) {
    row.style.display = '';
}
else
{
    row.style.display = 'none';
}
});

// Cập nhật thông tin phân trang (Ví dụ: Hiển thị 1 - 6 hoặc 7 - 12)
const startIdx = (currentReportPage - 1) * reportPageSize + 1;
const endIdx = Math.min(currentReportPage * reportPageSize, reportTotalRows);
const infoElem = document.getElementById('report-pagination-info');
if (infoElem) {
infoElem.innerHTML = `Hiển thị <strong>${startIdx} - ${endIdx}</strong> trên tổng số <strong>${reportTotalRows}</strong> kỳ báo cáo`;
}

// Cập nhật trạng thái active của các nút số trang
document.querySelectorAll('#report-pagination-list .page-item[data-page-item]').forEach(item => {
const p = parseInt(item.getAttribute('data-page-item'), 10);
if (p === currentReportPage) {
item.classList.add('active');
}
else
{
    item.classList.remove('active');
}
});

// Cập nhật trạng thái nút Trước / Sau
const prevBtn = document.getElementById('report-page-prev');
if (prevBtn) {
if (currentReportPage <= 1) {
prevBtn.classList.add('disabled');
}
else
{
    prevBtn.classList.remove('disabled');
}
}

const nextBtn = document.getElementById('report-page-next');
if (nextBtn) {
if (currentReportPage >= reportTotalPages) {
nextBtn.classList.add('disabled');
}
else
{
    nextBtn.classList.remove('disabled');
}
}
}

// Khi in ấn PDF, hiển thị toàn bộ hàng để văn bản đầy đủ
window.addEventListener('beforeprint', () => {
document.querySelectorAll('#period-report-tbody tr.report-row').forEach(r => r.style.display = '');
});
window.addEventListener('afterprint', () => {
changeReportPage(currentReportPage);
});

document.addEventListener('DOMContentLoaded', () => {
const revenueData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueChartData));
const orderData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.OrderChartData));
const chartLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartLabels));
const categorySegments = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CategoryRevenueSegments.Select(s => new { label = s.Label, value = s.Value, color = s.Color })));

if (window.Charts && typeof Charts.renderDualLineChart === 'function') {
// Biểu đồ 2 trục: Doanh thu (triệu VNĐ, trục trái) & Đơn hoàn tất (trục phải)
Charts.renderDualLineChart('dual-metrics-chart', {
labels: chartLabels,
series: [
{ name: 'Doanh thu', data: revenueData, color: '#434CE8', fillColor: 'rgba(67, 76, 232, 0.06)', unit: 'triệu VNĐ' },
{ name: 'Đơn hoàn tất', data: orderData, color: '#10B981', unit: 'đơn' }
]
});

// Donut Chart compliant with UC16
Charts.renderDonutChart('system-category-donut', {
segments: categorySegments
});
}

@if (Request.QueryString["pdfError"] == "1")
{
    <text>
        if (window.showToast) showToast('Không tạo được file PDF. Vui lòng thử lại!', 'error');
    </text>
}
});
</script>
}