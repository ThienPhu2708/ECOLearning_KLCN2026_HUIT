@using ECOLearning.Services
@model List<TeacherSpecialtyRequest>
@{
    ViewBag.Title = "Yêu cầu bổ sung chuyên môn";
    var teachers = ViewBag.Teachers as Dictionary<int, ECOLearning.Models.NguoiDung> ?? new Dictionary<int, ECOLearning.Models.NguoiDung>();
    var categories = ViewBag.Categories as Dictionary<string, string> ?? new Dictionary<string, string>();
    string status = ViewBag.Status as string ?? "Pending";
    int pendingCount = ViewBag.PendingCount ?? 0, approvedCount = ViewBag.ApprovedCount ?? 0, rejectedCount = ViewBag.RejectedCount ?? 0;
    Func<IEnumerable<string>, string> tenLinhVuc = ids => string.Join(", ", ids.Select(id => categories.ContainsKey(id) ? categories[id] : id));
}
<style>
    .ss-head { display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:24px; }
    .ss-head h1 { font-size:24px;font-weight:800;color:#0F172A;margin:0 0 4px; }
    .ss-head p { color:#64748B;font-size:14px;margin:0; }
    .ss-kpis { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-bottom:24px; }
    .ss-kpi { background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:20px; }
    .ss-kpi span { display:block;font-size:13px;color:#64748B;font-weight:600; }
    .ss-kpi strong { font-size:24px;font-weight:800; }
    .ss-tabs { display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px; }
    .ss-tab { padding:7px 14px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;background:#fff;color:#475569;border:1px solid #CBD5E1; }
    .ss-tab.is-active { background:#0F172A;color:#fff;border-color:#0F172A; }
    .ss-table-wrap { background:#fff;border:1px solid #E2E8F0;border-radius:16px;overflow-x:auto;box-shadow:0 4px 16px rgba(0,0,0,.02); }
    .ss-table { width:100%;min-width:860px;border-collapse:collapse;font-size:14px;text-align:left; }
    .ss-table th { padding:16px 20px;background:#F8FAFC;border-bottom:1px solid #E2E8F0;color:#475569;font-weight:700;white-space:nowrap; }
    .ss-table td { padding:16px 20px;border-bottom:1px solid #F1F5F9;vertical-align:top; }
    .ss-table tbody tr:hover { background:#F8FAFC; }
    .ss-id { font-weight:700;color:#4338CA;background:#EEF2FF;padding:4px 8px;border-radius:6px;font-size:12px; }
    .ss-name { font-weight:700;color:#0F172A; }
    .ss-sub { font-size:12px;color:#64748B; }
    .ss-tags { display:flex;flex-wrap:wrap;gap:6px; }
    .ss-tag { background:#EEF2FF;color:#434CE8;padding:3px 9px;border-radius:8px;font-size:12px;font-weight:600; }
    .ss-granted { margin-top:6px;font-size:12px;color:#047857; }
    .ss-status { display:inline-block;padding:4px 10px;border-radius:20px;font-size:12px;font-weight:700;white-space:nowrap; }
    .ss-status.is-pending { background:#FEF3C7;color:#B45309; }
    .ss-status.is-approved { background:#D1FAE5;color:#047857; }
    .ss-status.is-rejected { background:#FEE2E2;color:#B91C1C; }
    .ss-link { color:#2563EB;font-weight:600;text-decoration:none;font-size:13px;white-space:nowrap; }
    .ss-action { display:inline-block;padding:7px 14px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap; }
    .ss-action.is-primary { background:#434CE8;color:#fff; }
    .ss-action.is-soft { background:#F1F5F9;color:#334155; }
    .ss-empty { padding:40px 20px;text-align:center;color:#64748B; }
    @@media (max-width:760px) { .ss-kpis { grid-template-columns:1fr;gap:12px; } }
</style>

<div class="ss-head">
    <div>
        <h1>Yêu cầu bổ sung chuyên môn</h1>
        <p>Giáo viên đề xuất thêm lĩnh vực giảng dạy kèm minh chứng. Duyệt từng lĩnh vực hoặc từ chối kèm lý do.</p>
    </div>
</div>

@if (ViewBag.Installed != true)
{
    <div class="ss-kpi" style="margin-bottom:20px;">Chức năng chưa được cài đặt. Cần chạy migration 022_TeacherSpecialties.sql.</div>
}

<div class="ss-kpis">
    <div class="ss-kpi"><span>Chờ duyệt</span><strong style="color:#D97706;">@pendingCount</strong></div>
    <div class="ss-kpi"><span>Đã duyệt</span><strong style="color:#10B981;">@approvedCount</strong></div>
    <div class="ss-kpi"><span>Đã từ chối</span><strong style="color:#EF4444;">@rejectedCount</strong></div>
</div>

<div class="ss-tabs" role="tablist" aria-label="Lọc theo trạng thái">
    <a class="ss-tab @(status == "Pending" ? "is-active" : "")" href="@Url.Action("Index", new { status = "Pending" })">Chờ duyệt (@pendingCount)</a>
    <a class="ss-tab @(status == "Approved" ? "is-active" : "")" href="@Url.Action("Index", new { status = "Approved" })">Đã duyệt (@approvedCount)</a>
    <a class="ss-tab @(status == "Rejected" ? "is-active" : "")" href="@Url.Action("Index", new { status = "Rejected" })">Đã từ chối (@rejectedCount)</a>
    <a class="ss-tab @(status == "All" ? "is-active" : "")" href="@Url.Action("Index", new { status = "All" })">Tất cả (@(pendingCount + approvedCount + rejectedCount))</a>
</div>

<div class="ss-table-wrap">
    <table class="ss-table" data-paginate="10">
        <thead>
            <tr>
                <th>Mã yêu cầu</th>
                <th>Giáo viên</th>
                <th>Lĩnh vực đề xuất</th>
                <th>Minh chứng</th>
                <th>Ngày gửi</th>
                <th>Trạng thái</th>
                <th style="text-align:right;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="ss-empty">@(status == "Pending" ? "Không có yêu cầu nào đang chờ duyệt." : "Chưa có yêu cầu nào.")</td></tr>
            }
            @foreach (var r in Model)
            {
                ECOLearning.Models.NguoiDung gv;
                teachers.TryGetValue(r.TeacherId, out gv);
                <tr>
                    <td><span class="ss-id">#@r.Id</span></td>
                    <td>
                        <div class="ss-name">@(gv != null ? gv.hoTen : "Giáo viên #" + r.TeacherId)</div>
                        @if (gv != null) { <div class="ss-sub">@gv.email</div> }
                    </td>
                    <td>
                        <div class="ss-tags">@foreach (var id in r.CategoryIds) { <span class="ss-tag">@(categories.ContainsKey(id) ? categories[id] : id)</span> }</div>
                        @if (r.Status == "Approved") { <div class="ss-granted"><i class="bi bi-check2"></i> Được duyệt: @tenLinhVuc(r.GrantedCategoryIds)</div> }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(r.EvidenceUrl)) { <a class="ss-link" href="@Url.Content(r.EvidenceUrl)" target="_blank" rel="noopener">Xem <i class="bi bi-box-arrow-up-right"></i></a> }
                        else { <span class="ss-sub">-</span> }
                    </td>
                    <td>
                        <div>@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        @if (r.ReviewedAt.HasValue) { <div class="ss-sub">Xử lý: @r.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm")</div> }
                    </td>
                    <td>
                        <span class="ss-status @(r.Status == "Pending" ? "is-pending" : r.Status == "Approved" ? "is-approved" : "is-rejected")">@(r.Status == "Pending" ? "Chờ duyệt" : r.Status == "Approved" ? "Đã duyệt" : "Đã từ chối")</span>
                    </td>
                    <td style="text-align:right;">
                        <a class="ss-action @(r.Status == "Pending" ? "is-primary" : "is-soft")" href="@Url.Action("Manage", new { id = r.TeacherId })">@(r.Status == "Pending" ? "Xét duyệt" : "Xem chi tiết")</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
