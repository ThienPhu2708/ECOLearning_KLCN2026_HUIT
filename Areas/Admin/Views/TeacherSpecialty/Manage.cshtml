@using ECOLearning.Services
@model List<TeacherSpecialtyRequest>
@{
    ViewBag.Title = "Chuyên môn giáo viên";
    var teacher = ViewBag.Teacher as ECOLearning.Models.NguoiDung;
    var profile = ViewBag.Profile as ECOLearning.Models.TeacherApplication;
    var categories = ViewBag.Categories as List<ECOLearning.Models.DanhMuc> ?? new List<ECOLearning.Models.DanhMuc>();
    var approved = ViewBag.Approved as List<string> ?? new List<string>();

    string avatar = string.IsNullOrWhiteSpace(teacher.anhDaiDien) ? null : (teacher.anhDaiDien.StartsWith("http") ? teacher.anhDaiDien : Url.Content("~/" + teacher.anhDaiDien.TrimStart('~', '/')));
    string initial = string.IsNullOrWhiteSpace(teacher.hoTen) ? "G" : teacher.hoTen.Trim().Substring(0, 1).ToUpper();
}
<link rel="stylesheet" href="~/assets/css/teacher-specialty.css?v=3" />
<div class="specialty-page sp-manage">
    <header class="sp-page-heading">
        <div><h2>Chuyên môn giảng dạy</h2><p>Xét duyệt lĩnh vực giáo viên được phép tạo khóa học.</p></div>
        <a class="btn btn-outline" href="@Url.Action("Details", "Teacher", new { id = teacher.maNguoiDung })"><i class="bi bi-person-vcard" aria-hidden="true"></i> Hồ sơ giáo viên</a>
    </header>
    <div class="sp-manage-grid">
        <aside class="sp-card sp-profile-card">
            <div class="sp-teacher">
                @if (avatar != null) {<img class="sp-avatar" src="@avatar" alt="" />} else {<span class="sp-avatar">@initial</span>}
                <div><h3>@teacher.hoTen</h3><span class="sp-teacher-role">Giáo viên · #@teacher.maNguoiDung</span></div>
            </div>
            <div class="sp-profile-section">
                @if (profile != null && !string.IsNullOrWhiteSpace(profile.BioExperience)) {
                    <details class="sp-bio"><summary>Giới thiệu và kinh nghiệm <i class="bi bi-chevron-down" aria-hidden="true"></i></summary><p class="sp-description">@profile.BioExperience</p></details>
                }
                @if (profile != null && !string.IsNullOrEmpty(profile.CertificateFilePath)) {
                    <a class="sp-evidence" href="@Url.Content(profile.CertificateFilePath)" target="_blank" rel="noopener"><span class="sp-evidence-icon"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span><span>Bằng cấp / chứng chỉ<small>Xem minh chứng hồ sơ</small></span><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                }
            </div>
            <div class="sp-profile-section">
                <div class="sp-section-heading"><h3>Đã được duyệt</h3><span class="sp-number">@approved.Count</span></div>
                @if (approved.Any()) {
                    <div class="sp-approved-list">@foreach (var c in categories.Where(c => approved.Contains(c.maDanhMuc))) {<div><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>@c.tenDanhMuc @(c.trangThai == false ? "(tạm ngưng)" : "")</span></div>}</div>
                } else {
                    <div class="sp-empty-permission"><i class="bi bi-patch-check" aria-hidden="true"></i><p>@(ViewBag.Legacy == true ? "Giáo viên cũ chưa đề xuất chuyên môn." : "Chưa có lĩnh vực được duyệt.")</p></div>
                }
            </div>
        </aside>
        <div class="sp-main-col">
            <section class="sp-card sp-assignment-card">
                <div class="sp-section-heading"><h3>Phạm vi giảng dạy</h3><span class="sp-soft-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></span></div>
                @if (ViewBag.Legacy == true) {<p>Giáo viên cũ: khóa học đã tạo giữ nguyên lĩnh vực. Cần được duyệt chuyên môn để tạo khóa học mới.</p>}
                else {<p>Lĩnh vực được duyệt cùng hồ sơ đăng ký giảng dạy. Yêu cầu bổ sung được xét duyệt bên dưới.</p>}
            </section>
            <section class="sp-card sp-requests-card">
                <div class="sp-section-heading"><h3>Yêu cầu bổ sung chuyên môn</h3><span class="sp-number">@Model.Count</span></div>
                @if (!Model.Any()) {<p class="sp-req-empty">Giáo viên chưa gửi yêu cầu bổ sung chuyên môn.</p>}
                @foreach (var r in Model.Where(x => x.Status == "Pending")) {
                    <div class="sp-req is-pending">
                        <div class="sp-req-head"><span class="sp-req-meta"><strong>#@r.Id</strong> · @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span><span class="sp-request-status is-pending">Chờ duyệt</span></div>
                        <p class="sp-req-desc">@r.Description</p>
                        <a class="sp-text-link" href="@Url.Content(r.EvidenceUrl)" target="_blank" rel="noopener"><i class="bi bi-paperclip" aria-hidden="true"></i> Xem minh chứng đính kèm <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                        <form method="post" action="@Url.Action("Review")" class="sp-select-form">
                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="teacherId" value="@teacher.maNguoiDung" />
                            <span class="sp-label">LĨNH VỰC ĐỀ XUẤT</span>
                            <div class="sp-grid sp-category-grid">@foreach (var c in categories.Where(c => r.CategoryIds.Contains(c.maDanhMuc))) {<label class="sp-choice"><input type="checkbox" name="categoryIds" value="@c.maDanhMuc" disabled="@(c.trangThai == false)" /><span>@c.tenDanhMuc @(c.trangThai == false ? "(tạm ngưng)" : "")</span></label>}</div>
                            <label for="reason-@r.Id">Phản hồi xét duyệt <span class="sp-optional">Bắt buộc khi từ chối</span></label>
                            <textarea class="form-control" name="reason" id="reason-@r.Id" maxlength="2000" placeholder="Ghi rõ nội dung cần bổ sung hoặc lý do từ chối…"></textarea>
                            <div class="sp-form-footer"><span class="sp-selected-count" aria-live="polite">Chưa chọn lĩnh vực</span><div class="sp-footer-actions"><button name="approve" value="false" class="btn btn-outline">Từ chối yêu cầu</button><button name="approve" value="true" class="btn btn-primary">Duyệt lĩnh vực đã chọn</button></div></div>
                        </form>
                    </div>
                }
                @foreach (var r in Model.Where(x => x.Status != "Pending")) {
                    <div class="sp-req">
                        <div class="sp-req-head"><span class="sp-req-meta"><strong>#@r.Id</strong> · @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")@(r.ReviewedAt.HasValue ? " · xử lý " + r.ReviewedAt.Value.ToString("dd/MM/yyyy") : "")</span><span class="sp-request-status @(r.Status == "Approved" ? "is-approved" : "is-rejected")">@(r.Status == "Approved" ? "Đã duyệt" : "Đã từ chối")</span></div>
                        <div class="sp-tags">@foreach (var c in categories.Where(c => (r.Status == "Approved" ? r.GrantedCategoryIds : r.CategoryIds).Contains(c.maDanhMuc))) {<span class="sp-tag">@c.tenDanhMuc</span>}</div>
                        @if (!string.IsNullOrWhiteSpace(r.Reason)) {<p class="sp-req-reason"><strong>Phản hồi:</strong> @r.Reason</p>}
                        <a class="sp-text-link" href="@Url.Content(r.EvidenceUrl)" target="_blank" rel="noopener"><i class="bi bi-paperclip" aria-hidden="true"></i> Minh chứng</a>
                    </div>
                }
            </section>
        </div>
    </div>
</div>
@section Scripts {
<script>
@if (TempData["SpecialtyMessage"] != null)
{
    // Thông báo kết quả duyệt / từ chối: hiện nổi rồi tự tắt (showToast trong assets/js/app.js chèn HTML nên mã hóa nội dung trước)
    <text>if (window.showToast) showToast('@Html.Raw(HttpUtility.JavaScriptStringEncode(HttpUtility.HtmlEncode(TempData["SpecialtyMessage"].ToString())))', '@(TempData["SpecialtyMessageType"] as string ?? "info")');</text>
}
document.querySelectorAll('.sp-select-form').forEach(function(form) {
    var choices = form.querySelectorAll('input[name="categoryIds"]');
    var count = form.querySelector('.sp-selected-count');
    var confirm = form.querySelector('button[value="true"],button[type="submit"]');
    function updateSelection() {
        var total = form.querySelectorAll('input[name="categoryIds"]:checked:not(:disabled)').length;
        count.textContent = total ? 'Đã chọn ' + total + ' lĩnh vực' : 'Chưa chọn lĩnh vực';
        if (confirm) confirm.disabled = total === 0;
    }
    choices.forEach(function(input) { input.addEventListener('change', updateSelection); });
    updateSelection();
});
</script>
}
