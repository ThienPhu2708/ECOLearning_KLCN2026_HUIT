@model List<ECOLearning.Models.ViolationCourseSummary>
@{
    ViewBag.Title = "Báo Cáo Vi Phạm Khóa Học";
    string filter = ViewBag.Filter as string ?? "pending";
    string sort = ViewBag.Sort as string ?? "priority";
    bool notInstalled = ViewBag.NotInstalled ?? false;
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 12px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Báo Cáo Vi Phạm Khóa Học</h1>
        <p class="body-2" style="color: var(--text-secondary);">Tiếp nhận báo cáo từ học viên, tạm khóa khóa học chờ giáo viên phản hồi, mở lại hoặc khóa vĩnh viễn</p>
    </div>
</div>

@if (notInstalled)
{
    <div class="card" style="border-color: #FCD34D; background: #FFFBEB;">
        <h3 class="h3" style="margin-bottom: 8px;"><i class="bi bi-exclamation-triangle-fill me-1" style="color: #D97706;"></i> Chưa khởi tạo dữ liệu</h3>
        <p style="margin: 0;">Cơ sở dữ liệu chưa đủ bảng cho chức năng báo cáo vi phạm. Vui lòng chạy lần lượt
            <code>Database/Migrations/002_BaoCaoViPham.sql</code> và <code>003_BaoCaoViPham_BaiHoc.sql</code>
            trong SQL Server Management Studio rồi tải lại trang.</p>
    </div>
}
else
{
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <a href="@Url.Action("Index", new { filter = "pending", sort = sort })" class="btn btn-sm @(filter == "pending" ? "btn-primary" : "btn-secondary")">Chờ xử lý (@ViewBag.PendingCount)</a>
            @if (ViewBag.HasDiscussion == true)
            {
                <a href="@Url.Action("Index", new { filter = "review", sort = sort })" class="btn btn-sm @(filter == "review" ? "btn-primary" : "btn-secondary")">GV đã phản hồi, chờ xem xét (@ViewBag.ReviewCount)</a>
            }
            <a href="@Url.Action("Index", new { filter = "locked", sort = sort })" class="btn btn-sm @(filter == "locked" ? "btn-primary" : "btn-secondary")">Đang tạm khóa (@ViewBag.LockedCount)</a>
            <a href="@Url.Action("Index", new { filter = "banned", sort = sort })" class="btn btn-sm @(filter == "banned" ? "btn-primary" : "btn-secondary")">Khóa vĩnh viễn (@ViewBag.BannedCount)</a>
            <a href="@Url.Action("Index", new { filter = "all", sort = sort })" class="btn btn-sm @(filter == "all" ? "btn-primary" : "btn-secondary")">Tất cả (@ViewBag.AllCount)</a>
        </div>
        <form method="get" action="@Url.Action("Index")" style="display: flex; align-items: center; gap: 8px;">
            <input type="hidden" name="filter" value="@filter" />
            <label class="caption" style="font-weight: 700; color: var(--text-heading);">Sắp xếp:</label>
            <select name="sort" class="form-control" style="height: 38px; width: 220px;" onchange="this.form.submit()">
                <option value="priority" @(sort == "priority" ? "selected" : "")>Ưu tiên xử lý</option>
                <option value="latest" @(sort == "latest" ? "selected" : "")>Báo cáo mới nhất</option>
                <option value="oldest" @(sort == "oldest" ? "selected" : "")>Báo cáo cũ nhất</option>
                <option value="deadline" @(sort == "deadline" ? "selected" : "")>Hạn phản hồi gần nhất</option>
            </select>
        </form>
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        <div class="table-responsive">
            <table class="table" data-paginate="10">
                <thead>
                    <tr>
                        <th>Khóa học</th>
                        <th>Giáo viên</th>
                        <th>Trạng thái</th>
                        <th style="text-align: center;">Chờ xử lý</th>
                        <th style="text-align: center;">Tổng báo cáo</th>
                        <th>Báo cáo gần nhất</th>
                        <th>Tiến trình</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            bool isLocked = c.trangThaiKhoaHoc == ECOLearning.Services.CourseStatus.TamKhoa;
                            bool isBanned = c.trangThaiKhoaHoc == ECOLearning.Services.CourseStatus.KhoaVinhVien;
                            bool overdue = isLocked && c.hanPhanHoi.HasValue && c.hanPhanHoi.Value < DateTime.Now;
                            <tr>
                                <td class="cell-wrap">
                                    <strong>@c.tenKhoaHoc</strong>
                                    <div class="caption" style="color: var(--text-muted);">Mã: @c.maKhoaHoc</div>
                                </td>
                                <td>@c.tenGiaoVien</td>
                                <td>
                                    @if (isLocked)
                                    {
                                        <span class="badge badge-warning">Tạm khóa</span>
                                    }
                                    else if (isBanned)
                                    {
                                        <span class="badge badge-danger">Khóa vĩnh viễn</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">@(c.trangThaiKhoaHoc ?? "Bản nháp")</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (c.soChoXuLy > 0)
                                    {
                                        <span class="badge badge-danger">@c.soChoXuLy</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted);">0</span>
                                    }
                                </td>
                                <td style="text-align: center;">@c.tongBaoCao</td>
                                <td>
                                    @if (c.baoCaoGanNhat.HasValue)
                                    {
                                        <div style="font-weight: 600;">@c.baoCaoGanNhat.Value.ToString("HH:mm")</div>
                                        <div class="caption" style="color: var(--text-secondary);">@c.baoCaoGanNhat.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted);">-</span>
                                    }
                                </td>
                                <td>
                                    @if (isLocked && c.trangThaiXuLy == ECOLearning.Services.ViolationReportService.StepWaitingAdmin)
                                    {
                                        <span class="badge badge-primary">GV đã phản hồi</span>
                                        <div class="caption" style="color: var(--text-secondary); margin-top: 4px;">Chờ bạn xem xét</div>
                                    }
                                    else if (isLocked && c.hanPhanHoi.HasValue)
                                    {
                                        if (overdue)
                                        {
                                            <span class="badge badge-danger">Quá hạn</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">Chờ GV xử lý</span>
                                        }
                                        <div class="caption" style="color: var(--text-secondary); margin-top: 4px;">Hạn: @c.hanPhanHoi.Value.ToString("HH:mm dd/MM/yyyy")</div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted);">-</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <a href="@Url.Action("Detail", new { id = c.maKhoaHoc })" class="btn btn-sm btn-primary">Xử lý</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: var(--text-secondary); padding: 24px;">
                                Không có khóa học nào trong mục này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
