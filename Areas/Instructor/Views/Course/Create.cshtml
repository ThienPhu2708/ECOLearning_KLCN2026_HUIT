// Video lưu trên Cloudflare R2 ("r2:videos/...") phát qua VideoStream/Play; đường dẫn khác giữ nguyên
function videoPlayUrl(url) {
    return url && url.indexOf('r2:') === 0 ? '@Url.Content("~/VideoStream/Play")?src=' + encodeURIComponent(url) : url;
}
function libraryVideoDuration(url) {
    return new Promise(function(resolve) {
        var player = document.createElement('video'), done = false;
        function finish(value) { if (done) return; done = true; player.removeAttribute('src'); player.load(); resolve(value); }
        player.preload = 'metadata'; player.onloadedmetadata = function() { finish(Number.isFinite(player.duration) ? Math.round(player.duration) : 0); };
        player.onerror = function() { finish(0); }; player.src = videoPlayUrl(url);
        setTimeout(function() { finish(0); }, 10000);
    });
}
var libraryPickerFiles = [], libraryPickerLesson = null;
async function openLibraryPicker(lessonId) {
    libraryPickerLesson = document.getElementById(lessonId);
    document.getElementById('wizard-library').showModal();
    document.getElementById('wizard-library-files').textContent = 'Đang tải thư viện...';
    try { var response = await fetch('@Url.Action("List", "Resource", new { area = "Instructor" })'); var result = await response.json(); if (!result.success) throw new Error('Không thể tải thư viện.'); libraryPickerFiles = result.files; renderLibraryPicker(); }
    catch (error) { document.getElementById('wizard-library-files').textContent = 'Không thể tải thư viện. Vui lòng đóng và thử lại.'; }
}
function renderLibraryPicker() {
    var box = document.getElementById('wizard-library-files'); box.replaceChildren();
    var kind = document.getElementById('wizard-library-kind').value, query = document.getElementById('wizard-library-search').value.toLowerCase();
    var files = libraryPickerFiles.filter(function(file) { return (!kind || file.Kind === kind) && file.Name.toLowerCase().includes(query); });
    if (!files.length) { box.textContent = 'Chưa có tệp phù hợp. Bạn có thể tải tệp mới lên trong bài học.'; return; }
    files.forEach(function(file) {
        var row = document.createElement('div'); row.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border-color);';
        var text = document.createElement('div'); var title = document.createElement('strong'); title.textContent = file.Name; title.style.cssText = 'font-size:13px;overflow-wrap:anywhere;';
        var subtitle = document.createElement('div'); subtitle.className = 'caption'; subtitle.textContent = (file.Kind === 'video' ? 'Video' : 'Tài liệu') + ' · ' + (file.Courses.length ? file.Courses.join(', ') : 'Chưa gắn khóa học'); text.append(title, subtitle);
        var button = document.createElement('button'); button.type = 'button'; button.className = 'btn btn-primary btn-sm'; button.textContent = 'Chọn';
        button.onclick = async function() {
            button.disabled = true; pendingUploads++;
            try {
                var data = new FormData(); data.append('url', file.Url); data.append('__RequestVerificationToken', document.querySelector('#course-wizard-form input[name="__RequestVerificationToken"]').value);
                var response = await fetch('@Url.Action("Select", "Resource", new { area = "Instructor" })', {method:'POST', body:data}); var uploaded = await response.json();
                if (!uploaded.success) throw new Error(uploaded.message);
                if (!libraryPickerLesson || !libraryPickerLesson.isConnected) return;
                if (file.Kind === 'video') { var seconds = uploaded.duration || await libraryVideoDuration(uploaded.url); renderVideo(libraryPickerLesson, uploaded, seconds); }
                else { libraryPickerLesson.attachments = libraryPickerLesson.attachments || []; if (!libraryPickerLesson.attachments.some(function(item) {return item.url === uploaded.url;})) libraryPickerLesson.attachments.push(uploaded); renderAttachments(libraryPickerLesson); }
                document.getElementById('wizard-library').close();
            } catch (error) { showToast(error.message, 'error'); } finally { button.disabled = false; pendingUploads--; }
        };
        row.append(text, button); box.appendChild(row);
    });
}

var pendingUploads = 0;
function uploadLessonFile(file, kind, progress) {
    pendingUploads++;
    return new Promise(function(resolve, reject) {
        var data = new FormData(); data.append('file', file); data.append('kind', kind);
        data.append('__RequestVerificationToken', document.querySelector('#course-wizard-form input[name="__RequestVerificationToken"]').value);
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '@Url.Action("UploadLessonFile", "Course", new { area = "Instructor" })');
        xhr.upload.onprogress = function(event) { if (event.lengthComputable && progress) progress(Math.round(event.loaded / event.total * 100)); };
        xhr.onload = function() {
            pendingUploads--;
            try { var result = JSON.parse(xhr.responseText); if (xhr.status >= 200 && xhr.status < 300 && result.success) resolve(result); else reject(new Error(result.message || 'Không thể tải tệp lên.')); }
            catch (error) { reject(new Error('Không thể tải tệp lên. Vui lòng thử lại.')); }
        };
        xhr.onerror = function() { pendingUploads--; reject(new Error('Mất kết nối khi tải tệp.')); };
        xhr.send(data);
    });
}
function videoDuration(file) {
    return new Promise(function(resolve) {
        var video = document.createElement('video'), url = URL.createObjectURL(file), done = false;
        function finish(value) { if (done) return; done = true; URL.revokeObjectURL(url); resolve(value); }
        video.preload = 'metadata'; video.onloadedmetadata = function() { finish(Number.isFinite(video.duration) ? Math.round(video.duration) : 0); };
        video.onerror = function() { finish(0); }; video.src = url;
        setTimeout(function() { finish(0); }, 10000);
    });
}
function durationLabel(seconds) { return Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0'); }
function previewLessonVideo(url, name) {
    var dialog = document.getElementById('video-preview-dialog');
    var player = document.getElementById('video-preview-player');
    document.getElementById('video-preview-title').textContent = name;
    player.src = videoPlayUrl(url);
    dialog.showModal();
    player.play().catch(function() {});
}
document.getElementById('video-preview-dialog').addEventListener('close', function() {
    var player = document.getElementById('video-preview-player');
    player.pause(); player.removeAttribute('src'); player.load();
});
document.getElementById('video-preview-dialog').addEventListener('click', function(event) {
    if (event.target !== this) return;
    var bounds = this.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) this.close();
});

function renderVideo(lesson, uploaded, duration) {
    lesson.dataset.videoToken = uploaded.token; lesson.dataset.videoDuration = duration;
    lesson.dataset.videoName = uploaded.name; lesson.dataset.videoUrl = uploaded.url;
    var status = document.getElementById(lesson.id + '-status'); status.textContent = '';
    var link = document.createElement('a'); link.href = videoPlayUrl(uploaded.url); link.setAttribute('aria-label', 'Xem nhanh video ' + uploaded.name);
    link.onclick = function(event) { event.preventDefault(); previewLessonVideo(uploaded.url, uploaded.name); };
    link.className = 'lesson-video-link';
    var play = document.createElement('span'); play.className = 'lesson-play-icon'; play.setAttribute('aria-hidden', 'true');
    play.innerHTML = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="M6.3 4.6L11 8L6.3 11.4V4.6Z" fill="white"/></svg>';
    var filename = document.createElement('span'); filename.className = 'lesson-video-filename';
    filename.textContent = uploaded.name + (duration ? ' (' + durationLabel(duration) + ')' : '');
    link.append(play, filename); status.appendChild(link);
    var badge = document.createElement('span'); badge.textContent = '✓ Có video'; badge.className = 'lesson-video-badge'; status.appendChild(badge);
    lesson.querySelectorAll('button').forEach(function(btn) { if (btn.getAttribute('onclick') && btn.getAttribute('onclick').indexOf('simulateUpload') >= 0) btn.textContent = 'Thay video'; });
    countVideos();
}
var contentLessonId = null;
function renderLessonFileSelection(input) {
    var list = document.getElementById(input.id + '-selection');
    list.replaceChildren();
    Array.from(input.files).forEach(function(file) {
        var row = document.createElement('div');
        var size = file.size >= 1048576 ? (file.size / 1048576).toLocaleString('vi-VN', { maximumFractionDigits: 1 }) + ' MB' : Math.ceil(file.size / 1024) + ' KB';
        row.textContent = file.name + ' · ' + size;
        list.appendChild(row);
    });
}
['lesson-content-video', 'lesson-content-documents'].forEach(function(id) {
    document.getElementById(id).addEventListener('change', function() { renderLessonFileSelection(this); });
});
function openLessonContent(id) {
contentLessonId = id;
document.getElementById('lesson-content-video').value = '';
document.getElementById('lesson-content-documents').value = '';
renderLessonFileSelection(document.getElementById('lesson-content-video'));
renderLessonFileSelection(document.getElementById('lesson-content-documents'));
document.getElementById('lesson-content-status').textContent = '';
document.getElementById('lesson-content-dialog').showModal();
}
async function confirmLessonContent() {
var lesson = document.getElementById(contentLessonId), video = document.getElementById('lesson-content-video').files[0];
var documents = Array.from(document.getElementById('lesson-content-documents').files), status = document.getElementById('lesson-content-status');
if (!lesson || (!video && !documents.length)) { status.textContent = 'Vui lòng chọn video hoặc tài liệu.'; return; }
var confirm = document.getElementById('content-confirm'), cancel = document.getElementById('content-cancel'), dialog = document.getElementById('lesson-content-dialog');
confirm.disabled = cancel.disabled = true;
function preventClose(event) { event.preventDefault(); }
dialog.addEventListener('cancel', preventClose);
try {
var videoResult = null, duration = 0, attachments = [];
if (video) {
videoResult = await uploadLessonFile(video, 'video', function(percent) { status.textContent = 'Đang tải video: ' + percent + '%'; });
duration = await videoDuration(video);
}
for (var file of documents) { status.textContent = 'Đang tải tài liệu: ' + file.name; attachments.push(await uploadLessonFile(file, 'document')); }
if (!lesson.isConnected) return;
if (videoResult) { renderVideo(lesson, videoResult, duration); document.getElementById('warn-no-video').style.display = 'none'; }
lesson.attachments = (lesson.attachments || []).concat(attachments);
renderAttachments(lesson); dialog.close(); showToast('Đã thêm nội dung bài học.', 'success');
} catch (error) { status.textContent = error.message; }
finally { confirm.disabled = cancel.disabled = false; dialog.removeEventListener('cancel', preventClose); }
}
function simulateUpload(lesId) {
    var lesson = document.getElementById(lesId), input = document.createElement('input');
    input.type = 'file'; input.accept = '.mp4,.webm,.mov,.mkv,.m4v,.ogv';
    input.onchange = async function() {
        var file = input.files[0]; if (!file) return;
        var status = document.getElementById(lesId + '-status');
        status.textContent = 'Đang tải lên: ' + file.name + ' (0%)';
        try {
            var results = await Promise.all([uploadLessonFile(file, 'video', function(percent) { status.textContent = 'Đang tải lên: ' + file.name + ' (' + percent + '%)'; }), videoDuration(file)]);
            if (!lesson.isConnected) return;
            renderVideo(lesson, results[0], results[1]);
            document.getElementById('warn-no-video').style.display = 'none';
        } catch (error) {
            if (lesson.dataset.videoToken) renderVideo(lesson, {token:lesson.dataset.videoToken,name:lesson.dataset.videoName,url:lesson.dataset.videoUrl}, Number(lesson.dataset.videoDuration));
            else status.textContent = 'Tải lên thất bại. Vui lòng thử lại.';
            showToast(error.message, 'error');
        }
    }; input.click();
}
function renderAttachments(lesson) {
    var items = lesson.attachments || [], box = lesson.querySelector('.lesson-documents');
    if (!box) { box = document.createElement('div'); box.className = 'lesson-documents'; lesson.appendChild(box); }
    box.replaceChildren(); if (!items.length) return;
    var label = document.createElement('span'); label.textContent = 'Tài liệu đính kèm:'; box.appendChild(label);
    items.forEach(function(item) {
        var chip = document.createElement('span'); chip.className = 'lesson-document-chip';
        var link = document.createElement('a'); link.href = item.url; link.target = '_blank'; link.rel = 'noopener';
        var dot = item.name.lastIndexOf('.'); link.textContent = (dot > 0 ? item.name.substring(0, dot) + ' (' + item.name.substring(dot + 1).toUpperCase() + ')' : item.name);
        var icon = document.createElement('span'); icon.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2H6v20h12V6zM14 2v5h5M9 12h6M9 16h6"/></svg>'; link.prepend(icon);
        var remove = document.createElement('button'); remove.type = 'button'; remove.textContent = '×'; remove.setAttribute('aria-label', 'Xóa tài liệu ' + item.name);
        remove.onclick = function() { lesson.attachments = items.filter(function(entry) { return entry.token !== item.token; }); renderAttachments(lesson); };
        chip.append(link, remove); box.appendChild(chip);
    });
}
function serializeCurriculum() {
    var form = document.getElementById('course-wizard-form');
    form.querySelectorAll('.curriculum-binding').forEach(function(el) { el.remove(); });
    function hidden(name, value) { var el = document.createElement('input'); el.type = 'hidden'; el.className = 'curriculum-binding'; el.name = name; el.value = value; form.appendChild(el); }
    var chapterIndices = {};
    document.querySelectorAll('#curriculum-container .curriculum-section-card:not(#standalone-card)').forEach(function(chapter, i) {
        chapterIndices[chapter.id] = i;
        hidden('Chapters[' + i + '].Id', chapter.dataset.existingId || '');
        hidden('Chapters[' + i + '].Title', chapter.querySelector('.chapter-name').textContent);
    });
    document.querySelectorAll('#curriculum-container .lesson-item').forEach(function(lesson, i) {
        var prefix = 'Lessons[' + i + ']';
        hidden(prefix + '.Id', lesson.dataset.existingId || '');
        hidden(prefix + '.Title', lesson.querySelector('.lesson-name').textContent);
        var chapter = lesson.closest('.curriculum-section-card');
        hidden(prefix + '.ChapterIndex', chapter.id === 'standalone-card' ? '' : chapterIndices[chapter.id]);
        hidden(prefix + '.Preview', lesson.querySelector('input[type=checkbox]').checked ? 'true' : 'false');
        hidden(prefix + '.VideoToken', lesson.dataset.videoToken || '');
        hidden(prefix + '.Duration', lesson.dataset.videoDuration || '0');
        (lesson.attachments || []).forEach(function(item, index) { hidden(prefix + '.AttachmentTokens[' + index + ']', item.token); });
    });
}
var savedChapters = @Html.Raw(System.Web.Helpers.Json.Encode((Model.Chapters ?? new List<ECOLearning.Areas.Instructor.Models.CourseChapterInput>()).Select(c => new { c.Id, c.Title })));
var savedLessons = @Html.Raw(System.Web.Helpers.Json.Encode((Model.Lessons ?? new List<ECOLearning.Areas.Instructor.Models.CourseLessonInput>()).Select(l => new { l.Id, l.Title, l.ChapterIndex, l.Preview, l.VideoToken, l.Duration, l.AttachmentTokens })));
var savedUploads = @Html.Raw(System.Web.Helpers.Json.Encode(Session["CourseWizardUploads"] ?? new Dictionary<string, string[]>()));
restoringCurriculum = true;
var restoredContainers = savedChapters.map(function(chapter) { var container = addSection(chapter.Title); document.getElementById(container).closest(".curriculum-section-card").dataset.existingId = chapter.Id || ""; return container; });
savedLessons.forEach(function(lesson) {
    var container = lesson.ChapterIndex == null ? 'standalone-lessons' : restoredContainers[lesson.ChapterIndex];
    if (!container) return;
    var row = addLesson(container, lesson.Title); row.dataset.existingId = lesson.Id || ''; row.querySelector('input[type=checkbox]').checked = lesson.Preview;
    var video = savedUploads[lesson.VideoToken];
    if (video) renderVideo(row, {token:lesson.VideoToken, url:video[1], name:video[2]}, lesson.Duration);
    row.attachments = (lesson.AttachmentTokens || []).filter(function(token) { return !!savedUploads[token]; }).map(function(token) { return {token:token,url:savedUploads[token][1],name:savedUploads[token][2]}; });
    renderAttachments(row);
});
if (@Html.Raw(isEditing ? "true" : "false") && new URLSearchParams(window.location.search).get('step') === '2') { currentStep = 2; updateStepper(); }
restoringCurriculum = false;
document.getElementById('chapter-mode').checked = savedChapters.length > 0;
updateCurriculumMode();
if (savedLessons.length && !@Html.Raw(isEditing ? "true" : "false")) {
    showToast('Đề cương và các tệp đã tải lên được giữ lại.', 'info');
}
</script>

<script>
// ── Objectives Builder ───────────────────────────────────────────
function addObjective() {
    var list = document.getElementById('objectives-list');
    var div = document.createElement('div');
    div.className = 'form-group';
    div.style.cssText = 'display: flex; gap: 8px; margin-bottom: 10px;';
    div.innerHTML = '<input type="text" class="form-control objective-input" placeholder="Thêm mục tiêu...">' +
                    '<button type="button" class="btn btn-secondary btn-sm" style="width: 38px; padding: 0;" onclick="this.parentElement.remove()">✕</button>';
    list.appendChild(div);
}

var storedObjectives = document.getElementById('MucTieuDauRa-hidden').value;
if (storedObjectives) {
    document.getElementById('objectives-list').replaceChildren();
    storedObjectives.split(/\r?\n/).filter(Boolean).forEach(function(value) { addObjective(); var inputs = document.querySelectorAll('.objective-input'); inputs[inputs.length - 1].value = value; });
}
if (document.getElementById('inp-thumb').value) document.getElementById('inp-thumb').dispatchEvent(new Event('blur'));

// ── Form Submit Interceptor ───────────────────────────────────────────
document.getElementById('course-wizard-form').addEventListener('submit', function(e) {
    if (!validateStep1()) {
        e.preventDefault(); currentStep = 1; updateStepper();
        showToast('Vui lòng kiểm tra tên khóa học, danh mục và giá bán.', 'error');
        var invalid = !document.getElementById('inp-title').value.trim() ? 'inp-title' : !document.getElementById('inp-cat').value ? 'inp-cat' : 'gia-ban-display';
        document.getElementById(invalid).focus(); return;
    }
    if (e.submitter && e.submitter.value === 'submit' && !countVideos()) {
        e.preventDefault(); currentStep = 2; updateStepper(); showToast('Vui lòng tải ít nhất một video trước khi gửi duyệt.', 'error'); return;
    }
    if (pendingUploads > 0) { e.preventDefault(); showToast('Vui lòng đợi tải tệp hoàn tất.', 'info'); return; }
    serializeCurriculum();
    var objectives = [];
    document.querySelectorAll('.objective-input').forEach(function(input) {
        if (input.value.trim() !== '') {
            objectives.push(input.value.trim());
        }
    });
    document.getElementById('MucTieuDauRa-hidden').value = objectives.join('\n');
});

// ── Attachment Modal ───────────────────────────────────────────
var currentAttachLessonId = null;

function showAttachModal(lessonId) {
    currentAttachLessonId = lessonId;
    document.getElementById('attach-file-input').value = '';
    document.getElementById('attach-modal').classList.add('active');
}

function closeAttachModal() {
    document.getElementById('attach-modal').classList.remove('active');
    currentAttachLessonId = null;
}

async function simulateAttachUpload() {
    var input = document.getElementById('attach-file-input');
    if (!input.files.length) { showToast('Vui lòng chọn tệp tài liệu.', 'error'); return; }
    var lesson = document.getElementById(currentAttachLessonId), file = input.files[0]; if (!lesson) return;
    closeAttachModal();
    var status = document.createElement('div'); status.className = 'caption'; status.textContent = 'Đang tải tài liệu: ' + file.name; lesson.appendChild(status);
    try {
        var uploaded = await uploadLessonFile(file, 'document', function(percent) { status.textContent = 'Đang tải tài liệu: ' + file.name + ' (' + percent + '%)'; });
        if (!lesson.isConnected) return;
        lesson.attachments = lesson.attachments || []; lesson.attachments.push(uploaded); renderAttachments(lesson);
    } catch (error) { showToast(error.message, 'error'); }
    finally { status.remove(); }
}
</script>
}
