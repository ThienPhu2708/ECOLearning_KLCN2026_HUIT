@model ECOLearning.Areas.Instructor.Models.CourseCreateOrEditViewModel
@{
    bool isEditing = !string.IsNullOrEmpty(Model.MaKhoaHoc);
    // Khóa học bị tạm khóa do vi phạm: nút gửi = lưu rồi sang trang Xử lý vi phạm (không gửi kiểm duyệt)
    bool isViolationLocked = isEditing && Model.TrangThai == "Tạm khóa";
    ViewBag.ShowCourseBreadcrumb = true;
    ViewBag.Title = isEditing ? "Chỉnh sửa khóa học" : "Tạo Khóa Học Mới";
    ViewBag.BreadcrumbCurrent = isEditing ? "Chỉnh sửa khóa học" : "Tạo khóa học mới";
}

<style>
/* ── Stepper ───────────────────────────────────────────────────── */
.stepper-card { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 20px; padding: 20px 32px; margin-bottom: 28px; box-shadow: var(--shadow-card); }
.stepper-wrapper { display: flex; align-items: center; justify-content: space-between; }
.stepper-step { display: flex; align-items: center; gap: 14px; cursor: pointer; }
.step-number { width: 38px; height: 38px; border-radius: 50%; background: var(--bg-canvas); border: 2px solid var(--border-color); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; transition: all 0.2s; }
.stepper-step.active .step-number { background: var(--primary); border-color: var(--primary); color: #fff; box-shadow: 0 4px 12px rgba(67,76,232,.35); }
.stepper-step.completed .step-number { background: #ECFDF5; border-color: #10B981; color: #10B981; }
.step-label { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; }
.stepper-step.active .step-label { color: var(--primary); }
.stepper-step.completed .step-label { color: #10B981; }
.step-title { font-size: 14px; font-weight: 600; color: var(--text-secondary); }
.stepper-step.active .step-title { color: var(--text-heading); font-weight: 700; }
.stepper-divider { flex: 1; height: 2px; background: var(--border-color); margin: 0 20px; }
.stepper-divider.completed { background: #10B981; }

.curriculum-toolbar { display:flex; align-items:center; gap:20px; flex-wrap:wrap; }
.chapter-toggle { display:inline-flex; align-items:center; gap:10px; cursor:pointer; font-size:13px; font-weight:600; color:var(--text-secondary); position:relative; }
.chapter-toggle input { position:absolute; right:0; width:40px; height:24px; opacity:0; cursor:pointer; margin:0; }
.toggle-track { width:40px; height:24px; border-radius:20px; background:#CBD5E1; transition:background .2s; pointer-events:none; }
.toggle-track::after { content:''; display:block; width:18px; height:18px; margin:3px; border-radius:50%; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.15); transition:transform .2s; }
.chapter-toggle input:checked + .toggle-track { background:var(--primary); }
.chapter-toggle input:checked + .toggle-track::after { transform:translateX(16px); }
.chapter-toggle input:focus-visible + .toggle-track { outline:2px solid var(--primary); outline-offset:3px; }

/* ── Wizard panels ─────────────────────────────────────────────── */
.wizard-panel { display: none; }
.wizard-panel.active { display: block; animation: fadeIn .25s ease; }
@@keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
/* ── Footer actions ────────────────────────────────────────────── */
.step-footer { position: fixed; left: calc(var(--sidebar-width) + 32px); right: 32px; bottom: 16px; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 20px; box-shadow: 0 -4px 24px rgba(15,23,42,.08); margin: 0; }
#course-wizard-form { padding-bottom: 120px; }
@@media (max-width: 992px) { .step-footer { left: 16px; right: 16px; } }
@@media (max-width: 576px) { .step-footer { bottom: 8px; padding: 12px; flex-wrap: wrap; } .step-footer > div { margin-left: auto; flex-wrap: wrap; } #course-wizard-form { padding-bottom: 160px; } }
/* ── Checklist ─────────────────────────────────────────────────── */
.chk-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 12px; background: var(--bg-canvas); border: 1px solid var(--border-color); font-size: 14px; margin-bottom: 8px; }
.chk-item.passed { border-color: #A7F3D0; background: #ECFDF5; color: #065F46; }
.chk-item.failed { border-color: #FECACA; background: #FEF2F2; color: #991B1B; }
</style>

<!-- STEPPER HEADER -->
<div class="stepper-card">
    <div class="stepper-wrapper">
        <div class="stepper-step active" id="si-1" onclick="jumpToStep(1)">
            <div class="step-number" id="sn-1">1</div>
            <div><div class="step-label">Bước 1</div><div class="step-title">Thông tin cơ bản</div></div>
        </div>
        <div class="stepper-divider" id="sd-1"></div>
        <div class="stepper-step" id="si-2" onclick="jumpToStep(2)">
            <div class="step-number" id="sn-2">2</div>
            <div><div class="step-label">Bước 2</div><div class="step-title">Đề cương & Bài giảng</div></div>
        </div>
        <div class="stepper-divider" id="sd-2"></div>
        <div class="stepper-step" id="si-3" onclick="jumpToStep(3)">
            <div class="step-number" id="sn-3">3</div>
            <div><div class="step-label">Bước 3</div><div class="step-title">Xem lại & Gửi duyệt</div></div>
        </div>
    </div>
</div>

@using (Html.BeginForm(isEditing ? "Edit" : "Create", "Course", new { area = "Instructor" }, FormMethod.Post, new { id = "course-wizard-form", enctype = "multipart/form-data", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaKhoaHoc)
    @Html.ValidationSummary(false, "", new { @class = "form-feedback-error" })

    <!-- ============================================================ -->
    <!-- BƯỚC 1: THÔNG TIN CƠ BẢN                                     -->
    <!-- ============================================================ -->
    <div class="wizard-panel active" id="sp-1">
        <div class="grid-12">
            <!-- LEFT -->
            <div class="col-8">
                <div class="card" style="margin-bottom: 24px;">
                    <h3 class="h3" style="margin-bottom: 20px;">Thông tin khóa học cơ bản</h3>

                    <div class="form-group">
                        <label class="form-label">Tiêu đề khóa học <span class="required">*</span></label>
                        @Html.TextBoxFor(m => m.TenKhoaHoc, new { @class = "form-control", id = "inp-title", placeholder = "Ví dụ: Xây dựng Web hiện đại với React & Node.js", required = "required" })
                        <div id="err-title" class="form-feedback-error" style="display:none;">Vui lòng nhập tiêu đề!</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mô tả ngắn gọn <span class="required">*</span></label>
                        @Html.TextBoxFor(m => m.MoTaNgan, new { @class = "form-control", id = "inp-short", placeholder = "Tóm tắt 1-2 câu về giá trị cốt lõi của khóa học..." })
                        <div id="err-short" class="form-feedback-error" style="display:none;">Vui lòng nhập mô tả ngắn!</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mô tả chi tiết <span class="required">*</span></label>
                        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", id = "inp-desc", rows = "5", placeholder = "Mô tả lộ trình học, kiến thức thu được và dự án thực hành..." })
                        <div id="err-desc" class="form-feedback-error" style="display:none;">Vui lòng nhập mô tả chi tiết!</div>
                    </div>
                    <div class="grid-12">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="form-label">Danh mục đào tạo <span class="required">*</span></label>
                                @Html.DropDownListFor(m => m.MaDanhMuc, Model.Categories, "-- Chọn danh mục --", new { @class = "form-control", id = "inp-cat", required = "required" })
                                <div id="err-cat" class="form-feedback-error" style="display:none;">Vui lòng chọn danh mục!</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="form-label">Cấp độ tiếp cận</label>
                                <select name="CapDo" id="inp-level" class="form-control">
                                    <option value="Cơ bản" @(Model.CapDo == "Cơ bản" ? "selected" : "")>Cơ bản (Cho người mới)</option>
                                    <option value="Trung cấp" @(Model.CapDo == "Trung cấp" ? "selected" : "")>Trung cấp</option>
                                    <option value="Nâng cao" @(Model.CapDo == "Nâng cao" ? "selected" : "")>Nâng cao & Chuyên sâu</option>
                                    <option value="Tất cả cấp độ">Tất cả cấp độ</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Objectives List -->
                <div class="card">
                    <h3 class="h3" style="margin-bottom: 12px;">Mục tiêu đầu ra của học viên</h3>
                    <p class="caption" style="margin-bottom: 16px; color: var(--text-secondary);">Học viên sẽ làm được những gì sau khi hoàn thành khóa học này?</p>

                    <div id="objectives-list">
                        <div class="form-group" style="display: flex; gap: 8px; margin-bottom: 10px;">
                            <input type="text" class="form-control objective-input" placeholder="Ví dụ: Tự thiết kế kiến trúc Microservices với NestJS và Kafka">
                            <button type="button" class="btn btn-secondary btn-sm" style="width: 38px; padding: 0;" onclick="this.parentElement.remove()">✕</button>
                        </div>
                        <div class="form-group" style="display: flex; gap: 8px; margin-bottom: 10px;">
                            <input type="text" class="form-control objective-input" placeholder="Ví dụ: Đóng gói và triển khai ứng dụng trên môi trường Docker">
                            <button type="button" class="btn btn-secondary btn-sm" style="width: 38px; padding: 0;" onclick="this.parentElement.remove()">✕</button>
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline btn-sm" onclick="addObjective()">+ Thêm mục tiêu kiến thức</button>
                    @Html.HiddenFor(m => m.MucTieuDauRa, new { id = "MucTieuDauRa-hidden" })
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-4">
                <!-- Ảnh bìa -->
                <div class="card" style="margin-bottom: 24px;">
                    <h3 class="h3" style="margin-bottom: 8px;">Ảnh bìa khóa học</h3>
                    <p class="caption" style="margin-bottom: 14px; color: var(--text-muted);">Tỷ lệ 16:9 (1280×720px). Để trống sẽ dùng ảnh mặc định.</p>
                    <div style="display: flex; gap: 8px;">
                        @Html.TextBoxFor(m => m.AnhBia, new { @class = "form-control", id = "inp-thumb", placeholder = "Nhập URL ảnh bìa..." })
                        <button type="button" class="btn btn-secondary" onclick="document.getElementById('cover-file-input').click()" style="white-space: nowrap;">📂 Tải lên</button>
                    </div>
                    <input type="file" id="cover-file-input" name="CoverImageFile" accept="image/*" style="display: none;" />
                    <div id="thumb-preview-wrap" style="margin-top: 12px; border-radius: 12px; overflow: hidden; aspect-ratio: 16/9; background: var(--bg-canvas); display: none;">
                        <img id="thumb-preview-img" src="" style="width:100%; height:100%; object-fit:cover;" />
                    </div>
                </div>

                <!-- Giá bán -->
                <div class="card">
                    <h3 class="h3" style="margin-bottom: 16px;">Giá bán</h3>

                    <div class="form-group">
                        <label class="form-label">Giá bán (VNĐ) <span class="required">*</span></label>
                        <input type="text" id="gia-ban-display" class="form-control" placeholder="Ví dụ: 799,000" autocomplete="off" required />
                        @Html.HiddenFor(m => m.GiaBan, new { id = "GiaBan-hidden" })
                        <div id="err-price" class="form-feedback-error" style="display:none;">Vui lòng nhập giá bán hợp lệ!</div>
                    </div>

                    <div class="caption" style="background: var(--bg-canvas); padding: 10px 12px; border-radius: 10px; color: var(--text-secondary); line-height: 1.5;">
                        💡 Giá = 0 sẽ tự động gắn nhãn "Miễn phí". Giá khuyến mãi và mã giảm giá do bộ phận Marketing quản lý.
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer step 1 -->
        <div class="step-footer">
            <a href="@Url.Action("Index", "Course", new { area = "Instructor" })" class="btn btn-secondary">Hủy bỏ</a>
            <div style="display:flex; gap:10px;">
                <button type="submit" name="actionType" value="draft" class="btn btn-outline">@(isEditing ? "Lưu thay đổi" : "Lưu bản nháp")</button>
                <button type="button" class="btn btn-primary" onclick="proceedToStep2()">Tiếp tục</button>
            </div>
        </div>
    </div>

    <style>
        .curriculum-section-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-2xl);
            padding: 20px 24px;
            margin-bottom: 20px;
        }
        .lesson-item-box {
            background: var(--bg-canvas);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xl);
            padding: 16px;
            margin-top: 12px;
        }
    </style>

    <!-- ============================================================ -->
    <!-- BƯỚC 2: ĐỀ CƯƠNG & BÀI GIẢNG  -->
    <!-- ============================================================ -->
    <div class="wizard-panel" id="sp-2">

        <div id="warn-no-video" class="card" style="display:none; background:#FEF2F2; border:1px solid #FECACA; margin-bottom:24px; padding:16px 20px;">
            <div style="display:flex; align-items:center; gap:12px; color:#991B1B;">
                <span style="font-size:24px;">⚠️</span>
                <div>
                    <strong style="font-size:15px;">Khóa học chưa có video bài giảng!</strong>
                    <div style="font-size:13px; margin-top:2px;">Vui lòng thêm ít nhất 1 video trước khi chuyển sang Bước 3.</div>
                </div>
            </div>
        </div>

        <div style="display:flex; justify-content:flex-end; align-items:center; margin-bottom:24px;">
            
            <div class="curriculum-toolbar">
                <label class="chapter-toggle" for="chapter-mode">
                    <span>Chia theo chương</span>
                    <input type="checkbox" id="chapter-mode" role="switch" onchange="updateCurriculumMode()">
                    <span class="toggle-track" aria-hidden="true"></span>
                </label>
                <button type="button" id="curriculum-add" class="btn btn-primary" onclick="addCurriculumItem()">+ Thêm bài học</button>
            </div>
        </div>

        <!-- VIDEO UPLOAD PROGRESS SIMULATION HUD -->
        <div id="upload-progress-hud" style="display: none; background: #EEF2FF; border: 1px solid rgba(67, 76, 232, 0.2); border-radius: 12px; margin-bottom: 24px; padding: 16px 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <strong style="color: var(--primary); font-size: 15px;" id="upload-file-name">Đang tải lên: bai-giang-01.mp4 (0.0GB / 1.5GB)</strong>
                <button type="button" class="btn btn-secondary btn-sm" id="btn-cancel-upload" style="background:#fff;">Hủy tải lên</button>
            </div>
            <div style="background: rgba(67, 76, 232, 0.2); height: 8px; border-radius: 4px; overflow: hidden; margin-bottom: 8px;">
                <div id="upload-fill-bar" style="background: var(--primary); height: 100%; width: 0%; transition: width 0.3s ease;"></div>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 12px; color: var(--text-secondary);">
                <span id="upload-speed-text">Định dạng: MP4 (1080p) • Tốc độ: 14.2 MB/s</span>
                <span id="upload-percent-text">0% • Đang xử lý...</span>
            </div>
        </div>

        <p id="chapter-empty" class="caption" style="display:none; padding:28px; text-align:center; border:1px dashed var(--border-color); border-radius:16px;">Chưa có chương. Nhấn “Thêm chương mới” để bắt đầu.</p>
        <div id="curriculum-container">
            <div class="curriculum-section-card" id="standalone-card">
                <strong style="font-size:16px;">Danh sách bài học</strong>
                <div id="standalone-lessons"></div>
            </div>
        </div>

        <div class="step-footer">
            <button type="button" class="btn btn-secondary" onclick="jumpToStep(1)">← Quay lại Bước 1</button>
            <div style="display:flex; gap:10px;">
                <button type="submit" name="actionType" value="draft" class="btn btn-outline">@(isEditing ? "Lưu thay đổi" : "Lưu bản nháp")</button>
                <button type="button" class="btn btn-primary" onclick="proceedToStep3()">Tiếp tục</button>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- BƯỚC 3: XEM LẠI & GỬI DUYỆT                                 -->
    <!-- ============================================================ -->
    <div class="wizard-panel" id="sp-3">
        <div class="grid-12" style="margin-bottom:24px;">

            <!-- LEFT: Summary -->
            <div class="col-7">
                <div class="card" style="margin-bottom:20px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                        <h3 class="h3">1. Thông tin cơ bản</h3>
                        <button type="button" class="btn btn-outline btn-sm" onclick="jumpToStep(1)">Chỉnh sửa</button>
                    </div>
                    <table class="table" style="font-size:13px; margin:0;">
                        <tbody>
                            <tr><td style="width:140px; color:var(--text-secondary); font-weight:600;">Tiêu đề:</td><td><strong id="rv-title">—</strong></td></tr>
                            <tr><td style="color:var(--text-secondary); font-weight:600;">Danh mục:</td><td><span id="rv-cat" class="badge badge-primary">—</span></td></tr>
                            <tr><td style="color:var(--text-secondary); font-weight:600;">Cấp độ:</td><td><span id="rv-level">—</span></td></tr>
                            <tr><td style="color:var(--text-secondary); font-weight:600;">Giá bán:</td><td><strong style="color:var(--primary);" id="rv-price">—</strong></td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="card">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                        <h3 class="h3">2. Cấu trúc đề cương</h3>
                        <button type="button" class="btn btn-outline btn-sm" onclick="jumpToStep(2)">Chỉnh sửa</button>
                    </div>
                    <div class="grid-12" style="text-align:center;">
                        <div class="col-4"><div style="background:var(--bg-canvas); padding:12px; border-radius:12px;"><div style="font-size:20px; font-weight:800;" id="rv-sec">0</div><div class="caption">Số chương</div></div></div>
                        <div class="col-4"><div style="background:var(--bg-canvas); padding:12px; border-radius:12px;"><div style="font-size:20px; font-weight:800;" id="rv-les">0</div><div class="caption">Số bài học</div></div></div>
                        <div class="col-4"><div style="background:var(--bg-canvas); padding:12px; border-radius:12px;"><div style="font-size:20px; font-weight:800; color:#10B981;" id="rv-vid">0</div><div class="caption">Video</div></div></div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Checklist -->
            <div class="col-5">
                <div class="card">
                    <h3 class="h3" style="margin-bottom:12px;">Kiểm tra điều kiện xuất bản</h3>
                    <p class="caption" style="margin-bottom:16px; color:var(--text-muted);">Cần đáp ứng đủ các tiêu chí trước khi gửi Admin duyệt</p>
                    <div id="chk-title" class="chk-item">⬜ Tiêu đề khóa học</div>
                    <div id="chk-desc"  class="chk-item">⬜ Mô tả chi tiết</div>
                    <div id="chk-cat"   class="chk-item">⬜ Danh mục đào tạo</div>
                    <div id="chk-price" class="chk-item">⬜ Giá bán hợp lệ</div>
                    <div id="chk-vid"   class="chk-item">⬜ Ít nhất 1 video bài giảng</div>
                    <div id="chk-warn"  style="display:none; margin-top:14px; padding:10px; background:#FEF2F2; color:#991B1B; font-size:12px; border-radius:8px;">
                        ⚠️ Chưa đủ điều kiện gửi duyệt! Vui lòng bổ sung thông tin còn thiếu.
                    </div>
                </div>
            </div>
        </div>

        <div class="step-footer">
            <button type="button" class="btn btn-secondary" onclick="jumpToStep(2)">← Quay lại Bước 2</button>
            <div style="display:flex; gap:10px;">
                <button type="submit" name="actionType" value="draft" class="btn btn-outline">@(isEditing ? "Lưu thay đổi" : "Lưu bản nháp")</button>
                <button type="submit" name="actionType" value="submit" id="btn-submit" class="btn btn-primary"
                        onclick="return confirmSubmit()">@(isViolationLocked ? "Lưu & gửi phản hồi vi phạm" : "Gửi xét duyệt khóa học")</button>
            </div>
        </div>
    </div>
    <!-- MODAL ATTACHMENT UPLOAD -->
    <div class="modal-overlay" id="attach-modal">
        <div class="modal-container" style="background:#fff; border-radius:12px; width:100%; max-width:480px; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
            <div class="modal-header" style="display:flex; justify-content:space-between; align-items:center; padding:20px 24px; border-bottom:1px solid var(--border-color);">
                <h3 class="h3" style="margin:0;">Đính kèm tài liệu học tập (PDF/ZIP)</h3>
                <button type="button" class="btn btn-secondary btn-sm" style="padding:4px 10px;" onclick="closeAttachModal()">✕</button>
            </div>
            <div class="modal-body" style="padding:24px;">
                <div class="form-group">
                    <label class="form-label">Chọn tệp tài liệu (PDF, Word, ZIP, Code)</label>
                    <input type="file" id="attach-file-input" class="form-control" style="padding:10px;">
                </div>
                <div class="caption" style="color:var(--text-secondary); margin-top:12px; line-height:1.5;">Dung lượng tối đa: 50MB/tệp. Tài liệu đính kèm sẽ hiển thị ở khu vực bài học của học viên.</div>
            </div>
            <div class="modal-footer" style="padding:16px 24px; border-top:1px solid var(--border-color); display:flex; justify-content:flex-end; gap:12px; background:var(--bg-canvas); border-bottom-left-radius:12px; border-bottom-right-radius:12px;">
                <button type="button" class="btn btn-secondary" onclick="closeAttachModal()">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="simulateAttachUpload()">Tải lên</button>
            </div>
        </div>
    </div>
}

