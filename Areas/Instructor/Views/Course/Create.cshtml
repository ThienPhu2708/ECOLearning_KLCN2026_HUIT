@section Scripts {
<script>
var curriculumDialogCallback = null;
var curriculumDialogConfirmation = false;
function openCurriculumDialog(title, label, value, callback, buttonText, confirmation) {
    var dialog = document.getElementById('curriculum-dialog');
    curriculumDialogCallback = callback; curriculumDialogConfirmation = !!confirmation;
    document.getElementById('curriculum-dialog-title').textContent = title;
    var input = document.getElementById('curriculum-dialog-input');
    input.value = value; input.style.display = confirmation ? 'none' : 'block';
    var labelEl = document.getElementById('curriculum-dialog-label');
    labelEl.textContent = label; labelEl.style.display = confirmation ? 'none' : 'block';
    document.getElementById('curriculum-dialog-error').style.display = 'none';
    document.getElementById('curriculum-dialog-save').textContent = buttonText;
    dialog.showModal();
    if (!confirmation) { input.focus(); input.select(); }
}
function closeCurriculumDialog() { document.getElementById('curriculum-dialog').close(); curriculumDialogCallback = null; }
function saveCurriculumDialog() {
    var value = document.getElementById('curriculum-dialog-input').value.trim();
    if (!curriculumDialogConfirmation && !value) {
        document.getElementById('curriculum-dialog-error').style.display = 'block';
        document.getElementById('curriculum-dialog-input').focus(); return;
    }
    var callback = curriculumDialogCallback; closeCurriculumDialog(); if (callback) callback(value);
}
document.getElementById('curriculum-dialog-input').addEventListener('keydown', function(event) {
    if (event.key === 'Enter') { event.preventDefault(); saveCurriculumDialog(); }
});
document.getElementById('curriculum-dialog').addEventListener('close', function() { curriculumDialogCallback = null; });

var currentStep = 1;
var uploadedVideos = 0;

// ── Price format ─────────────────────────────────────────────────
function parseRaw(v) { return v.replace(/[^0-9]/g, ''); }
function formatVND(raw) { var n = parseInt(raw, 10); return Number.isNaN(n) ? '' : n.toLocaleString('vi-VN'); }

function setupPrice(dispId, hidId) {
    var inp = document.getElementById(dispId), hid = document.getElementById(hidId);
    if (hid.value && parseInt(hid.value) > 0) inp.value = formatVND(hid.value);
    inp.addEventListener('keypress', function(e) { if (!/[0-9]/.test(e.key)) e.preventDefault(); });
    inp.addEventListener('input',    function()  { hid.value = parseRaw(this.value) || '0'; });
    inp.addEventListener('blur',     function()  { var r = parseRaw(this.value); this.value = formatVND(r); hid.value = r || '0'; });
    inp.addEventListener('focus',    function()  { var r = parseRaw(this.value); this.value = r || ''; });
}
setupPrice('gia-ban-display', 'GiaBan-hidden');
    // Init display values
    if (document.getElementById('GiaBan-hidden').value) { document.getElementById('gia-ban-display').value = formatVND(document.getElementById('GiaBan-hidden').value); }

// ── Thumb URL preview ────────────────────────────────────────────
document.getElementById('inp-thumb').addEventListener('blur', function() {
    var url = this.value.trim();
    var wrap = document.getElementById('thumb-preview-wrap');
    var img  = document.getElementById('thumb-preview-img');
    if (url) { img.src = url; wrap.style.display = 'block'; }
    else { wrap.style.display = 'none'; }
});

document.getElementById('cover-file-input').addEventListener('change', function(e) {
    var file = e.target.files[0];
    if (file) {
        var reader = new FileReader();
        reader.onload = function(e2) {
            var wrap = document.getElementById('thumb-preview-wrap');
            var img  = document.getElementById('thumb-preview-img');
            img.src = e2.target.result;
            wrap.style.display = 'block';
            document.getElementById('inp-thumb').value = file.name;
        }
        reader.readAsDataURL(file);
    }
});

// ── Stepper ──────────────────────────────────────────────────────
function updateStepper() {
    for (var i = 1; i <= 3; i++) {
        var si = document.getElementById('si-' + i);
        var sn = document.getElementById('sn-' + i);
        var sd = document.getElementById('sd-' + i);
        if (i < currentStep)      { si.className = 'stepper-step completed'; sn.innerText = '✓'; if (sd) sd.className = 'stepper-divider completed'; }
        else if (i === currentStep){ si.className = 'stepper-step active';   sn.innerText = i;   if (sd) sd.className = 'stepper-divider'; }
        else                       { si.className = 'stepper-step';           sn.innerText = i;   if (sd) sd.className = 'stepper-divider'; }
    }
    document.querySelectorAll('.wizard-panel').forEach(function(p, idx) {
        p.classList.toggle('active', idx + 1 === currentStep);
    });
    window.scrollTo({ top: 100, behavior: 'smooth' });
    if (currentStep === 3) populateReview();
}

function jumpToStep(n) {
    if (n > 1 && !validateStep1(false)) { currentStep = 1; updateStepper(); showToast('Vui lòng hoàn thiện thông tin bắt buộc ở Bước 1!', 'error'); return; }
    if (n === 3) { proceedToStep3(); return; }
    currentStep = n; updateStepper();
}

// ── Validate step 1 ──────────────────────────────────────────────
function validateStep1(showErr) {
    if (showErr === undefined) showErr = true;
    var ok = true;
    function chk(id, errId) {
        var v = document.getElementById(id).value.trim();
        document.getElementById(errId).style.display = (!v && showErr) ? 'block' : 'none';
        if (!v) ok = false;
    }
    chk('inp-title', 'err-title');
    chk('inp-cat',   'err-cat');
    // Price
    var raw = parseRaw(document.getElementById('gia-ban-display').value) || document.getElementById('GiaBan-hidden').value;
    var priceOk = raw !== '' && parseInt(raw, 10) >= 0;
    document.getElementById('err-price').style.display = (!priceOk && showErr) ? 'block' : 'none';
    if (!priceOk) ok = false;
    return ok;
}

function proceedToStep2() {
    if (!validateStep1()) { showToast('Vui lòng điền đầy đủ thông tin bắt buộc!', 'error'); return; }
    currentStep = 2; updateStepper();
}

// ── Validate step 2 ──────────────────────────────────────────────
function proceedToStep3() {
    countVideos();
    var warn = document.getElementById('warn-no-video');
    if (pendingUploads > 0) { showToast('Vui lòng đợi tải tệp hoàn tất.', 'info'); return; }
    if (uploadedVideos === 0) {
        warn.style.display = 'block';
        warn.scrollIntoView({ behavior: 'smooth', block: 'center' });
        showToast('⚠ Chưa có video bài giảng nào!', 'error');
        return;
    }
    warn.style.display = 'none';
    currentStep = 3; updateStepper();
}

// ── Review step 3 ────────────────────────────────────────────────
function populateReview() {
    countVideos();
    var title = document.getElementById('inp-title').value.trim();
    var catEl  = document.getElementById('inp-cat');
    var catTxt = catEl.options[catEl.selectedIndex] ? catEl.options[catEl.selectedIndex].text : '—';
    var level  = document.getElementById('inp-level').value;
    var raw    = parseRaw(document.getElementById('gia-ban-display').value) || document.getElementById('GiaBan-hidden').value;

    var price = '—';
    if (raw !== '' && parseInt(raw, 10) === 0) {
        price = 'Miễn phí';
    } else if (raw !== '' && parseInt(raw, 10) > 0) {
        price = parseInt(raw, 10).toLocaleString('vi-VN') + ' đ';
    }

    document.getElementById('rv-title').innerText = title || '—';
    document.getElementById('rv-cat').innerText   = catTxt;
    document.getElementById('rv-level').innerText = level;
    document.getElementById('rv-price').innerText = price;

    var secs = document.querySelectorAll('#curriculum-container .curriculum-section-card:not(#standalone-card)').length;
    var less = document.querySelectorAll('.lesson-item').length;
    document.getElementById('rv-sec').innerText = secs;
    document.getElementById('rv-les').innerText = less;
    document.getElementById('rv-vid').innerText = uploadedVideos;

    function setChk(id, pass, label) {
        var el = document.getElementById(id);
        el.className = 'chk-item ' + (pass ? 'passed' : 'failed');
        el.innerHTML = (pass ? '✓ ' : '✕ ') + label;
    }
    setChk('chk-title', !!title,              'Tiêu đề khóa học');
    setChk('chk-desc',  !!document.getElementById('inp-desc').value.trim(), 'Mô tả chi tiết');
    setChk('chk-cat',   !!catEl.value,        'Danh mục đào tạo');
    setChk('chk-price', raw !== '' && parseInt(raw, 10) >= 0, 'Giá bán hợp lệ');
    setChk('chk-vid',   uploadedVideos > 0,   'Ít nhất 1 video bài giảng');

    var allPass = !!title && !!catEl.value && raw !== '' && parseInt(raw, 10) >= 0 && uploadedVideos > 0;
    document.getElementById('chk-warn').style.display = allPass ? 'none' : 'block';
    var btn = document.getElementById('btn-submit');
    btn.disabled = !allPass;
    btn.style.opacity = allPass ? '1' : '0.5';
}

var submitConfirmed = false;
function confirmSubmit() {
    if (!validateStep1()) { currentStep = 1; updateStepper(); showToast('Vui lòng kiểm tra tên khóa học, danh mục và giá bán.', 'error'); return false; }
    if (pendingUploads > 0) { showToast('Vui lòng đợi tải tệp hoàn tất.', 'info'); return false; }
    if (!countVideos()) { currentStep = 2; updateStepper(); showToast('Vui lòng tải ít nhất một video trước khi gửi duyệt.', 'error'); return false; }
    if (submitConfirmed) { submitConfirmed = false; return true; }
    openCurriculumDialog('@Html.Raw(HttpUtility.JavaScriptStringEncode(isViolationLocked ? "Lưu thay đổi và chuyển sang gửi phản hồi vi phạm?" : "Gửi khóa học lên kiểm duyệt?"))', '', '', function() {
        submitConfirmed = true;
        document.getElementById('course-wizard-form').requestSubmit(document.getElementById('btn-submit'));
        submitConfirmed = false;
    }, '@Html.Raw(HttpUtility.JavaScriptStringEncode(isViolationLocked ? "Lưu & tiếp tục" : "Gửi xét duyệt"))', true);
    return false;
}

// ── Curriculum Builder ───────────────────────────────────────────
function updateCurriculumMode() {
    document.querySelectorAll('#curriculum-container .curriculum-section-card').forEach(function(section) {
        section.querySelectorAll('.lesson-item').forEach(function(lesson, index) {
            var number = lesson.querySelector('.lesson-number');
            var label = 'Bài ' + (index + 1) + ': ';
            if (number && number.textContent !== label) number.textContent = label;
        });
    });
    document.querySelectorAll('#curriculum-container .curriculum-section-card:not(#standalone-card)').forEach(function(chapter, index) {
        var count = chapter.querySelector('.chapter-lesson-count');
        var countLabel = chapter.querySelectorAll('.lesson-item').length + ' bài học';
        if (count && count.textContent !== countLabel) count.textContent = countLabel;
        var number = chapter.querySelector('.chapter-number');
        var label = 'Chương ' + (index + 1) + ': ';
        if (number && number.textContent !== label) number.textContent = label;
    });
    var chapterMode = document.getElementById('chapter-mode').checked;
    document.getElementById('curriculum-add').textContent = chapterMode ? '+ Thêm chương mới' : '+ Thêm bài học';
    var hasStandaloneLessons = !!document.querySelector('#standalone-lessons .lesson-item');
    document.getElementById('standalone-card').style.display = chapterMode && !hasStandaloneLessons ? 'none' : 'block';
    document.getElementById('chapter-empty').style.display = chapterMode && !document.querySelector('#curriculum-container .curriculum-section-card:not(#standalone-card)') ? 'block' : 'none';
}
function addCurriculumItem() {
    if (document.getElementById('chapter-mode').checked) addSection();
    else addStandaloneLesson();
    updateCurriculumMode();
}
