@model ECOLearning.Models.KhoaHoc

@{
    ViewBag.Title = "Chi tiết khóa học";
    ViewBag.BreadcrumbCurrent = "Chi tiết khóa học";
    ViewBag.ShowCourseBreadcrumb = true;
    ViewBag.BreadcrumbCourseName = Model.tenKhoaHoc;
    ViewBag.BreadcrumbCourseId = Model.maKhoaHoc;
    bool isPublished = Model.trangThai == "DaDuyet" || Model.trangThai == "Đã xuất bản" || Model.trangThai == "Đã duyệt";
    bool needsRevision = Model.trangThai == "TuChoi" || Model.trangThai == "Từ chối" || Model.trangThai == "Cần sửa đổi";
    var outlineChapters = Model.ChuongHoc != null
        ? Model.ChuongHoc.OrderBy(c => c.thuTu).ToList()
        : new System.Collections.Generic.List<ECOLearning.Models.ChuongHoc>();
    var unchapteredLessons = ViewBag.UnchapteredLessons as System.Collections.Generic.List<ECOLearning.Models.BaiHoc>;
    if (unchapteredLessons != null && unchapteredLessons.Any())
    {
        outlineChapters.Add(new ECOLearning.Models.ChuongHoc
        {
            tenChuong = "Bài học không theo chương",
            BaiHoc = unchapteredLessons
        });
    }
    var outlineLessons = outlineChapters.SelectMany(c => c.BaiHoc).ToList();
    bool isPaused = Model.trangThai == ECOLearning.Services.CourseStatus.TamNgung;
    // Nút Tạm ngưng / Mở bán lại / Xóa (partial _CourseLifecycleActions)
    var lifecycleItem = new ECOLearning.Areas.Instructor.Models.InstructorCourseItem
    {
        MaKhoaHoc = Model.maKhoaHoc,
        TenKhoaHoc = Model.tenKhoaHoc,
        TrangThai = Model.trangThai ?? "Bản nháp",
        SoHocVien = Model.DangKyKhoaHoc != null ? Model.DangKyKhoaHoc.Count : 0,
        RevisionStatus = (ViewBag.CourseRevision as ECOLearning.Services.CourseRevisionRow)?.Status
    };
}

<style>
.course-detail-actions { gap:20px;flex-wrap:wrap; }
.course-detail-actions > div:first-child { flex:1 1 260px !important;min-width:0; }
.course-detail-actions > div:last-child { flex:0 1 auto;min-width:0; }
.course-detail-actions .btn { white-space:nowrap; }
.course-detail-metrics > div { min-width:0; }
.course-detail-metrics .detail-stat-val { white-space:nowrap; }
@@media(max-width:600px) {
    .course-detail-metrics { gap:12px; }
    .course-detail-metrics > .col-3 { grid-column:span 6; }
    .course-detail-metrics .detail-stat-pill { height:100%;padding:14px 10px; }
    .course-detail-metrics .detail-stat-val { font-size:21px;line-height:1.4; }
    .course-detail-metrics .caption { font-size:12px;line-height:1.6; }
}
@@media(max-width:900px) {
    .course-detail-actions { position:static !important;align-items:stretch !important;padding:20px !important;gap:16px; }
    .course-detail-actions > div:first-child,
    .course-detail-actions > div:last-child { flex:1 1 100% !important;width:100%; }
    .course-detail-actions > div:last-child { align-items:center; }
}
@@media(max-width:480px) {
    .course-detail-actions > div:last-child > .btn,
    .course-detail-actions > div:last-child > form { flex:1 1 100%; }
    .course-detail-actions > div:last-child > form .btn { width:100%; }
}
.outline-resource-toggle { border:0; background:transparent; padding:4px 0; color:var(--primary); font-size:12px; cursor:pointer; }

.course-outline-row { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:14px 4px; }
.course-outline-lesson { border-bottom:1px solid var(--border-color); }
.course-outline-lesson:last-child { border-bottom:0; }
.course-outline-name { display:flex; align-items:center; gap:10px; font-size:14px; color:var(--text-heading); }
.course-outline-play { display:flex; align-items:center; justify-content:center; width:18px; height:18px; flex:0 0 18px; color:var(--primary); }
.course-outline-placeholder { display:block; width:18px; height:18px; flex:0 0 18px; }
.course-outline-meta > span:last-child { min-width:40px; text-align:right; font-variant-numeric:tabular-nums; }
.course-outline-meta { display:flex; align-items:center; gap:16px; color:var(--text-muted); font-size:12px; white-space:nowrap; }
@@media (max-width:576px) { .course-outline-row { align-items:flex-start; flex-direction:column; gap:8px; } }

#detail-status-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 18px; font-size:14px; line-height:1.4; font-weight:700; border-radius:10px; border:1px solid #CBD5E1; background:#E2E8F0; color:#334155; }
#detail-status-badge::before { content:none; }
#detail-status-badge.badge-warning { background:#FEF3C7; color:#92400E; border-color:#FCD34D; }
#detail-status-badge.badge-success { background:#DCFCE7; color:#166534; border-color:#86EFAC; }
#detail-status-badge.badge-danger { background:#FEE2E2; color:#991B1B; border-color:#FCA5A5; }
.detail-lesson-card { padding:18px 20px; border:1px solid var(--border-color); border-radius:12px; background:var(--bg-surface); margin-top:12px; }
.detail-lesson-title { font-size:14px; color:var(--text-heading); }
.detail-lesson-media { display:flex; align-items:center; gap:12px; margin-top:14px; padding-top:14px; border-top:1px solid var(--border-color); }
.detail-video-link { display:flex; align-items:center; gap:5px; min-width:0; flex:1; color:var(--primary); text-decoration:none; font-size:12px; }
.detail-video-link svg { flex-shrink:0; }
.detail-video-link span { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:var(--text-secondary); }
.detail-lesson-media .badge { flex-shrink:0; }
.detail-documents { display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-top:12px; font-size:12px; color:var(--text-muted); }
.detail-document-chip { display:inline-flex; align-items:center; gap:6px; border:1px solid var(--border-color); border-radius:8px; padding:7px 10px; background:var(--bg-canvas); color:var(--text-heading); text-decoration:none; }

    .course-detail-cover {
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: var(--radius-2xl);
        object-fit: cover;
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-card);
    }

    .detail-stat-pill {
        background: var(--bg-canvas);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-xl);
        padding: 14px 18px;
        text-align: center;
    }

    .detail-stat-val {
        font-size: 20px;
        font-weight: 800;
        color: var(--text-heading);
    }

    .accordion-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        background: var(--bg-canvas);
        border-radius: var(--radius-xl);
        cursor: pointer;
        font-weight: 700;
        color: var(--text-heading);
        transition: background var(--transition-fast);
    }

    .accordion-header:hover {
        background: var(--primary-light);
        color: var(--primary);
    }

        .accordion-body {
        padding: 16px 0 8px;
    }

    

        .accordion-lesson-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        margin-bottom: 8px;
        background: var(--bg-surface);
    }

    /* Thanh điều khiển tùy biến: CC luôn hiện cả khi fullscreen, không phụ thuộc native controls. */
    .preview-player-shell { position:relative; line-height:0; background:#000; overflow:hidden; }
    .preview-player-shell video { display:block; width:100%; max-height:60vh; background:#000; cursor:pointer; }
    .preview-control-bar { position:absolute; z-index:3; left:0; right:0; bottom:0; min-height:48px; display:flex; align-items:center; gap:8px; padding:14px 16px 8px; background:linear-gradient(transparent,rgba(0,0,0,.9) 46%); line-height:1; transition:opacity .2s ease, transform .2s ease; }
    .preview-control-btn { flex:0 0 auto; display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; padding:0; border:0; border-radius:5px; background:transparent; color:#fff; font:700 14px/1 Arial,sans-serif; cursor:pointer; }
    .preview-control-btn:hover, .preview-control-btn:focus-visible { background:rgba(255,255,255,.22); outline:2px solid #fff; outline-offset:1px; }
    .preview-time { flex:0 0 auto; min-width:88px; color:#fff; font:600 12px/1 Arial,sans-serif; white-space:nowrap; }
    .preview-seek { flex:1 1 auto; min-width:40px; accent-color:#818CF8; cursor:pointer; }
    .preview-subtitle-control {
        flex:0 0 auto; width:31px; height:25px; padding:0; border:1px solid rgba(255,255,255,.72); border-radius:5px;
        background:rgba(15,23,42,.72); color:#fff; font:700 11px/1 Arial,sans-serif; letter-spacing:.2px; cursor:pointer; line-height:1;
    }
    .preview-subtitle-control:hover, .preview-subtitle-control:focus-visible { background:rgba(79,70,229,.96); border-color:#fff; outline:2px solid #fff; outline-offset:2px; }
    .preview-subtitle-control.is-active { background:#4F46E5; border-color:#C7D2FE; }
    .preview-subtitle-control:disabled { opacity:.55; cursor:wait; }
    .preview-player-shell:fullscreen, .preview-player-shell:-webkit-full-screen { width:100%; height:100%; display:flex; align-items:center; justify-content:center; }
    .preview-player-shell:fullscreen video, .preview-player-shell:-webkit-full-screen video { width:100%; height:100%; max-height:none; object-fit:contain; }
    .preview-player-shell:fullscreen .preview-control-bar, .preview-player-shell:-webkit-full-screen .preview-control-bar { padding:18px 28px 12px; }
    .preview-player-shell:fullscreen .preview-control-bar.controls-hidden, .preview-player-shell:-webkit-full-screen .preview-control-bar.controls-hidden { opacity:0; transform:translateY(12px); pointer-events:none; }
    .preview-player-shell:fullscreen.controls-hidden, .preview-player-shell:-webkit-full-screen.controls-hidden { cursor:none; }
    @@media(max-width:600px) { .preview-control-bar { gap:5px; padding:12px 10px 6px; } .preview-time { min-width:73px; font-size:11px; } }

    
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div style="padding: 12px 16px; background: #ECFDF5; border: 1px solid #10B981; color: #065F46; border-radius: 12px; margin-bottom: 20px; font-size: 14px; font-weight: 600;">
        ✓ @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="padding: 12px 16px; background: #FEF2F2; border: 1px solid #EF4444; color: #991B1B; border-radius: 12px; margin-bottom: 20px; font-size: 14px; font-weight: 600;">
        ✕ @TempData["ErrorMessage"]
    </div>
}

@{ var revision = ViewBag.CourseRevision as ECOLearning.Services.CourseRevisionRow; }
@if (revision != null && revision.Status != "Approved") {
    <div style="padding:18px 22px;margin-bottom:20px;border:1px solid #C7D2FE;background:#EEF2FF;border-radius:14px;">
        <strong>@(revision.Status == "Pending" ? "Bản sửa đang chờ Admin duyệt" : revision.Status == "Rejected" ? "Bản sửa cần chỉnh lại" : "Có bản nháp chỉnh sửa")</strong>
        <p style="margin:8px 0;">Bản đang hoạt động vẫn được giữ nguyên cho học viên.</p>
        @if (!string.IsNullOrWhiteSpace(revision.Reason)) { <p>Lý do: @revision.Reason</p> }
        @if (revision.Status == "Pending") {
            <form method="post" action="@Url.Action("CancelRevision")">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.maKhoaHoc"/><input type="hidden" name="version" value="@revision.Version"/><button class="btn btn-outline btn-sm" type="submit">Hủy gửi duyệt bản sửa</button></form>
        } else { <a class="btn btn-outline btn-sm" href="@Url.Action("Edit", new { id = Model.maKhoaHoc })">Tiếp tục sửa bản nháp</a> }
    </div>
}

<!-- SECTION 1: OVERVIEW CARD -->
<div class="card" style="margin-bottom: 24px;">
<div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 16px;">
    <div>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
            @{
                string badgeClass = "badge-secondary";
                string badgeText = "Bản nháp";
                if (isPublished)
                {
                    badgeClass = "badge-success"; badgeText = "Đã xuất bản";
                }
                else if (Model.trangThai == "ChoDuyet" || Model.trangThai == "Chờ duyệt")
                {
                    badgeClass = "badge-warning"; badgeText = "Chờ duyệt";
                }
                else if (needsRevision)
                {
                    badgeClass = "badge-danger"; badgeText = "Cần sửa đổi";
                }
                else if (Model.trangThai == "Tạm khóa")
                {
                    badgeClass = "badge-warning"; badgeText = "Tạm khóa (vi phạm)";
                }
                else if (Model.trangThai == "Khóa vĩnh viễn")
                {
                    badgeClass = "badge-danger"; badgeText = "Khóa vĩnh viễn";
                }
                else if (isPaused)
                {
                    badgeClass = "badge-warning"; badgeText = "Tạm ngưng bán";
                }
            }
        </div>
        <h1 class="h2" style="margin:0;" id="detail-title">@Model.tenKhoaHoc</h1>
    </div>

    <!-- Actions -->
    <div style="display: flex; gap: 6px; padding: 4px;">
        <span class="badge @badgeClass" id="detail-status-badge">@badgeText</span>
        
    </div>
</div>

    <div class="grid-12">
        <!-- Cover Image 16:9 -->
        <div class="col-5">
            <img id="detail-image" src="@(!string.IsNullOrEmpty(Model.anhBia) ? Model.anhBia : "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&auto=format&fit=crop&q=80")" alt="Cover Image" class="course-detail-cover">
        </div>

        <!-- Overview Details -->
        <div class="col-7">
            <div style="display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap;">
                <span class="badge badge-primary" id="detail-category">@(Model.DanhMuc != null ? Model.DanhMuc.tenDanhMuc : "Danh mục")</span>
                <span class="badge badge-secondary" id="detail-level">Cấp độ: @(string.IsNullOrEmpty(Model.capDo) ? "Người mới bắt đầu" : Model.capDo)</span>
                <span class="badge badge-secondary" id="detail-lang">Ngôn ngữ: Tiếng Việt</span>
            </div>

            <p class="body-1" style="color: var(--text-secondary); margin-bottom: 20px;" id="detail-desc">
                @(!string.IsNullOrEmpty(Model.moTaNgan) ? Model.moTaNgan : "Khóa học chưa có mô tả ngắn.")
            </p>

            <div style="margin-bottom: 20px;">
                <div class="caption" style="color: var(--text-muted); margin-bottom: 10px; line-height: 1.5;">Giá bán niêm yết:</div>
                <div style="display: flex; align-items: baseline; gap: 12px;">
                    @{
                        decimal displayPrice = Model.giaBan;
                    }
                    @if (displayPrice == 0)
                    {
                        <span style="display: inline-block; font-size: 28px; line-height: 1.3; font-weight: 800; color: var(--status-success);" id="detail-price">Miễn phí</span>
                    }
                    else
                    {
                        <span style="display: inline-block; font-size: 28px; line-height: 1.3; font-weight: 800; color: var(--primary);" id="detail-price">@displayPrice.ToString("#,##0 đ")</span>
                    }
                </div>
            </div>

            <!-- Metric Pills -->
            <div class="grid-12 course-detail-metrics">
                <div class="col-3">
                    <div class="detail-stat-pill">
                        <div class="detail-stat-val" id="stat-lessons">@outlineLessons.Count</div>
                        <div class="caption">Bài học</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="detail-stat-pill">
                        <div class="detail-stat-val" id="stat-duration">
                            @{
                                int totalSecs = outlineLessons.Sum(b => b.thoiLuong ?? 0);
                                string durationStr = totalSecs >= 3600 
                                    ? string.Format("{0}h {1:D2}m", totalSecs / 3600, (totalSecs % 3600) / 60)
                                    : string.Format("{0:D2}m {1:D2}s", totalSecs / 60, totalSecs % 60);
                            }
                            @durationStr
                        </div>
                        <div class="caption">Thời lượng</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="detail-stat-pill">
                        <div class="detail-stat-val" id="stat-students">@(Model.DangKyKhoaHoc != null ? Model.DangKyKhoaHoc.Count : 0)</div>
                        <div class="caption">Học viên</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="detail-stat-pill">
                        <div class="detail-stat-val" style="color: #F59E0B;" id="stat-rating">
                        @(Model.DanhGiaKhoaHoc != null && Model.DanhGiaKhoaHoc.Any() ? Math.Round(Model.DanhGiaKhoaHoc.Average(d => d.soSao), 1).ToString("0.0") : "0") ★
                    </div>
                        <div class="caption">Đánh giá</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECTION 2: CURRICULUM ACCORDION -->
<div class="card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
            <h3 class="h3">Đề cương khóa học</h3>

        </div>
        <a href="@Url.Action("Index", "Curriculum", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-outline btn-sm">Xem đề cương</a>
    </div>

    @if (outlineChapters.Any())
    {
        int accIndex = 1;
        foreach (var chuong in outlineChapters)
        {
            <div style="margin-bottom: 14px;">
                <div class="accordion-header" onclick="toggleAccordion('acc-@accIndex')">
                    <span>@(string.IsNullOrEmpty(chuong.maChuong) ? chuong.tenChuong : "Chương " + accIndex + ": " + chuong.tenChuong) (@(chuong.BaiHoc?.Count ?? 0) bài học)</span>
                    <span id="acc-icon-@accIndex">&#9660;</span>
                </div>
                <div class="accordion-body" id="acc-@accIndex">
                    @if (chuong.BaiHoc != null && chuong.BaiHoc.Any())
                    {
                        int lessonIndex = 1;
                        foreach (var bai in chuong.BaiHoc.OrderBy(b => b.thuTu))
                        {
                            <div class="course-outline-lesson">
                            <div class="course-outline-row">
                                <div class="course-outline-name">
                                    @if (!string.IsNullOrWhiteSpace(bai.duongDanVideo))
                                    {
                                        <a class="course-outline-play" href="@ECOLearning.Services.VideoStorageService.LinkPhat(bai.duongDanVideo)" data-title="@bai.tenBaiHoc" data-subtitle="@(ECOLearning.Services.VideoSubtitleService.CoPhuDe(bai.maBaiHoc) ? Url.Action("Subtitle", "Learning", new { area = "", courseId = Model.maKhoaHoc, lessonId = bai.maBaiHoc }) : "")" onclick="previewVideo(this.getAttribute('href'), this.dataset.title, this.dataset.subtitle); return false;" title="Xem video" aria-label="Xem video">
                                            <svg width="18" height="18" viewBox="0 0 16 16"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="M6.3 4.6L11 8L6.3 11.4Z" fill="white"/></svg>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="course-outline-placeholder" aria-hidden="true"></span>
                                    }
                                    <span>Bài @lessonIndex: @bai.tenBaiHoc</span>
                                </div>
                                <div class="course-outline-meta">
                                    @if (bai.TaiNguyen != null && bai.TaiNguyen.Any()) {
                                        <button type="button" class="outline-resource-toggle" aria-expanded="false" aria-controls="outline-res-@bai.maBaiHoc" onclick="var panel = document.getElementById(this.getAttribute('aria-controls')); panel.hidden = !panel.hidden; this.setAttribute('aria-expanded', String(!panel.hidden));">@bai.TaiNguyen.Count tài liệu ▾</button>
                                    }
                                    <span>@string.Format("{0:D2}:{1:D2}", (bai.thoiLuong ?? 0) / 60, (bai.thoiLuong ?? 0) % 60)</span>
                                </div>
                            </div>
                            @if (bai.TaiNguyen != null && bai.TaiNguyen.Any())
                            {
                                <div id="outline-res-@bai.maBaiHoc" hidden>
                                    <div class="detail-documents" style="margin:0;padding:0 4px 14px 32px;">
                                        @foreach (var resource in bai.TaiNguyen)
                                        {
                                            string extension = (System.IO.Path.GetExtension(resource.duongDan) ?? "").TrimStart('.');
                                            string name = System.IO.Path.GetFileNameWithoutExtension(resource.tenTaiNguyen);
                                            <a class="detail-document-chip" href="@resource.duongDan" target="_blank" rel="noopener">@name @(!string.IsNullOrEmpty(extension) ? "(" + extension.ToUpperInvariant() + ")" : "")</a>
                                        }
                                    </div>
                                </div>
                            }
                            </div>
                            lessonIndex++;
                        }
                    }
                    else
                    {
                        <div class="caption" style="text-align:center; padding: 10px; color: var(--text-muted);">Chưa có bài học nào trong chương này.</div>
                    }
                </div>
            </div>
            accIndex++;
        }
    }
    else
    {
        <div style="text-align: center; padding: 40px; color: var(--text-secondary);">
            <p style="margin-bottom: 10px;">Khóa học này chưa có đề cương nào.</p>
            <a href="@Url.Action("Index", "Curriculum", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-primary">Xem đề cương</a>
        </div>
    }
</div>

<section id="course-reviews" style="margin:24px 0;padding:24px;background:var(--bg-surface);border:1px solid var(--border-color);border-radius:16px;">
    <h3 class="h3">Đánh giá của học viên <span class="caption">(@ViewBag.ReviewCount)</span></h3>
    <p class="caption" style="margin-top:6px;">Nhận xét về khóa học, mới nhất trước.</p>
    @if (ViewBag.ReviewCount == 0)
    {
        <p style="padding:24px 0;color:var(--text-secondary);">Khóa học chưa có đánh giá.</p>
    }
    else
    {
        foreach (var review in (System.Collections.Generic.List<ECOLearning.Models.DanhGiaKhoaHoc>)ViewBag.CourseReviews)
        {
            <article style="padding:20px 0;border-top:1px solid var(--border-color);margin-top:12px;">
                <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                    <strong>@(review.NguoiDung != null ? review.NguoiDung.hoTen : "Học viên")</strong>
                    <time class="caption">@(review.ngayDanhGia.HasValue ? review.ngayDanhGia.Value.ToString("dd/MM/yyyy HH:mm") : "")</time>
                </div>
                <div style="color:#D97706;margin:8px 0;" aria-label="@review.soSao trên 5 sao">@for (int star = 1; star <= 5; star++) {<span>@(star <= review.soSao ? "★" : "☆")</span>} <span class="caption">@review.soSao/5</span></div>
                <p style="margin:0;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7;">@(string.IsNullOrWhiteSpace(review.noiDung) ? "Học viên chỉ chấm sao, chưa viết nhận xét." : review.noiDung)</p>
            </article>
        }
        if (ViewBag.ReviewPages > 1)
        {
            <nav aria-label="Trang đánh giá" style="display:flex;justify-content:flex-end;align-items:center;gap:12px;margin-top:16px;">
                @if (ViewBag.ReviewPage > 1) {<a class="btn btn-outline btn-sm" href="@Url.Action("Details", new { id = Model.maKhoaHoc, reviewPage = ViewBag.ReviewPage - 1 })#course-reviews">← Trước</a>}
                <span class="caption">Trang @ViewBag.ReviewPage / @ViewBag.ReviewPages</span>
                @if (ViewBag.ReviewPage < ViewBag.ReviewPages) {<a class="btn btn-outline btn-sm" href="@Url.Action("Details", new { id = Model.maKhoaHoc, reviewPage = ViewBag.ReviewPage + 1 })#course-reviews">Sau →</a>}
            </nav>
        }
    }
</section>

<!-- SECTION 3: DYNAMIC ACTION BAR -->
<div class="action-bar-card course-detail-actions" style="position: sticky; bottom: 24px; z-index: 30; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-2xl); padding: 18px 24px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12); display: flex; align-items: center; justify-content: space-between;">
    @if (isPublished)
    {
        <div style="flex: 1;">
            <strong style="color: var(--text-heading); font-size: 15px;">Khóa học đang hoạt động công khai</strong>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            @if (Model.DangKyKhoaHoc != null && Model.DangKyKhoaHoc.Any())
            {
                <a href="@Url.Action("CourseStudents", "Student", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-outline"><i class="bi bi-people" aria-hidden="true"></i> Xem học viên</a>
            }
            <a href="@Url.Action("Edit", "Course", new { area = "Instructor", id = Model.maKhoaHoc })" class="btn btn-outline">Chỉnh sửa thông tin</a>
            <a href="@Url.Action("Index", "Analytics", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-outline">Báo cáo thống kê</a>
            @Html.Partial("_CourseLifecycleActions", lifecycleItem)
        </div>
    }
    else if (isPaused)
    {
        <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
            <div style="font-size: 24px; color: #0284C7;"><i class="bi bi-pause-circle-fill"></i></div>
            <div>
                <strong style="color: var(--text-heading); font-size: 15px;">Khóa học đang tạm ngưng bán</strong>
                <div class="caption">Khóa học bị ẩn khỏi trang bán, không ai mua thêm được. Học viên đã mua vẫn học bình thường. Mở bán lại để tiếp tục bán hoặc chỉnh sửa.</div>
            </div>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            @if (Model.DangKyKhoaHoc != null && Model.DangKyKhoaHoc.Any())
            {
                <a href="@Url.Action("CourseStudents", "Student", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-outline"><i class="bi bi-people" aria-hidden="true"></i> Xem học viên</a>
            }
            <a href="@Url.Action("Index", "Analytics", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-outline">Báo cáo thống kê</a>
            @Html.Partial("_CourseLifecycleActions", lifecycleItem)
        </div>
    }
    else if (Model.trangThai == "ChoDuyet" || Model.trangThai == "Chờ duyệt")
    {
        <div style="display: flex; align-items: center; gap: 12px; color: var(--status-warning); flex: 1;">
            <div style="font-size: 24px;">⏳</div>
            <div>
                <strong style="color: var(--text-heading); font-size: 15px;">Khóa học đang chờ Admin kiểm duyệt</strong>
                <div class="caption">Hệ thống tạm khóa tính năng chỉnh sửa nội dung trong thời gian chờ xét duyệt</div>
            </div>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            @if (Model.DangKyKhoaHoc != null && Model.DangKyKhoaHoc.Any())
            {
                <a href="@Url.Action("CourseStudents", "Student", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-outline"><i class="bi bi-people" aria-hidden="true"></i> Xem học viên</a>
            }
            <form action="@Url.Action("CancelApproval", "Course", new { area = "Instructor" })" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.maKhoaHoc" />
                <button type="submit" class="btn btn-warning" onclick="return instructorConfirmSubmit(this, 'Bạn có chắc chắn muốn hủy gửi xét duyệt để quay lại trạng thái Bản nháp?');">Hủy gửi xét duyệt</button>
            </form>
            <button class="btn btn-secondary" disabled style="opacity: 0.5; cursor: not-allowed;">Đang khóa sửa</button>
        </div>
    }
    else if (Model.trangThai == "Tạm khóa" || Model.trangThai == "Khóa vĩnh viễn")
    {
        bool isTempLocked = Model.trangThai == "Tạm khóa";
        <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
            <div style="font-size: 22px; color: @(isTempLocked ? "#C2410C" : "#DC2626");"><i class="bi bi-flag-fill"></i></div>
            <div>
                <strong style="color: var(--text-heading); font-size: 15px;">@(isTempLocked ? "Khóa học đang bị tạm khóa do báo cáo vi phạm" : "Khóa học đã bị khóa vĩnh viễn do vi phạm")</strong>
                <div class="caption">@(isTempLocked ? "Khóa học bị ẩn khỏi trang bán. Hãy chỉnh sửa nội dung và gửi phản hồi cho quản trị viên." : "Khóa học không còn được bán và học viên không thể tiếp tục học.")</div>
            </div>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            @if (Model.DangKyKhoaHoc != null && Model.DangKyKhoaHoc.Any())
            {
                <a href="@Url.Action("CourseStudents", "Student", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-outline"><i class="bi bi-people" aria-hidden="true"></i> Xem học viên</a>
            }
            @if (isTempLocked)
            {
                <a href="@Url.Action("Edit", "Course", new { area = "Instructor", id = Model.maKhoaHoc })" class="btn btn-outline">Chỉnh sửa nội dung</a>
            }
            <a href="@Url.Action("Index", "Violation", new { area = "Instructor", id = Model.maKhoaHoc })" class="btn btn-primary">@(isTempLocked ? "Xử lý vi phạm" : "Xem lý do")</a>
        </div>
    }
    else
    {
        <div style="flex: 1;">
            <strong style="color: var(--text-heading); font-size: 15px;">@(needsRevision ? "Khóa học cần sửa đổi" : "Khóa học ở trạng thái Bản nháp")</strong>
            <div class="caption">@(needsRevision ? "Vui lòng chỉnh sửa khóa học theo yêu cầu kiểm duyệt trước khi gửi xét duyệt lại" : "Vui lòng hoàn thiện video bài giảng trước khi gửi đăng ký duyệt xuất bản")</div>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            @if (Model.DangKyKhoaHoc != null && Model.DangKyKhoaHoc.Any())
            {
                <a href="@Url.Action("CourseStudents", "Student", new { area = "Instructor", courseId = Model.maKhoaHoc })" class="btn btn-outline"><i class="bi bi-people" aria-hidden="true"></i> Xem học viên</a>
            }
            @Html.Partial("_CourseLifecycleActions", lifecycleItem)
            <a href="@Url.Action("Edit", "Course", new { area = "Instructor", id = Model.maKhoaHoc })" class="btn btn-outline">Chỉnh sửa thông tin</a>
            
            <form action="@Url.Action("SubmitForApproval", "Course", new { area = "Instructor" })" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.maKhoaHoc" />
                <button type="submit" class="btn btn-primary" onclick="return instructorConfirmSubmit(this, 'Gửi duyệt khóa học này?');">@(needsRevision ? "Gửi xét duyệt lại" : "Gửi xét duyệt ngay")</button>
            </form>
        </div>
    }
</div>

<!-- MODAL PREVIEW VIDEO -->


<div class="modal-overlay" id="video-preview-modal">
    <div class="modal-container" style="max-width: 720px; overflow: hidden;">
        <div class="modal-header">
            <h3 class="h3" id="video-preview-title" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 90%;">Xem trước video</h3>
            <div style="display:flex;gap:8px;align-items:center;"><button class="btn btn-secondary btn-sm" onclick="closeVideoPreview()">×</button></div>
        </div>
        <div class="modal-body" style="padding: 0; background: #000;" id="preview-video-container"></div>
    </div>
</div>

@section Scripts {
            <script>
        function toggleAccordion(id) {
            const el = document.getElementById(id);
            const icon = document.getElementById(id.replace('acc-', 'acc-icon-'));
            if (el.style.display === 'none') {
                el.style.display = 'block';
                if (icon) icon.innerHTML = '&#9660;';
            } else {
                el.style.display = 'none';
                if (icon) icon.innerHTML = '&#9650;';
            }
        }

        function toggleResources(id, link) {
            const el = document.getElementById(id);
            if (el.style.display === 'none') {
                el.style.display = 'block';
                link.innerHTML = link.innerHTML.replace('▾', '▴');
            } else {
                el.style.display = 'none';
                link.innerHTML = link.innerHTML.replace('▴', '▾');
            }
        }
        function getPreviewSubtitleButton() { return document.getElementById('preview-subtitle-toggle'); }
        function setPreviewSubtitle(subtitleUrl) {
            const button = document.getElementById('preview-subtitle-toggle');
            if (!button) return;
            button.hidden = !subtitleUrl;
            if (!subtitleUrl) return;
            const track = getPreviewSubtitleTrack();
            const enabled = localStorage.getItem('eco_subtitle_vi') === '1';
            if (track) track.mode = enabled ? 'showing' : 'hidden';
            button.setAttribute('aria-pressed', enabled ? 'true' : 'false');
            button.classList.toggle('is-active', enabled);
            button.title = enabled ? 'Tắt phụ đề tiếng Việt' : 'Bật phụ đề tiếng Việt';
        }
        function getPreviewSubtitleTrack() {
            const player = document.querySelector('#preview-video-container video');
            if (!player || !player.textTracks) return null;
            for (let i = 0; i < player.textTracks.length; i++) {
                const track = player.textTracks[i];
                if (track.language === 'vi' || track.label === 'Tiếng Việt') return track;
            }
            return null;
        }
        function togglePreviewSubtitle() {
            const button = getPreviewSubtitleButton();
            if (!button) return;
            const track = getPreviewSubtitleTrack();
            if (!track) {
                button.disabled = true; button.title = 'Đang tải phụ đề…';
                window.setTimeout(function() { button.disabled = false; button.title = 'Bật phụ đề tiếng Việt'; }, 800);
                return;
            }
            const enabled = track.mode !== 'showing';
            track.mode = enabled ? 'showing' : 'hidden';
            localStorage.setItem('eco_subtitle_vi', enabled ? '1' : '0');
            button.setAttribute('aria-pressed', enabled ? 'true' : 'false');
            button.classList.toggle('is-active', enabled);
            button.title = enabled ? 'Tắt phụ đề tiếng Việt' : 'Bật phụ đề tiếng Việt';
        }
        function previewTimeLabel(seconds) {
            if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
            const minutes = Math.floor(seconds / 60), remain = Math.floor(seconds % 60);
            return minutes + ':' + String(remain).padStart(2, '0');
        }
        function addPreviewControls(shell, player, hasSubtitle) {
            const bar = document.createElement('div'); bar.className = 'preview-control-bar';
            const play = document.createElement('button'); play.type = 'button'; play.className = 'preview-control-btn'; play.title = 'Phát'; play.setAttribute('aria-label', 'Phát hoặc tạm dừng video');
            const time = document.createElement('span'); time.className = 'preview-time'; time.textContent = '0:00 / 0:00';
            const seek = document.createElement('input'); seek.type = 'range'; seek.className = 'preview-seek'; seek.min = '0'; seek.max = '0'; seek.step = '0.05'; seek.value = '0'; seek.setAttribute('aria-label', 'Tiến trình video');
            const volume = document.createElement('button'); volume.type = 'button'; volume.className = 'preview-control-btn'; volume.title = 'Tắt tiếng'; volume.setAttribute('aria-label', 'Bật hoặc tắt âm thanh');
            const cc = document.createElement('button'); cc.id = 'preview-subtitle-toggle'; cc.type = 'button'; cc.className = 'preview-subtitle-control'; cc.hidden = !hasSubtitle;
            cc.textContent = 'CC'; cc.setAttribute('aria-pressed', 'false'); cc.title = 'Bật phụ đề tiếng Việt'; cc.setAttribute('aria-label', 'Bật hoặc tắt phụ đề tiếng Việt');
            const fullscreen = document.createElement('button'); fullscreen.type = 'button'; fullscreen.className = 'preview-control-btn'; fullscreen.title = 'Toàn màn hình'; fullscreen.setAttribute('aria-label', 'Bật hoặc tắt toàn màn hình');
            bar.append(play, time, seek, volume, cc, fullscreen); shell.appendChild(bar);

            let controlsTimer, interactingWithControls = false;
            function isFullscreen() { return document.fullscreenElement === shell || document.webkitFullscreenElement === shell; }
            function hideControls() {
                if (!isFullscreen() || player.paused || player.ended || interactingWithControls || bar.querySelector(':focus-visible')) return;
                bar.classList.add('controls-hidden'); shell.classList.add('controls-hidden');
            }
            function showControls() {
                clearTimeout(controlsTimer);
                bar.classList.remove('controls-hidden'); shell.classList.remove('controls-hidden');
                if (isFullscreen() && !player.paused && !player.ended) controlsTimer = setTimeout(hideControls, 2500);
            }
            function handleFullscreenChange() { refresh(); showControls(); }
            function handlePointerDown(event) {
                interactingWithControls = !!event.target.closest('.preview-control-bar');
                showControls();
            }
            function finishControlInteraction() {
                if (interactingWithControls) { interactingWithControls = false; showControls(); }
            }
            function handleKeyDown() { if (isFullscreen()) showControls(); }

            function refresh() {
                const duration = Number.isFinite(player.duration) ? player.duration : 0;
                seek.max = duration; seek.value = Math.min(player.currentTime || 0, duration);
                time.textContent = previewTimeLabel(player.currentTime) + ' / ' + previewTimeLabel(duration);
                play.textContent = player.paused ? '▶' : '❚❚'; play.title = player.paused ? 'Phát' : 'Tạm dừng';
                volume.textContent = player.muted || player.volume === 0 ? '🔇' : '🔊'; volume.title = player.muted || player.volume === 0 ? 'Bật tiếng' : 'Tắt tiếng';
                const full = document.fullscreenElement === shell || document.webkitFullscreenElement === shell;
                fullscreen.textContent = full ? '⤢' : '⛶'; fullscreen.title = full ? 'Thoát toàn màn hình' : 'Toàn màn hình';
            }
            function togglePlay() { if (player.paused) player.play(); else player.pause(); }
            function toggleFullscreen() {
                const full = document.fullscreenElement === shell || document.webkitFullscreenElement === shell;
                if (full) {
                    if (document.exitFullscreen) document.exitFullscreen(); else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                } else if (shell.requestFullscreen) shell.requestFullscreen(); else if (shell.webkitRequestFullscreen) shell.webkitRequestFullscreen();
            }
            play.addEventListener('click', togglePlay); player.addEventListener('click', togglePlay);
            seek.addEventListener('input', function() { player.currentTime = Number(seek.value); showControls(); });
            volume.addEventListener('click', function() { player.muted = !player.muted; });
            cc.addEventListener('click', togglePreviewSubtitle); fullscreen.addEventListener('click', toggleFullscreen);
            ['loadedmetadata', 'durationchange', 'timeupdate', 'play', 'pause', 'volumechange', 'ended'].forEach(function(name) { player.addEventListener(name, refresh); });
            player.addEventListener('play', showControls); player.addEventListener('pause', showControls); player.addEventListener('ended', showControls);
            shell.addEventListener('pointermove', showControls); shell.addEventListener('pointerdown', handlePointerDown); shell.addEventListener('focusin', showControls);
            document.addEventListener('pointerup', finishControlInteraction); document.addEventListener('pointercancel', finishControlInteraction);
            document.addEventListener('keydown', handleKeyDown);
            document.addEventListener('fullscreenchange', handleFullscreenChange); document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
            shell.previewCleanup = function() {
                clearTimeout(controlsTimer);
                document.removeEventListener('fullscreenchange', handleFullscreenChange); document.removeEventListener('webkitfullscreenchange', handleFullscreenChange);
                document.removeEventListener('pointerup', finishControlInteraction); document.removeEventListener('pointercancel', finishControlInteraction);
                document.removeEventListener('keydown', handleKeyDown);
            };
            refresh();
        }
        function previewVideo(videoUrl, title, subtitleUrl) {
            document.getElementById('video-preview-title').innerText = title;
            const container = document.getElementById('preview-video-container');
            
            // Clear previous
            container.innerHTML = '';
            
            // Fix absolute path for local files if needed, but in ASP.NET we already passed the exact URL.
            // But wait, if videoUrl doesn't start with http, we should probably prepend the Uploads folder if it's just a filename.
            if (!videoUrl.startsWith('http') && !videoUrl.startsWith('/')) {
                videoUrl = '/Uploads/Videos/' + videoUrl;
            }

            if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
                setPreviewSubtitle('');
                let videoId = '';
                if (videoUrl.includes('youtube.com/watch?v=')) {
                    videoId = videoUrl.split('v=')[1];
                    const ampersandPosition = videoId.indexOf('&');
                    if (ampersandPosition !== -1) {
                        videoId = videoId.substring(0, ampersandPosition);
                    }
                } else if (videoUrl.includes('youtu.be/')) {
                    videoId = videoUrl.split('youtu.be/')[1];
                }
                
                container.innerHTML = '<iframe width="100%" height="400" src="https://www.youtube.com/embed/' + videoId + '?autoplay=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
            } else {
                const shell = document.createElement('div');
                shell.className = 'preview-player-shell';
                const player = document.createElement('video');
                player.controls = false; player.playsInline = true;
                player.src = videoUrl;
                if (subtitleUrl) {
                    const track = document.createElement('track');
                    track.dataset.subtitlePreview = 'true'; track.kind = 'subtitles'; track.srclang = 'vi'; track.label = 'Tiếng Việt'; track.src = subtitleUrl;
                    track.addEventListener('load', function() { setPreviewSubtitle(subtitleUrl); });
                    track.addEventListener('error', function() { const button = getPreviewSubtitleButton(); if (button) { button.disabled = true; button.title = 'Không tải được phụ đề'; } });
                    player.appendChild(track);
                }
                shell.appendChild(player); addPreviewControls(shell, player, !!subtitleUrl); container.appendChild(shell);
                setPreviewSubtitle(subtitleUrl || '');
                player.play().catch(e => console.log('Auto-play blocked or error', e));
            }

            if (typeof openModal === 'function') openModal('video-preview-modal');
            else document.getElementById('video-preview-modal').classList.add('active');
        }

        function closeVideoPreview() {
            const container = document.getElementById('preview-video-container');
            const shell = container.querySelector('.preview-player-shell');
            if (shell && shell.previewCleanup) shell.previewCleanup();
            if (document.fullscreenElement === shell || document.webkitFullscreenElement === shell) {
                if (document.exitFullscreen) document.exitFullscreen(); else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
            }
            container.innerHTML = ''; // Stops playback
            
            if (typeof closeModal === 'function') closeModal('video-preview-modal');
            else document.getElementById('video-preview-modal').classList.remove('active');
        }
    </script>
}
