@model ECOLearning.Areas.Instructor.Models.CourseCreateOrEditViewModel
@{
    ViewBag.Title = "Chỉnh Sửa Khóa Học";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Chỉnh Sửa Khóa Học</h1>
        <p class="body-2" style="color: var(--text-secondary);">Cập nhật nội dung khóa học, học phí và trạng thái (Mã: <code>@Model.MaKhoaHoc</code>)</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a href="@Url.Action("Index", "Curriculum", new { area = "Instructor", courseId = Model.MaKhoaHoc })" class="btn btn-outline">
            Quản lý đề cương bài học <i class="bi bi-pencil-square ms-1"></i>
        </a>
        <a href="@Url.Action("Index", "Course", new { area = "Instructor" })" class="btn btn-secondary">
            <i class="bi bi-chevron-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="card" style="max-width: 900px; margin: 0 auto; padding: 28px 32px;">
    @using (Html.BeginForm("Edit", "Course", new { area = "Instructor" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.MaKhoaHoc)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", style = "color: var(--status-danger); margin-bottom: 20px;" })

        <div class="form-group">
            <label class="form-label">Tên khóa học <span class="required">*</span></label>
            @Html.TextBoxFor(m => m.TenKhoaHoc, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(m => m.TenKhoaHoc, "", new { style = "color: var(--status-danger); font-size: 13px;" })
        </div>

        <div class="grid-12">
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label">Danh mục đào tạo <span class="required">*</span></label>
                    @Html.DropDownListFor(m => m.MaDanhMuc, Model.Categories, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.MaDanhMuc, "", new { style = "color: var(--status-danger); font-size: 13px;" })
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label">Cấp độ tiếp cận</label>
                    <select name="CapDo" class="form-control">
                        <option value="Cơ bản" @(Model.CapDo == "Cơ bản" ? "selected" : "")>Cơ bản (Cho người mới)</option>
                        <option value="Trung cấp" @(Model.CapDo == "Trung cấp" ? "selected" : "")>Trung cấp</option>
                        <option value="Nâng cao" @(Model.CapDo == "Nâng cao" ? "selected" : "")>Nâng cao & Chuyên sâu</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="grid-12">
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label">Giá bán (VNĐ) <span class="required">*</span></label>
                    @Html.TextBoxFor(m => m.GiaBan, new { @class = "form-control", type = "number", min = "0", step = "10000", required = "required" })
                    @Html.ValidationMessageFor(m => m.GiaBan, "", new { style = "color: var(--status-danger); font-size: 13px;" })
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label">Giá khuyến mãi (VNĐ - tùy chọn)</label>
                    @Html.TextBoxFor(m => m.GiaKhuyenMai, new { @class = "form-control", type = "number", min = "0", step = "10000" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Mô tả ngắn</label>
            @Html.TextBoxFor(m => m.MoTaNgan, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label class="form-label">Mục tiêu đầu ra của học viên</label>
            @Html.TextAreaFor(m => m.MucTieuDauRa, new { @class = "form-control", rows = "3" })
        </div>

        <div class="form-group">
            <label class="form-label">Mô tả chi tiết khóa học</label>
            @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "5" })
        </div>

        <div class="form-group">
            <label class="form-label">Link ảnh bìa (Thumbnail URL)</label>
            @Html.TextBoxFor(m => m.AnhBia, new { @class = "form-control" })
            @if (!string.IsNullOrEmpty(Model.AnhBia))
            {
                <div style="margin-top: 10px;">
                    <img src="@Model.AnhBia" alt="Preview" style="max-width: 200px; height: auto; border-radius: 8px; border: 1px solid var(--border-color);" />
                </div>
            }
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px; border-top: 1px solid var(--border-color); padding-top: 20px;">
            <a href="@Url.Action("Index", "Course", new { area = "Instructor" })" class="btn btn-secondary">Hủy</a>
            <button type="submit" name="actionType" value="save" class="btn btn-primary">Lưu thay đổi</button>
            @if (Model.TrangThai == "Bản nháp" || Model.TrangThai == "Cần sửa đổi")
            {
                <button type="submit" name="actionType" value="submit" class="btn btn-outline">Lưu & Gửi duyệt</button>
            }
        </div>
    }
</div>
