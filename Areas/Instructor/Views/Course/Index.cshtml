@model List<ECOLearning.Areas.Instructor.Models.InstructorCourseItem>
@{
    ViewBag.Title = "Quản Lý Khóa Học";

    int totalAll       = Model != null ? Model.Count : 0;
    int totalDraft     = Model != null ? Model.Count(x => x.TrangThai == "BanNhap"  || x.TrangThai == "Bản nháp") : 0;
    int totalPending   = Model != null ? Model.Count(x => x.TrangThai == "ChoDuyet" || x.TrangThai == "Chờ duyệt") : 0;
    int totalPublished = Model != null ? Model.Count(x => x.TrangThai == "DaDuyet"  || x.TrangThai == "Đã xuất bản" || x.TrangThai == "Đã duyệt") : 0;
    int totalRejected  = Model != null ? Model.Count(x => x.TrangThai == "TuChoi"   || x.TrangThai == "Từ chối" || x.TrangThai == "Cần sửa đổi") : 0;
    int totalViolation = Model != null ? Model.Count(x => x.TrangThai == "Tạm khóa" || x.TrangThai == "Khóa vĩnh viễn") : 0;
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="padding: 12px 16px; background: #ECFDF5; border: 1px solid #10B981; color: #065F46; border-radius: 12px; margin-bottom: 20px; font-size: 14px; font-weight: 600;">
        ✓ @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="padding: 12px 16px; background: #FEF2F2; border: 1px solid #EF4444; color: #991B1B; border-radius: 12px; margin-bottom: 20px; font-size: 14px; font-weight: 600;">
        ✕ @TempData["ErrorMessage"]
    </div>
}

<!-- FILTER TABS + SEARCH -->
<div class="card" style="margin-bottom: 24px; padding: 16px 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <!-- Tab filter buttons -->
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <button class="btn btn-primary btn-sm filter-btn" data-filter="all">Tất cả (@totalAll)</button>
            <button class="btn btn-secondary btn-sm filter-btn" data-filter="draft">Bản nháp (@totalDraft)</button>
            <button class="btn btn-secondary btn-sm filter-btn" data-filter="pending">Chờ duyệt (@totalPending)</button>
            <button class="btn btn-secondary btn-sm filter-btn" data-filter="published">Đã xuất bản (@totalPublished)</button>
            @if (totalRejected > 0)
            {
                <button class="btn btn-secondary btn-sm filter-btn" data-filter="rejected">Cần sửa (@totalRejected)</button>
            }
            @if (totalViolation > 0)
            {
                <button class="btn btn-secondary btn-sm filter-btn" data-filter="violation" style="color: #C2410C;">Vi phạm (@totalViolation)</button>
            }
        </div>
        <!-- Search -->
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-left:auto;">
        <div style="width: 200px;">
            <input type="text" id="course-search" class="form-control"
                   style="height: 38px; font-size: 13px;"
                   placeholder="Tìm tên khóa học..." />
        </div>
            <a href="@Url.Action("Create", "Course", new { area = "Instructor" })" class="btn btn-primary btn-sm" style="height:38px;white-space:nowrap;">+ Tạo khóa học mới</a>
        </div>
    </div>
</div>

<!-- COURSES TABLE -->
<div class="card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="table" data-paginate="10">
            <thead>
                <tr>
                    <th style="width: 80px;">Ảnh</th>
                    <th>Tên khóa học</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Học viên</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody id="course-table-body">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string filterKey = "draft";
                        string badgeClass = "badge-secondary";
                        string badgeText = "Bản nháp";

                        if (item.TrangThai == "DaDuyet" || item.TrangThai == "Đã xuất bản" || item.TrangThai == "Đã duyệt")
                        { filterKey = "published"; badgeClass = "badge-success"; badgeText = "Đã xuất bản"; }
                        else if (item.TrangThai == "ChoDuyet" || item.TrangThai == "Chờ duyệt")
                        { filterKey = "pending"; badgeClass = "badge-warning"; badgeText = "Chờ duyệt"; }
                        else if (item.TrangThai == "TuChoi" || item.TrangThai == "Từ chối" || item.TrangThai == "Cần sửa đổi")
                        { filterKey = "rejected"; badgeClass = "badge-danger"; badgeText = "Cần sửa đổi"; }
                        else if (item.TrangThai == "Tạm khóa")
                        { filterKey = "violation"; badgeClass = "badge-warning"; badgeText = "Tạm khóa (vi phạm)"; }
                        else if (item.TrangThai == "Khóa vĩnh viễn")
                        { filterKey = "violation"; badgeClass = "badge-danger"; badgeText = "Khóa vĩnh viễn"; }

                        decimal displayPrice = item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai.Value > 0
                            ? item.GiaKhuyenMai.Value : item.GiaBan;

                        <tr data-filter="@filterKey">
                            <td>
                                <a href="@Url.Action("Details", "Course", new { area = "Instructor", id = item.MaKhoaHoc })">
                                    <img src="@(string.IsNullOrEmpty(item.AnhBia) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=120&auto=format&fit=crop&q=80" : item.AnhBia)"
                                         alt="@item.TenKhoaHoc"
                                         style="width: 60px; height: 38px; border-radius: 6px; object-fit: cover;" />
                                </a>
                            </td>
                            <td class="cell-wrap">
                                <a href="@Url.Action("Details", "Course", new { area = "Instructor", id = item.MaKhoaHoc })" style="text-decoration: none;">
                                    <strong style="color: var(--text-heading); display: block; max-width: 260px;">@item.TenKhoaHoc</strong>
                                </a>
                                <div class="caption" style="color: var(--text-muted); margin-top: 4px;">
                                    @if (filterKey == "published")
                                    {
                                        <text>@item.SoBaiHoc bài học</text>
                                    }
                                    else if (filterKey == "pending")
                                    {
                                        <text>Đang đợi Admin duyệt</text>
                                    }
                                    else if (filterKey == "draft")
                                    {
                                        <text>Chưa gửi duyệt</text>
                                        if (!item.CoVideo)
                                        {
                                            <text> • Cần bổ sung video</text>
                                        }
                                    }
                                    else if (filterKey == "rejected")
                                    {
                                        <span style="color: #DC2626;">Bị từ chối: @item.LyDoTuChoi</span>
                                    }
                                    else if (filterKey == "violation")
                                    {
                                        <a href="@Url.Action("Index", "Violation", new { area = "Instructor", id = item.MaKhoaHoc })" style="color: #C2410C; font-weight: 600; text-decoration: none;">
                                            <i class="bi bi-flag-fill"></i> @(item.TrangThai == "Tạm khóa" ? "Bị báo cáo vi phạm — xử lý ngay" : "Xem lý do khóa")
                                        </a>
                                    }
                                </div>
                            </td>
                            <td><span class="badge badge-primary">@item.TenDanhMuc</span></td>
                            <td>
                                @{
                                    if (displayPrice == 0)
                                    {
                                        <span class="badge badge-success">Miễn phí</span>
                                    }
                                    else
                                    {
                                        <strong>@displayPrice.ToString("#,##0 đ")</strong>
                                        if (item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai.Value > 0 && item.GiaBan > item.GiaKhuyenMai.Value)
                                        {
                                            <div style="font-size: 11px; text-decoration: line-through; color: var(--text-muted);">@item.GiaBan.ToString("#,##0 đ")</div>
                                        }
                                    }
                                }
                            </td>
                            <td>@item.SoHocVien học viên</td>
                            <td><span class="badge @badgeClass">@badgeText</span></td>
                            <td>
                                <div style="display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-start;">
                                    <a href="@Url.Action("Details", "Course", new { area = "Instructor", id = item.MaKhoaHoc })" class="btn btn-primary btn-sm" style="width: 36px; padding: 0;" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    
                                    @if (filterKey == "violation")
                                    {
                                        <a href="@Url.Action("Index", "Violation", new { area = "Instructor", id = item.MaKhoaHoc })" class="btn btn-sm" style="width: 36px; padding: 0; background: #FFF7ED; color: #C2410C; border: 1px solid #FDBA74;" title="Xử lý vi phạm">
                                            <i class="bi bi-flag-fill"></i>
                                        </a>
                                    }
                                    @if (filterKey == "draft" || filterKey == "rejected" || item.TrangThai == "Tạm khóa")
                                    {
                                    <a href="@Url.Action("Edit", "Course", new { area = "Instructor", id = item.MaKhoaHoc })" class="btn btn-secondary btn-sm" style="width: 36px; padding: 0;" title="Sửa khóa học">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    }

                                    @if (filterKey == "pending")
                                    {
                                        using (Html.BeginForm("CancelApproval", "Course", new { area = "Instructor", id = item.MaKhoaHoc }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline btn-sm" style="width:36px;padding:0;" title="Hủy yêu cầu duyệt" aria-label="Hủy yêu cầu duyệt" onclick="return instructorConfirmSubmit(this, 'Hủy yêu cầu duyệt và đưa khóa học về bản nháp?')">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; color: var(--text-secondary); padding: 48px 32px;">
                            <p class="body-2" style="margin-bottom: 12px;">Bạn chưa có khóa học nào.</p>
                            <a href="@Url.Action("Create", "Course", new { area = "Instructor" })" class="btn btn-primary">Tạo khóa học đầu tiên</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // ── Tab filter ────────────────────────────────────────────────────
    document.querySelectorAll('.filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            // Active tab
            document.querySelectorAll('.filter-btn').forEach(function (b) {
                b.classList.remove('btn-primary');
                b.classList.add('btn-secondary');
            });
            this.classList.remove('btn-secondary');
            this.classList.add('btn-primary');

            var filter = this.getAttribute('data-filter');
            document.querySelectorAll('#course-table-body tr').forEach(function (row) {
                if (filter === 'all' || row.getAttribute('data-filter') === filter) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });

    // ── Search realtime ──────────────────────────────────────────────
    document.getElementById('course-search').addEventListener('input', function () {
        var q = this.value.toLowerCase();
        document.querySelectorAll('#course-table-body tr').forEach(function (row) {
            row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
        });
        // Reset tab active nếu đang search
        if (q.length > 0) {
            document.querySelectorAll('.filter-btn').forEach(function (b) {
                b.classList.remove('btn-primary');
                b.classList.add('btn-secondary');
            });
        }
    });
</script>
}


