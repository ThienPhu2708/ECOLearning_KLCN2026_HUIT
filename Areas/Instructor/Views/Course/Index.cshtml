@model List<ECOLearning.Areas.Instructor.Models.InstructorCourseItem>
@{
    ViewBag.Title = "Quản Lý Khóa Học";
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="padding: 12px 16px; background: #ECFDF5; border: 1px solid #10B981; color: #065F46; border-radius: var(--radius-xl); margin-bottom: 20px; font-size: 14px; font-weight: 600;">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="padding: 12px 16px; background: #FEF2F2; border: 1px solid #EF4444; color: #991B1B; border-radius: var(--radius-xl); margin-bottom: 20px; font-size: 14px; font-weight: 600;">
        <i class="bi bi-x-circle-fill me-1"></i> @TempData["ErrorMessage"]
    </div>
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Danh Sách Khóa Học Của Bạn</h1>
        <p class="body-2" style="color: var(--text-secondary);">Quản lý nội dung, xuất bản khóa học và theo dõi số lượng học viên</p>
    </div>
    <div>
        <a href="@Url.Action("Create", "Course", new { area = "Instructor" })" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Tạo khóa học mới
        </a>
    </div>
</div>

<!-- FILTER & SEARCH BAR -->
<div class="card" style="margin-bottom: 24px; padding: 16px 20px;">
    <form method="get" action="@Url.Action("Index", "Course", new { area = "Instructor" })" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; gap: 12px; align-items: center; flex: 1; min-width: 280px;">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm theo tên khóa học hoặc mã..." style="max-width: 360px;">
            <select name="status" class="form-control" style="max-width: 180px;">
                <option value="">Tất cả trạng thái</option>
                <option value="Bản nháp" @(ViewBag.Status == "Bản nháp" ? "selected" : "")>Bản nháp</option>
                <option value="Chờ duyệt" @(ViewBag.Status == "Chờ duyệt" ? "selected" : "")>Chờ duyệt</option>
                <option value="Đã xuất bản" @(ViewBag.Status == "Đã xuất bản" ? "selected" : "")>Đã xuất bản</option>
                <option value="Cần sửa đổi" @(ViewBag.Status == "Cần sửa đổi" ? "selected" : "")>Cần sửa đổi</option>
            </select>
            <button type="submit" class="btn btn-secondary">Lọc</button>
        </div>
        <div>
            <span class="caption" style="font-weight: 600; color: var(--text-secondary);">Tổng số: <strong>@(Model != null ? Model.Count : 0)</strong> khóa học</span>
        </div>
    </form>
</div>

<!-- COURSE TABLE (UC9) -->
<div class="card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 80px;">Ảnh bìa</th>
                    <th>Tên khóa học</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Số học viên</th>
                    <th>Số bài học</th>
                    <th>Trạng thái</th>
                    <th style="text-align: Center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@item.AnhBia" alt="@item.TenKhoaHoc" style="width: 60px; height: 40px; border-radius: 8px; object-fit: cover;" />
                            </td>
                            <td>
                                <strong style="color: var(--text-heading); display: block;">@item.TenKhoaHoc</strong>
                                <span class="caption" style="color: var(--text-muted);">Mã: @item.MaKhoaHoc</span>
                            </td>
                            <td><span class="badge badge-secondary">@item.TenDanhMuc</span></td>
                            <td>
                                <strong style="color: #0D9488;">@item.GiaBan.ToString("#,##0 đ")</strong>
                                @if (item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai > 0)
                                {
                                    <div style="font-size: 11px; text-decoration: line-through; color: var(--text-muted);">
                                        @item.GiaKhuyenMai.Value.ToString("#,##0 đ")
                                    </div>
                                }
                            </td>
                            <td><strong>@item.SoHocVien</strong> học viên</td>
                            <td>
                                <a href="@Url.Action("Index", "Curriculum", new { area = "Instructor", courseId = item.MaKhoaHoc })" style="color: var(--primary); text-decoration: none; font-weight: 600;">
                                    @item.SoBaiHoc bài học <i class="bi bi-pencil-square ms-1"></i>
                                </a>
                            </td>
                            <td>
                                @if (item.TrangThai == "Đã xuất bản")
                                {
                                    <span class="badge badge-success">Đã xuất bản</span>
                                }
                                else if (item.TrangThai == "Chờ duyệt")
                                {
                                    <span class="badge badge-warning">Chờ duyệt</span>
                                }
                                else if (item.TrangThai == "Cần sửa đổi")
                                {
                                    <span class="badge badge-danger">Cần sửa đổi</span>
                                    if (!string.IsNullOrEmpty(item.LyDoTuChoi))
                                    {
                                        <div style="font-size: 11px; color: #DC2626; margin-top: 4px; max-width: 180px; background: #FEF2F2; padding: 4px 6px; border-radius: 6px; border: 1px solid #FCA5A5;">
                                            <i class="bi bi-chat-left-dots-fill me-1"></i> Lý do: @item.LyDoTuChoi
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Bản nháp</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 6px;">
                                    <a href="@Url.Action("Index", "Curriculum", new { area = "Instructor", courseId = item.MaKhoaHoc })" class="btn btn-sm btn-outline" title="Quản lý đề cương">
                                        Đề cương
                                    </a>
                                    <a href="@Url.Action("Edit", "Course", new { area = "Instructor", id = item.MaKhoaHoc })" class="btn btn-sm btn-secondary" title="Sửa khóa học">
                                        Sửa
                                    </a>
                                    @if (item.TrangThai == "Bản nháp" || item.TrangThai == "Cần sửa đổi")
                                    {
                                        using (Html.BeginForm("SubmitForApproval", "Course", new { area = "Instructor", id = item.MaKhoaHoc }, FormMethod.Post, new { style = "display: inline;", onsubmit = "return confirm('Bạn có chắc chắn muốn gửi kiểm duyệt khóa học này không?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary">Gửi duyệt</button>
                                        }
                                    }
                                    @using (Html.BeginForm("Delete", "Course", new { area = "Instructor", id = item.MaKhoaHoc }, FormMethod.Post, new { style = "display: inline;", onsubmit = "return confirm('Bạn có chắc chắn muốn xóa khóa học này?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--text-secondary); padding: 32px;">
                            Bạn chưa có khóa học nào hoặc không có kết quả phù hợp với bộ lọc.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
