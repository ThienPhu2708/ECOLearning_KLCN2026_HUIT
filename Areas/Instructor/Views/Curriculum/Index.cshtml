@model ECOLearning.Areas.Instructor.Models.CurriculumViewModel
@{
    ViewBag.Title = "Chi tiết đề cương";
    ViewBag.BreadcrumbCurrent = "Chi tiết đề cương";
    ViewBag.BreadcrumbCourseName = Model.TenKhoaHoc;
    ViewBag.BreadcrumbCourseId = Model.MaKhoaHoc;
    Layout = ViewContext.IsChildAction ? null : "~/Areas/Instructor/Views/Shared/_LayoutInstructor.cshtml";
}
<style>
 .outline-section { background:var(--bg-surface); border:1px solid var(--border-color); border-radius:16px; overflow:hidden; margin-bottom:24px; box-shadow:0 4px 18px rgba(15,23,42,.025); }
.outline-section-header { padding:20px 24px; background:var(--bg-canvas); border-bottom:1px solid var(--border-color); display:flex; align-items:center; justify-content:space-between; gap:16px; }
.outline-section-header h3 { font-size:17px; margin:0; line-height:1.5; }
.outline-section-header .caption { white-space:nowrap; }
.outline-lesson { padding:22px 24px; border-bottom:1px solid var(--border-color); display:grid; grid-template-columns:minmax(0,1fr) auto; gap:14px 24px; align-items:center; }
.outline-lesson:last-child { border-bottom:0; }
.outline-lesson strong { font-size:15px; line-height:1.6; }
.outline-video { display:inline-flex; align-items:center; justify-content:center; gap:9px; color:var(--primary); font-size:13px; font-weight:600; text-decoration:none; padding:9px 14px; border-radius:9px; background:#eef0ff; transition:background .15s; white-space:nowrap; }
.outline-video:hover { background:#e1e5ff; }
.outline-lesson > .caption { margin:0 !important; font-size:12px; padding:9px 14px; background:var(--bg-canvas); border-radius:9px; text-align:center; }
.outline-documents { grid-column:1 / -1; display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-size:12px; color:var(--text-secondary); }
.outline-document { display:inline-flex; align-items:center; gap:7px; padding:8px 12px; background:var(--bg-surface); border:1px solid var(--border-color); border-radius:8px; color:var(--text-heading); text-decoration:none; overflow-wrap:anywhere; transition:border-color .15s; }
.outline-document:hover { border-color:var(--primary); color:var(--primary); }
.outline-empty { padding:24px; margin:0; }
@@media(max-width:640px) { .outline-section-header { align-items:flex-start; flex-direction:column; gap:4px; padding:16px; } .outline-lesson { padding:18px 16px; grid-template-columns:1fr; gap:12px; } .outline-video,.outline-lesson > .caption { justify-self:start; } }
#outline-preview { position:fixed; inset:0; margin:auto; padding:0; width:900px; max-width:calc(100vw - 32px); max-height:calc(100vh - 32px); overflow:auto; border:0; border-radius:16px; }
#outline-preview::backdrop { background:rgba(15,23,42,.6); }
#outline-player { display:block; width:100%; max-height:calc(100vh - 120px); background:#000; }
</style>
<div style="display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px;">
    <div><h1 class="h2" style="margin:0 0 6px;">@Model.TenKhoaHoc</h1><p class="body-2" style="color:var(--text-secondary);margin:0;">Đề cương bài học và tài liệu khóa học</p></div>
    <div style="display:flex;align-items:center;gap:10px;">
        @if (Model.TrangThai != "Chờ duyệt" && Model.TrangThai != "ChoDuyet")
        {
        <a class="btn btn-outline btn-sm" href="@Url.Action("Edit", "Course", new { area = "Instructor", id = Model.MaKhoaHoc, step = 2 })" title="Chỉnh sửa đề cương" aria-label="Chỉnh sửa đề cương" style="width:36px;height:36px;padding:0;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 013 3L9 17l-4 1 1-4L16.5 3.5z"/></svg>
        </a>
        }
    <a class="btn btn-outline btn-sm" href="@Url.Action("Index", "Course", new { area = "Instructor" })">Quay lại danh sách</a>
    </div>
</div>
@if (Model.ChuongHocs.Any(c => c.MaChuong != "none" || c.BaiHocs.Any()))
{
    foreach (var chapter in Model.ChuongHocs.Where(c => c.MaChuong != "none" || c.BaiHocs.Any()).OrderBy(c => c.ThuTu))
    {
        int totalSeconds = chapter.BaiHocs.Sum(l => l.ThoiLuong);
        <section class="outline-section">
            <div class="outline-section-header">
                <h3 class="h3">@(chapter.MaChuong == "none" ? "Bài học không theo chương" : "Chương " + chapter.ThuTu + ": " + chapter.TenChuong)</h3>
                <span class="caption">@chapter.BaiHocs.Count bài học · @((totalSeconds / 60).ToString()) phút</span>
            </div>
            @foreach (var lesson in chapter.BaiHocs.OrderBy(l => l.ThuTu))
            {
                <div class="outline-lesson">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
                        <strong>Bài @lesson.ThuTu: @lesson.TenBaiHoc</strong>
                        @if (lesson.ChoXemThu) { <span class="badge badge-secondary">Xem thử</span> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(lesson.DuongDanVideo))
                    {
                        <a class="outline-video" href="@lesson.DuongDanVideo" data-title="@lesson.TenBaiHoc" onclick="showOutlineVideo(this);return false;">
                            <svg width="16" height="16" viewBox="0 0 16 16" style="flex-shrink:0;"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="M6.3 4.6L11 8L6.3 11.4Z" fill="white"/></svg>
                            <span>Xem video (@(lesson.ThoiLuong / 60):@((lesson.ThoiLuong % 60).ToString("D2")))</span>
                        </a>
                    }
                    else { <p class="caption" style="margin-top:8px;">Chưa có video</p> }
                    @if (lesson.TaiNguyens.Any())
                    {
                        <div class="outline-documents"><span>Tài liệu:</span>
                            @foreach (var resource in lesson.TaiNguyens)
                            {
                                <a class="outline-document" href="@resource.DuongDan" target="_blank" rel="noopener"><svg width="14" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="flex-shrink:0;"><path d="M14 2H6v20h12V6zM14 2v5h5M9 12h6M9 16h6"/></svg>@resource.TenTaiNguyen</a>
                            }
                        </div>
                    }
                </div>
            }
            @if (!chapter.BaiHocs.Any()) { <p class="caption outline-empty">Chưa có bài học trong chương này.</p> }
        </section>
    }
}
else { <div class="outline-section">Khóa học chưa có đề cương.</div> }
<dialog id="outline-preview" aria-labelledby="outline-preview-title">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;gap:16px;">
        <strong id="outline-preview-title"></strong>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('outline-preview').close()" aria-label="Đóng video">✕</button>
    </div>
    <video id="outline-player" controls playsinline></video>
</dialog>
<script>
function showOutlineVideo(link) {
    document.getElementById('outline-preview-title').textContent = link.dataset.title;
    var player = document.getElementById('outline-player'); player.src = link.href;
    document.getElementById('outline-preview').showModal(); player.play().catch(function() {});
}
document.getElementById('outline-preview').addEventListener('close', function() {
    var player = document.getElementById('outline-player'); player.pause(); player.removeAttribute('src'); player.load();
});
</script>
