@model ECOLearning.Areas.Instructor.Models.InstructorDashboardViewModel
@{
ViewBag.Title = "Dashboard Giảng Viên";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Tổng Quan Giảng Dạy</h1>
        <p class="body-2" style="color: var(--text-secondary);">Theo dõi doanh thu, tăng trưởng học viên và hiệu quả các khóa học của bạn</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a href="@Url.Action("Create", "Course", new { area = "Instructor" })" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Tạo khóa học mới
        </a>
    </div>
</div>

<!-- 4 METRIC CARDS COMPLIANT WITH 3.3.1.3 -->
<div class="grid-12" style="margin-bottom: 32px;">

    <!-- Card 1: Total Revenue -->
    <div class="col-3">
        <div class="card" style="padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Tổng doanh thu</span>
                <div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(13, 148, 136, 0.1); color: #0D9488; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                </div>
            </div>
            <div style="font-size: 24px; font-weight: 800; color: #0D9488; margin-bottom: 4px;">
                @Model.TotalRevenue.ToString("#,##0 đ")
            </div>
            <span class="caption" style="color: var(--text-muted);">Tích lũy từ tất cả đơn hàng</span>
        </div>
    </div>

    <!-- Card 2: Month Revenue -->
    <div class="col-3">
        <div class="card" style="padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Doanh thu tháng @DateTime.Now.Month</span>
                <div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(59, 130, 246, 0.1); color: #3B82F6; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                </div>
            </div>
            <div style="font-size: 24px; font-weight: 800; color: var(--text-heading); margin-bottom: 4px;">
                @Model.MonthRevenue.ToString("#,##0 đ")
            </div>
            <span class="caption" style="color: var(--status-success); font-weight: 600;">Tích lũy doanh thu</span>
        </div>
    </div>

    <!-- Card 3: Total Students -->
    <div class="col-3">
        <div class="card" style="padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Tổng học viên</span>
                <div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(16, 185, 129, 0.1); color: #10B981; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
            </div>
            <div style="font-size: 24px; font-weight: 800; color: var(--text-heading); margin-bottom: 4px;">
                @Model.TotalStudents.ToString("#,##0")
            </div>
            <span class="caption" style="color: var(--text-muted);">Học viên đã ghi danh</span>
        </div>
    </div>

    <!-- Card 4: Average Rating -->
    <div class="col-3">
        <div class="card" style="padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Đánh giá trung bình</span>
                <div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(245, 158, 11, 0.1); color: #F59E0B; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B" stroke-width="1">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                </div>
            </div>
            <div style="font-size: 24px; font-weight: 800; color: #F59E0B; margin-bottom: 4px;">
                @Model.AverageRating.ToString("0.0") <i class="bi bi-star-fill"></i>
            </div>
            <span class="caption" style="color: var(--text-muted);">Dựa trên phản hồi học viên</span>
        </div>
    </div>

</div>

<!-- REVENUE LINE CHART & TOP COURSES -->
<div class="grid-12" style="margin-bottom: 32px;">

    <!-- Biểu đồ biến động doanh thu 12 tháng -->
    <div class="col-8">
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <h3 class="h3">Biến Động Doanh Thu Khóa Học</h3>
                    <span class="caption">Doanh thu tích lũy qua các tháng trong năm (Triệu VNĐ)</span>
                </div>
                <span class="badge badge-primary" style="background: #CCFBF1; color: #0D9488;">Năm @DateTime.Now.Year</span>
            </div>
            <div id="instructor-revenue-chart"></div>
        </div>
    </div>

    <!-- Top 3 Khóa học mang lại doanh thu cao nhất -->
    <div class="col-4">
        <div class="card">
            <h3 class="h3" style="margin-bottom: 6px;">Top Khóa Học Nổi Bật</h3>
            <span class="caption" style="display: block; margin-bottom: 16px;">3 khóa học mang lại doanh thu cao nhất</span>

            @if (Model.TopCourses != null && Model.TopCourses.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    @foreach (var course in Model.TopCourses)
                    {
                        <div style="display: flex; align-items: center; gap: 12px; padding: 10px; background: var(--bg-canvas, #F8FAFC); border-radius: var(--radius-xl); border: 1px solid var(--border-color);">
                            <img src="@course.AnhBia" alt="@course.TenKhoaHoc" style="width: 52px; height: 52px; border-radius: 10px; object-fit: cover;" />
                            <div style="flex: 1; min-width: 0;">
                                <strong style="display: block; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-heading);">@course.TenKhoaHoc</strong>
                                <span style="font-size: 12px; color: #0D9488; font-weight: 700;">@course.DoanhThu.ToString("#,##0 đ")</span>
                                <span style="font-size: 11px; color: var(--text-muted); margin-left: 8px;">@course.SoHocVien học viên</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; color: var(--text-secondary); padding: 32px 16px;">
                    <p class="body-2">Chưa có khóa học nào phát sinh doanh thu.</p>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
    const revData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueChartData));
    const chartLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartLabels));

    if (window.Charts && typeof Charts.renderLineChart === 'function') {
    Charts.renderLineChart('instructor-revenue-chart', {
    data: revData,
    labels: chartLabels,
    color: '#0D9488',
    fillColor: 'rgba(13, 148, 136, 0.08)'
    });
}
});
</script>
}