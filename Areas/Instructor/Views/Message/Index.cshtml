@{
    ViewBag.Title = "Thảo luận bài học";
    Layout = "~/Areas/Instructor/Views/Shared/_LayoutInstructor.cshtml";
    var courses = (System.Collections.Generic.List<ECOLearning.Models.KhoaHoc>)ViewBag.Courses;
    var course = ViewBag.SelectedCourse as ECOLearning.Models.KhoaHoc;
    var lessons = (System.Collections.Generic.List<ECOLearning.Models.BaiHoc>)ViewBag.Lessons;
    var lesson = ViewBag.SelectedLesson as ECOLearning.Models.BaiHoc;
    var counts = (System.Collections.Generic.Dictionary<string, int>)ViewBag.DiscussionCounts;
}
<link rel="stylesheet" href="@Url.Content("~/assets/css/lesson-discussion.css")?v=@(System.IO.File.GetLastWriteTime(Server.MapPath("~/assets/css/lesson-discussion.css")).Ticks)" />
<style>
    .teacher-discussions { display:flex; min-height:620px; height:calc(100vh - 125px); background:#fff; border:1px solid #e2e8f0; border-radius:16px; overflow:hidden; }
    .teacher-discussions-sidebar { width:300px; flex-shrink:0; border-right:1px solid #e2e8f0; display:flex; flex-direction:column; }
    .teacher-discussions-sidebar h2 { margin:0; padding:22px 20px 12px; font-size:19px; color:#172033; }
    .teacher-discussions-search { margin:0 16px 14px; border:1px solid #dbe3ef; border-radius:10px; padding:10px 12px; font:inherit; font-size:13px; }
    .teacher-discussions-courses { overflow:auto; padding:0 10px 12px; }
    .teacher-discussions-course { display:block; text-decoration:none; padding:13px 12px; border-radius:10px; color:#334155; font-weight:650; font-size:14px; }
    .teacher-discussions-course[hidden] { display:none; }
    .teacher-discussions-course:hover,.teacher-discussions-course.active { color:#4338ca; background:#eeedff; }
    .teacher-discussions-course small { display:block; color:#94a3b8; font-size:11px; font-weight:500; margin-top:3px; }
    .teacher-lessons { width:280px; flex-shrink:0; border-right:1px solid #e2e8f0; display:flex; flex-direction:column; min-height:0; }
    .teacher-lessons-head { padding:20px 16px 10px; color:#172033; font-weight:700; }
    .teacher-lessons-list { flex:1; overflow:auto; padding:0 10px 12px; }
    .teacher-lesson { display:flex; align-items:center; gap:9px; text-decoration:none; padding:11px 10px; border-radius:9px; color:#475569; font-size:13px; }
    .teacher-lesson:hover,.teacher-lesson.active { background:#eeedff; color:#4338ca; }
    .teacher-lesson[hidden] { display:none; }
    .teacher-lesson-title { min-width:0; flex:1; overflow-wrap:anywhere; }
    .teacher-lesson-count { flex-shrink:0; background:#eef2ff; color:#4f46e5; border-radius:12px; padding:3px 7px; font-size:11px; }
    .teacher-discussions-main { flex:1; min-width:0; display:flex; flex-direction:column; }
    .teacher-discussions-heading { padding:18px 24px; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; gap:12px; }
    .teacher-discussions-heading h3 { margin:0; font-size:17px; color:#172033; }
    .teacher-discussions-heading select { max-width:55%; padding:9px; border:1px solid #dbe3ef; border-radius:9px; color:#334155; background:#fff; }
    .teacher-discussions .lesson-discussion-panel { position:relative; z-index:auto; top:auto; right:auto; width:100%; height:auto; min-height:0; flex:1; transform:none; box-shadow:none; }
    .teacher-discussions .lesson-discussion-backdrop,.teacher-discussions .lesson-discussion-close { display:none; }
    .teacher-discussions-empty { margin:auto; padding:24px; text-align:center; color:#64748b; }
    @@media(max-width:1100px) { .teacher-discussions-sidebar { width:230px; } .teacher-lessons { width:230px; } }
    @@media(max-width:700px) { .teacher-discussions { height:auto; min-height:70vh; flex-direction:column; } .teacher-discussions-sidebar,.teacher-lessons { width:100%; max-height:210px; border-right:0; border-bottom:1px solid #e2e8f0; } .teacher-discussions-main { min-height:550px; } .teacher-discussions-heading { flex-wrap:wrap; } }
</style>
<div class="teacher-discussions">
    <aside class="teacher-discussions-sidebar">
        <h2>Khóa học của bạn</h2>
        <input class="teacher-discussions-search" id="teacher-discussion-search" type="search" placeholder="Tìm khóa học..." aria-label="Tìm khóa học" />
        <div class="teacher-discussions-courses">
            @foreach (var item in courses)
            {
                <a class="teacher-discussions-course @(course != null && course.maKhoaHoc == item.maKhoaHoc ? "active" : "")" href="@Url.Action("Index", "Message", new { area = "Instructor", courseId = item.maKhoaHoc })">@item.tenKhoaHoc<small>@item.maKhoaHoc</small></a>
            }
            @if (courses.Count == 0) { <div class="teacher-discussions-empty">Bạn chưa có khóa học nào.</div> }
        </div>
    </aside>
    @if (course != null)
    {
        <aside class="teacher-lessons">
            <div class="teacher-lessons-head">Bài học · @lessons.Count</div>
            <input class="teacher-discussions-search" id="teacher-lesson-search" type="search" placeholder="Tìm bài học..." aria-label="Tìm bài học" />
            <div class="teacher-lessons-list">
                @foreach (var item in lessons)
                {
                    int count = counts.ContainsKey(item.maBaiHoc) ? counts[item.maBaiHoc] : 0;
                    <a class="teacher-lesson @(lesson != null && lesson.maBaiHoc == item.maBaiHoc ? "active" : "")" href="@Url.Action("Index", "Message", new { area = "Instructor", courseId = course.maKhoaHoc, lessonId = item.maBaiHoc })">
                        <i class="bi bi-play-circle"></i><span class="teacher-lesson-title">@item.tenBaiHoc</span><span class="teacher-lesson-count" title="Tổng bình luận">@count</span>
                    </a>
                }
                @if (lessons.Count == 0) { <div class="teacher-discussions-empty">Khóa học chưa có bài học.</div> }
            </div>
        </aside>
    }
    <main class="teacher-discussions-main">
        @if (course != null && lesson != null)
        {
            <div class="teacher-discussions-heading">
                <div><h3>@course.tenKhoaHoc</h3><span style="font-size:13px;color:#64748b">@lesson.tenBaiHoc</span></div>
            </div>
            <div id="learning-antiforgery" hidden>@Html.AntiForgeryToken()</div>
            @Html.Partial("~/Views/Learning/_LessonDiscussionPanel.cshtml")
        }
        else
        {
            <div class="teacher-discussions-empty">@(course == null ? "Chọn một khóa học để xem thảo luận." : "Khóa học này chưa có bài học.")</div>
        }
    </main>
</div>
@section Scripts {
    <script src="@Url.Content("~/Scripts/jquery.signalR-2.4.3.min.js")"></script>
    <script src="@Url.Content("~/signalr/hubs")"></script>
    <script src="@Url.Content("~/assets/js/lesson-discussion.js")?v=@(System.IO.File.GetLastWriteTime(Server.MapPath("~/assets/js/lesson-discussion.js")).Ticks)"></script>
    <script>
        $(function () {
            function normalize(value) { return value.toLocaleLowerCase('vi').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd'); }
            $('#teacher-discussion-search').on('input', function () { var q = normalize(this.value); $('.teacher-discussions-course').each(function () { this.hidden = normalize(this.textContent).indexOf(q) < 0; }); });
            $('#teacher-lesson-search').on('input', function () { var q = normalize(this.value); $('.teacher-lesson').each(function () { this.hidden = normalize(this.textContent).indexOf(q) < 0; }); });
            @if (course != null && lesson != null)
            {
                <text>
                EcoLessonDiscussion.init({
                    courseId: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.maKhoaHoc))',
                    lessonId: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(lesson.maBaiHoc))',
                    getUrl: '@Url.Action("Get", "LessonDiscussion", new { area = "" })',
                    createUrl: '@Url.Action("Create", "LessonDiscussion", new { area = "" })',
                    imageUrl: '@Url.Action("Image", "LessonDiscussion", new { area = "" })',
                    likeUrl: '@Url.Action("ToggleLike", "LessonDiscussion", new { area = "" })'
                });
                openLessonDiscussion();
                </text>
            }
        });
    </script>
}
