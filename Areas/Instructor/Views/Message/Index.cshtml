@model ECOLearning.ViewModels.InstructorChatIndexViewModel
@{
    ViewBag.Title = "Tin nhắn học viên";
    Layout = "~/Areas/Instructor/Views/Shared/_LayoutInstructor.cshtml";
    int currentTeacherId = Session["UserId"] != null ? (int)Session["UserId"] : 0;
}

<link rel="stylesheet" href="~/assets/css/chat.css?v=1.0" />

<div class="container-fluid py-3">
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-warning">@ViewBag.Error</div>
    }

    <div class="chat-app-container" style="height: calc(100vh - 130px);">
        <!-- 1. SIDEBAR HỘI THOẠI & BỘ LỌC KHÓA HỌC -->
        <div class="chat-sidebar" style="width: 330px;">
            <div class="chat-sidebar-header">
                <h2><i class="bi bi-chat-left-text-fill text-teal"></i> Hộp thư học viên</h2>

                <!-- Lọc theo khóa học -->
                <div class="mt-2">
                    <form method="get" action="@Url.Action("Index", "Message", new { area = "Instructor" })">
                        <select name="courseId" class="form-select form-select-sm" onchange="this.form.submit()" style="font-size: 12.5px; border-radius: 8px;">
                            <option value="">-- Tất cả khóa học --</option>
                            @foreach (var c in Model.DanhSachKhoaHoc)
                            {
                                <option value="@c.MaKhoaHoc" @(Model.FilterCourseId == c.MaKhoaHoc ? "selected" : "")>@c.TenKhoaHoc</option>
                            }
                        </select>
                        <input type="hidden" name="status" value="@Model.FilterStatus" />
                    </form>
                </div>

                <!-- Tabs lọc trạng thái -->
                <div class="chat-filter-tabs">
                    <a href="@Url.Action("Index", "Message", new { area = "Instructor", courseId = Model.FilterCourseId, status = "all" })" 
                       class="chat-filter-btn @(Model.FilterStatus == "all" || string.IsNullOrEmpty(Model.FilterStatus) ? "active" : "")">Tất cả</a>
                    <a href="@Url.Action("Index", "Message", new { area = "Instructor", courseId = Model.FilterCourseId, status = "unread" })" 
                       class="chat-filter-btn @(Model.FilterStatus == "unread" ? "active" : "")">Chưa đọc</a>
                    <a href="@Url.Action("Index", "Message", new { area = "Instructor", courseId = Model.FilterCourseId, status = "unanswered" })" 
                       class="chat-filter-btn @(Model.FilterStatus == "unanswered" ? "active" : "")">Chưa trả lời</a>
                </div>
            </div>

            <div class="chat-conversation-list">
                @if (Model.DanhSachHoiThoai == null || !Model.DanhSachHoiThoai.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
                        Không có tin nhắn nào phù hợp bộ lọc.
                    </div>
                }
                else
                {
                    foreach (var c in Model.DanhSachHoiThoai)
                    {
                        bool isActive = Model.SelectedHoiThoaiId == c.MaHoiThoai;
                        <a href="@Url.Action("Index", "Message", new { area = "Instructor", id = c.MaHoiThoai, courseId = Model.FilterCourseId, status = Model.FilterStatus })" 
                           class="chat-conv-item @(isActive ? "active" : "")" 
                           id="conv-item-@c.MaHoiThoai">
                            <div class="chat-avatar-wrap">
                                <img src="@(string.IsNullOrEmpty(c.AnhDaiDienHocVien) ? "/assets/images/default-avatar.png" : c.AnhDaiDienHocVien)" 
                                     class="chat-avatar-img" alt="@c.TenHocVien" />
                            </div>
                            <div class="chat-conv-info">
                                <div class="chat-conv-top">
                                    <span class="chat-conv-name">@c.TenHocVien</span>
                                    <span class="chat-conv-time">@(c.TinCuoiLuc.HasValue ? c.TinCuoiLuc.Value.ToString("dd/MM") : "")</span>
                                </div>
                                <div class="chat-conv-course">@c.TenKhoaHoc</div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="chat-conv-last-msg">@(string.IsNullOrEmpty(c.TinCuoiTomTat) ? "Chưa có tin nhắn" : c.TinCuoiTomTat)</span>
                                    @if (c.SoTinChuaDoc > 0)
                                    {
                                        <span class="chat-unread-badge">@c.SoTinChuaDoc</span>
                                    }
                                    else if (!c.DaTraLoi && c.TinCuoiLuc.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size: 10px; border-radius: 6px;">Chờ đáp</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- 2. KHUNG CHAT CHÍNH (GIỮA) -->
        <div class="chat-main">
            @if (Model.PhongChatHienTai != null)
            {
                var ht = Model.PhongChatHienTai.HoiThoai;
                <div class="chat-main-header">
                    <div class="chat-header-user">
                        <img src="@(string.IsNullOrEmpty(ht.AnhDaiDienHocVien) ? "/assets/images/default-avatar.png" : ht.AnhDaiDienHocVien)" 
                             class="chat-avatar-img" style="width: 42px; height: 42px;" alt="@ht.TenHocVien" />
                        <div>
                            <h3 class="chat-header-title">@ht.TenHocVien</h3>
                            <div class="chat-header-sub"><i class="bi bi-mortarboard"></i> Học viên khóa: <b>@ht.TenKhoaHoc</b></div>
                        </div>
                    </div>
                </div>

                <div class="chat-alert-banner">
                    <i class="bi bi-shield-check"></i>
                    <span>ECOLearning nghiêm cấm trao đổi số tài khoản ngân hàng hoặc thu phí ngoài hệ thống.</span>
                </div>

                <!-- Vùng hiển thị tin nhắn -->
                <div class="chat-messages-body" id="chat-messages-container">
                    @foreach (var m in Model.PhongChatHienTai.DanhSachTinNhan)
                    {
                        bool isMine = m.LaCuaToi;
                        <div class="chat-msg-row @(isMine ? "msg-mine" : "msg-other")" id="msg-row-@m.MaTinNhan">
                            <img src="@(string.IsNullOrEmpty(m.AnhDaiDien) ? "/assets/images/default-avatar.png" : m.AnhDaiDien)" 
                                 class="chat-msg-avatar" alt="@m.TenNguoiGui" />
                            <div>
                                <div class="chat-msg-bubble @(m.DaThuHoi ? "chat-msg-recalled" : "")">
                                    @m.NoiDung
                                </div>
                                <div class="chat-msg-time">
                                    @m.NgayGui.ToString("HH:mm - dd/MM")
                                    @if (isMine && m.CoTheThuHoi)
                                    {
                                        <button type="button" class="chat-recall-btn" onclick="EcoChat.recallMessage(@m.MaTinNhan)" title="Thu hồi tin trong 5 phút">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="chat-typing-indicator" id="chat-typing-indicator">
                    <i class="bi bi-pencil-fill"></i> Học viên đang soạn tin...
                </div>

                <!-- Khung gửi tin nhắn -->
                <div class="chat-footer">
                    @if (ht.TrangThai == "ChiDoc")
                    {
                        <div class="w-100 text-center text-muted py-2">
                            <i class="bi bi-lock-fill"></i> Khóa học hoặc hội thoại này đang ở chế độ chỉ đọc.
                        </div>
                    }
                    else
                    {
                        <textarea class="chat-input" id="chat-message-input" rows="1" placeholder="Nhập câu trả lời giải đáp cho học viên... (tối đa 2.000 ký tự)"></textarea>
                        <button type="button" class="chat-send-btn" id="chat-send-btn" title="Gửi phản hồi">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                    <i class="bi bi-chat-square-dots fs-1 mb-3 text-secondary"></i>
                    <h5>Chọn một học viên để trao đổi</h5>
                    <p class="small">Bấm vào danh sách bên trái để phản hồi câu hỏi và xem tiến độ học tập của học viên.</p>
                </div>
            }
        </div>

        <!-- 3. BẢNG THÔNG TIN HỌC VIÊN (BÊN PHẢI) -->
        @if (Model.PhongChatHienTai != null && Model.PhongChatHienTai.ThongTinHocVien != null)
        {
            var st = Model.PhongChatHienTai.ThongTinHocVien;
            <div class="chat-student-sidebar">
                <div class="chat-student-header">
                    <img src="@st.AnhDaiDien" class="chat-student-avatar" alt="@st.HoTen" />
                    <h4 class="chat-student-name">@st.HoTen</h4>
                    <div class="chat-student-email">@st.Email</div>
                    <div class="small text-muted mt-1"><i class="bi bi-telephone"></i> @st.SoDienThoai</div>
                </div>

                <h6 class="fw-bold mb-3" style="font-size: 13.5px; color: #334155;">
                    <i class="bi bi-graph-up text-teal me-1"></i> Hồ sơ học tập
                </h6>

                <!-- Tiến độ khóa học -->
                <div class="chat-metric-box">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="chat-metric-label">Tiến độ khóa học</span>
                        <span class="fw-bold text-teal" style="font-size: 13px;">@st.TienDoPhanTram%</span>
                    </div>
                    <div class="chat-progress-bar-bg">
                        <div class="chat-progress-bar-fill" style="width: @st.TienDoPhanTram%;"></div>
                    </div>
                </div>

                <!-- Bài đang học -->
                <div class="chat-metric-box">
                    <div class="chat-metric-label">Bài học gần nhất</div>
                    <div class="chat-metric-value" style="font-size: 13px; line-height: 1.4;">
                        <i class="bi bi-play-circle text-primary me-1"></i> @st.BaiDangHoc
                    </div>
                </div>

                <!-- Kết quả Quiz -->
                <div class="chat-metric-box">
                    <div class="chat-metric-label">Điểm Quiz tốt nhất</div>
                    <div class="chat-metric-value">
                        @(st.DiemQuiz.HasValue ? st.DiemQuiz.Value.ToString("0.0") + " điểm" : "Chưa làm Quiz")
                    </div>
                    <div class="small text-muted mt-1">Trạng thái: <b>@st.TrangThaiQuiz</b></div>
                </div>

                <!-- Chứng chỉ -->
                <div class="chat-metric-box">
                    <div class="chat-metric-label">Chứng chỉ khóa học</div>
                    <div class="chat-metric-value" style="font-size: 13px;">
                        <i class="bi bi-award-fill text-warning me-1"></i> @st.TrangThaiChungChi
                    </div>
                </div>

                <!-- Ngày mua khóa -->
                <div class="chat-metric-box">
                    <div class="chat-metric-label">Ngày ghi danh</div>
                    <div class="chat-metric-value" style="font-size: 13px;">
                        <i class="bi bi-calendar3 me-1"></i> @(st.NgayMua.HasValue ? st.NgayMua.Value.ToString("dd/MM/yyyy") : "N/A")
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script src="~/assets/js/chat.js?v=1.0"></script>
    <script>
        $(document).ready(function () {
            var convId = @(Model.SelectedHoiThoaiId ?? 0);
            var teacherId = @currentTeacherId;

            if (teacherId > 0) {
                EcoChat.init(teacherId, true);
                if (convId > 0) {
                    EcoChat.joinConversation(convId);
                }
            }
        });
    </script>
}

