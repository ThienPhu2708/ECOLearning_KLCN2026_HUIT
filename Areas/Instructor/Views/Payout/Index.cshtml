@model ECOLearning.Areas.Instructor.Models.InstructorPayoutViewModel
@{
    ViewBag.Title = "Nhận Thanh Toán Khóa Học";
    var paymentProfile = ViewBag.PaymentProfile as ECOLearning.Models.TeacherApplication;
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="padding: 12px 16px; background: #ECFDF5; border: 1px solid #10B981; color: #065F46; border-radius: var(--radius-xl); margin-bottom: 20px; font-size: 14px; font-weight: 600;">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="padding: 12px 16px; background: #FEF2F2; border: 1px solid #EF4444; color: #991B1B; border-radius: var(--radius-xl); margin-bottom: 20px; font-size: 14px; font-weight: 600;">
        <i class="bi bi-x-circle-fill me-1"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- 3 BALANCE CARDS -->
<div class="grid-12" style="margin-bottom: 28px;">

   
    <div class="col-4">
        <div class="card" style="padding: 24px; background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%); color: #ffffff;">
            <span class="caption" style="color: rgba(255, 255, 255, 0.8); font-weight: 600;">Số dư khả dụng có thể rút</span>
            <div style="font-size: 30px; font-weight: 800; margin: 8px 0 4px;">
                @Model.AvailableBalance.ToString("#,##0 đ")
            </div>
            <span class="caption" style="color: rgba(255, 255, 255, 0.7);">Ngưỡng rút tối thiểu: 500.000 đ</span>
        </div>
    </div>

   
    <div class="col-4">
        <div class="card" style="padding: 24px;">
            <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Đang chờ đối soát / phê duyệt</span>
            <div style="font-size: 30px; font-weight: 800; color: #F59E0B; margin: 8px 0 4px;">
                @Model.PendingBalance.ToString("#,##0 đ")
            </div>
            <span class="caption" style="color: var(--text-muted);">Yêu cầu rút đang được kế toán duyệt</span>
        </div>
    </div>

   
    <div class="col-4">
        <div class="card" style="padding: 24px;">
            <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Tổng tiền đã chi trả thành công</span>
            <div style="font-size: 30px; font-weight: 800; color: var(--text-heading); margin: 8px 0 4px;">
                @Model.TotalPaid.ToString("#,##0 đ")
            </div>
            <span class="caption" style="color: var(--status-success); font-weight: 600;"><i class="bi bi-check-circle-fill me-1"></i> Đã tất toán vào tài khoản</span>
        </div>
    </div>

</div>

<div style="margin: -12px 0 24px; padding: 12px 16px; border-radius: 12px; background: #F8FAFC; border: 1px solid var(--border-color); font-size: 13.5px; color: var(--text-secondary); display: flex; flex-wrap: wrap; gap: 6px 18px;">
    <span>Doanh thu thực thu (sau mã giảm giá): <strong style="color: var(--text-heading);">@Model.TongDoanhThuThucThu.ToString("#,##0 đ")</strong></span>
    <span>Phần của bạn (80%): <strong style="color: var(--text-heading);">@Model.PhanGiaoVien.ToString("#,##0 đ")</strong></span>
    <span style="color: #475569;"><i class="bi bi-info-circle me-1"></i>Yêu cầu chi trả được xử lý sau khi quản trị viên duyệt và xác nhận giao dịch.</span>
</div>

<!-- PAYOUT FORM & TRANSACTION HISTORY -->
<div class="grid-12">

   
    <div class="col-5">
        <div class="card">
            <h3 class="h3" style="margin-bottom: 6px;">Yêu Cầu Rút Tiền</h3>
            <span class="caption" style="display: block; margin-bottom: 20px;">Gửi yêu cầu để bộ phận phụ trách kiểm tra và chi trả vào tài khoản của bạn</span>

            @using (Html.BeginForm("RequestPayout", "Payout", new { area = "Instructor" }, FormMethod.Post, new { id = "payout-request-form", novalidate = "novalidate", onsubmit = "return validatePayoutRequest(this)" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Số tiền cần rút (VNĐ) <span class="required">*</span></label>
                    <input type="number" name="soTien" class="form-control" min="500000" step="1" max="@Model.AvailableBalance.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="Tối thiểu 500,000 đ" value="@(Model.AvailableBalance >= 500000 ? Math.Min(decimal.Truncate(Model.AvailableBalance), 2000000).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" required />
                </div>

                <div style="padding:18px;background:#f3f4fc;border:1px solid var(--border-color);border-radius:12px;">
                    <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px;"><strong>Tài khoản nhận tiền</strong><button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('payment-info-dialog').showModal()">Đổi thông tin</button></div>
                    @if (paymentProfile != null)
                    {
                        <div class="caption">Ngân hàng</div><p style="margin:4px 0 12px;font-weight:600;">@paymentProfile.BankName</p>
                        <div class="caption">Số tài khoản</div><p style="margin:4px 0 12px;font-weight:600;">@paymentProfile.AccountNumber</p>
                        <div class="caption">Chủ tài khoản</div><p style="margin:4px 0 0;font-weight:600;">@paymentProfile.AccountName</p>
                    }
                    else { <p class="caption">Chưa có thông tin tài khoản trong hồ sơ giáo viên.</p> }
                </div>
                <div style="margin-top: 24px;">
                    <button type="submit" class="btn btn-primary" style="width:100%;height:44px;">Rút tiền</button>
                </div>
            }
        </div>
    </div>

   
    <div class="col-7">
        <div class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-color);">
                <h3 class="h3">Lịch Sử Giao Dịch Rút Tiền</h3>
            </div>

            <div class="table-responsive">
                <style>
                    .po-hist td.po-wrap { white-space: normal !important; }
                    .po-hist td.po-wrap .caption { overflow-wrap: anywhere; }
                    .po-hist code { font-size: 11.5px; }
                    .po-hist td.po-wrap:last-child { min-width: 150px; }
                </style>
                <table class="table po-hist" data-paginate="10">
                    <thead>
                        <tr>
                            <th>Mã phiếu / Ngày</th>
                            <th>Số tiền</th>
                            <th>Tài khoản nhận</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PayoutRequests != null && Model.PayoutRequests.Any())
                        {
                            foreach (var p in Model.PayoutRequests)
                            {
                                <tr>
                                    <td><code>@p.MaPhieuChi</code><div class="caption" style="color: var(--text-muted); margin-top: 2px;">@(p.NgayYeuCau.HasValue ? p.NgayYeuCau.Value.ToString("dd/MM/yyyy HH:mm") : "")</div></td>
                                    <td><strong style="color: #0D9488;">@p.SoTien.ToString("#,##0 đ")</strong></td>
                                    <td class="po-wrap">
                                        <div style="font-size: 13px; font-weight: 600; color: var(--text-heading);">@p.NganHang</div>
                                        <span class="caption" style="color: var(--text-muted);">@p.SoTaiKhoan</span>
                                    </td>
                                    <td class="po-wrap">
                                        @if (p.TrangThai == "Đã thanh toán")
                                        {
                                            <span class="badge badge-success">Đã chuyển khoản</span>
                                            if (!string.IsNullOrEmpty(p.MaGiaoDichChi))
                                            {
                                                <div class="caption" style="margin-top: 4px; color: var(--text-muted);">Mã GD <code>@p.MaGiaoDichChi</code>@(p.NgayXuLy.HasValue ? " · " + p.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm") : "")</div>
                                            }
                                        }
                                        else if (p.TrangThai == "Từ chối")
                                        {
                                            <span class="badge badge-danger">Từ chối</span>
                                            if (!string.IsNullOrEmpty(p.LyDoTuChoi))
                                            {
                                                <div class="caption" style="margin-top: 4px; color: #B91C1C; max-width: 220px;">@p.LyDoTuChoi</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">Chờ duyệt</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; color: var(--text-secondary); padding: 32px;">
                                    Chưa có yêu cầu rút tiền nào được tạo.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<style>#payment-info-dialog { position:fixed;inset:0;margin:auto;width:480px;max-width:calc(100vw - 32px);max-height:90vh;overflow:auto;padding:24px;border:1px solid var(--border-color);border-radius:18px; } #payment-info-dialog::backdrop { background:rgba(15,23,42,.45); }</style>
<dialog id="payment-info-dialog" aria-labelledby="payment-info-title">
    <h3 class="h3" id="payment-info-title">Đổi thông tin thanh toán</h3>
    <p class="caption" style="margin:8px 0 20px;">Thông tin được lưu vào hồ sơ và dùng cho yêu cầu mới. Các yêu cầu đã gửi giữ nguyên tài khoản.</p>
    @using (Html.BeginForm("UpdatePaymentInfo", "Payout", new { area = "Instructor" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Ngân hàng nhận tiền <span class="required">*</span></label>
                    <input name="nganHang" class="form-control" maxlength="100" value="@(paymentProfile != null ? paymentProfile.BankName : "")" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Số tài khoản ngân hàng <span class="required">*</span></label>
                    <input type="text" name="soTaiKhoan" value="@(paymentProfile != null ? paymentProfile.AccountNumber : "")" class="form-control" placeholder="Ví dụ: 0123456789" inputmode="numeric" pattern="[0-9]{4,50}" maxlength="50" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Tên chủ tài khoản (In hoa không dấu) <span class="required">*</span></label>
                    <input type="text" name="tenChuTaiKhoan" value="@(paymentProfile != null ? paymentProfile.AccountName : "")" class="form-control" placeholder="Ví dụ: NGUYEN VAN A" maxlength="100" required />
                </div>


        <div style="display:flex;justify-content:flex-end;gap:10px;"><button type="button" class="btn btn-outline" onclick="document.getElementById('payment-info-dialog').close()">Hủy</button><button type="submit" class="btn btn-primary">Lưu thông tin</button></div>
    }
</dialog>

<script>
function validatePayoutRequest(form) {
    var available = @Model.AvailableBalance.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var hasBank = @(paymentProfile != null ? "true" : "false");
    var input = form.querySelector('[name="soTien"]'), amount = Number(input.value);
    if (available < 500000) { instructorNotice('Số dư khả dụng chưa đạt mức rút tối thiểu 500.000 đ.'); return false; }
    if (!input.value || !Number.isFinite(amount) || amount < 500000 || !Number.isInteger(amount)) { instructorNotice('Vui lòng nhập số tiền nguyên từ 500.000 đ trở lên.'); input.focus(); return false; }
    if (amount > available) { instructorNotice('Số tiền yêu cầu vượt quá số dư khả dụng.'); input.focus(); return false; }
    if (!hasBank) { instructorNotice('Vui lòng bổ sung thông tin tài khoản ngân hàng qua nút Đổi thông tin trước khi rút tiền.'); return false; }
    return true;
}
</script>
