@model List<ECOLearning.Services.QuizGradeAudit>
@{ViewBag.Title="Lịch sử điều chỉnh điểm";ViewBag.BreadcrumbCurrent=ViewBag.Title;}
<div class="card" style="padding:24px;max-width:100%"><h1 style="font-size:24px">Lịch sử điều chỉnh điểm</h1><p style="margin:16px 0;color:#64748b">Lưu nguyên điểm cũ, điểm tính theo quy tắc mới và điểm được công nhận. Chỉ hiển thị các khóa học bạn phụ trách.</p><a class="btn btn-outline" href="@Url.Action("Reports")">Báo lỗi câu hỏi</a>
@if(!Model.Any()){<p style="margin:20px 0">Chưa có lịch sử điều chỉnh.</p>}
@foreach(var row in Model){<section style="padding:18px 0;border-bottom:1px solid #e2e8f0"><strong>@row.CourseName · Lượt #@row.AttemptId</strong><p style="font-size:12px;color:#64748b;margin:8px 0">@row.TeacherName · @row.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><p style="white-space:pre-wrap;overflow-wrap:anywhere">@row.Reason</p><p style="margin:10px 0">Điểm trước: @row.OldScore · Tính lại: @row.CalculatedScore · Công nhận: <strong>@row.RecognizedScore /10</strong> · @(row.RecognizedPassed?"Đạt":"Chưa đạt")</p><a href="@Url.Action("Review",new{id=row.AttemptId})">Xem lượt thi và kết quả kỹ năng</a></section>}</div>
