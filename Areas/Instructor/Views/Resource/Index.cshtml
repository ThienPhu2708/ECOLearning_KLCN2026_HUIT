@model List<ECOLearning.Areas.Instructor.Controllers.LibraryFile>
@{ ViewBag.Title = "Thư viện tài nguyên"; ViewBag.BreadcrumbCurrent = "Thư viện tài nguyên"; }
@Html.AntiForgeryToken()
<style>
.library-toolbar { margin-bottom:20px;padding:16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap; }
.library-toolbar #library-search { flex:1;min-width:180px;width:auto !important;height:44px; }
.library-toolbar .teacher-select-button { height:44px;min-height:44px; }
.library-upload-button { height:44px;white-space:nowrap;margin-left:auto; }
#library-progress:empty { display:none; }
@@media(max-width:1100px) { .library-toolbar #library-search { flex-basis:100%; } .library-toolbar .teacher-select { flex:1;min-width:140px; } }
@@media(max-width:600px) { .library-toolbar { gap:10px;padding:14px; } .library-toolbar .teacher-select { width:100% !important;flex-basis:100%; } .library-upload-button { width:100%;margin-left:0; } }
.library-stats { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-bottom:24px; }
.library-stat { display:flex;align-items:center;justify-content:space-between;padding:24px;background:var(--bg-surface);border:1px solid var(--border-color);border-radius:16px;box-shadow:0 4px 16px rgba(15,23,42,.025); }
.library-stat-label { color:var(--text-secondary);font-size:14px;margin-bottom:8px; }
.library-stat-value { display:flex;align-items:baseline;gap:7px;font-size:28px;font-weight:700;line-height:1.3; }
.library-stat-value span { font-size:14px !important;font-weight:500 !important; }
.library-stat:nth-child(1) { background:#f3f0ff;border-color:#e0d9fa;color:#6554c0; }
.library-stat:nth-child(2) { background:#eef6ff;border-color:#d5e5f7;color:#3277ba; }
.library-stat:nth-child(3) { background:#edf9f3;border-color:#ceebdc;color:#268564; }
.library-stat:nth-child(1) .library-stat-value { color:#6554c0 !important; }
.library-stat:nth-child(2) .library-stat-value { color:#3277ba; }
.library-stat:nth-child(3) .library-stat-value { color:#268564; }
.library-stat .library-stat-icon { background:rgba(255,255,255,.8) !important;color:inherit !important;flex-shrink:0; }
.library-stat-icon { width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:#eef0ff;color:var(--primary); }
.library-table { table-layout:fixed;width:100%; }
.library-table th,.library-table td { vertical-align:middle; }
.library-table th { white-space:nowrap; }
.library-file { display:flex;align-items:center;gap:12px;min-width:0; }
.library-file-icon { width:38px;height:42px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#eef0ff;color:var(--primary);border-radius:10px; }
.library-file-icon.archive { background:#fff3df;color:#b7791f; }
.library-file-icon.document { background:#eaf8f2;color:#268564; }
.library-file-name { display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px; }
.library-type { display:inline-block;white-space:nowrap;padding:4px 10px;border-radius:20px;font-size:12px;background:#eef0ff;color:var(--primary); }
.library-type.document { background:#eaf8f2;color:#268564; }
.library-table .btn { white-space:nowrap; }
.library-actions { display:flex;align-items:center;gap:8px;flex-wrap:nowrap; }
.library-actions .btn { flex-shrink:0;margin-left:0 !important; }
.library-table { min-width:960px; }
@@media(max-width:800px) { .library-stats { gap:12px;grid-template-columns:1fr; } .library-stat { padding:18px; } .library-table { min-width:760px; } }
</style>
<div class="library-stats">
    <div class="library-stat"><div><div class="library-stat-label">Dung lượng tài nguyên</div><div class="library-stat-value" style="color:var(--primary);">@((Model.Sum(f => f.Size) / 1048576d).ToString("0.##")) <span style="font-size:16px;">MB</span></div></div><span class="library-stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v7c0 4 16 4 16 0V5M4 12v7c0 4 16 4 16 0v-7"/></svg></span></div>
    <div class="library-stat"><div><div class="library-stat-label">Video bài giảng</div><div class="library-stat-value">@Model.Count(f => f.Kind == "video") <span style="font-size:16px;font-weight:500;">video</span></div></div><span class="library-stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="4"/><path d="m10 8 6 4-6 4z"/></svg></span></div>
    <div class="library-stat"><div><div class="library-stat-label">Tài liệu đính kèm</div><div class="library-stat-value">@Model.Count(f => f.Kind == "document") <span style="font-size:16px;font-weight:500;">tài liệu</span></div></div><span class="library-stat-icon" style="background:#eaf8f2;color:#268564;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 2H5v20h14V7zM14 2v5h5M8 12h8M8 16h6"/></svg></span></div>
</div>
<div class="card library-toolbar">
    <input id="library-search" class="form-control" style="width:220px;max-width:100%;" placeholder="Tìm tên tệp..." oninput="filterLibrary()">
    <select id="library-kind" class="form-control" style="width:180px;" onchange="filterLibrary()"><option value="">Tất cả tệp</option><option value="video">Video</option><option value="document">Tài liệu</option></select>
    <select id="library-course" class="form-control" style="width:190px;" onchange="filterLibrary()">
        <option value="">Tất cả khóa học</option>
        <option value="__unused">Chưa gắn khóa học</option>
        @foreach (var course in Model.SelectMany(f => f.Courses).Distinct().OrderBy(c => c))
        {
            <option value="@course">@course</option>
        }
    </select>
    <select id="library-size" class="form-control" style="width:170px;" onchange="filterLibrary()">
        <option value="">Mọi dung lượng</option><option value="small">Dưới 10 MB</option><option value="medium">10 – 100 MB</option><option value="large">Trên 100 MB</option><option value="unknown">Chưa xác định</option>
    </select>
    <span id="library-progress" class="caption"></span>
    <button type="button" class="btn btn-primary library-upload-button" onclick="document.getElementById('library-upload').click()">+ Tải tệp lên</button>
    <input type="file" id="library-upload" hidden accept=".mp4,.webm,.mov,.mkv,.m4v,.ogv,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.txt,.csv">
</div>
<div class="card" style="padding:0;overflow:hidden;">
<div class="table-responsive"><table class="table library-table" data-paginate="10"><colgroup><col style="width:33%;"><col style="width:12%;"><col style="width:22%;"><col style="width:11%;"><col style="width:22%;"></colgroup><thead><tr><th>Tên tệp</th><th>Loại</th><th>Khóa học sử dụng</th><th>Dung lượng</th><th></th></tr></thead><tbody>
@foreach (var file in Model) {
    <tr data-kind="@file.Kind" data-name="@file.Name.ToLowerInvariant()" data-courses="@Newtonsoft.Json.JsonConvert.SerializeObject(file.Courses)" data-size="@file.Size">
        <td><div class="library-file"><span class="library-file-icon @(file.Kind == "video" ? "" : System.IO.Path.GetExtension(file.Url).Equals(".zip", StringComparison.OrdinalIgnoreCase) ? "archive" : "document")" aria-hidden="true">
                @if (file.Kind == "video")
                {
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><path d="m10 8 6 4-6 4z" fill="currentColor" stroke="none"/></svg>
                }
                else if (System.IO.Path.GetExtension(file.Url).Equals(".zip", StringComparison.OrdinalIgnoreCase))
                {
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M10 3v3h4v3h-4v3h4v3"/><rect x="10" y="15" width="4" height="3" rx="1"/></svg>
                }
                else
                {
                    <svg width="20" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 2H5v20h14V7zM14 2v5h5M8 12h8M8 16h6"/></svg>
                }
            </span><strong class="library-file-name" title="@file.Name">@file.Name</strong></div></td>
        <td><span class="library-type @(file.Kind == "video" ? "" : "document")">@(file.Kind == "video" ? "Video" : "Tài liệu")</span></td>
        <td>@(file.Courses.Any() ? string.Join(", ", file.Courses) : "Chưa gắn khóa học")</td>
        <td>@(file.Size > 0 ? (file.Size / 1048576d).ToString("0.##") + " MB" : "—")</td>
        <td><div class="library-actions">
            @if (file.Kind == "video") {
                <button type="button" class="btn btn-outline btn-sm" data-url="@file.Url" data-name="@file.Name" onclick="previewLibraryVideo(this)">Xem video</button>
            } else {
                <a class="btn btn-outline btn-sm" href="@Url.Action("Download", "Resource", new { area = "Instructor", url = file.Url })">Tải xuống</a>
            }
            <button type="button" class="btn btn-outline btn-sm" data-url="@file.Url" data-name="@file.Name" onclick="openLibraryRename(this)" title="Sửa tên" aria-label="Sửa tên"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 013 3L9 17l-4 1 1-4z"/></svg></button>
            <button type="button" class="btn btn-outline btn-sm" style="color:#dc4848;margin-left:6px;" data-url="@file.Url" data-name="@file.Name" onclick="deleteLibraryFile(this)" title="Xóa khỏi thư viện" aria-label="Xóa khỏi thư viện"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/></svg></button>
        </div></td>
    </tr>
}
@if (!Model.Any()) { <tr><td colspan="5" style="text-align:center;padding:32px;">Chưa có tài nguyên. Tải tệp lên hoặc thêm video, tài liệu vào khóa học.</td></tr> }
</tbody></table></div></div>
<dialog id="library-preview" style="position:fixed;inset:0;margin:auto;padding:20px;border:0;border-radius:16px;width:850px;max-width:calc(100vw - 32px);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;"><strong id="library-video-title"></strong><button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('library-preview').close()">Đóng</button></div>
    <video id="library-video" controls playsinline style="display:block;width:100%;max-height:65vh;background:#000;"></video>
</dialog>
<dialog id="library-document-preview" style="position:fixed;inset:0;margin:auto;padding:20px;border:0;border-radius:16px;width:950px;max-width:calc(100vw - 32px);">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;"><strong id="library-document-title"></strong><div style="display:flex;gap:8px;"><a id="library-document-download" class="btn btn-outline btn-sm">Tải xuống</a><button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('library-document-preview').close()">Đóng</button></div></div>
    <p class="caption">Bản xem nhanh nội dung; tệp Word có thể không giữ nguyên định dạng.</p>
    <iframe id="library-document-frame" title="Nội dung tài liệu" sandbox style="width:100%;height:65vh;border:1px solid var(--border-color);border-radius:8px;margin-top:12px;"></iframe>
</dialog>
<style>#library-document-preview::backdrop { background:rgba(15,23,42,.6); } #library-preview::backdrop { background:rgba(15,23,42,.6); }</style>
<dialog id="library-rename" style="position:fixed;inset:0;margin:auto;padding:24px;border:1px solid var(--border-color);border-radius:16px;width:440px;max-width:calc(100vw - 32px);">
    <h3 class="h3" style="margin-bottom:16px;">Sửa tên tệp</h3>
    <form onsubmit="saveLibraryRename(event)"><label class="form-label" for="library-rename-name">Tên tệp</label><input id="library-rename-name" class="form-control" maxlength="200" required><p class="caption" style="margin-top:10px;">Phần mở rộng của tệp được giữ nguyên.</p><div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px;"><button type="button" class="btn btn-outline" onclick="document.getElementById('library-rename').close()">Hủy</button><button type="submit" class="btn btn-primary">Lưu tên</button></div></form>
</dialog>
<style>#library-rename::backdrop { background:rgba(15,23,42,.5); }</style>
@section Scripts {
<script>
function openLibraryRename(button) {
    var dialog = document.getElementById('library-rename'); dialog.dataset.url = button.dataset.url;
    document.getElementById('library-rename-name').value = button.dataset.name; dialog.showModal();
}
function saveLibraryRename(event) {
    event.preventDefault();
    var dialog = document.getElementById('library-rename'), button = event.target.querySelector('[type="submit"]');
    var data = new FormData(); data.append('url', dialog.dataset.url); data.append('name', document.getElementById('library-rename-name').value);
    data.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value); button.disabled = true;
    fetch('@Url.Action("Rename", "Resource", new { area = "Instructor" })', {method:'POST',body:data})
        .then(function(response) { if (!response.ok) throw new Error('Không thể lưu tên tệp.'); return response.json(); })
        .then(function(result) { if (!result.success) throw new Error(result.message); location.reload(); })
        .catch(function(error) { button.disabled = false; dialog.close(); instructorNotice(error.message); });
}
function deleteLibraryFile(button) {
    instructorDialog('Xóa tài nguyên', 'Xóa “' + button.dataset.name + '” khỏi thư viện?', function() {
        var data = new FormData(); data.append('url', button.dataset.url);
        data.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        button.disabled = true;
        fetch('@Url.Action("Delete", "Resource", new { area = "Instructor" })', {method:'POST', body:data})
            .then(function(response) { if (!response.ok) throw new Error('Không thể xóa tệp.'); return response.json(); })
            .then(function(result) { if (!result.success) throw new Error(result.message); location.reload(); })
            .catch(function(error) { button.disabled = false; instructorNotice(error.message); });
    });
}
function previewLibraryDocument(button) {
    document.getElementById('library-document-title').textContent = button.dataset.name;
    document.getElementById('library-document-download').href = button.dataset.download;
    document.getElementById('library-document-frame').src = button.dataset.preview;
    document.getElementById('library-document-preview').showModal();
}
document.getElementById('library-document-preview').addEventListener('close', function() { document.getElementById('library-document-frame').src = 'about:blank'; });
function filterLibrary() {
    var kind = document.getElementById('library-kind').value,
        search = document.getElementById('library-search').value.toLowerCase().trim(),
        course = document.getElementById('library-course').value,
        size = document.getElementById('library-size').value;
    document.querySelectorAll('tr[data-kind]').forEach(function(row) {
        var courses = JSON.parse(row.dataset.courses), bytes = Number(row.dataset.size), mb = bytes / 1048576;
        var matchesCourse = !course || (course === '__unused' ? courses.length === 0 : courses.includes(course));
        var matchesSize = !size || (size === 'unknown' ? bytes <= 0 : bytes > 0 &&
            (size === 'small' ? mb < 10 : size === 'medium' ? mb >= 10 && mb <= 100 : mb > 100));
        row.hidden = (!!kind && row.dataset.kind !== kind) || !row.dataset.name.includes(search) || !matchesCourse || !matchesSize;
    });

}
// Video lưu trên Cloudflare R2 ("r2:videos/...") phát qua VideoStream/Play; đường dẫn khác giữ nguyên
function videoPlayUrl(url) {
    return url && url.indexOf('r2:') === 0 ? '@Url.Content("~/VideoStream/Play")?src=' + encodeURIComponent(url) : url;
}
function previewLibraryVideo(button) {
    document.getElementById('library-video-title').textContent = button.dataset.name;
    var video = document.getElementById('library-video'); video.src = videoPlayUrl(button.dataset.url);
    document.getElementById('library-preview').showModal(); video.play().catch(function() {});
}
document.getElementById('library-preview').addEventListener('close', function() { var video = document.getElementById('library-video'); video.pause(); video.removeAttribute('src'); video.load(); });
document.getElementById('library-upload').addEventListener('change', function() {
    var file = this.files[0]; if (!file) return;
    var ext = file.name.split('.').pop().toLowerCase(), kind = ['mp4','webm','mov','mkv','m4v','ogv'].includes(ext) ? 'video' : 'document';
    var data = new FormData(); data.append('file', file); data.append('kind', kind); data.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
    var progress = document.getElementById('library-progress'), xhr = new XMLHttpRequest();
    progress.textContent = 'Đang tải lên...';
    xhr.open('POST', '@Url.Action("UploadLessonFile", "Course", new { area = "Instructor" })');
    xhr.upload.onprogress = function(event) { if (event.lengthComputable) progress.textContent = 'Đang tải: ' + Math.round(event.loaded / event.total * 100) + '%'; };
    xhr.onload = function() { try { var result = JSON.parse(xhr.responseText); if (!result.success) throw new Error(result.message); location.reload(); } catch (error) { progress.textContent = ''; instructorNotice(error.message); } };
    xhr.onerror = function() { progress.textContent = ''; instructorNotice('Không thể tải tệp. Vui lòng thử lại.'); }; xhr.send(data);
});
</script>
}
