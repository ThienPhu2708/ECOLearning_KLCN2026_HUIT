@{
    var discussionPage = string.Equals(Convert.ToString(ViewContext.RouteData.Values["controller"]), "Message", StringComparison.OrdinalIgnoreCase);
}
@if (!discussionPage)
{
<div id="teacher-chat-widget">
    <a id="teacher-chat-launcher" class="teacher-chat-launcher" href="@Url.Action("Index", "Message", new { area = "Instructor" })" aria-label="Mở thảo luận bài học" title="Thảo luận bài học" style="text-decoration:none">
        <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>
    </a>
</div>
<style>
    .teacher-chat-launcher { position:fixed; right:24px; bottom:var(--teacher-chat-bottom,24px); z-index:1000; width:60px; height:60px; border:0; border-radius:50%; background:#4F46E5; color:white; box-shadow:0 6px 24px #4F46E54D; font-size:26px; display:grid; place-items:center; }
    .teacher-chat-launcher:hover { background:#4338CA; color:white; }
    .teacher-chat-launcher:focus-visible { outline:3px solid #A5B4FC; outline-offset:2px; }
    @@media(max-width:540px) { .teacher-chat-launcher { right:16px; } }
</style>
<script>
(function () {
    var root = document.getElementById('teacher-chat-widget');
    function avoidActionBar() {
        var bottom = window.innerWidth <= 540 ? 16 : 24;
        document.querySelectorAll('.step-footer').forEach(function (bar) {
            if (!bar.getClientRects().length) return;
            var rect = bar.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) bottom = Math.max(bottom, window.innerHeight - rect.top + 12);
        });
        root.style.setProperty('--teacher-chat-bottom', bottom + 'px');
    }
    window.addEventListener('resize', avoidActionBar);
    if (window.ResizeObserver) {
        var barObserver = new ResizeObserver(avoidActionBar);
        document.querySelectorAll('.step-footer').forEach(function (bar) { barObserver.observe(bar); });
    }
    avoidActionBar();
})();
</script>
}
