<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewBag.Title | E-Learning Giáo Viên</title>
        <link rel="stylesheet" href="~/assets/css/variables.css">
        <link rel="stylesheet" href="~/assets/css/base.css">
        <link rel="stylesheet" href="~/assets/css/components.css?v=2">
        <link rel="stylesheet" href="~/assets/css/dashboard-tables.css?v=4">
        <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/assets/css/staff-ui.css?v=1.4">
    <style>
        .instructor-dashboard { overflow-x: clip; }
        .instructor-dashboard .dashboard-layout { width: 100%;min-width: 0; }
        .instructor-dashboard .dashboard-main { flex: 1 1 0%;width: calc(100% - var(--sidebar-width));max-width: calc(100% - var(--sidebar-width)); }
        .instructor-dashboard .dashboard-sidebar { z-index: 50; }
        .dashboard-topbar { height: var(--header-height); padding: 0 32px; margin-bottom: 0; }
        @@media(max-width:992px) {
            .instructor-dashboard .dashboard-main { width:100%;max-width:100%; }
        }
    </style>
    </head>
    <body class="staff-ui staff-flush instructor-dashboard">
        <button type="button" id="teacher-menu-backdrop" aria-label="Đóng menu điều hướng" hidden onclick="toggleTeacherMenu(false)"></button>
        <div class="dashboard-layout">
            <!-- SIDEBAR -->
            <aside class="dashboard-sidebar" id="teacher-sidebar">
                <div class="sidebar-logo">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Instructor" })" class="brand-logo">
                        <div class="logo-icon" style="width: 34px; height: 34px; background: #0D9488;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            </svg>
                        </div>
                        <span class="logo-text" style="font-size: 18px;">Giáo Viên<span>.</span></span>
                    </a>
                </div>

                @{
                string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
                string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                bool quizResults = currentCtrl == "Quiz" && (currentAction == "Results" || currentAction == "History" || currentAction == "Review");
            }

            <nav class="sidebar-menu">
                <div class="sidebar-section">Tổng quan</div>
                <a href="@Url.Action("Index", "Dashboard", new { area = "Instructor" })" class="sidebar-item @(currentCtrl == "Dashboard" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    Dashboard tổng quan
                </a>
                <div class="sidebar-section">Giảng dạy</div>
                <a href="@Url.Action("Index", "Course", new { area = "Instructor" })" class="sidebar-item @((currentCtrl == "Course" || currentCtrl == "Curriculum") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Quản lý khóa học
                </a>
                <a href="@Url.Action("Index", "Specialty", new { area = "Instructor" })" class="sidebar-item @(currentCtrl == "Specialty" ? "active" : "")"><i class="bi bi-patch-check" aria-hidden="true"></i> Chuyên môn giảng dạy</a>
                <a href="@Url.Action("Index", "Resource", new { area = "Instructor" })" class="sidebar-item @(currentCtrl == "Resource" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                    Thư viện tài nguyên
                </a>
                @{var menuQuizCounts = ViewBag.MenuQuizCounts as ECOLearning.Services.QuizTeacherNotificationCounts ?? new ECOLearning.Services.QuizTeacherNotificationCounts();int menuQuizTotal = menuQuizCounts.Appeals + menuQuizCounts.Reports;}
                <a id="teacher-quiz-nav" href="@Url.Action("Index", "Quiz", new { area = "Instructor" })" data-count-url="@Url.Action("NotificationCounts", "Quiz", new { area = "Instructor" })" class="sidebar-item @(currentCtrl == "Quiz" && !quizResults ? "active" : "")"><i class="bi bi-question-circle" aria-hidden="true"></i><span class="teacher-menu-label">Ngân hàng câu hỏi &amp; Quiz</span><span id="teacher-quiz-review-badge" class="teacher-review-badge" hidden="@(menuQuizTotal == 0)" title="@menuQuizCounts.Appeals phúc khảo/phản hồi · @menuQuizCounts.Reports báo lỗi cần xử lý" aria-label="@menuQuizTotal yêu cầu quiz cần xử lý">@(menuQuizTotal > 99 ? "99+" : menuQuizTotal.ToString())</span></a>
                <div class="sidebar-section">Học viên</div>
                <a id="teacher-student-nav" href="@(ViewBag.StudentReviewCount != null && (int)ViewBag.StudentReviewCount > 0 ? Url.Action("NeedsReview", "Student", new { area = "Instructor" }) : Url.Action("Index", "Student", new { area = "Instructor" }))" data-review-url="@Url.Action("NeedsReview", "Student", new { area = "Instructor" })" data-students-url="@Url.Action("Index", "Student", new { area = "Instructor" })" data-count-url="@Url.Action("ReviewNotificationCount", "Student", new { area = "Instructor" })" class="sidebar-item @(currentCtrl == "Student" || quizResults ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span>Quản lý học viên</span>
                    <span id="teacher-student-review-badge" class="teacher-review-badge" hidden="@(ViewBag.StudentReviewCount == null || (int)ViewBag.StudentReviewCount == 0)" title="Lượt thi mới cần xem xét" aria-label="@ViewBag.StudentReviewCount lượt thi mới cần xem xét">@(ViewBag.StudentReviewCount != null && (int)ViewBag.StudentReviewCount > 99 ? "99+" : Convert.ToString(ViewBag.StudentReviewCount))</span>
                </a>
                <a href="@Url.Action("Index", "Analytics", new { area = "Instructor" })" class="sidebar-item @(currentCtrl == "Analytics" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    Báo cáo thống kê
                </a>
                <div class="sidebar-section">Thu nhập</div>
                <a href="@Url.Action("Index", "Payout", new { area = "Instructor" })" class="sidebar-item @(currentCtrl == "Payout" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                    Nhận thanh toán
                </a>
            </nav>

            <div class="sidebar-footer">
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline btn-sm" style="width: 100%; margin-bottom: 10px;">Quay lại trang web</a>
                <button type="button" class="btn btn-secondary btn-sm" style="width: 100%; cursor: pointer;" onclick="confirmInstructorLogout()">Đăng xuất</button>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main" style="padding: 0;">
            <!-- TOP NAVIGATION BAR -->
            <header class="dashboard-topbar">
                <button type="button" id="teacher-menu-toggle" class="btn btn-outline btn-sm" aria-label="Mở menu điều hướng" aria-controls="teacher-sidebar" aria-expanded="false" onclick="toggleTeacherMenu(true)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
                @if (ViewBag.HideBreadcrumb != true)
                {
                <nav class="breadcrumb-nav">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Instructor" })">Giáo viên</a>
                    @if (ViewBag.ShowCourseBreadcrumb == true || string.Equals(ViewContext.RouteData.Values["controller"] as string, "Curriculum", StringComparison.OrdinalIgnoreCase) || (string.Equals(ViewContext.RouteData.Values["controller"] as string, "Course", StringComparison.OrdinalIgnoreCase) && (string.Equals(ViewContext.RouteData.Values["action"] as string, "Create", StringComparison.OrdinalIgnoreCase) || string.Equals(ViewContext.RouteData.Values["action"] as string, "Edit", StringComparison.OrdinalIgnoreCase))))
                    {
                        <span class="separator">/</span>
                        <a href="@Url.Action("Index", "Course", new { area = "Instructor" })">Quản lí khóa học</a>
                    }
                    @if (ViewBag.BreadcrumbCourseName != null && ViewBag.BreadcrumbCourseId != null)
                    {
                        <span class="separator">/</span>
                        <a href="@Url.Action("Details", "Course", new { area = "Instructor", id = (string)ViewBag.BreadcrumbCourseId })">@ViewBag.BreadcrumbCourseName</a>
                    }
                    @if (ViewBag.ShowQuestionBankBreadcrumb == true)
                    {
                        <span class="separator">/</span>
                        <a href="@Url.Action("Index", "Quiz", new { area = "Instructor", courseId = ViewBag.QuestionBankCourseId })">Ngân hàng câu hỏi</a>
                    }
                    @if (ViewBag.ShowStudentBreadcrumb == true)
                    {
                        <span class="separator">/</span>
                        <a href="@Url.Action("Index", "Student", new { area = "Instructor", courseId = ViewBag.CourseId })">Quản lý học viên</a>
                    }
                    @if (ViewBag.BreadcrumbCurrent != null)
                    {
                        <span class="separator">/</span>
                        <span class="current">@ViewBag.BreadcrumbCurrent</span>
                    }
                </nav>
                }
            </header>

            <div style="padding: 32px;">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- MODAL XÁC NHẬN ĐĂNG XUẤT GIÁO VIÊN -->
    <div class="modal-overlay" id="instructor-logout-modal">
        <div class="modal-container" style="max-width: 420px; text-align: center; padding: 32px 24px; border-radius: 20px; background: #FFFFFF;">
            <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(239, 68, 68, 0.1); color: #EF4444; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </div>
            <h3 class="h3" style="margin-bottom: 8px;">Xác nhận đăng xuất</h3>
            <p class="body-2" style="color: var(--text-secondary); margin-bottom: 24px; font-size: 14px; line-height: 1.5;">
                Bạn có chắc chắn muốn kết thúc phiên làm việc Giảng viên và quay về Trang chủ không?
            </p>
            <div style="display: flex; gap: 12px;">
                <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="closeInstructorLogoutModal()">Hủy</button>
                <a href="@Url.Action("Logout", "Account", new { area = "" })" class="btn btn-danger" style="flex: 1; background: #EF4444; border-color: #EF4444; color: #ffffff; text-decoration: none; display: flex; align-items: center; justify-content: center; font-weight: 600;">Đăng xuất</a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/assets/js/charts.js"></script>
    <script src="~/assets/js/admin-charts.js?v=2"></script>
    <script src="~/assets/js/app.js"></script>
    <script src="~/assets/js/table-pagination.js?v=2"></script>
    <script>
        function confirmInstructorLogout() {
        const modal = document.getElementById('instructor-logout-modal');
        if (modal) {
        if (window.openModal) {
        openModal('instructor-logout-modal');
    }
    else
    {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }
}
else
{
    instructorDialog('Đăng xuất', 'Bạn có chắc chắn muốn đăng xuất?', function() { window.location.href = '@Url.Action("Logout", "Account", new { area = "" })'; });
}
}

function closeInstructorLogoutModal() {
const modal = document.getElementById('instructor-logout-modal');
if (modal) {
if (window.closeModal) {
closeModal('instructor-logout-modal');
}
else
{
    modal.classList.remove('active');
    document.body.style.overflow = '';
}
}
}
</script>
<dialog id="instructor-action-dialog" aria-labelledby="instructor-action-title">
    <div style="padding:24px;">
        <h3 class="h3" id="instructor-action-title" style="margin:0 0 12px;"></h3>
        <p id="instructor-action-message" style="font-size:14px;line-height:1.6;color:var(--text-secondary);margin:0;"></p>
        <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;">
            <button type="button" id="instructor-action-cancel" class="btn btn-secondary" onclick="document.getElementById('instructor-action-dialog').close()">Hủy</button>
            <button type="button" id="instructor-action-accept" class="btn btn-primary">Xác nhận</button>
        </div>
    </div>
</dialog>
<style>
#instructor-action-dialog { position:fixed;inset:0;margin:auto;padding:0;width:440px;max-width:calc(100vw - 32px);max-height:calc(100vh - 32px);overflow:auto;border:1px solid var(--border-color);border-radius:18px;background:var(--bg-surface);box-shadow:0 24px 64px rgba(15,23,42,.2); }
#instructor-action-dialog::backdrop { background:rgba(15,23,42,.45); }
</style>
<script>
function instructorDialog(title, message, action, acceptText, danger) {
    var dialog = document.getElementById('instructor-action-dialog');
    document.getElementById('instructor-action-title').textContent = title;
    document.getElementById('instructor-action-message').textContent = message;
    document.getElementById('instructor-action-cancel').hidden = !action;
    var accept = document.getElementById('instructor-action-accept');
    accept.textContent = acceptText || (action ? 'Xác nhận' : 'Đóng');
    accept.className = 'btn ' + (danger ? 'btn-danger' : 'btn-primary');
    accept.onclick = function() { dialog.close(); if (action) action(); };
    dialog.showModal();
}
function instructorNotice(message) { instructorDialog('Thông báo', message); }
function instructorConfirmSubmit(button, message) {
    var form = button.form;
    if (!form) return false;
    instructorDialog('Xác nhận thao tác', message, function() { form.requestSubmit(button); });
    return false;
}
// Xác nhận thao tác khó hoàn tác (tạm ngưng, xóa khóa học): tiêu đề, nội dung và nút đọc từ data-confirm-* của nút bấm
function instructorConfirmAction(button) {
    var form = button.form;
    if (!form) return false;
    instructorDialog(button.getAttribute('data-confirm-title'), button.getAttribute('data-confirm-message'),
        function() { form.requestSubmit(button); }, button.getAttribute('data-confirm-accept'), button.hasAttribute('data-confirm-danger'));
    return false;
}
</script>

<style>
.teacher-select { position:relative;display:inline-block;vertical-align:middle;min-width:0; }
.teacher-select > select { position:absolute !important;inset:0;width:100% !important;height:100%;opacity:0;pointer-events:none; }
.teacher-select-button { width:100%;min-height:38px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 16px;background:#fff;border:1px solid var(--border-color);border-radius:12px;color:var(--text-heading);font:inherit;font-size:14px;text-align:left;cursor:pointer; }
.teacher-select-button span { overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.teacher-select-button:focus-visible,.teacher-select-button[aria-expanded="true"] { outline:2px solid #c7c9ff;outline-offset:2px;border-color:var(--primary); }
.teacher-select-button:disabled { opacity:.55;cursor:default; }
.teacher-select-menu { position:fixed;z-index:10000;padding:6px;background:#fff;border:1px solid var(--border-color);border-radius:12px;box-shadow:0 8px 24px rgba(15,23,42,.12);max-height:280px;overflow:auto; }
.teacher-select-option { display:block;width:100%;border:0;border-radius:7px;padding:11px 10px;background:transparent;color:var(--text-heading);font:inherit;font-size:13px;text-align:left;cursor:pointer; }
.teacher-select-option:hover,.teacher-select-option:focus-visible { background:#f3f4fc;outline:none; }
.teacher-select-option[aria-selected="true"] { background:#eef0ff;color:var(--primary);font-weight:600; }
.teacher-select-option:disabled { opacity:.45;cursor:default; }
</style>
<script>
(function() {
    var opened = null;
    function closeMenu() { if (opened) { opened.menu.remove(); opened.button.setAttribute('aria-expanded', 'false'); opened = null; } }
    function enhance(select) {
        if (select.multiple || select.size > 1 || select.dataset.teacherSelect) return;
        select.dataset.teacherSelect = 'true';
        var wrapper = document.createElement('span'); wrapper.className = 'teacher-select';
        wrapper.style.width = select.style.width || '100%'; wrapper.style.maxWidth = select.style.maxWidth || '';
        select.parentNode.insertBefore(wrapper, select); wrapper.appendChild(select);
        var button = document.createElement('button'); button.type = 'button'; button.className = 'teacher-select-button';
        button.setAttribute('aria-haspopup', 'listbox'); button.setAttribute('aria-expanded', 'false');
        button.innerHTML = '<span></span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
        wrapper.appendChild(button);
        function sync() { button.firstChild.textContent = select.selectedIndex >= 0 ? select.options[select.selectedIndex].text : ''; button.disabled = select.disabled; button.setAttribute('aria-label', select.getAttribute('aria-label') || button.firstChild.textContent); }
        select.addEventListener('change', sync); select.addEventListener('focus', function() { button.focus(); });
        new MutationObserver(sync).observe(select, {childList:true,subtree:true,attributes:true});
        button.addEventListener('click', function() {
            var wasOpen = opened && opened.button === button; closeMenu(); if (wasOpen) return;
            var menu = document.createElement('div'); menu.className = 'teacher-select-menu'; menu.setAttribute('role', 'listbox');
            Array.from(select.options).forEach(function(option, index) {
                var item = document.createElement('button'); item.type = 'button'; item.className = 'teacher-select-option'; item.textContent = option.text; item.disabled = option.disabled; item.setAttribute('role', 'option'); item.setAttribute('aria-selected', index === select.selectedIndex ? 'true' : 'false');
                item.addEventListener('click', function() { select.selectedIndex = index; sync(); closeMenu(); button.focus(); select.dispatchEvent(new Event('change', {bubbles:true})); }); menu.appendChild(item);
            });
            (select.closest('dialog') || document.body).appendChild(menu);
            var rect = button.getBoundingClientRect(); menu.style.width = rect.width + 'px'; menu.style.left = Math.min(rect.left, window.innerWidth - rect.width - 8) + 'px';
            menu.style.top = (rect.bottom + 5) + 'px';
            if (rect.bottom + 5 + menu.offsetHeight > window.innerHeight) menu.style.top = Math.max(8, rect.top - menu.offsetHeight - 5) + 'px';
            button.setAttribute('aria-expanded', 'true'); opened = {button:button,menu:menu};
            var active = menu.querySelector('[aria-selected="true"]') || menu.querySelector('button:not(:disabled)'); if (active) active.focus();
            menu.addEventListener('keydown', function(event) {
                var items = Array.from(menu.querySelectorAll('button:not(:disabled)')), index = items.indexOf(document.activeElement);
                if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); items[(index + (event.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length].focus(); }
                if (event.key === 'Escape') { event.preventDefault(); closeMenu(); button.focus(); }
                if (event.key === 'Tab') closeMenu();
            });
        }); sync();
    }
    function scan() { document.querySelectorAll('select:not([data-teacher-select])').forEach(enhance); }
    document.addEventListener('click', function(event) { if (opened && !opened.menu.contains(event.target) && !opened.button.contains(event.target)) closeMenu(); });
    window.addEventListener('resize', closeMenu); document.addEventListener('scroll', function(event) { if (opened && !opened.menu.contains(event.target)) closeMenu(); }, true);
    document.addEventListener('reset', function() { setTimeout(function() { document.querySelectorAll('.teacher-select select').forEach(function(select) { select.dispatchEvent(new Event('change')); }); }, 0); });
    scan(); new MutationObserver(scan).observe(document.body, {childList:true,subtree:true});
})();
</script>

<style>
#teacher-menu-toggle { display:none; }
#teacher-menu-backdrop { position:fixed;inset:0;border:0;background:rgba(15,23,42,.4);z-index:100; }
#teacher-menu-backdrop[hidden] { display:none; }
@@media(max-width:992px) {
    #teacher-menu-toggle { display:inline-flex;flex-shrink:0;width:40px;height:40px;padding:0; }
    .dashboard-topbar { gap:14px;padding:0 20px;justify-content:flex-start; }
    .breadcrumb-nav { min-width:0;flex-wrap:wrap; }
    #teacher-sidebar { z-index:101;max-width:calc(100vw - 56px); }
    #teacher-sidebar .sidebar-menu { overflow-y:auto;min-height:0; }
}
</style>
<script>
var teacherMenuPreviousFocus;
function toggleTeacherMenu(open) {
    var sidebar = document.getElementById('teacher-sidebar');
    sidebar.classList.toggle('active', open);
    document.getElementById('teacher-menu-backdrop').hidden = !open;
    document.getElementById('teacher-menu-toggle').setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) { teacherMenuPreviousFocus = document.activeElement; sidebar.querySelector('a').focus(); }
    else if (teacherMenuPreviousFocus) { teacherMenuPreviousFocus.focus(); teacherMenuPreviousFocus = null; }
}
document.addEventListener('keydown', function(event) { if (event.key === 'Escape' && document.getElementById('teacher-sidebar').classList.contains('active')) toggleTeacherMenu(false); });
window.addEventListener('resize', function() { if (window.innerWidth > 992 && document.getElementById('teacher-sidebar').classList.contains('active')) toggleTeacherMenu(false); });
</script>
@RenderSection("Scripts", required: false)
<style>
.teacher-menu-label{min-width:0;flex:1;line-height:1.55}.teacher-review-badge{display:inline-flex;align-items:center;justify-content:center;gap:4px;margin-left:auto;min-width:22px;padding:3px 5px;border-radius:7px;background:#fff0f0;color:#c46d6d;font-size:10px;font-weight:700;line-height:1.4;flex-shrink:0}.teacher-review-badge::before{content:"";width:5px;height:5px;border-radius:50%;background:#ce7474}.teacher-review-badge[hidden]{display:none!important}
</style>
<script>
(function () {
    const link = document.getElementById('teacher-student-nav');
    const badge = document.getElementById('teacher-student-review-badge');
    if (!link || !badge) return;
    let busy = false;
    async function refresh() {
        if (busy || document.hidden) return;
        busy = true;
        try {
            const response = await fetch(link.dataset.countUrl, { credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json' } });
            if (!response.ok) return;
            const data = await response.json();
            if (!Number.isInteger(data.count) || data.count < 0) return;
            badge.hidden = data.count === 0; badge.textContent = data.count > 99 ? '99+' : String(data.count);
            const label = data.count + ' lượt thi mới cần xem xét'; badge.title = label; badge.setAttribute('aria-label', label);
            link.href = data.count > 0 ? link.dataset.reviewUrl : link.dataset.studentsUrl;
        } catch (_) { /* Keep the last known count while offline. */ }
        finally { busy = false; }
    }
    setInterval(refresh, 30000);
    document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
    window.addEventListener('focus', refresh);
})();
</script>

<script>
(function () {
    const link = document.getElementById('teacher-quiz-nav');
    const badge = document.getElementById('teacher-quiz-review-badge');
    if (!link || !badge) return;
    let busy = false;
    async function refresh() {
        if (busy || document.hidden) return;
        busy = true;
        try {
            const response = await fetch(link.dataset.countUrl, { credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json' } });
            if (!response.ok) return;
            const data = await response.json();
            if (!Number.isInteger(data.Appeals) || !Number.isInteger(data.Reports) || data.Appeals < 0 || data.Reports < 0) return;
            const count = data.Appeals + data.Reports;
            badge.hidden = count === 0;
            badge.textContent = count > 99 ? '99+' : String(count);
            badge.title = data.Appeals + ' phúc khảo/phản hồi · ' + data.Reports + ' báo lỗi cần xử lý';
            badge.setAttribute('aria-label', count + ' yêu cầu quiz cần xử lý');
        } catch (_) { /* Keep the last known count while offline. */ }
        finally { busy = false; }
    }
    setInterval(refresh, 30000);
    document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
    window.addEventListener('focus', refresh);
})();
</script>
</body>
</html>
