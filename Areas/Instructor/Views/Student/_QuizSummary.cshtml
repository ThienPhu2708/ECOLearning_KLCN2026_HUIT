@model List<ECOLearning.ViewModels.QuizStudentRow>
@{
    var tested = Model.Where(r => r.BestScore.HasValue).ToList();
    int passed = tested.Count(r => r.Passed);
}
<style>
.student-summary{margin:0 0 24px}.student-summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.student-summary-card{padding:20px 22px;background:var(--bg-surface);border:1px solid var(--border-color);border-radius:16px;box-shadow:var(--shadow-card);min-width:0}.student-summary-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.student-summary-top h2{font-size:13px;font-weight:600;color:var(--text-secondary);margin:0;line-height:1.6}.student-summary-icon{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;flex-shrink:0;background:#eef0ff;color:#5548dc;font-size:18px}.student-summary-icon.is-teal{background:#eaf7f4;color:#398f81}.student-summary-icon.is-green{background:#edf8ee;color:#4a9260}.student-summary-icon.is-amber{background:#fff5e5;color:#b38334}.student-summary-value{display:block;font-size:30px;font-weight:700;letter-spacing:-.7px;color:var(--text-heading);line-height:1.3;margin:14px 0 7px}.student-summary-value small{font-size:14px;font-weight:500;letter-spacing:0;color:var(--text-secondary);margin-left:3px}.student-summary-card>p{font-size:12px;color:var(--text-secondary);line-height:1.7;margin:0}.student-score-distribution{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:16px}.student-score-range{border:1px solid var(--border-color);border-radius:12px;background:var(--bg-surface);padding:16px 20px}.student-score-range>div{display:flex;justify-content:space-between;gap:12px;font-size:13px;color:var(--text-secondary);margin-bottom:12px}.student-score-range strong{color:var(--text-heading)}.student-score-range progress{display:block;width:100%;height:6px;border:0;border-radius:8px;overflow:hidden;accent-color:var(--primary)}.student-score-range progress::-webkit-progress-bar{background:var(--bg-canvas);border-radius:8px}.student-score-range progress::-webkit-progress-value{background:var(--primary);border-radius:8px}.student-score-range progress::-moz-progress-bar{background:var(--primary);border-radius:8px}.student-score-extremes{display:flex;gap:20px;flex-wrap:wrap;font-size:12px;color:var(--text-secondary);margin:18px 0 0}
@@media(max-width:1200px){.student-summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@media(max-width:576px){
    .student-summary-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .student-score-distribution{grid-template-columns:1fr}
    .student-summary-card{padding:14px}
    .student-summary-top h2{font-size:12px;min-height:38px}
    .student-summary-icon{display:none}
    .student-summary-value{font-size:24px;margin:8px 0 6px;white-space:nowrap}
    .student-summary-value small{font-size:12px}
    .student-summary-card>p{font-size:11px;line-height:1.6}
}
@@media(max-width:340px){.student-summary-grid{grid-template-columns:1fr}.student-summary-top h2{min-height:0}}
</style>
<section class="student-summary" aria-label="Thống kê kết quả học viên">
    <div class="student-summary-grid">
        <section class="student-summary-card"><div class="student-summary-top"><h2>Tổng lượt ghi danh</h2><span class="student-summary-icon"><i class="bi bi-people" aria-hidden="true"></i></span></div><strong class="student-summary-value">@Model.Count</strong><p>Theo bộ lọc hiện tại</p></section>
        <section class="student-summary-card"><div class="student-summary-top"><h2>Đã có điểm quiz</h2><span class="student-summary-icon is-teal"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span></div><strong class="student-summary-value">@tested.Count</strong><p>Lượt ghi danh đã có kết quả thi</p></section>
        <section class="student-summary-card"><div class="student-summary-top"><h2>Tỷ lệ đạt quiz</h2><span class="student-summary-icon is-green"><i class="bi bi-check2-circle" aria-hidden="true"></i></span></div><strong class="student-summary-value">@(tested.Count == 0 ? "—" : (100.0 * passed / tested.Count).ToString("0.0"))@if (tested.Count > 0) {<small>%</small>}</strong><p>@(tested.Count == 0 ? "Chưa có kết quả thi" : passed + "/" + tested.Count + " lượt ghi danh có điểm đã đạt")</p></section>
        <section class="student-summary-card"><div class="student-summary-top"><h2>Điểm trung bình /10</h2><span class="student-summary-icon is-amber"><i class="bi bi-bar-chart" aria-hidden="true"></i></span></div><strong class="student-summary-value">@(tested.Count == 0 ? "—" : tested.Average(r => r.BestScore.Value).ToString("0.00"))<small>/10</small></strong><p>Tính theo điểm cao nhất mỗi ghi danh</p></section>
    </div>
</section>
