@model ECOLearning.Areas.Marketing.Models.MarketingReportViewModel
@{
    ViewBag.Title = "Báo cáo Marketing";
    var chuongTrinh = ViewBag.ChuongTrinh as List<ECOLearning.ViewModels.ChuongTrinhKhuyenMai> ?? new List<ECOLearning.ViewModels.ChuongTrinhKhuyenMai>();
    var chienDich = ViewBag.ChienDich as List<ECOLearning.ViewModels.ChienDichItem> ?? new List<ECOLearning.ViewModels.ChienDichItem>();
    string tu = Model.TuNgay.ToString("yyyy-MM-dd");
    string den = Model.DenNgay.ToString("yyyy-MM-dd");
    int maxChart = Model.ChartData.Count > 0 ? Math.Max(1, Model.ChartData.Max()) : 1;
}

<div class="mk-page-head">
    <div>
        <h1 class="h2">Báo cáo hiệu quả Marketing</h1>
        <p>Chỉ tính đơn hàng đã thanh toán có dùng ưu đãi trong khoảng ngày đã chọn (theo thời điểm dùng mã).</p>
    </div>
    @if (Model.ThongBaoLoi == null)
    {
        <a href="@Url.Action("ExportCsv", "CampaignReport", new { tuNgay = tu, denNgay = den, khuyenMai = Model.MaKhuyenMai, chienDich = Model.MaChienDich })" class="btn btn-outline"><i class="bi bi-download me-1"></i> Xuất CSV</a>
    }
</div>

@Html.Partial("_Flash")

<form method="get" action="@Url.Action("Index", "CampaignReport")" class="card mk-filter">
    <div class="mk-field">
        <label for="tuNgay">Từ ngày</label>
        <input type="date" id="tuNgay" name="tuNgay" class="form-control" value="@tu" required />
    </div>
    <div class="mk-field">
        <label for="denNgay">Đến ngày</label>
        <input type="date" id="denNgay" name="denNgay" class="form-control" value="@den" required />
    </div>
    <div class="mk-field" style="min-width: 220px;">
        <label for="khuyenMai">Chương trình</label>
        <select id="khuyenMai" name="khuyenMai" class="form-control">
            <option value="">Tất cả chương trình</option>
            @foreach (var p in chuongTrinh)
            {
                <option value="@p.MaKhuyenMai" @(p.MaKhuyenMai == Model.MaKhuyenMai ? "selected" : "")>@p.TenKhuyenMai (@p.MaCode)</option>
            }
        </select>
    </div>
    <div class="mk-field" style="min-width: 200px;">
        <label for="chienDich">Chiến dịch</label>
        <select id="chienDich" name="chienDich" class="form-control">
            <option value="">Tất cả chiến dịch</option>
            @foreach (var c in chienDich)
            {
                <option value="@c.MaChienDich" @(c.MaChienDich == Model.MaChienDich ? "selected" : "")>@c.TenChienDich</option>
            }
        </select>
    </div>
    <button type="submit" class="btn mk-btn-accent btn-sm" style="height: 38px;">Xem báo cáo</button>
</form>

@if (Model.ThongBaoLoi != null)
{
    <div class="mk-flash mk-flash-error" role="alert"><span><i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.ThongBaoLoi</span></div>
}
else
{
    <div class="mk-stats">
        <div class="card mk-stat"><div class="mk-stat-label">Chương trình trong phạm vi</div><div class="mk-stat-value">@Model.SoChuongTrinh</div></div>
        <div class="card mk-stat"><div class="mk-stat-label">Lượt dùng ưu đãi</div><div class="mk-stat-value">@Model.SoLuotDung</div><div class="mk-stat-note">= @Model.SoDonHang đơn hàng thành công</div></div>
        <div class="card mk-stat"><div class="mk-stat-label">Doanh thu trước giảm</div><div class="mk-stat-value">@Model.DoanhThuTruocGiam.ToString("N0") đ</div></div>
        <div class="card mk-stat"><div class="mk-stat-label">Tổng tiền ưu đãi</div><div class="mk-stat-value" style="color: #E11D48;">@Model.TienGiam.ToString("N0") đ</div></div>
        <div class="card mk-stat"><div class="mk-stat-label">Doanh thu sau giảm</div><div class="mk-stat-value">@Model.DoanhThuSauGiam.ToString("N0") đ</div></div>
    </div>

    <div class="card mk-section">
        <h2>Lượt dùng ưu đãi @(Model.ChartTheoThang ? "theo tháng" : "theo ngày")</h2>
        @if (Model.SoLuotDung == 0)
        {
            <p class="mk-muted" style="margin: 0;">Không có lượt dùng ưu đãi nào trong khoảng ngày đã chọn.</p>
        }
        else
        {
            <div class="mk-bars" role="img" aria-label="Biểu đồ lượt dùng ưu đãi">
                @for (int i = 0; i < Model.ChartData.Count; i++)
                {
                    int v = Model.ChartData[i];
                    <div class="mk-bar" style="height: @(v == 0 ? 0 : Math.Max(4, v * 100 / maxChart))%;" title="@Model.ChartLabels[i]: @v lượt"></div>
                }
            </div>
            <div class="mk-bar-labels">
                <span>@Model.ChartLabels.First()</span>
                <span>@Model.ChartLabels.Last()</span>
            </div>
        }
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        <div style="padding: 18px 22px 6px;"><h2 style="font-size: 15px; font-weight: 800; margin: 0;">Kết quả theo chương trình</h2></div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Chương trình</th>
                        <th>Ưu đãi</th>
                        <th>Trạng thái</th>
                        <th style="text-align: right;">Lượt dùng</th>
                        <th style="text-align: right;">Trước giảm</th>
                        <th style="text-align: right;">Tiền giảm</th>
                        <th style="text-align: right;">Sau giảm</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td><a href="@Url.Action("Details", "Promotion", new { id = r.MaKhuyenMai })" style="font-weight: 700;">@r.TenKhuyenMai</a> <span class="mk-code" style="font-size: 11.5px;">@r.MaCode</span>
                                @if (!string.IsNullOrEmpty(r.TenChienDich)) { <div class="mk-muted"><i class="bi bi-megaphone"></i> @r.TenChienDich</div> }
                            </td>
                            <td>@r.MoTaUuDai</td>
                            <td>@r.TrangThai</td>
                            <td style="text-align: right;">@r.SoLuotDung</td>
                            <td style="text-align: right;">@r.DoanhThuTruocGiam.ToString("N0") đ</td>
                            <td style="text-align: right; color: #E11D48;">@r.TienGiam.ToString("N0") đ</td>
                            <td style="text-align: right; font-weight: 700;">@r.DoanhThuSauGiam.ToString("N0") đ</td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="7" class="mk-empty"><i class="bi bi-bar-chart"></i>Không có chương trình nào trong phạm vi lọc.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
