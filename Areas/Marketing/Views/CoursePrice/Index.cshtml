@model List<ECOLearning.Areas.Marketing.Controllers.CoursePriceRow>
@{
    ViewBag.Title = "Giá khuyến mãi khóa học";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string loc = ViewBag.Loc as string;
    string returnUrl = Request.RawUrl;
}

<div class="mk-page-head">
    <div>
        <h1 class="h2">Giá khuyến mãi khóa học</h1>
        <p>Giáo viên chỉ nhập giá gốc. Marketing đặt giá giảm cho từng khóa tại đây; coupon áp dụng tiếp trên giá bán hiện tại.</p>
    </div>
</div>

@Html.Partial("_Flash")

<form method="get" action="@Url.Action("Index", "CoursePrice")" class="card mk-filter">
    <div class="mk-field" style="flex: 1; min-width: 220px;">
        <label for="search">Tên hoặc mã khóa học</label>
        <input type="text" id="search" name="search" class="form-control" value="@currentSearch" />
    </div>
    <div class="mk-field">
        <label for="loc">Hiển thị</label>
        <select id="loc" name="loc" class="form-control">
            <option value="" @(string.IsNullOrEmpty(loc) ? "selected" : "")>Tất cả khóa có giá</option>
            <option value="dangGiam" @(loc == "dangGiam" ? "selected" : "")>Đang giảm giá</option>
            <option value="khongHopLe" @(loc == "khongHopLe" ? "selected" : "")>Giá giảm không hợp lệ</option>
        </select>
    </div>
    <button type="submit" class="btn btn-secondary btn-sm" style="height: 38px;">Lọc</button>
</form>

<div class="card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Khóa học</th>
                    <th>Trạng thái</th>
                    <th style="text-align: right;">Giá gốc</th>
                    <th style="text-align: right;">Đang bán</th>
                    <th style="width: 330px;">Đặt giá khuyến mãi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.TenKhoaHoc</strong><div class="mk-muted">@c.TenDanhMuc · @c.GiaoVien</div></td>
                        <td><span class="mk-muted" style="font-size: 13px;">@c.TrangThai</span></td>
                        <td style="text-align: right;">@c.GiaBan.ToString("N0") đ</td>
                        <td style="text-align: right;">
                            @if (c.DangGiam)
                            {
                                <strong style="color: #E11D48;">@c.GiaKhuyenMai.Value.ToString("N0") đ</strong>
                                <div class="mk-muted">-@c.PhanTramGiam%</div>
                            }
                            else
                            {
                                <span>@c.GiaBan.ToString("N0") đ</span>
                                if (c.KhongHopLe)
                                {
                                    <div class="mk-muted" style="color: #B45309;">Giá giảm @c.GiaKhuyenMai.Value.ToString("N0") đ không hợp lệ</div>
                                }
                            }
                        </td>
                        <td>
                            @using (Html.BeginForm("Update", "CoursePrice", new { id = c.MaKhoaHoc }, FormMethod.Post, new { style = "display: flex; gap: 6px; margin: 0;" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input type="number" name="giaKhuyenMai" class="form-control" step="1" min="1" max="@((long)c.GiaBan - 1)"
                                       value="@(c.DangGiam ? c.GiaKhuyenMai.Value.ToString("0") : "")" placeholder="Trống = giá gốc"
                                       style="height: 36px; font-size: 13px;" aria-label="Giá khuyến mãi của @c.TenKhoaHoc" />
                                <button type="submit" class="btn btn-secondary btn-sm" style="height: 36px;">Lưu</button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="mk-empty"><i class="bi bi-journal-x"></i>Không có khóa học phù hợp.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div style="padding: 14px 22px; border-top: 1px solid var(--border-color);" class="mk-muted">
        Giá khuyến mãi phải lớn hơn 0 và nhỏ hơn giá gốc. Để trống rồi bấm Lưu để bỏ giá giảm. Đơn hàng đã thanh toán giữ nguyên giá tại thời điểm mua.
    </div>
</div>
