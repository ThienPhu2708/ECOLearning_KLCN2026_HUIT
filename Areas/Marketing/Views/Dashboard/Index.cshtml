@model ECOLearning.Areas.Marketing.Models.MarketingDashboardViewModel
@{
    ViewBag.Title = "Dashboard Marketing";
    var now = DateTime.Now;
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; gap: 16px; flex-wrap: wrap;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Tổng quan Marketing</h1>
        <p class="body-2" style="color: var(--text-secondary);">Khuyến mãi đang chạy, chiến dịch đang triển khai và hiệu quả mã giảm giá (chỉ tính đơn đã thanh toán có dùng mã)</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a href="@Url.Action("Create", "Promotion", new { area = "Marketing" })" class="btn btn-primary">+ Tạo khuyến mãi</a>
        <a href="@Url.Action("Index", "CampaignReport", new { area = "Marketing" })" class="btn btn-outline">Báo cáo chi tiết</a>
    </div>
</div>

@if (ViewBag.ChuaKhoiTao as bool? == true)
{
    <div class="mk-flash mk-flash-error" role="alert"><span><i class="bi bi-exclamation-triangle-fill me-1"></i> Chưa khởi tạo dữ liệu Marketing: chạy Database/Migrations 008, 009 và 018.</span></div>
}

<div class="mk-stats">
    <div class="card mk-stat">
        <div class="mk-stat-label">Khuyến mãi đang chạy</div>
        <div class="mk-stat-value" style="color: #10B981;">@Model.ActiveCampaignsCount</div>
        <div class="mk-stat-note">Trong thời gian áp dụng, đang bật</div>
    </div>
    <div class="card mk-stat">
        <div class="mk-stat-label">Chiến dịch đang triển khai</div>
        <div class="mk-stat-value">@Model.ChienDichDangTrienKhai</div>
    </div>
    <div class="card mk-stat">
        <div class="mk-stat-label">Lượt dùng mã tháng @now.Month</div>
        <div class="mk-stat-value" style="color: var(--primary);">@Model.TotalCouponsUsed.ToString("#,##0")</div>
    </div>
    <div class="card mk-stat">
        <div class="mk-stat-label">Doanh thu tháng @now.Month</div>
        <div class="mk-stat-value">@Model.DrivenRevenue.ToString("#,##0 đ")</div>
        <div class="mk-stat-note">Từ các đơn có mã, sau giảm</div>
    </div>
    <div class="card mk-stat">
        <div class="mk-stat-label">Tiền giảm tháng @now.Month</div>
        <div class="mk-stat-value">@Model.TienGiamThangNay.ToString("#,##0 đ")</div>
    </div>
</div>

<div class="grid-12" style="margin-bottom: 24px;">
    <div class="col-8">
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <h3 class="h3">Lượt dùng mã và doanh thu</h3>
                    <span class="caption">12 tháng năm @now.Year</span>
                </div>
            </div>
            @if (Model.CouponUsageChartData.Sum() == 0)
            {
                <p class="mk-muted" style="margin: 0;">Năm nay chưa có đơn hàng đã thanh toán nào dùng mã.</p>
            }
            else
            {
                <div class="ad-legend" style="margin-bottom: 6px;"><span><span class="ad-swatch" style="background: #434CE8;"></span> Lượt dùng mã</span><span><span class="ad-swatch" style="background: #10B981;"></span> Doanh thu</span></div>
                <div id="marketing-coupon-chart"></div>
            }
        </div>
    </div>

    <div class="col-4">
        <div class="card">
            <h3 class="h3" style="margin-bottom: 6px;">Top 5 mã dùng nhiều</h3>
            <span class="caption" style="display: block; margin-bottom: 16px;">Toàn thời gian, đơn đã thanh toán</span>
            @if (Model.TopCoupons.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    @foreach (var cp in Model.TopCoupons)
                    {
                        <div style="padding: 10px 12px; background: var(--bg-canvas, #F8FAFC); border-radius: var(--radius-xl); border: 1px dashed rgba(67, 76, 232, 0.3); display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                            <div style="min-width: 0;">
                                <span class="badge badge-primary" style="background: var(--primary-light); color: var(--primary); font-weight: 700; font-size: 13px; letter-spacing: 0.05em;">@cp.MaCode</span>
                                <div style="font-size: 12px; color: var(--text-secondary); margin-top: 4px;">@cp.TenKhuyenMai</div>
                            </div>
                            <div style="text-align: right; flex-shrink: 0;">
                                <strong style="font-size: 13px; color: var(--text-heading);">@cp.SoLuongDung lượt</strong>
                                <div style="font-size: 11px; color: var(--text-muted);">@cp.DoanhThu.ToString("#,##0 đ")</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="body-2" style="color: var(--text-secondary); text-align: center; padding: 24px 8px;">Chưa có mã nào được dùng.</p>
            }
        </div>
    </div>
</div>

<div class="grid-12">
    <div class="col-6">
        <div class="card">
            <h3 class="h3" style="margin-bottom: 6px;">Mã cần chú ý</h3>
            <span class="caption" style="display: block; margin-bottom: 16px;">Đang chạy, hết hạn trong 7 ngày hoặc đã dùng từ 80% lượt</span>
            @if (Model.MaCanChuY.Any())
            {
                <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px;">
                    @foreach (var m in Model.MaCanChuY)
                    {
                        <li style="display: flex; justify-content: space-between; gap: 10px; font-size: 14px;">
                            <a href="@Url.Action("Details", "Promotion", new { id = m.MaKhuyenMai })"><span class="mk-code">@m.MaCode</span> @m.TenKhuyenMai</a>
                            <span style="color: #B45309; white-space: nowrap;">@m.LyDo</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="body-2" style="color: var(--text-secondary);">Không có mã nào sắp hết hạn hoặc sắp hết lượt.</p>
            }
        </div>
    </div>
    <div class="col-6">
        <div class="card">
            <h3 class="h3" style="margin-bottom: 6px;">Chiến dịch sắp kết thúc</h3>
            <span class="caption" style="display: block; margin-bottom: 16px;">5 chiến dịch đang triển khai có ngày kết thúc gần nhất</span>
            @if (Model.ChienDichSapKetThuc.Any())
            {
                <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px;">
                    @foreach (var c in Model.ChienDichSapKetThuc)
                    {
                        <li style="display: flex; justify-content: space-between; gap: 10px; font-size: 14px;">
                            <a href="@Url.Action("Details", "Campaign", new { id = c.MaChienDich })">@c.TenChienDich</a>
                            <span style="color: var(--text-muted); white-space: nowrap;">đến @c.NgayKetThuc.ToString("dd/MM/yyyy")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="body-2" style="color: var(--text-secondary);">Không có chiến dịch nào đang triển khai.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        var box = document.getElementById('marketing-coupon-chart');
        if (!box || !window.AdminCharts) return;
        var C = AdminCharts;
        C.dualLine(box, {
            labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartLabels)),
            ariaLabel: 'Biểu đồ lượt dùng mã và doanh thu',
            axes: [function (v) { return C.fmtNum(Math.round(v)); }, C.fmtShort],
            series: [
                { name: 'Lượt dùng mã', data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CouponUsageChartData)), color: '#434CE8', fill: 'rgba(67,76,232,0.08)', format: C.fmtNum },
                { name: 'Doanh thu', data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueChartData)), color: '#10B981', dashed: true, format: C.fmtMoney }
            ]
        });
    });
</script>
}
