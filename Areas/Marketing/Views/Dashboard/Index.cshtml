@model ECOLearning.Areas.Marketing.Models.MarketingDashboardViewModel
@{
    ViewBag.Title = "Dashboard Marketing";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px;">
    <div>
        <h1 class="h2" style="margin-top: 6px;">Tổng Quan Chiến Dịch Tiếp Thị</h1>
        <p class="body-2" style="color: var(--text-secondary);">Giám sát hiệu quả chương trình khuyến mại, lượt sử dụng coupon và doanh thu kích cầu</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a href="@Url.Action("Index", "Promotion", new { area = "Marketing" })" class="btn btn-primary">
            + Quản lý Voucher & KM
        </a>
    </div>
</div>

<!-- 3 MARKETING KPI CARDS COMPLIANT WITH 3.3.1.5 -->
<div class="grid-12" style="margin-bottom: 32px;">

    <!-- Card 1: Active Campaigns -->
    <div class="col-4">
        <div class="card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Chiến dịch đang chạy</span>
                <div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(16, 185, 129, 0.1); color: #10B981; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </div>
            </div>
            <div style="font-size: 30px; font-weight: 800; color: #10B981; margin-bottom: 4px;">
                @Model.ActiveCampaignsCount.ToString("00") chiến dịch
            </div>
            <span class="caption" style="color: var(--text-muted);">Chương trình trong thời gian áp dụng</span>
        </div>
    </div>

    <!-- Card 2: Coupons Used -->
    <div class="col-4">
        <div class="card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Tổng lượt coupon đã dùng</span>
                <div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(225, 29, 72, 0.1); color: #E11D48; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                    </svg>
                </div>
            </div>
            <div style="font-size: 30px; font-weight: 800; color: #E11D48; margin-bottom: 4px;">
                @Model.TotalCouponsUsed.ToString("#,##0") lượt
            </div>
            <span class="caption" style="color: var(--status-success); font-weight: 600;">Chỉ tính đơn hàng đã thanh toán</span>
        </div>
    </div>

    <!-- Card 3: Driven Revenue -->
    <div class="col-4">
        <div class="card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span class="caption" style="color: var(--text-secondary); font-weight: 600;">Doanh thu kích cầu</span>
                <div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(59, 130, 246, 0.1); color: #3B82F6; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                </div>
            </div>
            <div style="font-size: 30px; font-weight: 800; color: var(--text-heading); margin-bottom: 4px;">
                @Model.DrivenRevenue.ToString("#,##0 đ")
            </div>
            <span class="caption" style="color: var(--text-muted);">Từ các đơn hàng có mã ưu đãi</span>
        </div>
    </div>

</div>

<!-- TREND CHART & TOP COUPONS -->
<div class="grid-12">

    <!-- Biểu đồ xu hướng sử dụng coupon -->
    <div class="col-8">
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <h3 class="h3">Xu Hướng Sử Dụng Coupon</h3>
                    <span class="caption">Lượng mã khuyến mãi được học viên áp dụng qua các tháng trong năm</span>
                </div>
                <span class="badge badge-primary" style="background: #FFE4E6; color: #E11D48;">Năm @DateTime.Now.Year</span>
            </div>
            <div id="marketing-coupon-chart"></div>
        </div>
    </div>

    <!-- Top Coupon hiệu quả -->
    <div class="col-4">
        <div class="card">
            <h3 class="h3" style="margin-bottom: 6px;">Coupon Nổi Bật</h3>
            <span class="caption" style="display: block; margin-bottom: 16px;">Các mã giảm giá được sử dụng nhiều nhất</span>

            @if (Model.TopCoupons != null && Model.TopCoupons.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var cp in Model.TopCoupons)
                    {
                        <div style="padding: 12px 14px; background: var(--bg-canvas, #F8FAFC); border-radius: var(--radius-xl); border: 1px dashed rgba(225, 29, 72, 0.3); display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <span class="badge badge-primary" style="background: #FFE4E6; color: #E11D48; font-weight: 700; font-size: 13px; letter-spacing: 0.05em;">@cp.MaCode</span>
                                <div style="font-size: 12px; color: var(--text-secondary); margin-top: 4px;">@cp.TenKhuyenMai</div>
                            </div>
                            <div style="text-align: right;">
                                <strong style="font-size: 13px; color: var(--text-heading);">@cp.SoLuongDung lượt</strong>
                                <div style="font-size: 11px; color: var(--status-success); font-weight: 600;">@cp.MoTaUuDai</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; color: var(--text-secondary); padding: 32px 16px;">
                    <p class="body-2">Chưa có mã khuyến mãi nào được tạo.</p>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const usageData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CouponUsageChartData));
        const chartLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartLabels));

        if (window.Charts && typeof Charts.renderLineChart === 'function') {
            Charts.renderLineChart('marketing-coupon-chart', {
                data: usageData,
                labels: chartLabels,
                color: '#E11D48',
                fillColor: 'rgba(225, 29, 72, 0.06)'
            });
        }
    });
</script>
}
