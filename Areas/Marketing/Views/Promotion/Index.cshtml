@model List<ECOLearning.ViewModels.ChuongTrinhKhuyenMai>
@{
    ViewBag.Title = "Chương trình khuyến mãi";
    string currentStatus = ViewBag.CurrentStatus as string ?? "all";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string doiTuong = ViewBag.CurrentDoiTuong as string;
    string tuNgay = ViewBag.TuNgay as string;
    string denNgay = ViewBag.DenNgay as string;
    var now = DateTime.Now;
    var statuses = new[] { "all", "Đang chạy", "Chưa bắt đầu", "Tạm ngưng", "Hết lượt", "Đã kết thúc" };
    string returnUrl = Request.RawUrl;
    var adminTamDung = ViewBag.AdminTamDung as HashSet<string> ?? new HashSet<string>();
}

<div class="mk-page-head">
    <div>
        <h1 class="h2">Chương trình khuyến mãi & Coupon</h1>
        <p>Tạo và quản lý ưu đãi cho học viên. Giá và số tiền giảm luôn được tính lại ở máy chủ khi học viên thanh toán.</p>
    </div>
    <a href="@Url.Action("Create", "Promotion")" class="btn mk-btn-accent"><i class="bi bi-plus-lg me-1"></i> Tạo chương trình</a>
</div>

@Html.Partial("_Flash")

<form method="get" action="@Url.Action("Index", "Promotion")" class="card mk-filter">
    <div class="mk-field" style="flex: 1; min-width: 200px;">
        <label for="search">Tên hoặc mã coupon</label>
        <input type="text" id="search" name="search" class="form-control" value="@currentSearch" placeholder="VD: BLF2026" />
    </div>
    <div class="mk-field">
        <label for="doiTuong">Đối tượng</label>
        <select id="doiTuong" name="doiTuong" class="form-control">
            <option value="" @(string.IsNullOrEmpty(doiTuong) ? "selected" : "")>Tất cả</option>
            <option value="TatCa" @(doiTuong == "TatCa" ? "selected" : "")>Mọi học viên</option>
            <option value="ThanThiet" @(doiTuong == "ThanThiet" ? "selected" : "")>Học viên thân thiết</option>
        </select>
    </div>
    <div class="mk-field">
        <label for="tuNgay">Áp dụng từ ngày</label>
        <input type="date" id="tuNgay" name="tuNgay" class="form-control" value="@tuNgay" />
    </div>
    <div class="mk-field">
        <label for="denNgay">Đến ngày</label>
        <input type="date" id="denNgay" name="denNgay" class="form-control" value="@denNgay" />
    </div>
    <input type="hidden" name="status" value="@(currentStatus == "all" ? "" : currentStatus)" />
    <button type="submit" class="btn btn-secondary btn-sm" style="height: 38px;">Lọc</button>
    @if (!string.IsNullOrEmpty(currentSearch) || currentStatus != "all" || !string.IsNullOrEmpty(doiTuong) || tuNgay != null || denNgay != null)
    {
        <a href="@Url.Action("Index", "Promotion")" class="btn btn-outline btn-sm" style="height: 38px; display: inline-flex; align-items: center;">Đặt lại</a>
    }
</form>

<div class="mk-tabs" style="margin-bottom: 14px;">
    @foreach (var s in statuses)
    {
        <a class="mk-tab @(currentStatus == s ? "is-active" : "")"
           href="@Url.Action("Index", "Promotion", new { status = s == "all" ? null : s, search = currentSearch, doiTuong, tuNgay, denNgay })">@(s == "all" ? "Tất cả" : s)</a>
    }
</div>

<div class="card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="table pm-table">
            <thead>
                <tr>
                    <th>Chương trình</th>
                    <th>Ưu đãi</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th style="width: 110px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var p in Model)
                    {
                        string tt = p.TrangThaiHienThi(now);
                        <tr class="pm-row" tabindex="0" role="button" aria-label="Xem chi tiết @p.TenKhuyenMai">
                            <td>
                                <div style="font-weight: 700; color: var(--text-heading);">@p.TenKhuyenMai</div>
                                <div class="mk-muted" style="margin-top: 3px;">
                                    <span class="mk-code" style="font-size: 11.5px;">@p.MaHienThi</span>
                                    @if (!string.IsNullOrEmpty(p.TenChienDich)) { <span><i class="bi bi-megaphone"></i> @p.TenChienDich</span> }
                                </div>
                            </td>
                            <td><strong style="color: var(--primary);">@p.MoTaUuDai</strong></td>
                            <td style="white-space: nowrap;">@p.NgayBatDau.ToString("dd/MM/yyyy")<br /><span class="mk-muted">đến</span> @p.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (tt == "Đang chạy") { <span class="badge badge-success">Đang chạy</span> }
                                else if (tt == "Tạm ngưng") { <span class="badge badge-warning">Tạm ngưng</span> }
                                else if (tt == "Chưa bắt đầu") { <span class="badge badge-info">Chưa bắt đầu</span> }
                                else if (tt == "Hết lượt") { <span class="badge badge-danger">Hết lượt</span> }
                                else { <span class="badge badge-secondary">Đã kết thúc</span> }
                                @if (adminTamDung.Contains(p.MaKhuyenMai))
                                {
                                    <div><span class="badge badge-danger" title="Quản trị viên đã tạm dừng, xem lý do ở trang chi tiết"><i class="bi bi-shield-exclamation"></i> Admin tạm dừng</span></div>
                                }
                            </td>
                            <td style="text-align: right;">
                                <button type="button" class="btn btn-outline btn-sm pm-open"><i class="bi bi-eye"></i> Xem</button>
                                <template class="pm-tpl">
                                    <div class="pm-head">
                                        <div style="min-width: 0;">
                                            <h3 class="h3" style="margin: 0 0 6px;">@p.TenKhuyenMai</h3>
                                            <span class="mk-code">@p.MaHienThi</span>
                                            @if (tt == "Đang chạy") { <span class="badge badge-success">Đang chạy</span> }
                                            else if (tt == "Tạm ngưng") { <span class="badge badge-warning">Tạm ngưng</span> }
                                            else if (tt == "Chưa bắt đầu") { <span class="badge badge-info">Chưa bắt đầu</span> }
                                            else if (tt == "Hết lượt") { <span class="badge badge-danger">Hết lượt</span> }
                                            else { <span class="badge badge-secondary">Đã kết thúc</span> }
                                        </div>
                                        <button type="button" class="pm-close" aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    <dl class="mk-dl pm-dl">
                                        <dt>Loại</dt>
                                        <dd>@(p.LaGiamTrucTiep ? "Giảm trực tiếp (không cần mã)" : "Coupon (nhập mã khi thanh toán)")</dd>
                                        <dt>Ưu đãi</dt>
                                        <dd><strong style="color: var(--primary);">@p.MoTaUuDai</strong>@if (p.DonHangToiThieu.HasValue) { <span class="mk-muted"> · đơn từ @p.DonHangToiThieu.Value.ToString("N0") đ</span> }</dd>
                                        <dt>Thời gian</dt>
                                        <dd>@p.NgayBatDau.ToString("dd/MM/yyyy") – @p.NgayKetThuc.ToString("dd/MM/yyyy")</dd>
                                        <dt>Phạm vi</dt>
                                        <dd>@p.MoTaPhamVi</dd>
                                        <dt>Đối tượng</dt>
                                        <dd>
                                            @if (p.LaThanThiet)
                                            {
                                                <span class="badge badge-warning"><i class="bi bi-award"></i> Học viên thân thiết</span>
                                                if (p.SoKhoaToiThieu.HasValue) { <span class="mk-muted"> · từ @p.SoKhoaToiThieu.Value khóa</span> }
                                                if (p.ChiTieuToiThieu.HasValue) { <span class="mk-muted"> · chi tiêu từ @p.ChiTieuToiThieu.Value.ToString("N0") đ</span> }
                                            }
                                            else { <span>Mọi học viên</span> }
                                        </dd>
                                        <dt>Hiển thị</dt>
                                        <dd>@(p.CongKhai ? "Công khai cho học viên" : "Mã kín: chỉ dùng khi được gửi riêng")</dd>
                                        <dt>Lượt dùng</dt>
                                        <dd><strong>@p.SoLuotDaDung</strong>@(p.GioiHanLuotDung.HasValue ? " / " + p.GioiHanLuotDung.Value : "") lượt@(p.HetLuot ? " (đã hết lượt)" : "")</dd>
                                        @if (!string.IsNullOrEmpty(p.TenChienDich))
                                        {
                                            <dt>Chiến dịch</dt>
                                            <dd>@p.TenChienDich</dd>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.DieuKienApDung))
                                        {
                                            <dt>Điều kiện</dt>
                                            <dd>@p.DieuKienApDung</dd>
                                        }
                                    </dl>
                                    @if (adminTamDung.Contains(p.MaKhuyenMai))
                                    {
                                        <div class="mk-flash mk-flash-error" style="margin: 14px 0 0;"><span><i class="bi bi-shield-exclamation me-1"></i> Quản trị viên đã tạm dừng chương trình này. Xem lý do ở trang chi tiết.</span></div>
                                    }
                                    <div class="pm-foot">
                                        <a href="@Url.Action("Details", "Promotion", new { id = p.MaKhuyenMai })" class="btn btn-outline btn-sm">Xem đầy đủ</a>
                                        @if (tt != "Đã kết thúc")
                                        {
                                            <a href="@Url.Action("Edit", "Promotion", new { id = p.MaKhuyenMai })" class="btn mk-btn-accent btn-sm">Sửa</a>
                                            using (Html.BeginForm("ChangeStatus", "Promotion", new { id = p.MaKhuyenMai }, FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                if (adminTamDung.Contains(p.MaKhuyenMai))
                                                {
                                                    <button type="button" class="btn btn-secondary btn-sm" disabled title="Đang bị Quản trị viên tạm dừng">Kích hoạt</button>
                                                }
                                                else if (p.DangTamNgung)
                                                {
                                                    <button type="submit" name="hanhDong" value="resume" class="btn btn-secondary btn-sm">Kích hoạt</button>
                                                }
                                                else
                                                {
                                                    <button type="submit" name="hanhDong" value="pause" class="btn btn-secondary btn-sm">Tạm ngừng</button>
                                                }
                                            }
                                        }
                                    </div>
                                </template>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="mk-empty"><i class="bi bi-tag"></i>Không có chương trình khuyến mãi nào phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div style="padding: 14px 22px; border-top: 1px solid var(--border-color);" class="mk-muted">
        Hiển thị <strong>@Model.Count</strong> chương trình. Bấm vào một dòng để xem chi tiết, sửa hoặc tạm ngừng. Chương trình đã phát sinh giao dịch không bị xóa, chỉ tạm ngừng hoặc kết thúc để giữ lịch sử.
    </div>
</div>

<div class="modal-overlay" id="pm-modal" aria-hidden="true">
    <div class="modal-container pm-modal" role="dialog" aria-modal="true"></div>
</div>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('pm-modal');
            var box = modal.querySelector('.pm-modal');
            function dong() {
                modal.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
                box.innerHTML = '';
            }
            function mo(row) {
                var tpl = row.querySelector('template.pm-tpl');
                if (!tpl) return;
                box.innerHTML = '';
                box.appendChild(tpl.content.cloneNode(true));
                modal.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }
            document.querySelectorAll('tr.pm-row').forEach(function (row) {
                row.addEventListener('click', function (e) { if (!e.target.closest('a, form')) mo(row); });
                row.addEventListener('keydown', function (e) { if (e.key === 'Enter' && e.target === row) mo(row); });
            });
            modal.addEventListener('click', function (e) { if (e.target === modal || e.target.closest('.pm-close')) dong(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('active')) dong(); });
        })();
    </script>
}
