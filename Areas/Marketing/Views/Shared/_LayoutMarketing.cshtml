<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title | E-Learning Marketing</title>
    <link rel="stylesheet" href="~/assets/css/variables.css">
    <link rel="stylesheet" href="~/assets/css/base.css">
    <link rel="stylesheet" href="~/assets/css/components.css">
    <link rel="stylesheet" href="~/assets/css/dashboard-tables.css?v=4">
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/assets/css/marketing.css?v=1.0">
    <link rel="stylesheet" href="~/assets/css/staff-ui.css?v=1.4">
    @RenderSection("Styles", required: false)
</head>
<body class="staff-ui">
    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="dashboard-sidebar" id="staff-sidebar">
            <div class="sidebar-logo">
                <a href="@Url.Action("Index", "Dashboard", new { area = "Marketing" })" class="brand-logo">
                    <div class="logo-icon" style="width: 34px; height: 34px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                            <line x1="7" y1="7" x2="7.01" y2="7"></line>
                        </svg>
                    </div>
                    <span class="logo-text" style="font-size: 18px;">Marketing<span>.</span></span>
                </a>
            </div>

            @{
                string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
                string staffName = Session["FullName"]?.ToString() ?? "Marketing";
                string staffAvatar = Session["Avatar"]?.ToString();
                string staffInitial = staffName.Trim().Length > 0 ? staffName.Trim().Substring(staffName.Trim().LastIndexOf(' ') + 1, 1).ToUpper() : "M";
            }

            <nav class="sidebar-menu">
                <div class="sidebar-section">Tổng quan</div>
                <a href="@Url.Action("Index", "Dashboard", new { area = "Marketing" })" class="sidebar-item @(currentCtrl == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i> Dashboard Marketing
                </a>

                <div class="sidebar-section">Khuyến mãi</div>
                <a href="@Url.Action("Index", "Promotion", new { area = "Marketing" })" class="sidebar-item @(currentCtrl == "Promotion" ? "active" : "")">
                    <i class="bi bi-tag"></i> Khuyến mãi &amp; Coupon
                </a>
                <a href="@Url.Action("Index", "Loyalty", new { area = "Marketing" })" class="sidebar-item @(currentCtrl == "Loyalty" ? "active" : "")">
                    <i class="bi bi-award"></i> Ưu đãi thân thiết
                </a>

                <div class="sidebar-section">Chiến dịch</div>
                <a href="@Url.Action("Index", "Campaign", new { area = "Marketing" })" class="sidebar-item @(currentCtrl == "Campaign" ? "active" : "")">
                    <i class="bi bi-megaphone"></i> Chiến dịch Marketing
                </a>
                <a href="@Url.Action("Index", "CampaignReport", new { area = "Marketing" })" class="sidebar-item @(currentCtrl == "CampaignReport" ? "active" : "")">
                    <i class="bi bi-bar-chart-line"></i> Báo cáo Marketing
                </a>
                <a href="@Url.Action("Index", "CourseEngagement", new { area = "Marketing" })" class="sidebar-item @(currentCtrl == "CourseEngagement" ? "active" : "")">
                    <i class="bi bi-activity"></i> Tương tác khóa học
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="staff-user">
                    @if (!string.IsNullOrWhiteSpace(staffAvatar))
                    {
                        <img class="staff-avatar" src="@(staffAvatar.StartsWith("http") ? staffAvatar : Url.Content("~/" + staffAvatar.TrimStart('/')))" alt="" />
                    }
                    else
                    {
                        <span class="staff-avatar">@staffInitial</span>
                    }
                    <div class="staff-user-info">
                        <div class="staff-user-name" title="@staffName">@staffName</div>
                        <div class="staff-user-role">Nhân viên Marketing</div>
                    </div>
                    <button type="button" class="staff-logout" title="Đăng xuất" aria-label="Đăng xuất" onclick="confirmMarketingLogout()">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </div>
        </aside>
        <div class="staff-backdrop" id="staff-backdrop" onclick="toggleStaffSidebar(false)"></div>

        <!-- MAIN -->
        <main class="dashboard-main">
            <!-- TOP NAVIGATION BAR -->
            <header class="dashboard-topbar">
                <div class="topbar-left">
                    <button type="button" class="staff-menu-btn" aria-label="Mở menu" onclick="toggleStaffSidebar(true)"><i class="bi bi-list"></i></button>
                    <nav class="breadcrumb-nav">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "Marketing" })">Marketing</a>
                        @if (ViewBag.BreadcrumbCurrent != null)
                        {
                            <span class="separator">/</span>
                            <span class="current">@ViewBag.BreadcrumbCurrent</span>
                        }
                    </nav>
                </div>
                <div class="topbar-actions">
                    <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline btn-sm"><i class="bi bi-house-door"></i> <span class="staff-hide-sm">Về Trang chủ</span></a>
                </div>
            </header>

            @RenderBody()
        </main>
    </div>

    <!-- MODAL XÁC NHẬN ĐĂNG XUẤT MARKETING -->
    <div class="modal-overlay" id="marketing-logout-modal">
        <div class="modal-container" style="max-width: 420px; text-align: center; padding: 32px 24px; border-radius: 20px; background: #FFFFFF;">
            <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(239, 68, 68, 0.1); color: #EF4444; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </div>
            <h3 class="h3" style="margin-bottom: 8px;">Xác nhận đăng xuất</h3>
            <p class="body-2" style="color: var(--text-secondary); margin-bottom: 24px; font-size: 14px; line-height: 1.5;">
                Bạn có chắc chắn muốn kết thúc phiên làm việc Marketing và quay về Trang chủ không?
            </p>
            <div style="display: flex; gap: 12px;">
                <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="closeMarketingLogoutModal()">Hủy</button>
                <a href="@Url.Action("Logout", "Account", new { area = "" })" class="btn btn-danger" style="flex: 1; background: #EF4444; border-color: #EF4444; color: #ffffff; text-decoration: none; display: flex; align-items: center; justify-content: center; font-weight: 600;">Đăng xuất</a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/assets/js/charts.js"></script>
    <script src="~/assets/js/admin-charts.js?v=2"></script>
    <script src="~/assets/js/app.js"></script>
    <script>
        function toggleStaffSidebar(open) {
            var sb = document.getElementById('staff-sidebar'), bd = document.getElementById('staff-backdrop');
            if (sb) sb.classList.toggle('active', open);
            if (bd) bd.classList.toggle('active', open);
        }

        function confirmMarketingLogout() {
            const modal = document.getElementById('marketing-logout-modal');
            if (modal) {
                if (window.openModal) {
                    openModal('marketing-logout-modal');
                } else {
                    modal.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            } else {
                if (confirm('Bạn có chắc chắn muốn đăng xuất khỏi phiên làm việc Marketing không?')) {
                    window.location.href = '@Url.Action("Logout", "Account", new { area = "" })';
                }
            }
        }

        function closeMarketingLogoutModal() {
            const modal = document.getElementById('marketing-logout-modal');
            if (modal) {
                if (window.closeModal) {
                    closeModal('marketing-logout-modal');
                } else {
                    modal.classList.remove('active');
                    document.body.style.overflow = '';
                }
            }
        }
    </script>
    @Html.Partial("~/Views/Shared/_PhienDangNhap.cshtml")
    @RenderSection("Scripts", required: false)
</body>
</html>
