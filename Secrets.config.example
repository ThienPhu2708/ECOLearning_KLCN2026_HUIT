<?xml version="1.0" encoding="utf-8"?>
<!-- MẪU: sao chép thành Secrets.config rồi điền mã do VNPay gửi qua email (đăng ký sandbox: https://sandbox.vnpayment.vn/devreg/).
     Khóa bí mật, KHÔNG đưa lên Git (đã có trong .gitignore). Web.config đọc file này qua <appSettings file="Secrets.config">.
     Payment:Mode = VNPay  -> thanh toán qua VNPay Sandbox; giá trị khác (vd. Sandbox) -> cổng thử nghiệm nội bộ /Payment/Gateway. -->
<appSettings>
  <add key="Payment:Mode" value="VNPay" />
  <add key="VNPay:TmnCode" value="MA_WEBSITE_VNPAY" />
  <add key="VNPay:HashSecret" value="CHUOI_BI_MAT_VNPAY" />
  <add key="VNPay:PaymentUrl" value="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html" />
  <add key="VNPay:ApiUrl" value="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction" />
  <!-- API ứng dụng di động: địa chỉ public (tunnel) dùng để tạo link ảnh, video, trang VNPay quay về.
       Để trống thì tự lấy theo header X-Forwarded-Host hoặc địa chỉ request. Đổi giá trị thì khởi động lại IIS Express.
  <add key="Api:PublicBaseUrl" value="https://xxxx.trycloudflare.com" />
  -->

  <!-- Cloudflare R2 (lưu video bài học). Lấy ở Cloudflare Dashboard > R2:
       - AccountId: Account ID (cột phải trang R2), endpoint S3 = https://<AccountId>.r2.cloudflarestorage.com
       - BucketName: tên bucket đã tạo
       - AccessKeyId / SecretAccessKey: R2 > Manage R2 API Tokens (quyền Object Read & Write cho bucket); xin trưởng nhóm, không đưa lên Git
       - PublicUrl: để trống nếu dùng link có hạn dùng (presigned); điền https://pub-xxxx.r2.dev hoặc tên miền riêng nếu bật truy cập công khai -->
  <add key="R2:AccountId" value="DIEN_ACCOUNT_ID" />
  <add key="R2:BucketName" value="DIEN_TEN_BUCKET" />
  <add key="R2:AccessKeyId" value="DIEN_ACCESS_KEY_ID" />
  <add key="R2:SecretAccessKey" value="DIEN_SECRET_ACCESS_KEY" />
  <add key="R2:PublicUrl" value="" />
</appSettings>
