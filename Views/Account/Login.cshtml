</div>



@section scripts {
<script>
    function switchAuthMode(mode) {
        const authTabs = document.getElementById('main-auth-tabs');
        const loginTab = document.getElementById('tab-login-btn');
        const regTab = document.getElementById('tab-register-btn');
        const loginView = document.getElementById('login-view');
        const regView = document.getElementById('register-view');
        const forgotView = document.getElementById('forgot-password-view');

        const loginPass = document.getElementById('login-password');
        const loginEye = document.getElementById('icon-toggle-login-pass');
        if (loginPass && loginEye) {
            loginPass.type = 'password';
            loginEye.className = 'bi bi-eye';
            loginEye.style.color = '#64748B';
        }

        if (mode === 'login') {
            authTabs.style.display = 'flex';
            loginTab.classList.add('active');
            regTab.classList.remove('active');
            loginView.style.display = 'block';
            regView.style.display = 'none';
            forgotView.style.display = 'none';
        }
        else if (mode === 'register')
        {
            authTabs.style.display = 'flex';
            regTab.classList.add('active');
            loginTab.classList.remove('active');
            loginView.style.display = 'none';
            regView.style.display = 'block';
            forgotView.style.display = 'none';
        }
        else if (mode === 'forgot')
        {
            authTabs.style.display = 'none';
            loginView.style.display = 'none';
            regView.style.display = 'none';
            forgotView.style.display = 'block';
            document.getElementById('forgot-step-1').style.display = 'block';
            document.getElementById('forgot-step-2').style.display = 'none';
            document.getElementById('forgot-step-3').style.display = 'none';
        }
    }

    function toggleLoginPassword() {
        const input = document.getElementById('login-password');
        const icon = document.getElementById('icon-toggle-login-pass');
        if (!input || !icon) return;
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
            icon.style.color = '#434CE8';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
            icon.style.color = '#64748B';
        }
    }

// --- GOOGLE SIGN-IN INTEGRATION (GIS SDK + OAuth 2.0 Flow) ---
function parseJwt(token) {
try {
var base64Url = token.split('.')[1];
var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
var jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
}).join(''));
return JSON.parse(jsonPayload);
} catch(e) {
return null;
}
}

        function handleGoogleCredentialResponse(response) {
            if (response && response.credential) {
                var idToken = response.credential;
                var payload = parseJwt(idToken);
                if (payload) {
                    var email = payload.email || '';
                    var familyName = (payload.family_name || '').trim();
                    var givenName = (payload.given_name || '').trim();
                    var displayName = (payload.name || '').trim();

                    var fullName = '';
                    if (familyName && givenName) {
                        fullName = familyName + ' ' + givenName;
                    } else if (displayName) {
                        fullName = displayName;
                    } else if (givenName) {
                        fullName = givenName;
                    }

                    var picture = payload.picture || '';
                    postGoogleAuth(idToken, email, fullName, picture, givenName, familyName);
                    return;
                }
            }
            showToast('Xác thực Google ID Token thất bại!', 'error');
        }

        function setGoogleBtnLoading(loading) {
            var btn = document.querySelector('.btn-google');
            if (!btn) return;
            if (loading) {
                btn.style.opacity = '0.6';
                btn.style.pointerEvents = 'none';
            } else {
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
            }
        }

        function postGoogleAuth(idToken, email, name, avatar, givenName, familyName) {
            setGoogleBtnLoading(true);
            $.ajax({
                url: '@Url.Action("GoogleLogin", "Account")',
                type: 'POST',
                data: { 
                    idToken: idToken || '', 
                    googleEmail: email, 
                    googleName: name || '', 
                    googleAvatar: avatar || '',
                    googleGivenName: givenName || '',
                    googleFamilyName: familyName || ''
                },
                success: function (res) {
                    if (res.success) {
                        window.location.href = res.redirectUrl || '@Url.Action("Index", "Home")';
                    }
                    else
                    {
                        setGoogleBtnLoading(false);
                        showToast(res.message || 'Đăng nhập bằng Google không thành công!', 'error');
                    }
                },
                error: function () {
                    setGoogleBtnLoading(false);
                    showToast('Có lỗi xảy ra khi kết nối máy chủ!', 'error');
                }
            });
        }

        function initGoogleIdentity() {
            if (window.google && window.google.accounts && window.google.accounts.id) {
                try {
                    window.google.accounts.id.initialize({
                        client_id: "16112335076-7inckr0r5mo4og4gmi70c5t10j82bg4o.apps.googleusercontent.com",
                        callback: handleGoogleCredentialResponse
                    });
                } catch(e) {
                    console.log("Google GIS Init Error:", e);
                }
            }
        }

        window.addEventListener('load', function() {
            initGoogleIdentity();
        });

        function triggerGoogleOAuthPopup() {
            if (window.google && window.google.accounts && window.google.accounts.oauth2) {
                try {
                    var client = window.google.accounts.oauth2.initTokenClient({
                        client_id: '16112335076-7inckr0r5mo4og4gmi70c5t10j82bg4o.apps.googleusercontent.com',
                        scope: 'email profile openid',
                        callback: function (tokenResponse) {
                            if (tokenResponse && tokenResponse.access_token) {
                                setGoogleBtnLoading(true);
                                fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
                                    headers: { Authorization: 'Bearer ' + tokenResponse.access_token }
                                })
                                .then(function (res) { return res.json(); })
                                .then(function (user) {
                                    if (user && user.email) {
                                        var familyName = (user.family_name || '').trim();
                                        var givenName = (user.given_name || '').trim();
                                        var displayName = (user.name || '').trim();

                                        var fullName = '';
                                        if (familyName && givenName) {
                                            fullName = familyName + ' ' + givenName;
                                        } else if (displayName) {
                                            fullName = displayName;
                                        } else if (givenName) {
                                            fullName = givenName;
                                        }

                                        postGoogleAuth('', user.email, fullName, user.picture || '', givenName, familyName);
                                    }
                                    else
                                    {
                                        setGoogleBtnLoading(false);
                                        showToast('Không thể lấy thông tin người dùng từ Google!', 'error');
                                    }
                                })
                                .catch(function () {
                                    setGoogleBtnLoading(false);
                                    showToast('Lỗi khi truy xuất thông tin từ Google!', 'error');
                                });
                            }
                        }
                    });
                        client.requestAccessToken();
                    } catch(e) {
                        console.log("OAuth2 Popup Error:", e);
                    }
                }
                else
                {
                    showToast('Đang tải thư viện Google, vui lòng thử lại sau giây lát...', 'info');
                }
            }

function handleGoogleLogin() {
if (window.google && window.google.accounts) {
if (window.google.accounts.id) {
try {
initGoogleIdentity();
window.google.accounts.id.prompt(function (notification) {
if (notification.isNotDisplayed() || notification.isSkippedMoment()) {
triggerGoogleOAuthPopup();
}
});
return;
} catch(e) {
console.log("Google GIS prompt error:", e);
}
}
triggerGoogleOAuthPopup();
}
else
{
    showToast('Đang tải thư viện Google, vui lòng thử lại sau giây lát...', 'info');
}
}

function showForgotPassword(e) {
if (e) e.preventDefault();
const currentLoginEmail = document.getElementById('login-email').value.trim();
if (currentLoginEmail) {
document.getElementById('forgot-email').value = currentLoginEmail;
}
switchAuthMode('forgot');
