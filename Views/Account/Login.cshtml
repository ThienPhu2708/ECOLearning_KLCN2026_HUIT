                        <span id="forgot-new-pass-error" class="field-validation-valid form-feedback-error" data-valmsg-for="NewPassword" data-valmsg-replace="true" role="alert" aria-live="polite" style="display: none; color: #EF4444; font-size: 12px; font-weight: 600; margin-top: 6px;"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="forgot-confirm-pass">Xác nhận mật khẩu mới <span class="required">*</span></label>
