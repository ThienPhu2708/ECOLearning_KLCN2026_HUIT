                    <button type="submit" id="btn-verify-forgot-otp" class="btn btn-primary" style="width: 100%; height: 48px; background: #434CE8; border-radius: 12px; font-weight: 700; margin-bottom: 12px;">Xác nhận mã OTP</button>
                    <button type="button" class="btn btn-outline" style="width: 100%; height: 44px; border-radius: 12px;" onclick="backToForgotStep1()"><i class="bi bi-arrow-left me-1"></i> Quay lại nhập Email</button>
                </form>
            </div>

            <!-- Giai đoạn 3: Đặt mật khẩu mới (Chỉ hiện khi nhập OTP đúng) -->
            <div id="forgot-step-3" style="display: none;">
                <form onsubmit="handleResetPasswordSubmit(event)" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="forgot-new-pass">Mật khẩu mới <span class="required">*</span></label>
