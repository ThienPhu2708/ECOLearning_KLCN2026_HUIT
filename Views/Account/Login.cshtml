            matchError.style.display = 'none';
        }
    });
}

const forgotPassInput = document.getElementById('forgot-new-pass');
const forgotPassConfirmInput = document.getElementById('forgot-confirm-pass');
if (forgotPassConfirmInput && forgotPassInput) {
    forgotPassConfirmInput.addEventListener('input', function () {
        const matchError = document.getElementById('forgot-pass-match-error');
        if (matchError && this.value === forgotPassInput.value) {
            matchError.style.display = 'none';
        }
    });
}
});

function bindFullNameInputEvents() {
    const input = document.getElementById('reg-fullname');
    const errorEl = document.getElementById('reg-fullname-error');
    if (!input || !errorEl) return;

    input.addEventListener('input', function () {
        const val = this.value;
        if (!val || val.length === 0) {
            errorEl.style.display = 'none';
            input.setAttribute('aria-invalid', 'false');
            return;
        }
        const hasDigit = /[0-9]/.test(val);
        const hasSpecial = /[^\p{L}\s0-9]/u.test(val);

        if (hasDigit && hasSpecial) {
            errorEl.innerText = 'Họ và tên chỉ được chứa chữ cái, không được chứa chữ số và ký tự đặc biệt!';
            errorEl.style.display = 'block';
            input.setAttribute('aria-invalid', 'true');
        } else if (hasDigit) {
            errorEl.innerText = 'Họ và tên không được chứa chữ số (0-9)!';
            errorEl.style.display = 'block';
            input.setAttribute('aria-invalid', 'true');
        } else if (hasSpecial) {
            errorEl.innerText = 'Họ và tên không được chứa ký tự đặc biệt!';
            errorEl.style.display = 'block';
            input.setAttribute('aria-invalid', 'true');
        } else {
            errorEl.style.display = 'none';
            input.setAttribute('aria-invalid', 'false');
        }
    });

    input.addEventListener('blur', function () {
        const val = this.value.trim();
        if (val) {
            const err = validateFullName(val);
            if (err) {
                errorEl.innerText = err;
                errorEl.style.display = 'block';
                input.setAttribute('aria-invalid', 'true');
            } else {
                errorEl.style.display = 'none';
                input.setAttribute('aria-invalid', 'false');
            }
        }
    });
}

function bindEmailInputEvents(inputId, errorId) {
const input = document.getElementById(inputId);
const errorEl = document.getElementById(errorId);
if (!input) return;

input.addEventListener('blur', function () {
const val = input.value.trim();
if (val && !isValidEmailFormat(val)) {
if (errorEl) {
errorEl.innerText = 'Định dạng Email không hợp lệ!';
errorEl.style.display = 'block';
}
input.setAttribute('aria-invalid', 'true');
} else if (val && isValidEmailFormat(val)) {
if (errorEl && (errorEl.innerText.includes('định dạng') || errorEl.innerText.includes('Định dạng'))) {
errorEl.style.display = 'none';
}
input.setAttribute('aria-invalid', 'false');
}
});

input.addEventListener('input', function () {
const val = input.value.trim();
if (isValidEmailFormat(val)) {
if (errorEl && (errorEl.innerText.includes('định dạng') || errorEl.innerText.includes('Định dạng'))) {
errorEl.style.display = 'none';
}
input.setAttribute('aria-invalid', 'false');
}
});
}
