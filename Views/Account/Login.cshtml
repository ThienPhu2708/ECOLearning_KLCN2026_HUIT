const email = document.getElementById('forgot-email').value.trim();
const otp = document.getElementById('forgot-otp').value.trim();
const p1 = document.getElementById('forgot-new-pass').value;
const p2 = document.getElementById('forgot-confirm-pass').value;

if (p1.length < 8) {
showToast('Mật khẩu tối thiểu phải 8 ký tự!', 'error');
return;
}
if (p1 !== p2) {
document.getElementById('forgot-pass-match-error').style.display = 'block';
showToast('Mật khẩu xác nhận không khớp!', 'error');
return;
}
document.getElementById('forgot-pass-match-error').style.display = 'none';

const btn = document.getElementById('btn-reset-password');
if (btn) {
btn.disabled = true;
btn.innerText = 'Đang cập nhật mật khẩu...';
}

$.ajax({
url: '@Url.Action("ResetPassword", "Account")',
type: 'POST',
data: { email: email, otp: otp, newPassword: p1 },
success: function (res) {
if (btn) {
btn.disabled = false;
btn.innerText = 'Thiết lập mật khẩu mới';
}
if (res.success) {
showToast(res.message, 'success');
setTimeout(function () {
switchAuthMode('login');
document.getElementById('login-email').value = email;
}, 1200);
}
else
{
    showToast(res.message, 'error');
}
},
error: function () {
if (btn) {
btn.disabled = false;
btn.innerText = 'Thiết lập mật khẩu mới';
}
showToast('Có lỗi xảy ra khi đặt lại mật khẩu!', 'error');
}
});
}

// --- GẮN EVENT LISTENERS KIỂM TRA ĐỊNH DẠNG EMAIL TỰ ĐỘNG KHÔNG CẦN CHỜ SUBMIT ---
$(document).ready(function () {
const loginForm = document.getElementById('form-login');
if (loginForm) {
loginForm.addEventListener('submit', function (e) {
const emailInput = document.getElementById('login-email');
const email = emailInput ? emailInput.value.trim() : '';
const emailErrorEl = document.getElementById('login-email-error');

if (!email) {
e.preventDefault();
if (emailErrorEl) {
emailErrorEl.innerText = 'Vui lòng nhập địa chỉ Email';
emailErrorEl.style.display = 'block';
}
if (emailInput) emailInput.setAttribute('aria-invalid', 'true');
showToast('Vui lòng nhập địa chỉ Email!', 'error');
return false;
}

if (!isValidEmailFormat(email)) {
e.preventDefault();
if (emailErrorEl) {
emailErrorEl.innerText = 'Địa chỉ Email không đúng định dạng (ví dụ: tenban@gmail.com)';
emailErrorEl.style.display = 'block';
}
if (emailInput) emailInput.setAttribute('aria-invalid', 'true');
showToast('Email không đúng định dạng!', 'error');
return false;
}
});
}

bindEmailInputEvents('reg-email', 'reg-email-error');
bindEmailInputEvents('login-email', 'login-email-error');
bindEmailInputEvents('forgot-email', 'forgot-email-error');
});

function bindEmailInputEvents(inputId, errorId) {
const input = document.getElementById(inputId);
const errorEl = document.getElementById(errorId);
if (!input) return;

input.addEventListener('blur', function () {
const val = input.value.trim();
if (val && !isValidEmailFormat(val)) {
if (errorEl) {
errorEl.innerText = 'Định dạng Email không hợp lệ! Vui lòng nhập đủ ký tự @@, tên miền và đuôi (ví dụ: tenban@@gmail.com)';
errorEl.style.display = 'block';
}
input.setAttribute('aria-invalid', 'true');
} else if (val && isValidEmailFormat(val)) {
if (errorEl && (errorEl.innerText.includes('định dạng') || errorEl.innerText.includes('Định dạng'))) {
errorEl.style.display = 'none';
}
input.setAttribute('aria-invalid', 'false');
}
});

input.addEventListener('input', function () {
const val = input.value.trim();
if (isValidEmailFormat(val)) {
if (errorEl && (errorEl.innerText.includes('định dạng') || errorEl.innerText.includes('Định dạng'))) {
errorEl.style.display = 'none';
}
input.setAttribute('aria-invalid', 'false');
}
});
}
</script>
}