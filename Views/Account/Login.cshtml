btn.innerText = 'Đang xử lý đăng ký...';
}

$.ajax({
url: '@Url.Action("VerifyOtpAndRegister", "Account")',
type: 'POST',
data: { fullName: fullname, email: email, otp: otp, password: p1 },
success: function (res) {
if (res.success) {
showToast(res.message, 'success');
setTimeout(function () {
window.location.href = res.redirectUrl || '@Url.Action("Index", "Home")';
}, 1000);
}
else
{
    showToast(res.message, 'error');
    if (btn) {
