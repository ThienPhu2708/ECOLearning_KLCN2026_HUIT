                        <span id="forgot-pass-match-error" class="field-validation-valid form-feedback-error" data-valmsg-for="ConfirmPassword" data-valmsg-replace="true" role="alert" aria-live="polite" style="display: none; color: #EF4444; font-size: 12px; font-weight: 600; margin-top: 6px;">Mật khẩu xác nhận không khớp!</span>
                    </div>

                    <div class="form-group" style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
                        <input type="checkbox" id="show-forgot-passwords" onchange="toggleForgotPasswords(this.checked)" style="width: 16px; height: 16px; accent-color: #434CE8; cursor: pointer;">
                        <label for="show-forgot-passwords" style="font-size: 13px; color: #475569; cursor: pointer; user-select: none; margin: 0;">Hiển thị mật khẩu</label>
                    </div>

                    <button type="submit" id="btn-reset-password" class="btn btn-primary" style="width: 100%; height: 48px; background: #434CE8; border-radius: 12px; font-weight: 700; margin-bottom: 12px;">Thiết lập mật khẩu mới</button>
                    <button type="button" class="btn btn-outline" style="width: 100%; height: 44px; border-radius: 12px;" onclick="cancelForgotPassword()"><i class="bi bi-x-lg me-1"></i> Hủy</button>
                </form>
            </div>
        </div>
