@model ECOLearning.ViewModels.CartViewModel
@* Danh sách mã trong hộp thoại "Chọn mã khuyến mãi" ở giỏ hàng: chỉ mã đã lưu trong "Mã giảm giá của tôi".
   Mã đang dùng đứng đầu, rồi mã dùng được (giảm nhiều trước), mã chưa đủ điều kiện kèm lý do ở cuối. *@
@{
    var ds = (Model.AvailableCoupons ?? new List<ECOLearning.ViewModels.MaGiamGiaHienThi>())
        .OrderByDescending(m => string.Equals(m.MaCode, Model.AppliedCouponCode, StringComparison.OrdinalIgnoreCase))
        .ToList();
    bool gioTrong = Model.Items == null || Model.Items.Count == 0;
    int soDungDuoc = gioTrong ? 0 : ds.Count(m => m.CoTheApDung);
    // Gợi ý sẵn mã giảm nhiều nhất cho giỏ hiện tại nhưng không tự áp (đặc tả Marketing mục 9)
    string maGoiY = gioTrong ? null : ds.Where(m => m.CoTheApDung && m.TienGiam > 0).OrderByDescending(m => m.TienGiam).Select(m => m.MaCode).FirstOrDefault();
}
<div class="cp-list" data-usable="@soDungDuoc">
    @if (!Model.IsLoggedIn)
    {
        <div class="cp-empty">
            <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Index", "Cart") })">Đăng nhập</a> để dùng mã đã lưu trong ví.
            Bạn vẫn có thể nhập mã ở ô phía trên.
        </div>
    }
    else if (ds.Count == 0)
    {
        <div class="cp-empty">
            Ví của bạn chưa có mã nào dùng được lúc này.<br />
            <a href="@Url.Action("Index", "Coupon", new { tab = "thuthap" })">Thu thập mã khuyến mãi</a> rồi quay lại để áp dụng.
        </div>
    }
    else
    {
        foreach (var m in ds)
        {
            bool dangDung = string.Equals(m.MaCode, Model.AppliedCouponCode, StringComparison.OrdinalIgnoreCase);
            bool dungDuoc = !gioTrong && m.CoTheApDung;
            <div class="cp-item @(dangDung ? "is-applied" : "") @(!dungDuoc && !dangDung ? "is-disabled" : "")">
                <div class="cp-item-value">
                    @m.GiaTriNgan
                    @if (!string.IsNullOrEmpty(m.GhiChuGiaTri))
                    {
                        <small>@m.GhiChuGiaTri</small>
                    }
                </div>
                <div class="cp-item-body">
                    @if (m.MaCode == maGoiY && !dangDung)
                    {
                        <div style="display: inline-block; font-size: 11px; font-weight: 700; color: #047857; background: #ECFDF5; border-radius: 9999px; padding: 1px 8px; margin-bottom: 3px;"><i class="bi bi-stars"></i> Gợi ý: giảm nhiều nhất</div>
                    }
                    <div class="cp-item-title">@m.MoTaUuDai</div>
                    <div class="cp-item-name"><span class="cp-code">@m.MaCode</span> @m.TenKhuyenMai</div>
                    <div class="cp-cond">@string.Join(" · ", m.DieuKien) · @(m.ChuaBatDau ? "Từ " + m.NgayBatDau.ToString("dd/MM/yyyy") + " · " : "")HSD @m.NgayKetThuc.ToString("dd/MM/yyyy")</div>
                    @if (dungDuoc && m.TienGiam > 0)
                    {
                        <div class="cp-save">Giảm @m.TienGiam.ToString("N0") đ cho giỏ hàng này</div>
                    }
                    else if (gioTrong)
                    {
                        <div class="cp-reason">Thêm khóa học vào giỏ để dùng mã.</div>
                    }
                    else if (!m.CoTheApDung && !string.IsNullOrEmpty(m.LyDo))
                    {
                        <div class="cp-reason">@m.LyDo</div>
                    }
                </div>
                <div class="cp-item-action">
                    @if (dangDung)
                    {
                        <span class="cp-btn-applied"><i class="bi bi-check2"></i> Đang dùng</span>
                    }
                    else
                    {
                        <button type="button" class="cp-btn" data-code="@m.MaCode" onclick="applyCoupon(this.getAttribute('data-code'))" @(dungDuoc ? "" : "disabled")>Áp dụng</button>
                    }
                </div>
            </div>
        }
    }
    @if (Model.ThanThietSapMo.Any())
    {
        <div style="margin-top: 12px; padding: 10px 12px; border: 1px dashed #FCD34D; background: #FFFBEB; border-radius: 12px;">
            <div style="font-weight: 700; font-size: 13px; color: #92400E; margin-bottom: 4px;"><i class="bi bi-award"></i> Ưu đãi thân thiết sắp mở</div>
            @foreach (var u in Model.ThanThietSapMo)
            {
                <div style="font-size: 13px; color: #78350F;"><strong>@u.GiaTriNgan</strong> · @u.TenKhuyenMai: @u.TienDo</div>
            }
        </div>
    }
</div>
