@model ECOLearning.ViewModels.StudentChatIndexViewModel
@{
    ViewBag.Title = "Tin nhắn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int currentUserId = Session["UserId"] != null ? (int)Session["UserId"] : 0;
}

<link rel="stylesheet" href="~/assets/css/chat.css?v=@(System.IO.File.GetLastWriteTime(Server.MapPath("~/assets/css/chat.css")).Ticks)" />

<div class="student-inbox-page">
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-warning">@ViewBag.Error</div>
    }

    <div class="chat-app-container student-inbox @(Model.PhongChatHienTai != null ? "has-conversation" : "")">
        <!-- 1. SIDEBAR HỘI THOẠI -->
        <div class="chat-sidebar">
            <div class="chat-sidebar-header">
                <h2><i class="bi bi-chat-dots-fill text-teal"></i> Tin nhắn của tôi</h2>
            </div>

            <div class="chat-conversation-list">
                @if (Model.DanhSachHoiThoai == null || !Model.DanhSachHoiThoai.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-chat-square-text fs-2 mb-2 d-block"></i>
                        Bạn chưa có cuộc trò chuyện nào với giáo viên.
                        <p class="small mt-2">Vào trang khóa học đang học và bấm <b>"Hỏi giáo viên"</b> để bắt đầu trao đổi nhé!</p>
                    </div>
                }
                else
                {
                    foreach (var c in Model.DanhSachHoiThoai)
                    {
                        bool isActive = Model.SelectedHoiThoaiId == c.MaHoiThoai;
                        <a href="@Url.Action("Index", "Chat", new { id = c.MaHoiThoai })" 
                           class="chat-conv-item @(isActive ? "active" : "") @(c.SoTinChuaDoc > 0 ? "is-unread" : "")"
                           id="conv-item-@c.MaHoiThoai">
                            <div class="chat-avatar-wrap">
                                <img src="@(string.IsNullOrEmpty(c.AnhDaiDienGiaoVien) ? "/assets/images/default-avatar.png" : c.AnhDaiDienGiaoVien)" 
                                     class="chat-avatar-img" alt="@c.TenGiaoVien" />
                            </div>
                            <div class="chat-conv-info">
                                <div class="chat-conv-top">
                                    <span class="chat-conv-name">@c.TenGiaoVien</span>
                                    <span class="chat-conv-time">@(c.TinCuoiLuc.HasValue ? c.TinCuoiLuc.Value.ToString("dd/MM") : "")</span>
                                </div>
                                <div class="chat-conv-course">@c.TenKhoaHoc</div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="chat-conv-last-msg">@(string.IsNullOrEmpty(c.TinCuoiTomTat) ? "Bắt đầu cuộc trò chuyện..." : c.TinCuoiTomTat)</span>
                                </div>
                            </div>
                            <span class="inbox-unread-dot" hidden="@(c.SoTinChuaDoc == 0)" aria-label="Tin nhắn chưa đọc"></span>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- 2. KHUNG CHAT CHÍNH -->
        <div class="chat-main">
            @if (Model.PhongChatHienTai != null)
            {
                var ht = Model.PhongChatHienTai.HoiThoai;
                <div class="chat-main-header">
                    <div class="chat-header-user">
                        <a class="student-chat-back" href="@Url.Action("Index", "Chat", new { id = "" })" aria-label="Quay lại danh sách tin nhắn"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                        <img src="@(string.IsNullOrEmpty(ht.AnhDaiDienGiaoVien) ? "/assets/images/default-avatar.png" : ht.AnhDaiDienGiaoVien)" 
                             class="chat-avatar-img" style="width: 42px; height: 42px;" alt="@ht.TenGiaoVien" />
                        <div>
                            <h3 class="chat-header-title">@ht.TenGiaoVien</h3>
                            <div class="chat-header-sub"><i class="bi bi-book"></i> @ht.TenKhoaHoc</div>
                        </div>
                    </div>
                    <div class="chat-header-actions">
                        <button type="button" class="student-chat-report" onclick="reportConversation(@ht.MaHoiThoai)" title="Báo cáo vi phạm" aria-label="Báo cáo cuộc trò chuyện">
                            <i class="bi bi-flag" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="chat-alert-banner">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Trao đổi về bài học. Thanh toán chỉ thực hiện trên hệ thống.</span>
                </div>

                <!-- Thân tin nhắn -->
                <div class="chat-messages-body" id="chat-messages-container">
                    @foreach (var m in Model.PhongChatHienTai.DanhSachTinNhan)
                    {
                        bool isMine = m.LaCuaToi;
                        <div class="chat-msg-row @(isMine ? "msg-mine" : "msg-other")" id="msg-row-@m.MaTinNhan" data-sender="@m.MaNguoiGui" tabindex="0">
                            <img src="@(string.IsNullOrEmpty(m.AnhDaiDien) ? "/assets/images/default-avatar.png" : m.AnhDaiDien)" 
                                 class="chat-msg-avatar" alt="@m.TenNguoiGui" />
                            <div>
                                <div class="chat-msg-bubble @(m.DaThuHoi ? "chat-msg-recalled" : "")">@if (m.ImageUrl != null) { <button type="button" class="chat-image-open" data-image-url="@m.ImageUrl"><img class="chat-image" src="@m.ImageUrl" alt="Ảnh trong cuộc trò chuyện" /></button> } else { @m.NoiDung }</div>
                                <div class="chat-msg-time">
                                    @m.NgayGui.ToString("HH:mm")
                                    @if (isMine && m.CoTheThuHoi)
                                    {
                                        <button type="button" class="chat-recall-btn" data-recall-seconds="@m.RecallSeconds" onclick="EcoChat.recallMessage(@m.MaTinNhan)" title="Thu hồi tin trong 5 phút" aria-label="Thu hồi tin nhắn">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="chat-typing-indicator" id="chat-typing-indicator">
                    <i class="bi bi-pencil-fill"></i> Giáo viên đang soạn tin...
                </div>

                <!-- Ô nhập tin nhắn -->
                <div class="chat-footer">
                    @if (ht.TrangThai == "ChiDoc")
                    {
                        <div class="w-100 text-center text-muted py-2">
                            <i class="bi bi-lock-fill"></i> Cuộc trò chuyện này ở chế độ chỉ đọc.
                        </div>
                    }
                    else
                    {
                        <textarea class="chat-input" id="chat-message-input" rows="1" maxlength="2000" aria-label="Nội dung tin nhắn" placeholder="Nhập tin nhắn..."></textarea>
                        <button type="button" class="chat-send-btn" id="chat-send-btn" title="Gửi tin nhắn">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="inbox-empty-conversation">
                    <span class="inbox-empty-icon"><i class="bi bi-chat-square-text" aria-hidden="true"></i></span>
                    <h3>Chưa chọn cuộc trò chuyện</h3>
                    <p>Chọn giáo viên bên trái để xem tin nhắn.</p>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    @Html.AntiForgeryToken()
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script src="~/assets/js/chat.js?v=@(System.IO.File.GetLastWriteTime(Server.MapPath("~/assets/js/chat.js")).Ticks)"></script>
    <script>
        $(document).ready(function () {
            var inbox = document.querySelector('.student-inbox');
            function fitStudentChat() {
                if (window.innerWidth > 768) { inbox.style.removeProperty('--student-chat-height'); return; }
                var viewport = window.visualViewport;
                var height = viewport ? viewport.height : window.innerHeight;
                var top = Math.max(0, inbox.getBoundingClientRect().top - (viewport ? viewport.offsetTop : 0));
                inbox.style.setProperty('--student-chat-height', Math.max(180, height - top - 12) + 'px');
            }
            window.addEventListener('resize', fitStudentChat);
            if (window.visualViewport) window.visualViewport.addEventListener('resize', fitStudentChat);
            fitStudentChat();
            $('.student-inbox .chat-avatar-img,.student-inbox .chat-msg-avatar').each(function () {
                var image = this;
                function fallback() {
                    var avatar = document.createElement('span'); avatar.className = image.className + ' chat-avatar-fallback';
                    avatar.textContent = (image.alt || '?').trim().charAt(0).toUpperCase(); avatar.setAttribute('aria-hidden','true'); image.replaceWith(avatar);
                }
                image.addEventListener('error', fallback, { once:true }); if (image.complete && !image.naturalWidth) fallback();
            });
            var convId = @(Model.SelectedHoiThoaiId ?? 0);
            var userId = @currentUserId;

            if (userId > 0) {
                EcoChat.isActive = function () { return inbox.classList.contains('has-conversation') && !document.hidden; };
                EcoChat.init(userId, false);
                if (convId > 0) {
                    EcoChat.joinConversation(convId);
                }
            }
        });

        function reportConversation(convId) {
            if (confirm('Bạn muốn báo cáo cuộc hội thoại này cho Quản trị viên kiểm tra nội dung vi phạm?')) {
                $.post('@Url.Action("Report", "Chat")', { conversationId: convId, reason: 'Báo cáo từ học viên', __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function (res) {
                    alert(res.message);
                });
            }
        }
    </script>
}

