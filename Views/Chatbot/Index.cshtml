@{
    ViewBag.Title = "Trợ lý Elearning";
}

<style>
    .eco-chat { max-width: 820px; margin: 32px auto 60px; padding: 0 16px; }
    .eco-chat h1 { font-size: 24px; margin: 0 0 4px; }
    .eco-chat .sub { color: var(--text-secondary, #64748B); margin: 0 0 16px; }
    .eco-chat-box { background: #fff; border: 1px solid var(--border-color, #E2E8F0); border-radius: 14px; display: flex; flex-direction: column; height: 70vh; min-height: 420px; }
    .eco-chat-log { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
    .eco-msg { max-width: 85%; padding: 10px 14px; border-radius: 14px; line-height: 1.5; word-break: break-word; }
    .eco-msg.user { align-self: flex-end; background: #434CE8; color: #fff; border-bottom-right-radius: 4px; }
    .eco-msg.bot { align-self: flex-start; background: #F1F5F9; color: #0F172A; border-bottom-left-radius: 4px; }
    .eco-msg.err { background: #FEF2F2; color: #B91C1C; }
    .eco-dbg { align-self: flex-start; font-size: 11px; color: #94A3B8; margin-top: -6px; }
    .eco-cards { align-self: flex-start; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; width: 100%; }
    .eco-card { display: flex; gap: 10px; border: 1px solid var(--border-color, #E2E8F0); border-radius: 12px; padding: 8px; text-decoration: none; color: inherit; background: #fff; }
    .eco-card:hover { border-color: #434CE8; }
    .eco-card img { width: 72px; height: 54px; object-fit: cover; border-radius: 8px; flex-shrink: 0; background: #E2E8F0; }
    .eco-card .t { font-weight: 700; font-size: 13px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .eco-card .m { font-size: 12px; color: #64748B; margin-top: 2px; }
    .eco-card .g { font-size: 13px; font-weight: 700; color: #434CE8; }
    .eco-chat-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--border-color, #E2E8F0); }
    .eco-chat-form input[type=text] { flex: 1; border: 1px solid var(--border-color, #CBD5E1); border-radius: 10px; padding: 10px 14px; font-size: 15px; }
    .eco-chat-form button { border: 0; border-radius: 10px; padding: 0 18px; font-weight: 700; cursor: pointer; }
    .eco-chat-form .gui { background: #434CE8; color: #fff; }
    .eco-chat-form .gui:disabled { opacity: .55; cursor: wait; }
    .eco-chat-form .xoa { background: #F1F5F9; color: #475569; }
    .eco-sg { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .eco-sg button { border: 1px solid var(--border-color, #CBD5E1); background: #fff; border-radius: 999px; padding: 6px 12px; font-size: 13px; cursor: pointer; }
</style>

<div class="eco-chat">
    <h1>Trợ lý Elearning</h1>
    <p class="sub">Hỏi về khóa học: tìm theo chủ đề, giá, cấp độ. Dữ liệu lấy trực tiếp từ hệ thống.</p>

    <div class="eco-chat-box">
        <div class="eco-chat-log" id="chat-log" aria-live="polite">
            <div class="eco-msg bot">Xin chào! Mình là Trợ lý Elearning. Bạn muốn học gì hôm nay?</div>
        </div>
        <form class="eco-chat-form" id="chat-form" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="text" id="chat-input" maxlength="500" placeholder="Ví dụ: Có khóa Python nào dưới 300.000đ không?" aria-label="Câu hỏi" />
            <button type="submit" class="gui" id="chat-send">Gửi</button>
            <button type="button" class="xoa" id="chat-clear" title="Xóa cuộc trò chuyện">Xóa</button>
        </form>
    </div>

    <div class="eco-sg" id="chat-suggest">
        <button type="button">Mình mới học lập trình, nên bắt đầu từ khóa nào?</button>
        <button type="button">Có khóa Python nào dưới 300.000đ không?</button>
        <button type="button">Khóa học miễn phí nào đáng học?</button>
        <button type="button">Khóa nào được đánh giá cao nhất?</button>
    </div>
</div>

@section scripts {
<script>
(function () {
    var log = document.getElementById('chat-log');
    var form = document.getElementById('chat-form');
    var input = document.getElementById('chat-input');
    var send = document.getElementById('chat-send');
    var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
    var dang = false;

    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    // Chữ đậm **...** và xuống dòng; mọi thứ khác đều được escape trước
    function dinhDang(s) { return esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>'); }
    function tien(n) { return n > 0 ? Number(n).toLocaleString('vi-VN') + 'đ' : 'Miễn phí'; }
    function cuonXuong() { log.scrollTop = log.scrollHeight; }

    function them(loai, html) {
        var d = document.createElement('div');
        d.className = 'eco-msg ' + loai;
        d.innerHTML = html;
        log.appendChild(d);
        cuonXuong();
        return d;
    }

    function themThe(ds) {
        if (!ds || !ds.length) return;
        var w = document.createElement('div');
        w.className = 'eco-cards';
        ds.forEach(function (c) {
            var a = document.createElement('a');
            a.className = 'eco-card';
            a.href = c.url; a.target = '_blank'; a.rel = 'noopener';
            a.innerHTML = (c.anh ? '<img src="' + esc(c.anh) + '" alt="" loading="lazy" referrerpolicy="no-referrer">' : '<img alt="">') +
                '<div><div class="t">' + esc(c.ten) + '</div>' +
                '<div class="m">' + esc(c.giaoVien || '') + (c.soDanhGia > 0 ? ' · ★ ' + c.diem : '') + '</div>' +
                '<div class="g">' + tien(c.gia) + '</div></div>';
            w.appendChild(a);
        });
        log.appendChild(w);
        cuonXuong();
    }

    function hoi(cau) {
        cau = (cau || '').trim();
        if (!cau || dang) return;
        dang = true; send.disabled = true; input.value = '';
        document.getElementById('chat-suggest').style.display = 'none';
        them('user', esc(cau));
        var cho = them('bot', '<em>Đang trả lời…</em>');

        var body = new URLSearchParams();
        body.append('__RequestVerificationToken', token);
        body.append('cauHoi', cau);

        fetch('@Url.Action("Hoi", "Chatbot")', { method: 'POST', body: body, credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                cho.className = 'eco-msg ' + (d.ok ? 'bot' : 'bot err');
                cho.innerHTML = dinhDang(d.reply);
                if (d.ok) themThe(d.courses);
                if (d.debug) {
                    var g = document.createElement('div');
                    g.className = 'eco-dbg';
                    g.textContent = d.debug.loi ? ('Lỗi: ' + d.debug.loi) :
                        ('Mô hình: ' + d.debug.model + (d.debug.duPhong ? ' (dự phòng)' : '') + ' · ' + d.debug.congCu + ' lượt gọi công cụ · ' + (d.debug.ms / 1000).toFixed(1) + ' s');
                    log.appendChild(g);
                }
            })
            .catch(function () { cho.className = 'eco-msg bot err'; cho.textContent = 'Không kết nối được máy chủ, bạn thử lại nhé.'; })
            .then(function () { dang = false; send.disabled = false; input.focus(); cuonXuong(); });
    }

    form.addEventListener('submit', function (e) { e.preventDefault(); hoi(input.value); });
    document.querySelectorAll('#chat-suggest button').forEach(function (b) { b.addEventListener('click', function () { hoi(b.textContent); }); });
    document.getElementById('chat-clear').addEventListener('click', function () {
        var body = new URLSearchParams(); body.append('__RequestVerificationToken', token);
        fetch('@Url.Action("Xoa", "Chatbot")', { method: 'POST', body: body, credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' } })
            .then(function () { log.innerHTML = '<div class="eco-msg bot">Đã xóa cuộc trò chuyện. Bạn muốn hỏi gì tiếp?</div>'; document.getElementById('chat-suggest').style.display = ''; });
    });
})();
</script>
}
