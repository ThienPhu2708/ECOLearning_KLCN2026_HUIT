@model ECOLearning.ViewModels.ViMaGiamGiaViewModel
@{
    ViewBag.Title = "Mã giảm giá của tôi";
    string linkDung = Model.GioHangCoKhoaHoc ? Url.Action("Index", "Cart") : Url.Action("Index", "Course");
    var tabs = new[]
    {
        new { Key = "codung", Ten = "Có thể dùng", So = Model.CoTheDung.Count },
        new { Key = "dadung", Ten = "Đã dùng", So = Model.DaDung.Count },
        new { Key = "hethan", Ten = "Hết hiệu lực", So = Model.HetHieuLuc.Count },
        new { Key = "thuthap", Ten = "Thu thập mã", So = Model.CoTheThuThap.Count }
    };
    string thanhCong = TempData["CouponSuccess"] as string;
    string loi = TempData["CouponError"] as string;
    string maNhap = TempData["CouponInput"] as string;
}

<main class="cpn-page">
    <div class="safe-container">
        <div class="cpn-page-head">
            <div>
                <h1>Mã giảm giá của tôi</h1>
                <p>Lưu mã vào ví, đến giỏ hàng chỉ cần chọn mã ở mục <strong>Mã giảm giá</strong>. Mỗi đơn hàng dùng tối đa 1 mã. Mã đã lưu không thể xóa.</p>
            </div>
        </div>

        @using (Html.BeginForm("Redeem", "Coupon", FormMethod.Post, new { @class = "cpn-redeem" }))
        {
            @Html.AntiForgeryToken()
            <input type="text" name="code" class="form-control" maxlength="30" placeholder="Nhập mã Marketing gửi cho bạn" value="@maNhap" aria-label="Nhập mã giảm giá" required />
            <button type="submit" class="btn btn-primary">Lưu vào ví</button>
        }
        @if (thanhCong != null) { <div class="cpn-flash is-ok" role="status"><i class="bi bi-check-circle-fill me-1"></i> @thanhCong</div> }
        @if (loi != null) { <div class="cpn-flash is-error" role="alert"><i class="bi bi-exclamation-circle-fill me-1"></i> @loi</div> }

        <nav class="cpn-tabs" aria-label="Lọc mã giảm giá">
            @foreach (var t in tabs)
            {
                <a class="cpn-tab @(Model.Tab == t.Key ? "is-active" : "")" href="@Url.Action("Index", "Coupon", new { tab = t.Key })" @(Model.Tab == t.Key ? "aria-current=page" : "")>
                    @t.Ten<span class="cpn-tab-count">@t.So</span>
                </a>
            }
        </nav>

        @if (Model.Tab == "thuthap")
        {
            if (Model.CoTheThuThap.Count == 0)
            {
                <div class="cpn-empty"><i class="bi bi-ticket-perforated"></i>Hiện chưa có mã công khai mới. Bạn đã lưu hết các mã đang có.</div>
            }
            else
            {
                <div class="cpn-grid">
                    @foreach (var m in Model.CoTheThuThap)
                    {
                        @Html.Partial("_CouponTicket", new ECOLearning.ViewModels.TheMaGiamGiaModel { Ma = m })
                    }
                </div>
            }
        }
        else
        {
            var ds = Model.Tab == "dadung" ? Model.DaDung : Model.Tab == "hethan" ? Model.HetHieuLuc : Model.CoTheDung;
            if (ds.Count == 0)
            {
                <div class="cpn-empty">
                    <i class="bi bi-ticket-perforated"></i>
                    @if (Model.Tab == "codung")
                    {
                        <span>Bạn chưa có mã nào dùng được.</span>
                        if (Model.CoTheThuThap.Count > 0)
                        {
                            <span> <a href="@Url.Action("Index", "Coupon", new { tab = "thuthap" })">Thu thập @Model.CoTheThuThap.Count mã đang có</a></span>
                        }
                    }
                    else if (Model.Tab == "dadung")
                    {
                        <span>Bạn chưa dùng hết lượt của mã nào.</span>
                    }
                    else
                    {
                        <span>Không có mã hết hiệu lực.</span>
                    }
                </div>
            }
            else
            {
                <div class="cpn-grid">
                    @foreach (var v in ds)
                    {
                        string nhan = null;
                        string dongPhu = null;
                        if (v.TrangThai == "CoTheDung")
                        {
                            if (v.LuotCuaToi > 0 && v.GioiHanMoiHocVien.HasValue) { dongPhu = "Đã dùng " + v.LuotCuaToi + "/" + v.GioiHanMoiHocVien.Value + " lượt của bạn"; }
                        }
                        else if (v.TrangThai == "SapDienRa")
                        {
                            nhan = "Dùng được từ " + v.Ma.NgayBatDau.ToString("dd/MM/yyyy");
                        }
                        else
                        {
                            nhan = v.NhanTrangThai;
                            if (v.TrangThai == "DaDung" && v.LichSu.Any())
                            {
                                dongPhu = string.Join("; ", v.LichSu.Take(3).Select(l => l.NgaySuDung.ToString("dd/MM/yyyy") + " · đơn " + l.MaDonHang + " · giảm " + l.TienGiam.ToString("N0") + " đ"));
                            }
                        }
                        @Html.Partial("_CouponTicket", new ECOLearning.ViewModels.TheMaGiamGiaModel
                        {
                            Ma = v.Ma,
                            NhanTrangThai = nhan,
                            DongPhu = dongPhu,
                            LamMo = v.TrangThai == "DaDung" || v.TrangThai == "HetHieuLuc",
                            LinkDungNgay = v.TrangThai == "CoTheDung" ? linkDung : null,
                            HienNutLuu = false
                        })
                    }
                </div>
            }
        }

        @if ((Model.Tab == "thuthap" || Model.Tab == "codung") && Model.ThanThietSapMo.Any())
        {
            <section class="cpn-loyal" aria-label="Ưu đãi thân thiết sắp mở">
                <h2><i class="bi bi-award"></i> Ưu đãi thân thiết sắp mở</h2>
                @foreach (var u in Model.ThanThietSapMo)
                {
                    <div class="cpn-loyal-item">
                        <div class="cpn-loyal-value">@u.GiaTriNgan</div>
                        <div>
                            <div class="cpn-loyal-name">@u.TenKhuyenMai</div>
                            <div class="cpn-loyal-progress">@u.TienDo</div>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
</main>
