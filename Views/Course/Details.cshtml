@model ECOLearning.Models.KhoaHoc
@{
    ViewBag.Title = (Model != null ? Model.tenKhoaHoc : "Chi tiết khóa học") + " | E-Learning Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var chapters = ViewBag.Chapters as List<ECOLearning.Models.ChuongHoc> ?? (Model != null && Model.ChuongHoc != null ? Model.ChuongHoc.OrderBy(c => c.thuTu).ToList() : new List<ECOLearning.Models.ChuongHoc>());
    var unchapteredLessons = ViewBag.UnchapteredLessons as List<ECOLearning.Models.BaiHoc> ?? new List<ECOLearning.Models.BaiHoc>();
    bool isEnrolled = ViewBag.IsEnrolled ?? false;
    bool isInCart = ViewBag.IsInCart ?? false;
    bool isOwner = ViewBag.IsOwner ?? false;
    bool isGuest = !User.Identity.IsAuthenticated && Session["UserId"] == null;

    int totalLessons = chapters.Sum(c => c.BaiHoc != null ? c.BaiHoc.Count : 0) + unchapteredLessons.Count;
    int totalDurationSeconds = chapters.Sum(c => c.BaiHoc != null ? c.BaiHoc.Sum(b => b.thoiLuong ?? 0) : 0) + unchapteredLessons.Sum(b => b.thoiLuong ?? 0);
    int totalMinutes = totalDurationSeconds / 60;

    var allLessonsList = chapters.SelectMany(c => c.BaiHoc != null ? c.BaiHoc : new List<ECOLearning.Models.BaiHoc>()).Concat(unchapteredLessons).ToList();

    var previewLesson = allLessonsList.FirstOrDefault(b => b.choXemThu == true && !string.IsNullOrEmpty(b.duongDanVideo));
    if (previewLesson == null)
    {
        previewLesson = allLessonsList.FirstOrDefault(b => !string.IsNullOrEmpty(b.duongDanVideo));
    }
    // Video tải lên (máy chủ hoặc Cloudflare R2): phát qua VideoStream/Play (không dùng Session) để hỗ trợ HTTP Range Request
    // đúng chuẩn; video R2 được chuyển hướng sang link ký có hạn dùng. YouTube / link ngoài giữ nguyên
    Func<string, string> toPlayableVideoUrl = ECOLearning.Services.VideoStorageService.LinkPhat;

    string previewVideoUrl = previewLesson != null ? toPlayableVideoUrl(previewLesson.duongDanVideo) : "";
    string previewLessonTitle = previewLesson != null ? previewLesson.tenBaiHoc : "Video giới thiệu khóa học";

    double avgRating = Model != null && Model.DanhGiaKhoaHoc != null && Model.DanhGiaKhoaHoc.Count > 0
        ? Model.DanhGiaKhoaHoc.Average(d => (double)d.soSao)
        : 0.0;
    int reviewCount = Model != null && Model.DanhGiaKhoaHoc != null ? Model.DanhGiaKhoaHoc.Count : 0;
}

