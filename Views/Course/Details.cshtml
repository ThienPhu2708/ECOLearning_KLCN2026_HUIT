            box-shadow: 0 20px 30px -10px rgba(15, 23, 42, 0.08);
            overflow: hidden;
            position: sticky;
            top: 96px;
        }

        .preview-media-container {
            position: relative;
            cursor: pointer;
            overflow: hidden;
            background: #0F172A;
        }

        .preview-media-container img {
            width: 100%;
            height: 210px;
            object-fit: cover;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .preview-media-container:hover img {
            transform: scale(1.06);
        }

        .play-btn-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #434CE8 0%, #6366F1 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 24px;
            box-shadow: 0 0 25px rgba(67, 76, 232, 0.6);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .preview-media-container:hover .play-btn-overlay {
            transform: translate(-50%, -50%) scale(1.15);
        }

        .price-tag-big {
            font-size: 28px;
            font-weight: 800;
            color: #434CE8;
            letter-spacing: -0.02em;
            white-space: nowrap;
            line-height: 1;
        }

        .price-tag-old {
            font-size: 15px;
            color: #94A3B8;
            text-decoration: line-through;
            white-space: nowrap;
        }

        .badge-discount-tag {
            background: #FEF2F2;
            color: #EF4444;
            font-size: 12px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid #FCA5A5;
            white-space: nowrap;
        }

        .curriculum-chapter-card {
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            margin-bottom: 16px;
            overflow: hidden;
            background: #FFFFFF;
            transition: border-color 0.2s;
        }

        .curriculum-chapter-card:hover {
            border-color: #CBD5E1;
        }

        .chapter-header {
            background: #F8FAFC;
            padding: 16px 20px;
            font-weight: 700;
            font-size: 15px;
            color: #1E293B;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: background 0.2s;
        }

        .chapter-header:hover {
            background: #F1F5F9;
        }

        .lesson-item-row {
            padding: 14px 20px;
            border-top: 1px solid #F1F5F9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 14px;
            transition: background 0.2s;
        }

        .lesson-item-row:hover {
            background: #F8FAFC;
        }

        .badge-preview {
            background: #DEF7EC;
            color: #03543F;
            font-size: 12px;
            padding: 4px 12px;
            border-radius: 9999px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, background 0.2s;
            border: 1px solid #84E1BC;
        }

        .badge-preview:hover {
            transform: translateY(-1px);
            background: #BCF0DA;
        }

        .video-placeholder-container {
            padding: 40px 20px;
            text-align: center;
            background: #000;
            color: #fff;
            border-radius: 12px;
        }

        .btn-cta-primary {
            background: #434CE8 !important;
            border: none !important;
            color: #FFFFFF !important;
            font-weight: 700 !important;
            box-shadow: 0 4px 12px rgba(67, 76, 232, 0.2);
            transition: background-color 0.2s ease, opacity 0.2s ease !important;
        }

        .btn-cta-primary:hover {
            background: #3B43D6 !important;
            opacity: 0.96;
            transform: none !important;
            box-shadow: 0 4px 12px rgba(67, 76, 232, 0.25) !important;
        }

        /* Scoped utilities for Details Page */
        .details-page-main .d-flex { display: flex !important; }
        .details-page-main .flex-wrap { flex-wrap: wrap !important; }
        .details-page-main .flex-grow-1 { flex: 1 1 0% !important; flex-grow: 1 !important; }
        .details-page-main .flex-shrink-0 { flex-shrink: 0 !important; }
        .details-page-main .align-items-center { align-items: center !important; }
        .details-page-main .align-items-start { align-items: flex-start !important; }
        .details-page-main .align-items-baseline { align-items: baseline !important; }
        .details-page-main .justify-content-between { justify-content: space-between !important; }
        .details-page-main .gap-2 { gap: 8px !important; }
        .details-page-main .gap-3 { gap: 16px !important; }
        .details-page-main .gap-4 { gap: 24px !important; }
        .details-page-main .gap-5 { gap: 32px !important; }
        .details-page-main .w-100 { width: 100% !important; }
        .details-page-main .mb-0 { margin-bottom: 0 !important; }
        .details-page-main .mb-1 { margin-bottom: 4px !important; }
        .details-page-main .mb-2 { margin-bottom: 8px !important; }
        .details-page-main .mb-3 { margin-bottom: 12px !important; }
        .details-page-main .mb-4 { margin-bottom: 16px !important; }
        .details-page-main .mb-5 { margin-bottom: 24px !important; }
        .details-page-main .p-4 { padding: 24px !important; }
        .details-page-main .pt-2 { padding-top: 8px !important; }
        .details-page-main .pt-3 { padding-top: 12px !important; }
        .details-page-main .me-1 { margin-right: 4px !important; }
        .details-page-main .me-2 { margin-right: 8px !important; }
        .details-page-main .ms-1 { margin-left: 4px !important; }

        .details-page-main .row { display: flex; flex-wrap: wrap; margin-right: -12px; margin-left: -12px; }
        .details-page-main .col-md-6 { flex: 0 0 50%; max-width: 50%; padding-right: 12px; padding-left: 12px; box-sizing: border-box; }
        @@media (max-width: 768px) {
            .details-page-main .col-md-6 { flex: 0 0 100%; max-width: 100%; }
        }

        /* Curriculum Accordion Styles */
        .curriculum-chapter-card .collapse-content {
            display: block;
        }
        .chapter-header {
            user-select: none;
            cursor: pointer;
        }
        .chapter-header .chevron-icon {
            transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-block;
        }
        .chapter-header.collapsed .chevron-icon {
