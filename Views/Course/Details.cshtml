        }

        .breadcrumb-link {
            color: #94A3B8;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.2s;
        }

        .breadcrumb-link:hover {
            color: #38BDF8;
        }

        .course-title-main {
            font-size: 32px;
            font-weight: 800;
            line-height: 1.35;
            margin-top: 14px;
            margin-bottom: 16px;
            color: #FFFFFF;
            letter-spacing: -0.02em;
        }

        .pill-badge-category {
            display: inline-flex;
            align-items: center;
            background: rgba(224, 231, 255, 0.95);
            color: #434CE8;
            font-size: 13px;
            font-weight: 700;
            padding: 5px 16px;
            border-radius: 9999px;
            text-decoration: none;
        }

        .pill-badge-bestseller {
            display: inline-flex;
            align-items: center;
            background: #FEF3C7;
            color: #D97706;
            font-size: 13px;
            font-weight: 700;
            padding: 5px 16px;
            border-radius: 9999px;
        }

        .details-layout-grid {
            display: flex;
            gap: 36px;
            align-items: flex-start;
        }

        .details-left-content {
            flex: 1;
            min-width: 0;
        }

        .details-right-sidebar {
            width: 360px;
            flex-shrink: 0;
        }

        @@media (max-width: 991px) {
            .details-layout-grid {
