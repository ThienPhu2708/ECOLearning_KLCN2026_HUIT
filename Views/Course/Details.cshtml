            .fbt-thumb { flex-basis: auto; width: 100%; height: 170px; }
            .fbt-plus { margin: -10px auto; }
            .fbt-total { justify-content: space-between; }
            .fbt-btn-primary { width: 100%; }
        }

        .custom-modal-body {
            padding: 0;
            background: #000000;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 320px;
        }

        @@media (max-width: 640px) {
            .details-hero { padding: 28px 0 34px; margin-bottom: 22px; }
            .details-hero .safe-container { padding-left: 16px; padding-right: 16px; }
            .course-title-main { font-size: clamp(24px, 7vw, 32px); line-height: 1.2; overflow-wrap: anywhere; }
            .details-hero .breadcrumb-item { overflow-wrap: anywhere; }
            .details-page-main .details-layout-grid { gap: 20px; }
            .details-page-main .details-left-content .p-4 { padding: 16px !important; }
            .sticky-course-card { border-radius: 16px; }
            .preview-media-container img { height: auto; aspect-ratio: 16 / 9; }
            .price-tag-big { font-size: 24px; }
            .chapter-header { gap: 10px; padding: 14px; }
            .lesson-item-row { gap: 10px; padding: 12px 14px; }
            .badge-preview { flex: 0 0 auto; padding: 4px 8px; }
            .custom-modal-overlay { padding: 12px; min-height: 100dvh; height: 100dvh; }
            .custom-modal-dialog { max-height: calc(100dvh - 24px); display: flex; flex-direction: column; }
            .custom-modal-header { padding: 12px 14px; gap: 10px; }
            .custom-modal-body { min-height: 0; flex: 1 1 auto; }
            .video-placeholder-container { padding: 28px 16px !important; }
        }

    </style>
}

<main class="details-page-main">
    @if (Model == null)
    {
        <div class="safe-container py-5 text-center">
            <div class="alert alert-info py-5 rounded-4 shadow-sm" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
                <i class="bi bi-info-circle fs-1 text-primary mb-3 d-block"></i>
                <h4 class="fw-bold">Khóa học thử nghiệm đang được khởi tạo</h4>
                <p class="text-secondary">Dữ liệu thử nghiệm hệ thống đang được cập nhật tự động.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2" style="background: #434CE8; border-color: #434CE8;">Quay lại Trang chủ</a>
            </div>
        </div>
    }
    else
    {
        <!-- Header Hero Section -->
        <div class="details-hero">
            <div class="safe-container">
                @* Quay về trang trước (danh sách, tìm kiếm, trang chủ...); mở khóa ở tab mới hoặc vào thẳng đường dẫn thì về danh sách khóa học *@
                <a href="@Url.Action("Index", "Course")" class="details-back" id="details-back">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
                <script>
                    document.getElementById('details-back').addEventListener('click', function (e) {
                        try {
                            if (window.history.length > 1 && document.referrer && new URL(document.referrer).origin === window.location.origin) {
                                e.preventDefault();
                                window.history.back();
                            }
                        } catch (err) { /* dùng liên kết mặc định về danh sách khóa học */ }
                    });
                </script>

                <div class="details-title-row">
                    <h1 class="course-title-main">@Model.tenKhoaHoc</h1>
                    <div class="details-title-badges">
                    <span class="pill-badge-category">
                        @(Model.DanhMuc != null ? Model.DanhMuc.tenDanhMuc : "Lập trình & CNTT")
                    </span>
                    <span class="pill-badge-bestseller">
                        Bán chạy nhất
                    </span>
                    </div>
                </div>

                <!-- Short Description -->
                <p class="lead text-light opacity-75 fs-6 mb-4" style="max-width: 860px; line-height: 1.6; color: #94A3B8 !important; white-space: pre-line;">@Model.moTaNgan</p>

                <!-- Bottom Meta Info Bar -->
                <div class="d-flex align-items-center flex-wrap" style="font-size: 14.5px; column-gap: 24px; row-gap: 12px;">
                    <!-- Rating & Reviews -->
                    @{
                        double headerScore = reviewCount > 0 ? avgRating : 0.0;
                        int headerReviews = reviewCount;
                    }
                    <div class="d-flex align-items-center gap-1">
                        <span class="fw-bold" style="color: @(headerScore > 0 ? "#F59E0B" : "#94A3B8"); font-size: 15px;">@headerScore.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                        @ECOLearning.Services.RatingStars.Html(headerScore, "ms-1 star-rating-dark")
                        <span class="ms-1" style="color: #CBD5E1;">(@headerReviews đánh giá)</span>
                    </div>

                    <!-- Giảng viên -->
                    <div style="color: #94A3B8;">
                        Giáo viên: 
                        @if (Model.NguoiDung != null)
                        {
                            <a href="@Url.Action("Index", "User", new { id = Model.NguoiDung.maNguoiDung })" target="_blank" rel="noopener" title="Xem thông tin chi tiết giáo viên @Model.NguoiDung.hoTen" style="color: #FFFFFF; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; transition: color 0.2s;" onmouseover="this.style.color='#A5B4FC'" onmouseout="this.style.color='#FFFFFF'">
                                @Model.NguoiDung.hoTen
                            </a>
                        }
                        else
                        {
                            <strong style="color: #FFFFFF; font-weight: 700;">Giáo viên E-Learning</strong>
                        }
                    </div>


                    <!-- Cập nhật mới nhất -->
                    <div style="color: #94A3B8;">
                        Cập nhật mới nhất: <strong style="color: #FFFFFF; font-weight: 700;">@DateTime.Now.ToString("MM/yyyy")</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="safe-container">
            <div class="details-layout-grid">
                <!-- Left Main Content Column (Flex 1) -->
                <div class="details-left-content">
                    <!-- Section 1: Outcomes -->
                    @if (!string.IsNullOrEmpty(Model.mucTieuDauRa))
                    {
                        var outcomesList = ECOLearning.Services.CourseOutcomes.Tach(Model.mucTieuDauRa);

                        if (outcomesList.Any())
                        {
                            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: linear-gradient(135deg, #F8FAFC 0%, #EEF2FF 100%); border: 1px solid #C7D2FE !important;">
                                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-check-circle-fill text-primary me-2"></i>Mục tiêu đạt được sau khóa học</h5>
                                <div class="row g-3">
                                    @foreach (var outcome in outcomesList)
                                    {
                                        <div class="col-md-6 d-flex align-items-start gap-2">
                                            <i class="bi bi-check2-circle text-primary fs-5 flex-shrink-0 mt-1"></i>
                                            <span class="text-secondary fs-6 fw-medium lh-base">@outcome</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <!-- Section 2: Dynamic Curriculum Accordion (Tính năng Thu gọn / Mở rộng chương học) -->
                    <div class="mb-5">
                        <div class="d-flex align-items-center justify-content-between mb-3 gap-3 flex-wrap">
                            <h4 class="fw-bold text-dark m-0 text-nowrap" style="font-size: 20px;"><i class="bi bi-list-nested me-2 text-primary"></i>Đề cương chi tiết</h4>
                            <div class="d-flex align-items-center flex-wrap ms-auto text-muted" style="column-gap: 18px; row-gap: 8px; font-size: 14px;">
                                @if (chapters.Count > 0)
                                {
                                    <span class="text-nowrap"><strong>@chapters.Count</strong> chương</span>
                                }
                                <span class="text-nowrap"><strong>@totalLessons</strong> bài học</span>
                                <span class="text-nowrap"><strong>@totalMinutes</strong> phút</span>
                            </div>
                        </div>

                        @if (unchapteredLessons.Count > 0)
                        {
                            int unchapSeconds = unchapteredLessons.Sum(b => b.thoiLuong ?? 0);
                            int unchapMin = unchapSeconds / 60;

                            <div class="curriculum-chapter-card">
                                <div class="chapter-header" onclick="toggleChapterAccordion('collapseUnchapDetail', this)" title="Bấm để đóng / mở danh sách bài học">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-chevron-down text-primary chevron-icon"></i>
                                        <span class="fw-bold text-dark"><i class="bi bi-file-earmark-play me-2 text-primary"></i>@(chapters.Count > 0 ? "Bài học độc lập (Không phân chương)" : "Danh sách bài học")</span>
                                    </div>
                                    <span class="text-muted fw-normal fs-6">@unchapteredLessons.Count bài học (@unchapMin phút)</span>
                                </div>

                                <div id="collapseUnchapDetail" class="collapse-content">
                                    @foreach (var les in unchapteredLessons)
                                    {
                                        int lesMin = (les.thoiLuong ?? 0) / 60;
                                        int lesSec = (les.thoiLuong ?? 0) % 60;
                                        string durationText = string.Format("{0:D2}:{1:D2}", lesMin, lesSec);
                                        bool hasVideo = !string.IsNullOrEmpty(les.duongDanVideo);

                                        <div class="lesson-item-row">
                                            <div class="d-flex align-items-center gap-3">
                                                <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                                                <span class="fw-semibold text-dark">@les.tenBaiHoc</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (hasVideo && les.choXemThu == true)
                                                {
                                                    <span class="badge-preview" role="button" data-title="@les.tenBaiHoc" data-video="@toPlayableVideoUrl(les.duongDanVideo)" onclick="handlePreviewClick(this)">
                                                        <i class="bi bi-eye"></i> Học thử
                                                    </span>
                                                }
                                                else if (!hasVideo)
                                                {
                                                    <span class="badge bg-secondary opacity-75 fw-normal" style="font-size: 11px;">
                                                        <i class="bi bi-clock-history me-1"></i> Video đang phát triển
                                                    </span>
                                                }
                                                <span class="text-muted text-nowrap"><i class="bi bi-clock me-1"></i>@durationText</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (chapters.Count > 0)
                        {
                            int chapIndex = 1;
                            foreach (var chap in chapters)
                            {
                                var lessons = chap.BaiHoc != null ? chap.BaiHoc.OrderBy(b => b.thuTu).ToList() : new List<ECOLearning.Models.BaiHoc>();
                                int chapSeconds = lessons.Sum(b => b.thoiLuong ?? 0);
                                int chapMin = chapSeconds / 60;

                                <div class="curriculum-chapter-card">
                                    <div class="chapter-header" onclick="toggleChapterAccordion('collapseChap_@chapIndex', this)" title="Bấm để đóng / mở danh sách bài học">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-chevron-down text-primary chevron-icon"></i>
                                            <span class="fw-bold text-dark">@chap.tenChuong</span>
                                        </div>
                                        <span class="text-muted fw-normal fs-6">@lessons.Count bài học (@chapMin phút)</span>
                                    </div>

                                    <div id="collapseChap_@chapIndex" class="collapse-content">
                                        @if (lessons.Count > 0)
                                        {
                                            foreach (var les in lessons)
                                            {
                                                int lesMin = (les.thoiLuong ?? 0) / 60;
                                                int lesSec = (les.thoiLuong ?? 0) % 60;
                                                string durationText = string.Format("{0:D2}:{1:D2}", lesMin, lesSec);
                                                bool hasVideo = !string.IsNullOrEmpty(les.duongDanVideo);

                                                <div class="lesson-item-row">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                                                        <span class="fw-semibold text-dark">@les.tenBaiHoc</span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (hasVideo && les.choXemThu == true)
                                                        {
                                                            <span class="badge-preview" role="button" data-title="@les.tenBaiHoc" data-video="@toPlayableVideoUrl(les.duongDanVideo)" onclick="handlePreviewClick(this)">
                                                                <i class="bi bi-eye"></i> Học thử
                                                            </span>
                                                        }
                                                        else if (!hasVideo)
                                                        {
                                                            <span class="badge bg-secondary opacity-75 fw-normal" style="font-size: 11px;">
                                                                <i class="bi bi-clock-history me-1"></i> Video đang phát triển
                                                            </span>
                                                        }
                                                        <span class="text-muted text-nowrap"><i class="bi bi-clock me-1"></i>@durationText</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="p-3 text-center text-muted fs-6">Đang cập nhật bài học...</div>
                                        }
                                    </div>
                                </div>
                                chapIndex++;
                            }
                        }
                        else if (unchapteredLessons.Count == 0)
                        {
                            <div class="alert alert-info">Đang cập nhật khung chương trình học.</div>
                        }
                    </div>

                    <!-- Section 3: Course Description -->
                    <div class="mb-5">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-file-text me-2 text-primary"></i> Mô tả chi tiết khóa học</h4>
                        <div class="text-secondary fs-6 lh-lg p-4 rounded-4 bg-white border" style="border-color: #E2E8F0 !important; white-space: pre-line;">
                            @Model.moTa
                        </div>
                    </div>
                    
                    <!-- Giảng viên + các khóa khác của giảng viên (số liệu thật: Services/InstructorProfileService.cs) -->
                    @{ var giangVien = ViewBag.GiangVien as ECOLearning.ViewModels.GiangVienKhoaHocViewModel; }
                    @if (giangVien != null)
                    {
                        @Html.Partial("_InstructorInfo", giangVien)
                    }

                    <!-- Section 4: Student Reviews (UC6): 5 đánh giá mới nhất, hữu ích, phản hồi của giáo viên -->
                    @{ var danhGia = ViewBag.DanhGia as ECOLearning.ViewModels.DanhSachDanhGiaViewModel; }
                    @if (danhGia != null)
                    {
                        @Html.Partial("_ReviewSection", danhGia)
                    }
                    @* Item-based trên dữ liệu mua: "Thường xuyên được mua cùng nhau" + "Học viên khác cũng mua" *@
                    @{ var lienQuan = ViewBag.KhoaHocLienQuan as ECOLearning.ViewModels.KhoaHocLienQuanViewModel; }
                    @if (lienQuan != null && lienQuan.CoNoiDung)
                    {
                        <div class="rel-wrap">@Html.Partial("_RelatedCourses", lienQuan)</div>
                    }
                </div>

                <!-- Right Sticky Sidebar Column (Fixed 360px) -->
                <div class="details-right-sidebar">
                    <div class="sticky-course-card">
                        <div class="preview-media-container" role="button" data-title="@previewLessonTitle" data-video="@previewVideoUrl" onclick="handlePreviewClick(this)">
                            <img src="@(string.IsNullOrEmpty(Model.anhBia) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80" : Model.anhBia)" alt="@Model.tenKhoaHoc" />
                            <div class="play-btn-overlay">
                                <i class="bi bi-play-fill ms-1"></i>
                            </div>
                        </div>

                        <div class="p-4">
                            <!-- Price Block (Strict single horizontal line matching mockup 100%) -->
                            @{
                                // Giá hiệu lực do server tính (CourseDiscountService): giá gốc đã trừ giảm trực tiếp; coupon (ô mã bên dưới / giỏ hàng) tính sau
                                var giaKhoa = ECOLearning.Services.CourseDiscountService.Tinh(Model);
                                decimal originalPrice = giaKhoa.GiaGoc;
                                decimal salePrice = giaKhoa.Gia;
                                bool isFree = originalPrice <= 0;
                            }
                            <div class="d-flex align-items-baseline gap-2 mb-3" style="flex-wrap: nowrap; white-space: nowrap;">
                                @if (isFree)
                                {
                                    <span style="font-size: 26px; font-weight: 800; color: #10B981; line-height: 1; letter-spacing: -0.02em;">Miễn phí</span>
                                }
                                else
                                {
                                    <span style="font-size: 26px; font-weight: 800; color: @(giaKhoa.DangGiam ? "#DC2626" : "#0F172A"); line-height: 1; letter-spacing: -0.02em;">@salePrice.ToString("N0") đ</span>
                                    if (giaKhoa.DangGiam)
                                    {
                                        <span style="font-size: 15px; color: #94A3B8; text-decoration: line-through;">@originalPrice.ToString("N0") đ</span>
                                        <span class="price-badge" style="font-size: 13px;">-@giaKhoa.PhanTram%</span>
                                    }
                                }
                            </div>
                            @if (giaKhoa.DangGiam)
                            {
                                <div style="margin: -8px 0 14px; font-size: 12.5px; color: #DC2626; font-weight: 600;">
                                    <i class="bi bi-tag-fill"></i> @giaKhoa.TenChuongTrinh · còn đến @giaKhoa.NgayKetThuc.Value.ToString("dd/MM/yyyy")
                                </div>
                            }

                            <!-- Action Buttons -->
                            @if (isOwner)
                            {
                                <a href="@Url.Action("Edit", "Course", new { area = "Instructor", id = Model.maKhoaHoc })" class="btn btn-secondary btn-lg w-100 py-3 mb-3 text-center d-block fw-bold text-decoration-none shadow-sm" style="background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; border-radius: 12px !important; font-size: 15px;">
                                    <i class="bi bi-pencil-square me-2"></i> Quản lý khóa học của bạn
                                </a>
                            }
                            else if (isEnrolled)
                            {
                                <a href="@Url.Action("Study", "Learning", new { courseId = Model.maKhoaHoc })" class="btn btn-secondary btn-lg w-100 py-3 mb-3 text-center d-block fw-bold text-decoration-none shadow-sm" style="background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; border-radius: 12px !important; font-size: 15px; transition: all 0.2s;">
                                    <i class="bi bi-play-circle-fill me-2 text-primary"></i> VÀO HỌC NGAY
                                </a>
                            }
                            else if (isGuest)
                            {
                                @* Khách chưa đăng nhập (khóa có phí hay miễn phí): một nút "Đăng ký học" dẫn tới đăng nhập,
                                   đăng nhập xong quay lại đúng khóa này; ẩn Mua ngay / Thêm vào giỏ hàng *@
                                <div class="course-cta-row">
                                    <a href="@Url.Action("Login", "Account", new { mode = "login", returnUrl = Request.RawUrl })" class="btn btn-cta-primary btn-lg w-100 py-3 mb-3 text-center d-block fw-bold shadow-sm text-decoration-none" style="background: #10B981 !important; border: none !important; border-radius: 12px !important; font-size: 16px; color: #FFFFFF;">
                                        <i class="bi bi-mortarboard-fill me-2"></i> Đăng ký học
                                    </a>
                                    @Html.Partial("_FavoriteButton", new ECOLearning.ViewModels.FavoriteButtonModel { CourseId = Model.maKhoaHoc, TeacherId = Model.maGiaoVien, Variant = "square" })
                                </div>
                            }
                            else if (isFree)
                            {
                                <!-- Nút chính + nút thả tim vuông cùng một hàng -->
                                <div class="course-cta-row">
                                    <button type="button" onclick="enrollFreeAjax('@Model.maKhoaHoc', this)" class="btn btn-cta-primary btn-lg w-100 py-3 mb-3 text-center d-block fw-bold shadow-sm" style="background: #10B981 !important; border: none !important; border-radius: 12px !important; font-size: 16px;">
                                        <i class="bi bi-mortarboard-fill me-2"></i> Đăng ký học
                                    </button>
                                    @Html.Partial("_FavoriteButton", new ECOLearning.ViewModels.FavoriteButtonModel { CourseId = Model.maKhoaHoc, TeacherId = Model.maGiaoVien, Variant = "square" })
                                </div>
                            }
                            else
                            {
                                <button type="button" onclick="buyNowAjax('@Model.maKhoaHoc', this)" class="btn btn-cta-primary btn-lg w-100 py-3 mb-2 text-center d-block fw-bold shadow-sm" style="border-radius: 12px !important; font-size: 16px;">
                                    Mua ngay
                                </button>
                                <!-- Nút giỏ hàng + nút thả tim vuông cùng một hàng (addToCartAjax thay nút giỏ hàng tại chỗ) -->
                                <div class="course-cta-row">
                                    @if (isInCart)
                                    {
                                        <a href="@Url.Action("Index", "Cart")" id="btnAddToCartMain" class="btn w-100 py-3 fw-bold mb-3 text-center d-block text-decoration-none" style="background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; border-radius: 12px !important; font-size: 15px; transition: all 0.2s;">
                                            <i class="bi me-1"></i> Chuyển đến giỏ hàng
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" id="btnAddToCartMain" onclick="addToCartAjax('@Model.maKhoaHoc', this)" class="btn w-100 py-3 fw-bold mb-3" style="background: #F1F5F9; color: #0F172A; border: none; border-radius: 12px !important; font-size: 15px; transition: background 0.2s;">
                                            Thêm vào giỏ hàng
                                        </button>
                                    }
                                    @Html.Partial("_FavoriteButton", new ECOLearning.ViewModels.FavoriteButtonModel { CourseId = Model.maKhoaHoc, TeacherId = Model.maGiaoVien, Variant = "square" })
                                </div>
                            }

                            <!-- Course Inclusions Grid Layout (Matching Mockup 100%) -->
                            <div class="border-top pt-3 mt-1">
                                <h6 class="fw-bold mb-3 text-dark" style="font-size: 13.5px; color: #475569;">Khóa học bao gồm:</h6>
                                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 12px;">
                                    <!-- 1. Video duration -->
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-play-btn-fill" style="font-size: 18px; color: #434CE8; margin-top: 1px;"></i>
                                        <div style="font-size: 13px; line-height: 1.45; color: #475569;">
                                            <strong style="color: #0F172A; font-weight: 700; display: inline-block;">@(totalMinutes > 0 ? totalMinutes + " phút" : "Video bài giảng")</strong>
                                            <div>video học tập</div>
                                        </div>
                                    </div>

                                    <!-- 2. Lessons count -->
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-journal-check" style="font-size: 18px; color: #434CE8; margin-top: 1px;"></i>
                                        <div style="font-size: 13px; line-height: 1.45; color: #475569;">
                                            <strong style="color: #0F172A; font-weight: 700; display: inline-block;">@(totalLessons > 0 ? totalLessons + " bài học" : "Bài học")</strong>
                                            <div>thử nghiệm & thực hành</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</main>

<!-- Modal Xem Thử Video Preview (Tự định nghĩa Modal độc lập - Không nhảy trang, không đơ web) -->
<div class="custom-modal-overlay" id="previewModal">
    <div class="custom-modal-dialog">
        <div class="custom-modal-header">
            <h6 class="modal-title-text" id="previewModalTitle"><i class="bi bi-play-circle-fill me-2" style="color: #6366F1;"></i> Xem thử bài học</h6>
            <button type="button" class="custom-modal-close" onclick="closePreviewModal()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="custom-modal-body" id="modalVideoBody" style="background: #000; min-height: 320px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 0 0 16px 16px;">
            <!-- Iframe player for YouTube / Vimeo -->
            <div id="previewIframeWrapper" style="display:none; width: 100%; aspect-ratio: 16/9; max-height: 480px; position: relative; background: #000;">
                <iframe id="previewVideoIframe"
                        src=""
                        style="width: 100%; height: 100%; border: none; display: block;"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
            </div>

            <!-- HTML5 Video player for MP4 / WebM -->
            <video id="previewVideoPlayer" controls controlsList="nodownload" style="width:100%; max-height:480px; display:none; aspect-ratio: 16/9; background: #000;">
                <source id="previewVideoSource" src="" type="video/mp4" />
                Trình duyệt không hỗ trợ HTML5 Video.
            </video>

            <!-- Placeholder when no video -->
            <div id="previewVideoPlaceholder" class="video-placeholder-container" style="display:none; padding: 48px 24px; text-align: center; width: 100%;">
                <i class="bi bi-camera-video-off fs-1 text-secondary mb-3 d-block"></i>
                <h5 class="fw-bold text-white mb-2">Video đang trong quá trình phát triển</h5>
                <p class="text-secondary small mb-0">Nội dung video cho bài học này hiện chưa cập nhật. Vui lòng quay lại sau.</p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/assets/js/course-reviews.js?v=1.0")"></script>
    <script>
        // Thu gọn / hiện các mục khóa học liên quan; nhớ lựa chọn trên trình duyệt này.
        // Chỉ ảnh hưởng cột trái: thẻ khóa học bên phải là sticky trong cột phải (cao bằng cột trái), nên khi cột trái
        // co lại thẻ sẽ bị đẩy lên và trang bị kéo cuộn. Vì vậy bù khoảng trống cuối cột trái vừa đủ để thẻ giữ nguyên
        // vị trí, rồi trả lại vị trí cuộn cũ — tất cả trong cùng một khung hình nên không thấy nhảy.
        (function () {
            var wrap = document.querySelector('.rel-wrap');
            var grid = document.querySelector('.details-layout-grid');
            var card = document.querySelector('.sticky-course-card');

            function giuViTriTheBenPhai(doiNoiDung) {
                if (!wrap || !grid || !card || getComputedStyle(card).position !== 'sticky') {
                    doiNoiDung();
                    return;
                }
                var y = window.scrollY;
                var r = card.getBoundingClientRect();
                var dayTheMongMuon = y + r.bottom;               // đáy thẻ (tọa độ trang) cần giữ
                wrap.style.paddingBottom = '0px';
                doiNoiDung();
                var dayLuoi = grid.getBoundingClientRect().bottom + window.scrollY;
                var thieu = Math.ceil(dayTheMongMuon - dayLuoi);
                wrap.style.paddingBottom = thieu > 0 ? thieu + 'px' : '0px';
                // base.css bật scroll-behavior: smooth; trả vị trí cuộn phải tức thì, nếu không trang sẽ trượt thấy rõ
                window.scrollTo({ top: y, left: window.scrollX, behavior: 'instant' });
            }

            document.querySelectorAll('.rel-section').forEach(function (sec) {
                var btn = sec.querySelector('.rel-toggle');
                var body = document.getElementById(btn.getAttribute('aria-controls'));
                var key = 'rel-collapsed-' + sec.getAttribute('data-rel-key');
                function apply(collapsed) {
                    body.hidden = collapsed;
                    btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                    btn.querySelector('.rel-toggle-text').textContent = collapsed ? 'Hiện ' + btn.getAttribute('data-count') + ' khóa học' : 'Thu gọn';
                    btn.querySelector('.bi').className = collapsed ? 'bi bi-chevron-down' : 'bi bi-chevron-up';
                }
                var saved = null;
                try { saved = localStorage.getItem(key); } catch (e) { }
                apply(saved === '1');
                btn.addEventListener('click', function () {
                    var collapsed = !body.hidden;
                    giuViTriTheBenPhai(function () { apply(collapsed); });
                    try { localStorage.setItem(key, collapsed ? '1' : '0'); } catch (e) { }
                });
            });
        })();

        // Combo "Thường xuyên được mua cùng nhau": thêm từng khóa / thêm tất cả vào giỏ (Cart/AddManyToCart kiểm tra lại ở server)
        (function () {
            var cartUrl = '@Url.Action("Index", "Cart")';
            var addManyUrl = '@Url.Action("AddManyToCart", "Cart")';
            var khoaDangXem = '@Model.maKhoaHoc';

            function daTrongGio(courseId) {
                document.querySelectorAll('[data-fbt-add]').forEach(function (b) {
                    if (b.getAttribute('data-course') !== courseId) return;
                    var a = document.createElement('a');
                    a.href = cartUrl;
                    a.className = 'fbt-btn is-in-cart';
                    a.innerHTML = '<i class="bi bi-check2"></i> Đã trong giỏ';
                    b.replaceWith(a);
                });
                // Nút "Thêm vào giỏ hàng" của thẻ bên phải (khóa đang xem)
                var main = document.getElementById('btnAddToCartMain');
                if (courseId === khoaDangXem && main && main.tagName === 'BUTTON') {
                    var link = document.createElement('a');
                    link.href = cartUrl;
                    link.id = 'btnAddToCartMain';
                    link.className = 'btn w-100 py-3 fw-bold mb-3 text-center d-block text-decoration-none';
                    link.style.cssText = 'background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; border-radius: 12px !important; font-size: 15px; transition: all 0.2s;';
                    link.innerHTML = '<i class="bi bi-cart-check-fill me-1"></i> Chuyển đến giỏ hàng';
                    main.replaceWith(link);
                }
            }

            function capNhatNutTatCa() {
                var all = document.querySelector('[data-fbt-add-all]');
                if (!all) return;
                var conLai = Array.prototype.map.call(document.querySelectorAll('[data-fbt-add]'), function (b) { return b.getAttribute('data-course'); });
                if (conLai.length === 0) {
                    var a = document.createElement('a');
                    a.href = cartUrl;
                    a.className = 'fbt-btn-primary';
                    a.innerHTML = '<i class="bi bi-cart-check"></i> Đến giỏ hàng';
                    all.replaceWith(a);
                } else {
                    all.setAttribute('data-courses', conLai.join(','));
                }
            }

            function themVaoGio(ids, nut, nhanCu) {
                nut.disabled = true;
                nut.textContent = 'Đang thêm...';
                $.ajax({
                    url: addManyUrl,
                    type: 'POST',
                    traditional: true,
                    data: { courseIds: ids },
                    success: function (res) {
                        (res.inCart || []).forEach(daTrongGio);
                        if (typeof res.cartCount === 'number' && typeof updateHeaderCartBadge === 'function') updateHeaderCartBadge(res.cartCount);
                        capNhatNutTatCa();
                        if (res.errors && res.errors.length) {
                            showToast(res.errors.map(function (e) { return e.message; }).join(' '), 'warning');
                        } else if (!res.success) {
                            showToast(res.message || 'Không thêm được vào giỏ hàng.', 'error');
                        }
                        if (document.body.contains(nut)) { nut.disabled = false; nut.textContent = nhanCu; }
                    },
                    error: function () {
                        nut.disabled = false;
                        nut.textContent = nhanCu;
                        showToast('Có lỗi xảy ra khi thêm vào giỏ hàng!', 'error');
                    }
                });
            }

            document.addEventListener('click', function (e) {
                var mot = e.target.closest('[data-fbt-add]');
                if (mot) {
                    themVaoGio([mot.getAttribute('data-course')], mot, 'Thêm vào giỏ hàng');
                    return;
                }
                var tatCa = e.target.closest('[data-fbt-add-all]');
                if (tatCa) {
                    var ids = (tatCa.getAttribute('data-courses') || '').split(',').filter(Boolean);
                    if (ids.length) themVaoGio(ids, tatCa, 'Thêm tất cả vào giỏ hàng');
                }
            });
        })();

        function extractVideoInfo(url) {
            if (!url || typeof url !== 'string' || !url.trim()) return null;
            url = url.trim();

            // 1. YouTube formats: watch?v=ID, youtu.be/ID, embed/ID, shorts/ID
            var ytMatch = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/|youtube\.com\/shorts\/)([^"&?\/\s]{11})/i);
            if (ytMatch && ytMatch[1]) {
                return {
                    type: 'youtube',
                    id: ytMatch[1],
                    embedUrl: 'https://www.youtube-nocookie.com/embed/' + ytMatch[1] + '?autoplay=1&rel=0&modestbranding=1&enablejsapi=1'
                };
            }

            // Direct 11-character YouTube ID
            if (/^[a-zA-Z0-9_-]{11}$/.test(url)) {
                return {
                    type: 'youtube',
                    id: url,
                    embedUrl: 'https://www.youtube-nocookie.com/embed/' + url + '?autoplay=1&rel=0&modestbranding=1&enablejsapi=1'
                };
            }

            // 2. Vimeo format: vimeo.com/ID
            var vimeoMatch = url.match(/(?:vimeo\.com\/|player\.vimeo\.com\/video\/)([0-9]+)/i);
            if (vimeoMatch && vimeoMatch[1]) {
                return {
                    type: 'vimeo',
                    id: vimeoMatch[1],
                    embedUrl: 'https://player.vimeo.com/video/' + vimeoMatch[1] + '?autoplay=1'
                };
            }

            // 3. Fallback to direct HTML5 video (mp4, webm, etc.)
            return {
                type: 'html5',
                url: url
            };
        }

        function playPreviewModal(title, videoUrl) {
            var modalTitle = document.getElementById('previewModalTitle');
            if (modalTitle) {
                modalTitle.innerHTML = '<i class="bi bi-play-circle-fill me-2" style="color: #6366F1;"></i> ' + (title || 'Xem thử bài học');
            }

            var iframeWrapper = document.getElementById('previewIframeWrapper');
            var iframeElem = document.getElementById('previewVideoIframe');
            var videoPlayer = document.getElementById('previewVideoPlayer');
            var videoSource = document.getElementById('previewVideoSource');
            var placeholder = document.getElementById('previewVideoPlaceholder');
            var modalOverlay = document.getElementById('previewModal');

            // Reset current state
            if (videoPlayer) {
                try { videoPlayer.pause(); } catch(e){}
                videoPlayer.style.display = 'none';
            }
            if (iframeElem) {
                iframeElem.src = '';
            }
            if (iframeWrapper) {
                iframeWrapper.style.display = 'none';
            }
            if (placeholder) {
                placeholder.style.display = 'none';
            }

            var info = extractVideoInfo(videoUrl);
            if (info) {
                if (info.type === 'youtube' || info.type === 'vimeo') {
                    if (iframeElem && iframeWrapper) {
                        iframeElem.src = info.embedUrl;
                        iframeWrapper.style.display = 'block';
                    }
                } else if (info.type === 'html5') {
                    if (videoPlayer && videoSource) {
                        videoSource.src = info.url;
                        videoPlayer.style.display = 'block';
                        videoPlayer.load();
                        videoPlayer.play().catch(function (e) { console.log('Autoplay handled:', e); });
                    }
                }
            } else {
                if (placeholder) {
                    placeholder.style.display = 'block';
                }
            }

            if (modalOverlay) {
                modalOverlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function handlePreviewClick(elem) {
            if (!elem) return;
            var title = elem.getAttribute('data-title') || 'Xem thử bài học';
            var videoUrl = elem.getAttribute('data-video') || '';
            playPreviewModal(title, videoUrl);
        }

        function closePreviewModal() {
            var modalOverlay = document.getElementById('previewModal');
            var videoPlayer = document.getElementById('previewVideoPlayer');
            var iframeElem = document.getElementById('previewVideoIframe');
            var iframeWrapper = document.getElementById('previewIframeWrapper');

            if (videoPlayer) {
                try { videoPlayer.pause(); videoPlayer.currentTime = 0; } catch (e) {}
                videoPlayer.style.display = 'none';
            }
            if (iframeElem) {
                iframeElem.src = '';
            }
            if (iframeWrapper) {
                iframeWrapper.style.display = 'none';
            }
            if (modalOverlay) {
                modalOverlay.classList.remove('active');
            }
            document.body.style.overflow = '';
        }

        // Đóng khi nhấp bên ngoài dialog
        var modalElem = document.getElementById('previewModal');
        if (modalElem) {
            modalElem.addEventListener('click', function (e) {
                if (e.target === this) {
                    closePreviewModal();
                }
            });
        }

        // Đóng khi nhấn phím ESC
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closePreviewModal();
            }
        });

        function showCartWarningToast(message, cartUrl) {
            var container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.style.cssText = 'position: fixed; bottom: 24px; right: 24px; z-index: 99999; display: flex; flex-direction: column; gap: 10px; pointer-events: none;';
                document.body.appendChild(container);
            }

            var existingWarning = container.querySelector('.cart-warning-toast-item');
            if (existingWarning) {
                existingWarning.remove();
            }

            var toast = document.createElement('div');
            toast.className = 'cart-warning-toast-item';
            toast.style.cssText = 'background: #FFFBEB; border: 1px solid #FCD34D; border-left: 5px solid #F59E0B; color: #92400E; padding: 14px 18px; border-radius: 14px; font-size: 14px; display: flex; align-items: center; gap: 12px; box-shadow: 0 15px 30px -5px rgba(245, 158, 11, 0.25), 0 4px 12px rgba(0,0,0,0.08); transform: translateY(20px); opacity: 0; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); pointer-events: auto; max-width: 460px;';

            var targetCartUrl = cartUrl || '/Cart';

            toast.innerHTML = '<div style="width: 36px; height: 36px; background: #FEF3C7; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #D97706; font-size: 17px; font-weight: 800;"><i class="bi bi-exclamation-triangle-fill"></i></div>' +
                '<div style="flex: 1; min-width: 0;">' +
                '<div style="font-weight: 700; color: #78350F; font-size: 14px; margin-bottom: 2px;">Khóa học đã có trong giỏ hàng!</div>' +
                '<div style="font-size: 12.5px; color: #B45309; line-height: 1.35;">' + (message || 'Khóa học này đã được thêm vào giỏ hàng từ trước.') + '</div>' +
                '</div>' +
                '<a href="' + targetCartUrl + '" style="background: #F59E0B; color: #FFFFFF; font-weight: 700; font-size: 12px; padding: 8px 14px; border-radius: 8px; text-decoration: none; white-space: nowrap; flex-shrink: 0; transition: background 0.2s;">Xem giỏ hàng <i class="bi bi-arrow-right ms-1"></i></a>';

            container.appendChild(toast);

            setTimeout(function () {
                toast.style.transform = 'translateY(0)';
                toast.style.opacity = '1';
            }, 10);

            setTimeout(function () {
                if (toast.parentNode) {
                    toast.style.transform = 'translateY(20px)';
                    toast.style.opacity = '0';
                    setTimeout(function () { if (toast.parentNode) toast.remove(); }, 250);
                }
            }, 4500);
        }

        function addToCartAjax(courseId, btnElement) {
            if (!courseId) return;
            var $btn = $('#btnAddToCartMain');
            var cartUrl = '@Url.Action("Index", "Cart")';

            $btn.prop('disabled', true).css('opacity', '0.75').html('<i class="bi bi-hourglass-split me-1"></i> Đang xử lý...');

            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { courseId: courseId },
                success: function (res) {
                    if (res && res.cartCount) {
                        if (typeof updateHeaderCartBadge === 'function') {
                            updateHeaderCartBadge(res.cartCount);
                        } else if ($('#header-cart-badge').length) {
                            if (res.cartCount > 0) {
                                $('#header-cart-badge').text(res.cartCount).css('display', 'flex');
                            }
                        }
                    }

                    // Ngay lập tức biến đổi nút thành "Chuyển đến giỏ hàng"
                    $('#btnAddToCartMain').replaceWith('<a href="' + cartUrl + '" id="btnAddToCartMain" class="btn w-100 py-3 fw-bold mb-3 text-center d-block text-decoration-none" style="background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; border-radius: 12px !important; font-size: 15px; transition: all 0.2s;"><i class="bi bi-cart-check-fill me-1"></i> Chuyển đến giỏ hàng</a>');
                },
                error: function () {
                    $('#btnAddToCartMain').replaceWith('<a href="' + cartUrl + '" id="btnAddToCartMain" class="btn w-100 py-3 fw-bold mb-3 text-center d-block text-decoration-none" style="background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; border-radius: 12px !important; font-size: 15px; transition: all 0.2s;"><i class="bi bi-cart-check-fill me-1"></i> Chuyển đến giỏ hàng</a>');
                }
            });
        }

        function buyNowAjax(courseId, btnElement) {
            if (!courseId) return;
            var $btn = $(btnElement);
            var originalHtml = $btn.html();

            $btn.prop('disabled', true).css('opacity', '0.75').html('<i class="bi bi-hourglass-split me-1"></i> Đang xử lý...');

            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { courseId: courseId },
                success: function (res) {
                    window.location.href = '@Url.Action("Index", "Cart")';
                },
                error: function () {
                    window.location.href = '@Url.Action("Index", "Cart")';
                }
            });
        }

        function enrollFreeAjax(courseId, btnElement) {
            if (!courseId) return;
            var $btn = $(btnElement);
            var originalHtml = $btn.html();

            $btn.prop('disabled', true).css('opacity', '0.75').html('<i class="bi bi-hourglass-split me-1"></i> Đang đăng ký...');

            $.ajax({
                url: '@Url.Action("EnrollFree", "Course")',
                type: 'POST',
                data: { courseId: courseId },
                success: function (res) {
                    if (res.requireLogin) {
                        if (typeof showToast === 'function') {
                            showToast(res.message, 'warning');
                        } else {
                            alert(res.message);
                        }
                        setTimeout(function () {
                            window.location.href = '@Url.Action("Login", "Account")?returnUrl=' + encodeURIComponent(window.location.pathname);
                        }, 600);
                        return;
                    }

                    if (res.success) {
                        if (typeof showToast === 'function') {
                            showToast(res.message, 'success');
                        } else {
                            alert(res.message);
                        }
                        setTimeout(function () {
                            window.location.href = res.redirectUrl || '@Url.Action("MyCourses", "Learning")';
                        }, 800);
                    } else {
                        $btn.prop('disabled', false).css('opacity', '1').html(originalHtml);
                        if (typeof showToast === 'function') {
                            showToast(res.message, 'danger');
                        } else {
                            alert(res.message);
                        }
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).css('opacity', '1').html(originalHtml);
                    if (typeof showToast === 'function') {
                        showToast('Có lỗi xảy ra trong quá trình đăng ký. Vui lòng thử lại!', 'danger');
                    } else {
                        alert('Có lỗi xảy ra trong quá trình đăng ký!');
                    }
                }
            });
        }

        // Accordion Expand / Collapse Functions for Course Curriculum
        function toggleChapterAccordion(targetId, headerElem) {
            var $target = $('#' + targetId);
            var $header = $(headerElem);

            if ($target.is(':visible')) {
                $target.slideUp(250);
                $header.addClass('collapsed');
            } else {
                $target.slideDown(250);
                $header.removeClass('collapsed');
            }
        }

        function toggleAllChapters() {
            var $btn = $('#btnToggleAllChapters');
            var isExpanded = $btn.data('expanded') !== false; // Mặc định true (đang mở tất cả)

            if (isExpanded) {
                $('.collapse-content').slideUp(250);
                $('.chapter-header').addClass('collapsed');
                $btn.html('<i class="bi bi-arrows-expand me-1"></i> Mở rộng tất cả');
                $btn.data('expanded', false);
            } else {
                $('.collapse-content').slideDown(250);
                $('.chapter-header').removeClass('collapsed');
                $btn.html('<i class="bi bi-arrows-collapse me-1"></i> Thu gọn tất cả');
                $btn.data('expanded', true);
            }
        }
    </script>
}
