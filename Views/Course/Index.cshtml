@model List<ECOLearning.Models.KhoaHoc>
@{
    ViewBag.Title = "Tìm kiếm & Bộ lọc Khóa học | E-Learning Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categories = ViewBag.Categories as List<ECOLearning.Models.DanhMuc> ?? new List<ECOLearning.Models.DanhMuc>();
    var enrollCounts = ViewBag.EnrollCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    string searchTerm = ViewBag.SearchTerm as string;
    string selectedCat = ViewBag.SelectedCategory as string;
    bool isFree = ViewBag.IsFree ?? false;
    bool isPaid = ViewBag.IsPaid ?? false;
    string selectedLevel = ViewBag.SelectedLevel as string;
    double? minRating = ViewBag.MinRating as double?;
    string currentSort = ViewBag.Sort as string;
    // 12 khóa mỗi trang (CourseController.Index); bộ lọc / sắp xếp gửi lại form nên luôn về trang 1
    var phanTrang = ViewBag.PhanTrang as ECOLearning.ViewModels.PhanTrangViewModel;
    int tongSoKhoa = phanTrang != null ? phanTrang.TongSo : Model.Count;
}

@section styles {
    <style>
        .trending-skills-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .skill-tag {
            font-size: 13px;
            padding: 6px 14px;
            border-radius: var(--radius-full, 9999px);
            background: #FFFFFF;
            border: 1px solid var(--border-color, #E2E8F0);
            color: var(--text-body, #334155);
            cursor: pointer;
            transition: all var(--transition-fast, 0.2s);
            text-decoration: none;
            display: inline-block;
        }

        .skill-tag:hover,
        .skill-tag.active {
            border-color: var(--primary, #434CE8);
            background: var(--primary-light, #EEF2FF);
            color: var(--primary, #434CE8);
            font-weight: 600;
        }

        .filter-sidebar {
            background: #FFFFFF;
            border: 1px solid var(--border-color, #E2E8F0);
            border-radius: var(--radius-2xl, 16px);
            padding: 24px;
            position: sticky;
            top: 100px;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
        }

        .filter-group {
            margin-bottom: 24px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color, #E2E8F0);
        }

        .filter-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .filter-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-heading, #0F172A);
            margin-bottom: 12px;
        }

        .filter-checkbox-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: var(--text-body, #334155);
            margin-bottom: 10px;
            cursor: pointer;
        }

        .filter-checkbox-label input {
            width: 16px;
            height: 16px;
            accent-color: var(--primary, #434CE8);
            cursor: pointer;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: #FFFFFF;
            border-radius: var(--radius-2xl, 16px);
            border: 1px dashed var(--border-color, #E2E8F0);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.02);
        }
    </style>
}

<main style="padding: 36px 0 80px; background-color: #F8FAFC; min-height: calc(100vh - 76px - 200px);">
    <div class="safe-container">

        <!-- Header Title & Active Keyword Banner -->
        <div style="margin-bottom: 24px;">
            <p style="font-size: 14px; color: #64748B; margin: 0;">
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <span>Kết quả tìm kiếm cho từ khóa: <strong style="color: #434CE8;">"@searchTerm"</strong></span>
                }
                else
                {
                    <span>Tìm kiếm theo tên khóa học, giảng viên thực chiến hoặc kỹ năng chuyên môn</span>
                }
            </p>
        </div>

        <!-- Trending Skills Pills Bar -->
        <div class="trending-skills-bar">
            <span class="caption" style="font-weight: 700; color: #0F172A; text-transform: uppercase;">Kỹ năng thịnh hành:</span>
            <a href="@Url.Action("Index", "Course")" class="skill-tag @(string.IsNullOrEmpty(searchTerm) ? "active" : "")">Tất cả</a>
            <a href="@Url.Action("Index", "Course", new { search = "HTML5" })" class="skill-tag @(searchTerm == "HTML5" ? "active" : "")">HTML5 / CSS3</a>
            <a href="@Url.Action("Index", "Course", new { search = "Figma" })" class="skill-tag @(searchTerm == "Figma" ? "active" : "")">Figma UI/UX</a>
            <a href="@Url.Action("Index", "Course", new { search = "Python" })" class="skill-tag @(searchTerm == "Python" ? "active" : "")">Python AI</a>
            <a href="@Url.Action("Index", "Course", new { search = "Web" })" class="skill-tag @(searchTerm == "Web" ? "active" : "")">Lập trình Web</a>
            <a href="@Url.Action("Index", "Course", new { search = "React" })" class="skill-tag @(searchTerm == "React" ? "active" : "")">React & Next.js</a>
        </div>

        <form id="filter-form" method="get" action="@Url.Action("Index", "Course")">
            <input type="hidden" name="search" value="@searchTerm" />

            <div class="grid-12">
                <!-- LEFT SIDEBAR: FILTERS -->
                <div class="col-4">
                    <aside class="filter-sidebar">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                            <h3 style="font-size: 16px; font-weight: 800; color: #0F172A; margin: 0;">Bộ lọc nâng cao</h3>
                            <a href="@Url.Action("Index", "Course")" class="btn btn-secondary btn-sm" style="text-decoration: none; border-radius: 8px;">Đặt lại</a>
                        </div>

                        <!-- Price Filter -->
                        <div class="filter-group">
                            <div class="filter-title">Mức giá</div>
                            <label class="filter-checkbox-label">
                                <input type="checkbox" name="isFree" value="true" @(isFree ? "checked" : "") onchange="this.form.submit()" />
                                <strong>Khóa học Miễn phí (0 đ)</strong>
                            </label>
                            <label class="filter-checkbox-label">
                                <input type="checkbox" name="isPaid" value="true" @(isPaid ? "checked" : "") onchange="this.form.submit()" />
                                Khóa học có phí
                            </label>
                        </div>

                        <!-- Rating Filter (Đánh giá tối thiểu) -->
                        <div class="filter-group">
                            <div class="filter-title">Đánh giá tối thiểu</div>
                            <label class="filter-checkbox-label">
                                <input type="radio" name="minRating" value="" @(!minRating.HasValue || minRating.Value == 0 ? "checked" : "") onchange="this.form.submit()" />
                                Tất cả đánh giá
                            </label>
                            <label class="filter-checkbox-label">
                                <input type="radio" name="minRating" value="4.8" @(minRating == 4.8 ? "checked" : "") onchange="this.form.submit()" />
                                <span class="stars" style="color: #F59E0B;"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span> Từ 4.8 sao
                            </label>
                            <label class="filter-checkbox-label">
                                <input type="radio" name="minRating" value="4.5" @(minRating == 4.5 ? "checked" : "") onchange="this.form.submit()" />
                                <span class="stars" style="color: #F59E0B;"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i></span> Từ 4.5 sao
                            </label>
                        </div>

                        <!-- Level Filter -->
                        <div class="filter-group">
                            <div class="filter-title">Cấp độ</div>
                            <label class="filter-checkbox-label">
                                <input type="radio" name="level" value="" @(string.IsNullOrEmpty(selectedLevel) ? "checked" : "") onchange="this.form.submit()" />
                                Tất cả cấp độ
                            </label>
                            <label class="filter-checkbox-label">
                                <input type="radio" name="level" value="Cơ bản" @(selectedLevel == "Cơ bản" ? "checked" : "") onchange="this.form.submit()" />
                                Người mới bắt đầu
                            </label>
                            <label class="filter-checkbox-label">
                                <input type="radio" name="level" value="Trung cấp" @(selectedLevel == "Trung cấp" ? "checked" : "") onchange="this.form.submit()" />
                                Trung cấp
                            </label>
                            <label class="filter-checkbox-label">
                                <input type="radio" name="level" value="Nâng cao" @(selectedLevel == "Nâng cao" ? "checked" : "") onchange="this.form.submit()" />
                                Nâng cao
                            </label>
                        </div>

                        <!-- Category Filter -->
                        <div class="filter-group">
                            <div class="filter-title">Danh mục đào tạo</div>
                            <label class="filter-checkbox-label">
                                <input type="radio" name="category" value="" @(string.IsNullOrEmpty(selectedCat) ? "checked" : "") onchange="this.form.submit()" />
                                Tất cả danh mục
                            </label>
                            @foreach (var cat in categories)
                            {
                                <label class="filter-checkbox-label">
                                    <input type="radio" name="category" value="@cat.maDanhMuc" @(selectedCat == cat.maDanhMuc ? "checked" : "") onchange="this.form.submit()" />
                                    @cat.tenDanhMuc
                                </label>
                            }
                        </div>
                    </aside>
                </div>

                <!-- RIGHT: COURSE GRID & RESULTS -->
                <div class="col-8">
                    <!-- Results header bar & Sort dropdown -->
                    <div id="ds-khoa-hoc" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; background: #FFFFFF; border: 1px solid #E2E8F0; padding: 14px 20px; border-radius: 16px; scroll-margin-top: 96px;">
                        <div>
                            <div style="font-weight: 700; color: #0F172A; font-size: 15px;">
                                Tìm thấy <span style="color: #434CE8;">@tongSoKhoa</span> khóa học
                                @if (phanTrang != null && phanTrang.CoNhieuTrang)
                                {
                                    <span style="font-weight: 500; color: #64748B; font-size: 13.5px;">• Trang @phanTrang.Trang/@phanTrang.TongSoTrang</span>
                                }
                            </div>
                            @if ((ViewBag.SoKhoaDaSoHuu as int? ?? 0) > 0)
                            {
                                <div style="font-size: 12.5px; color: #64748B; margin-top: 2px;">
                                    @ViewBag.SoKhoaDaSoHuu khóa bạn đã sở hữu nằm ở
                                    <a href="@Url.Action("MyCourses", "Learning")" style="font-weight: 600;">Khóa học của tôi</a>
                                </div>
                            }
                        </div>

                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 13px; color: #64748B; font-weight: 600;">Sắp xếp:</span>
                            <select name="sort" class="form-control" style="width: 180px; height: 38px; font-size: 13px; border-radius: 10px;" onchange="this.form.submit()">
                                <option value="" @(string.IsNullOrEmpty(currentSort) ? "selected" : "")>Mới nhất / Nổi bật</option>
                                <option value="price-asc" @(currentSort == "price-asc" ? "selected" : "")>Giá: Thấp đến Cao</option>
                                <option value="price-desc" @(currentSort == "price-desc" ? "selected" : "")>Giá: Cao đến Thấp</option>
                            </select>
                        </div>
                    </div>

                    @if (Model.Count == 0)
                    {
                        <!-- EMPTY STATE FOR SEARCH -->
                        <div class="empty-state">
                            <div style="font-size: 48px; margin-bottom: 12px;"><i class="bi bi-search text-muted"></i></div>
                            <h3 style="font-size: 20px; font-weight: 800; color: #0F172A; margin-bottom: 8px;">Không tìm thấy kết quả phù hợp</h3>
                            <p style="font-size: 14px; color: #64748B; margin-bottom: 24px; line-height: 22px;">
                                Vui lòng thử lại với các từ khóa phổ biến: <em>"Web", "Python", "UI/UX", "HTML5"</em> hoặc chọn lại bộ lọc.
                            </p>
                            <a href="@Url.Action("Index", "Course")" class="btn btn-primary btn-sm" style="padding: 10px 24px; border-radius: 10px; font-weight: 700; text-decoration: none;">
                                Xóa bộ lọc và tải lại
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- COURSES RESULTS GRID -->
                        <div class="grid-12">
                            @foreach (var course in Model)
                            {
                                int enrollCount;
                                enrollCounts.TryGetValue(course.maKhoaHoc, out enrollCount);
                                int soDanhGia = course.DanhGiaKhoaHoc != null ? course.DanhGiaKhoaHoc.Count : 0;

                                <div class="col-6" style="margin-bottom: 24px;">
                                    @Html.Partial("_CourseCard", new ECOLearning.ViewModels.CourseCardViewModel
                                    {
                                        Course = course,
                                        SoHocVien = enrollCount,
                                        SoDanhGia = soDanhGia,
                                        DiemDanhGia = soDanhGia > 0 ? course.DanhGiaKhoaHoc.Average(d => (double)d.soSao) : 0
                                    })
                                </div>
                            }
                        </div>
                        @Html.Partial("_Pagination", phanTrang)
                    }
                </div>
            </div>
        </form>

    </div>
</main>
