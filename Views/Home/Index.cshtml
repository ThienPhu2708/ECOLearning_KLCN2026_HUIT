@section scripts {
<script>
    let currentCatIndex = 0;

    function slideCategory(direction) {
    const track = document.getElementById('category-track');
    if (!track) return;

    const items = track.querySelectorAll('.category-item-col');
    if (!items.length) return;

    const visibleCount = 4;
    const maxIndex = Math.max(0, items.length - visibleCount);

    currentCatIndex += direction;
    if (currentCatIndex < 0) currentCatIndex = 0;
    if (currentCatIndex > maxIndex) currentCatIndex = maxIndex;

    const itemWidth = items[0].getBoundingClientRect().width;
    const gap = 24; // Khoảng cách giữa các cột
    const moveAmount = (itemWidth + gap) * currentCatIndex;

    track.style.transform = `translateX(-${moveAmount}px)`;

    const prevBtn = document.getElementById('cat-prev-btn');
    const nextBtn = document.getElementById('cat-next-btn');

    if (prevBtn) prevBtn.disabled = (currentCatIndex === 0);
    if (nextBtn) nextBtn.disabled = (currentCatIndex >= maxIndex);
}

/* ==========================================================================
   SLIDER KHÓA HỌC ("Khóa học dành riêng cho bạn", "Khóa học nổi bật nhất tuần"):
   5 khóa một lượt, mỗi lần bấm dời 4 khóa (khóa cuối của lượt trước là khóa đầu của lượt sau)
   ========================================================================== */
document.querySelectorAll('.course-slider').forEach(function initCourseSlider(slider) {
    const track = slider.querySelector('.course-slider-track');
    const nav = document.querySelector('[data-slider-nav="' + slider.id + '"]');
    if (!track) return;

    const slides = track.querySelectorAll('.course-slide');
    const prevBtn = nav ? nav.querySelector('.js-slider-prev') : null;
    const nextBtn = nav ? nav.querySelector('.js-slider-next') : null;
    let index = 0; // vị trí thẻ đầu tiên đang hiển thị

    // Số thẻ một lượt lấy từ CSS (5 trên máy tính, ít hơn trên màn hình nhỏ)
    function perView() {
        return parseInt(getComputedStyle(slider).getPropertyValue('--per-view'), 10) || 5;
    }

    function maxIndex() {
        return Math.max(0, slides.length - perView());
    }

    function render() {
        index = Math.min(Math.max(index, 0), maxIndex());
        const offset = slides.length ? slides[index].offsetLeft - slides[0].offsetLeft : 0;
        track.style.transform = 'translateX(-' + offset + 'px)';

        if (nav) nav.hidden = slides.length <= perView();
        if (prevBtn) prevBtn.disabled = index === 0;
        if (nextBtn) nextBtn.disabled = index >= maxIndex();
    }

    function slide(direction) {
        // Số thẻ dời mỗi lần bấm: --slide-step nếu có (slider mã khuyến mãi dời đúng 1 lượt), mặc định perView - 1
        const step = parseInt(getComputedStyle(slider).getPropertyValue('--slide-step'), 10) || Math.max(1, perView() - 1);
        index += direction * step;
        render();
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { slide(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { slide(1); });

    // Vuốt trái / phải trên màn hình cảm ứng
    let startX = null;
    slider.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    slider.addEventListener('touchend', function (e) {
        if (startX === null) return;
        const dx = e.changedTouches[0].clientX - startX;
        startX = null;
        if (Math.abs(dx) > 50) slide(dx < 0 ? 1 : -1);
    });

    let resizeTimer;
    window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(render, 150);
    });

    render();
});

function addToCartAjax(courseId, btnElement) {
if (!courseId) return;
var $btn = $(btnElement);
var originalHtml = $btn.html();

$btn.prop('disabled', true).css('opacity', '0.75').html('<i class="bi bi-hourglass-split me-1"></i> Đang xử lý...');

$.ajax({
url: '@Url.Action("AddToCart", "Cart")',
type: 'POST',
data: { courseId: courseId },
success: function (response) {
$btn.prop('disabled', false).css('opacity', '1').html(originalHtml);
if (response.success) {
if (typeof updateHeaderCartBadge === 'function') {
updateHeaderCartBadge(response.cartCount);
} else if ($('#header-cart-badge').length) {
if (response.cartCount > 0) {
$('#header-cart-badge').text(response.cartCount).css('display', 'flex');
}
else
{
    $('#header-cart-badge').text('').css('display', 'none');
}
}

if (typeof showToast === 'function') {
showToast(response.message, 'success');
}
else
{
    alert(response.message);
}
}
else
{
    if (typeof showToast === 'function') {
    showToast(response.message, 'warning');
}
else
{
    alert(response.message);
}
}
},
error: function () {
$btn.prop('disabled', false).css('opacity', '1').html(originalHtml);
if (typeof showToast === 'function') {
showToast('Có lỗi xảy ra khi thêm vào giỏ hàng!', 'error');
}
else
{
    alert('Có lỗi xảy ra khi thêm vào giỏ hàng!');
}
}
});
}

/* ==========================================================================
   TASK 2: STATS COUNTER ANIMATION (CHẠY TRONG 3S, LƯU SESSIONSTORAGE)
   ========================================================================== */
(function initStatsCounter() {
    const STATS_SESSION_KEY = 'ecolearning_stats_counter_animated';
    const STATS_SESSION_DURATION = 20 * 60 * 1000; // 20 phút (chu kỳ session chuẩn)

    function isStatsSessionActive() {
        try {
            const raw = sessionStorage.getItem(STATS_SESSION_KEY);
            if (!raw) return false;
            const data = JSON.parse(raw);
            if (!data || !data.timestamp) return false;
            // Kiểm tra xem session đã hết hạn hay chưa
            if (Date.now() - data.timestamp > STATS_SESSION_DURATION) {
                sessionStorage.removeItem(STATS_SESSION_KEY);
                return false;
            }
            return true;
        } catch (e) {
            return false;
        }
    }

    function saveStatsSession() {
        try {
            sessionStorage.setItem(STATS_SESSION_KEY, JSON.stringify({
                timestamp: Date.now(),
                animated: true
            }));
        } catch (e) {}
    }

    const statsSection = document.getElementById('platform-stats-section');
    if (!statsSection) return;

    const counters = statsSection.querySelectorAll('.stat-number-counter');
    if (!counters.length) return;

    // Nếu người dùng F5 lại (session vẫn còn lưu): KHÔNG CHẠY LẠI animation, giữ nguyên số cuối
    if (isStatsSessionActive()) {
        return;
    }

    // Nếu là phiên mới hoặc sau khi session hết hạn: Thiết lập về 0 để chuẩn bị chạy animation khi cuộn tới
    counters.forEach(counter => {
        const type = counter.getAttribute('data-type');
        const suffix = counter.getAttribute('data-suffix') || '';
        if (type === 'fraction') {
            counter.textContent = '0/0';
        } else {
            counter.textContent = '0' + suffix;
        }
    });

    let hasStarted = false;

    function startCountingAnimation() {
        if (hasStarted) return;
        hasStarted = true;
        saveStatsSession(); // Lưu session ngay khi bắt đầu chạy để F5 không bị lặp lại

        const duration = 3000; // Đúng 3 giây (3000ms) theo yêu cầu
        const startTime = performance.now();

        // Hàm gia tốc chuyển động mượt mà (Cubic Ease-Out)
        function easeOutCubic(t) {
            return 1 - Math.pow(1 - t, 3);
        }

        function frame(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easedProgress = easeOutCubic(progress);

            counters.forEach(counter => {
                const type = counter.getAttribute('data-type');
                const suffix = counter.getAttribute('data-suffix') || '';

                if (type === 'fraction') {
                    const target1 = parseInt(counter.getAttribute('data-target-num1'), 10) || 24;
                    const target2 = parseInt(counter.getAttribute('data-target-num2'), 10) || 7;
                    const val1 = Math.floor(easedProgress * target1);
                    const val2 = Math.floor(easedProgress * target2);
                    counter.textContent = val1 + '/' + val2;
                } else if (type === 'comma') {
                    const target = parseInt(counter.getAttribute('data-target'), 10) || 15000;
                    const currentVal = Math.floor(easedProgress * target);
                    counter.textContent = currentVal.toLocaleString('en-US') + suffix;
                } else {
                    const target = parseInt(counter.getAttribute('data-target'), 10) || 500;
                    const currentVal = Math.floor(easedProgress * target);
                    counter.textContent = currentVal + suffix;
                }
            });

            if (progress < 1) {
                requestAnimationFrame(frame);
            } else {
                // Đảm bảo kết thúc ở chính xác con số mục tiêu 100%
                counters.forEach(counter => {
                    const type = counter.getAttribute('data-type');
                    const suffix = counter.getAttribute('data-suffix') || '';
                    if (type === 'fraction') {
                        counter.textContent = '24/7';
                    } else if (type === 'comma') {
                        const target = parseInt(counter.getAttribute('data-target'), 10) || 15000;
                        counter.textContent = target.toLocaleString('en-US') + suffix;
                    } else {
                        const target = parseInt(counter.getAttribute('data-target'), 10);
                        counter.textContent = target + suffix;
                    }
                });
            }
        }

        requestAnimationFrame(frame);
    }

    // Lắng nghe sự kiện cuộn xuống phần thống kê (IntersectionObserver)
    if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    startCountingAnimation();
                    observer.unobserve(statsSection);
                }
            });
        }, {
            threshold: 0.25
        });
        observer.observe(statsSection);
    } else {
        // Fallback cuộn trang cho trình duyệt cũ
        function scrollHandler() {
            const rect = statsSection.getBoundingClientRect();
            if (rect.top <= window.innerHeight * 0.85 && rect.bottom >= 0) {
                startCountingAnimation();
                window.removeEventListener('scroll', scrollHandler);
            }
        }
        window.addEventListener('scroll', scrollHandler);
        scrollHandler();
    }
})();

/* ==========================================================================
   HIỆU ỨNG XUẤT HIỆN KHI CUỘN TỚI: "Giá trị cốt lõi" (trồi lên) và "4 bước" (lật 3D)
   ========================================================================== */
(function initRevealOnScroll() {
    const groups = document.querySelectorAll('.reveal-group');
    if (!groups.length) return;

    if (!('IntersectionObserver' in window)) {
        groups.forEach(g => g.classList.add('is-visible'));
        return;
    }

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target); // chỉ chạy một lần
            }
        });
    }, { threshold: 0.2 });

    groups.forEach(g => observer.observe(g));
})();
</script>
}