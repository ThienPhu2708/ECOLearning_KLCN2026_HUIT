                                    @if (isTopTrending)
                                    {
                                        <span class="badge badge-primary" style="position: absolute; top: 12px; left: 12px; background: #434CE8; color: #FFFFFF;">🔥 Top Trending</span>
                                    }
                                    else if (isHighRated)
                                    {
                                        <span class="badge badge-success" style="position: absolute; top: 12px; left: 12px; background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0;">★ Đánh giá cao</span>
                                    }
                                </div>
                                <div class="course-body">
                                    <div class="course-category">
                                        <span class="caption" style="color: var(--primary); font-weight: 700;">@categoryName</span>
                                    </div>
                                    <h3 class="course-title" title="@course.tenKhoaHoc">@course.tenKhoaHoc</h3>
                                    <div class="course-instructor">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                        @teacherName
                                    </div>
                                    
                                    <!-- Layout Đánh Giá Star Rating (Hiện số sao khi có đánh giá, thiết kế sẵn layout khi chưa có) -->
                                    <div class="course-rating">
                                        @if (hasRatings)
                                        {
                                            double avgRating = course.DanhGiaKhoaHoc.Average(d => d.soSao);
                                            int ratingCount = course.DanhGiaKhoaHoc.Count;
                                            <span class="rating-score">@avgRating.ToString("0.00")</span>
                                            <div class="stars">★★★★★</div>
                                            <span class="rating-count">(@ratingCount)</span>
                                        }
                                        else
                                        {
                                            <span class="rating-score" style="color: var(--text-muted, #94A3B8); font-size: 13px; font-weight: 500;">Chưa có đánh giá</span>
                                            <div class="stars" style="color: #CBD5E1; opacity: 0.7;">★★★★★</div>
                                        }
                                    </div>

                                    <div class="course-footer">
                                        <div class="course-pricing">
                                            <span class="price-current">@actualPrice.ToString("N0") đ</span>
                                            @if (actualPrice < oldPrice)
                                            {
                                                <span class="price-original">@oldPrice.ToString("N0") đ</span>
                                            }
                                        </div>
                                        <a href="@Url.Action("Details", "Course", new { id = course.maKhoaHoc })" class="btn btn-outline btn-sm" onclick="event.stopPropagation();" style="border-radius: var(--radius-xl, 10px); font-weight: 600; text-decoration: none;">
                                            Chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@section scripts {
    <script>
        function addToCartAjax(courseId, btnElement) {
            if (!courseId) return;
            var $btn = $(btnElement);
            var originalHtml = $btn.html();

            $btn.prop('disabled', true).css('opacity', '0.75').html('⏳ Đang xử lý...');

            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { courseId: courseId },
                success: function (response) {
                    $btn.prop('disabled', false).css('opacity', '1').html(originalHtml);
                    if (response.success) {
                        // Update Cart count badge in header
                        if (typeof updateHeaderCartBadge === 'function') {
                            updateHeaderCartBadge(response.cartCount);
                        } else if ($('#header-cart-badge').length) {
                            if (response.cartCount > 0) {
                                $('#header-cart-badge').text(response.cartCount).css('display', 'flex');
                            } else {
                                $('#header-cart-badge').text('').css('display', 'none');
                            }
                        }

                        // Trigger Toast message
                        if (typeof showToast === 'function') {
                            showToast(response.message, 'success');
                        } else {
                            alert(response.message);
                        }
                    } else {
                        if (typeof showToast === 'function') {
                            showToast(response.message, 'warning');
                        } else {
                            alert(response.message);
                        }
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).css('opacity', '1').html(originalHtml);
                    if (typeof showToast === 'function') {
                        showToast('Có lỗi xảy ra khi thêm vào giỏ hàng!', 'error');
                    } else {
                        alert('Có lỗi xảy ra khi thêm vào giỏ hàng!');
                    }
                }
            });
        }
    </script>
}
