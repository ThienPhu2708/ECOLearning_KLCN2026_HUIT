@model List<ECOLearning.Models.KhoaHoc>
@{
    bool isLoggedIn = User.Identity.IsAuthenticated || Session["UserId"] != null;
    ViewBag.Title = isLoggedIn ? "Trang Chủ - Nền tảng Đào tạo Trực tuyến" : "Chào mừng đến với E-Learning";
    var courses = Model ?? new List<ECOLearning.Models.KhoaHoc>();
    var categories = ViewBag.Categories as List<ECOLearning.Models.DanhMuc> ?? new List<ECOLearning.Models.DanhMuc>();
    var categoryImages = ViewBag.CategoryImages as Dictionary<string, string> ?? new Dictionary<string, string>();
    var enrollCounts = ViewBag.EnrollCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var homeRecommendation = ViewBag.HomeRecommendation as ECOLearning.ViewModels.GoiYTrangChuViewModel ?? new ECOLearning.ViewModels.GoiYTrangChuViewModel();
    var recommendations = homeRecommendation.Items;
    var interestPicker = ViewBag.InterestPicker as ECOLearning.ViewModels.InterestPickerViewModel;
}

<!-- Hero Section: carousel 4 banner (Views/Home/_HeroCarousel.cshtml) -->
@Html.Partial("_HeroCarousel")

@if (isLoggedIn)
{
    <!-- Section Danh Mục Khóa Học Truy Vấn Từ CSDL (CHỈ HIỆN KHI ĐÃ ĐĂNG NHẬP, TỐI ĐA 4 DANH MỤC + NÚT MŨI TÊN DI CHUYỂN NẾU > 4) -->
    <section id="categories-section" style="padding: 48px 0; background: var(--bg-canvas, #F8FAFC);">
        <style>
            .category-slider-viewport {
            overflow: hidden;
            width: 100%;
            position: relative;
            /* Chừa chỗ cho hiệu ứng nâng thẻ (-3px) và bóng đổ khi hover, không bị cắt mất viền trên */
            padding: 8px 4px 16px;
            margin: -8px -4px -16px;
            box-sizing: content-box;
        }

        .category-slider-track {
        display: flex;
        gap: 24px;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .category-item-col {
    flex: 0 0 calc(25% - 18px);
    min-width: calc(25% - 18px);
    max-width: calc(25% - 18px);
}

/* Thẻ lĩnh vực: ảnh minh họa (Admin tải lên) ở trên, khung 16:10 cố định; ảnh khác tỉ lệ được cắt vừa khung
   (object-fit: cover), không méo. Danh mục chưa có ảnh hiện biểu tượng trên nền màu cùng khung. */
.category-card {
display: flex;
flex-direction: column;
overflow: hidden;
background: #FFFFFF;
border: 1px solid var(--border-color, #E2E8F0);
border-radius: var(--radius-2xl, 16px);
text-decoration: none;
transition: all 0.25s ease;
box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
height: 100%;
}

.category-card:hover {
border-color: #434CE8 !important;
transform: translateY(-3px);
box-shadow: 0 10px 25px rgba(67, 76, 232, 0.12) !important;
}

.category-media {
position: relative;
aspect-ratio: 16 / 10;
width: 100%;
overflow: hidden;
display: flex;
align-items: center;
justify-content: center;
font-size: 34px;
flex-shrink: 0;
}

.category-media img {
width: 100%;
height: 100%;
object-fit: cover;
object-position: center;
display: block;
transition: transform 0.35s ease;
}

.category-media .category-icon-bg {
transition: transform 0.25s ease;
}

.category-card:hover .category-media img,
.category-card:hover .category-icon-bg {
transform: scale(1.06);
}

.category-card-name {
padding: 14px 16px 16px;
font-weight: 700;
font-size: 15px;
line-height: 1.4;
color: var(--text-heading, #0F172A);
display: -webkit-box;
-webkit-line-clamp: 2;
-webkit-box-orient: vertical;
overflow: hidden;
}

.cat-nav-btn {
width: 38px;
height: 38px;
border-radius: 50%;
border: 1px solid var(--border-color, #E2E8F0);
background: #FFFFFF;
color: var(--text-heading, #0F172A);
font-size: 18px;
font-weight: 700;
display: flex;
align-items: center;
justify-content: center;
cursor: pointer;
transition: all 0.2s ease;
box-shadow: 0 2px 5px rgba(15, 23, 42, 0.06);
}

.cat-nav-btn:hover:not(:disabled) {
background: var(--primary, #434CE8);
color: #FFFFFF;
border-color: var(--primary, #434CE8);
}

.cat-nav-btn:disabled {
opacity: 0.4;
cursor: not-allowed;
}

.cat-head-actions {
display: flex;
gap: 10px;
align-items: center;
flex-shrink: 0;
}

.cat-all-link {
height: 38px;
padding: 0 16px;
display: inline-flex;
align-items: center;
gap: 6px;
border-radius: 9999px;
border: 1px solid var(--border-color, #E2E8F0);
background: #FFFFFF;
color: var(--primary, #434CE8);
font-size: 14px;
font-weight: 700;
text-decoration: none;
white-space: nowrap;
box-shadow: 0 2px 5px rgba(15, 23, 42, 0.06);
transition: all 0.2s ease;
}

.cat-all-link:hover {
background: var(--primary, #434CE8);
border-color: var(--primary, #434CE8);
color: #FFFFFF;
}
</style>

<div class="safe-container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px 16px; margin-bottom: 24px;">
        <div>
            <span class="caption" style="text-transform: uppercase; color: var(--primary); font-weight: 700;">Danh mục đào tạo</span>
            <h2 class="h2" style="margin-top: 4px;">Khám phá theo lĩnh vực</h2>
        </div>
        <div class="cat-head-actions">
            @if (categories.Count > 4)
            {
                <button id="cat-prev-btn" class="cat-nav-btn" onclick="slideCategory(-1)" title="Danh mục trước" disabled><i class="bi bi-chevron-left"></i></button>
                <button id="cat-next-btn" class="cat-nav-btn" onclick="slideCategory(1)" title="Danh mục tiếp theo"><i class="bi bi-chevron-right"></i></button>
            }
            <a class="cat-all-link" href="@Url.Action("All", "Category", new { area = "" })">
                Tất cả các lĩnh vực <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    @if (categories != null && categories.Any())
    {
        <div class="category-slider-viewport">
            <div class="category-slider-track" id="category-track">
                @for (int i = 0; i < categories.Count; i++)
                {
                    var cat = categories[i];
                    var style = ECOLearning.ViewModels.IconDanhMuc.TheoViTri(i);
                    string anhDanhMuc;
                    categoryImages.TryGetValue(cat.maDanhMuc, out anhDanhMuc);
                    <div class="category-item-col">
                        <a href="@Url.Action("Index", "Category", new { area = "", slug = ECOLearning.Services.SlugHelper.ToSlug(cat.tenDanhMuc) })" class="category-card" title="Xem danh mục @cat.tenDanhMuc">
                            @if (!string.IsNullOrEmpty(anhDanhMuc))
                            {
                                <div class="category-media" style="background: @style.Bg;">
                                    <img src="@Url.Content("~" + anhDanhMuc)" alt="@cat.tenDanhMuc" loading="lazy" />
                                </div>
                            }
                            else
                            {
                                <div class="category-media" style="background: @style.Bg; color: @style.Color;">
                                    <i class="bi @style.Icon category-icon-bg" aria-hidden="true"></i>
                                </div>
                            }
                            <div class="category-card-name">@cat.tenDanhMuc</div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div style="text-align: center; color: var(--text-secondary); padding: 24px; background: #FFFFFF; border-radius: 16px; border: 1px dashed var(--border-color);">
            Chưa có danh mục khóa học nào trong cơ sở dữ liệu.
        </div>
    }
</div>
</section>

    @* Mã khuyến mãi công khai (Marketing) — lưu vào "Mã giảm giá của tôi", dùng ở bước thanh toán *@
    var homeCoupons = ViewBag.HomeCoupons as List<ECOLearning.ViewModels.MaGiamGiaHienThi>;
    if (homeCoupons != null && homeCoupons.Count > 0)
    {
        <section id="coupons-section" class="cpn-home" aria-labelledby="coupons-heading">
            <div class="safe-container">
                <div class="cpn-section-head">
                    <div>
                        <span class="caption" style="text-transform: uppercase; color: var(--primary); font-weight: 700;">Ưu đãi dành cho bạn</span>
                        <h2 class="h2" id="coupons-heading" style="margin-top: 4px;">Mã khuyến mãi</h2>
                        <p style="margin: 6px 0 0; font-size: 14px; color: var(--text-secondary, #64748B);">Lưu mã vào ví, sau đó chọn mã ở bước thanh toán để được giảm giá.</p>
                    </div>
                    <div class="cpn-section-actions">
                        @* Mũi tên chỉ hiện khi nhiều mã hơn số thẻ một lượt (slider dùng chung với khóa học, JS cuối trang) *@
                        <div class="course-slider-nav" data-slider-nav="coupon-slider" style="display: flex; gap: 10px; align-items: center;" hidden>
                            <button type="button" class="cat-nav-btn js-slider-prev" title="Mã trước" aria-label="Mã khuyến mãi trước" disabled><i class="bi bi-chevron-left"></i></button>
                            <button type="button" class="cat-nav-btn js-slider-next" title="Mã tiếp theo" aria-label="Mã khuyến mãi tiếp theo"><i class="bi bi-chevron-right"></i></button>
                        </div>
                        <a class="cpn-section-link" href="@Url.Action("Index", "Coupon", new { area = "" })">Mã giảm giá của tôi <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
                <div class="course-slider cpn-slider" id="coupon-slider" aria-roledescription="carousel" aria-label="Mã khuyến mãi">
                    <div class="course-slider-track">
                        @foreach (var cp in homeCoupons.OrderBy(c => c.DaLuu))
                        {
                            <div class="course-slide">
                                @Html.Partial("_CouponTicket", new ECOLearning.ViewModels.TheMaGiamGiaModel { Ma = cp })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    }

    <style>
        /* Slider khóa học (gợi ý + nổi bật): 5 thẻ một lượt, mỗi lần trượt dời (5 - 1) thẻ để thẻ cuối lượt trước thành thẻ đầu lượt sau */
        .course-slider {
            --per-view: 5;
            --slide-gap: 18px;
            overflow: hidden;
            /* chừa chỗ cho hiệu ứng nâng thẻ và bóng đổ khi hover, không bị cắt */
            padding: 8px 4px 16px;
            margin: -8px -4px -16px;
        }

        .recommend-anchor {
            color: var(--text-secondary);
            margin: 0;
        }

        .recommend-anchor a {
            color: var(--primary, #434CE8);
            font-weight: 700;
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .recommend-anchor a:hover {
            color: var(--primary-hover, #3730A3);
        }

        .recommend-anchor strong {
            color: var(--text-heading, #0F172A);
        }

        /* Link mở hộp thoại chọn lĩnh vực quan tâm (Views/Shared/_InterestPicker.cshtml) */
        .recommend-anchor a.recommend-interest-link,
        a.recommend-interest-link {
            margin-left: 8px;
            color: var(--primary, #434CE8);
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
        }

        a.recommend-interest-link:hover {
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .course-slider-nav[hidden] {
            display: none !important;
        }

        .course-slider-track {
            display: flex;
            gap: var(--slide-gap);
            transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .course-slider {
            --shown: var(--per-view);
        }

        /* Ít khóa hơn số thẻ một lượt (is-fill, --count = số khóa): thẻ giãn ra lấp đầy hàng */
        .course-slider.is-fill {
            --shown: min(var(--per-view), var(--count));
        }

        .course-slide {
            flex: 0 0 calc((100% - (var(--shown) - 1) * var(--slide-gap)) / var(--shown));
            min-width: 0;
            display: flex;
        }

        .course-slide .course-card {
            width: 100%;
        }

        /* Thẻ thu nhỏ cho vừa 5 khóa một hàng */
        .course-slider .course-body {
            padding: 14px;
        }

        .course-slider .course-category {
            margin-bottom: 6px;
        }

        .course-slider .course-category .caption {
            font-size: 11.5px;
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .course-slider .course-title {
            font-size: 15px;
            line-height: 21px;
            min-height: 42px;
            margin-bottom: 6px;
        }

        .course-slider .course-instructor {
            font-size: 12.5px;
            margin-bottom: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }

        .course-slider .course-card-outcomes {
            margin: 4px 0 8px 0 !important;
        }

        .course-slider .course-rating {
            margin-bottom: 10px;
            gap: 4px;
            font-size: 11px;
        }

        .course-slider .course-thumb .badge {
            top: 8px !important;
            left: 8px !important;
            font-size: 10.5px;
            padding: 3px 8px;
        }

        .course-slider .course-footer {
            padding-top: 10px;
            gap: 6px;
        }

        .course-slider .course-pricing {
            flex-direction: column;
            align-items: flex-start;
            gap: 0;
            min-width: 0;
        }

        .course-slider .price-current {
            font-size: 15px;
        }

        .course-slider .price-original {
            font-size: 11.5px;
        }

        .course-slider .course-footer .btn {
            height: 30px;
            padding: 0 10px;
            font-size: 12px;
            flex-shrink: 0;
        }

        /* Thẻ giãn rộng: ảnh bìa không cao quá (cắt bớt theo object-fit: cover) */
        .course-slider.is-fill .course-thumb {
            max-height: 240px;
        }

        /* Từ 3 khóa trở xuống: thẻ đủ rộng nên trả chữ / nút về cỡ thường của thẻ khóa học */
        .course-slider.is-roomy .course-body { padding: 20px; }
        .course-slider.is-roomy .course-category { margin-bottom: 10px; }
        .course-slider.is-roomy .course-category .caption { font-size: 12px; }
        .course-slider.is-roomy .course-title { font-size: var(--fs-h3); line-height: 24px; min-height: 48px; margin-bottom: 8px; }
        .course-slider.is-roomy .course-instructor { font-size: var(--fs-body2); margin-bottom: 12px; }
        .course-slider.is-roomy .course-rating { margin-bottom: 16px; font-size: inherit; }
        .course-slider.is-roomy .course-thumb .badge { top: 12px !important; left: 12px !important; font-size: 12px; padding: 4px 10px; }
        .course-slider.is-roomy .course-footer { padding-top: 14px; }
        .course-slider.is-roomy .course-pricing { flex-direction: row; align-items: baseline; gap: 8px; }
        .course-slider.is-roomy .price-current { font-size: 18px; }
        .course-slider.is-roomy .price-original { font-size: 13px; }
        .course-slider.is-roomy .course-footer .btn { height: 36px; padding: 0 16px; font-size: var(--fs-caption); }

        /* Chỉ 1 khóa: thẻ nằm ngang (ảnh trái, nội dung phải) thay vì một ảnh bìa rộng cả hàng */
        .course-slider.is-single .course-card { flex-direction: row; }
        .course-slider.is-single .course-thumb { width: 42%; flex-shrink: 0; aspect-ratio: auto; max-height: none; min-height: 240px; }

        @@media (max-width: 1200px) {
            .course-slider { --per-view: 3; }
        }

        @@media (max-width: 768px) {
            .course-slider { --per-view: 2; --slide-gap: 14px; }
        }

        @@media (max-width: 480px) {
            .course-slider { --per-view: 1; }
            .course-slider.is-single .course-card { flex-direction: column; }
            .course-slider.is-single .course-thumb { width: 100%; aspect-ratio: 16 / 9; min-height: 0; }
        }
    </style>

<!-- Section UC7: Khóa Học Dành Riêng Cho Bạn (Gợi Ý Cá Nhân Hóa bằng lọc cộng tác, xem RecommendationService) -->
<section id="recommendations" style="padding: 60px 0; background: var(--bg-surface); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
    <div class="safe-container">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px;">
            <div>
                @* Tiêu đề và mô tả đổi theo nguồn gợi ý (RecommendationService.GetForHome) *@
                <h2 class="h2" style="margin-top: 8px;">@(homeRecommendation.CheDo == ECOLearning.ViewModels.CheDoGoiY.PhoBien ? "Khóa học phổ biến" : "Khóa học dành riêng cho bạn")</h2>
                @switch (homeRecommendation.CheDo)
                {
                    case ECOLearning.ViewModels.CheDoGoiY.TheoKhoaVuaXem:
                        <p class="body-2 recommend-anchor">
                            Vì bạn đã xem “<a href="@Url.Action("Details", "Course", new { id = homeRecommendation.MaKhoaHocMoc })" target="_blank" rel="noopener" title="Xem lại khóa học này">@homeRecommendation.TenKhoaHocMoc</a>”
                        </p>
                        break;
                    case ECOLearning.ViewModels.CheDoGoiY.TheoSoThich:
                        <p class="body-2 recommend-anchor">
                            Vì bạn quan tâm <strong>@string.Join(", ", homeRecommendation.LinhVucQuanTam.Select(l => l.TenDanhMuc))</strong>
                            @if (interestPicker != null)
                            {
                                <a href="#" class="recommend-interest-link" data-open-interest>Đổi lĩnh vực</a>
                            }
                        </p>
                        break;
                    case ECOLearning.ViewModels.CheDoGoiY.TongHop:
                        <p class="body-2" style="color: var(--text-secondary);">Gợi ý dựa trên các khóa học bạn đã học, xem và đánh giá</p>
                        break;
                    case ECOLearning.ViewModels.CheDoGoiY.PhoBien:
                        <p class="body-2" style="color: var(--text-secondary);">
                            @(homeRecommendation.DaCoTuongTac ? "Được nhiều học viên quan tâm trong lĩnh vực bạn đã xem" : "Phổ biến với học viên mới")
                            @if (interestPicker != null)
                            {
                                <a href="#" class="recommend-interest-link" data-open-interest>Chọn lĩnh vực quan tâm để nhận gợi ý phù hợp hơn</a>
                            }
                        </p>
                        break;
                    default:
                        <p class="body-2" style="color: var(--text-secondary);">Gợi ý dựa trên các khóa học bạn đã học, xem và đánh giá</p>
                        break;
                }
            </div>
            <div style="display: flex; gap: 10px; align-items: center; flex-shrink: 0;">
                @if (recommendations.Count > 1)
                {
                    <div class="course-slider-nav" data-slider-nav="recommend-slider" style="display: flex; gap: 10px; align-items: center;" hidden>
                        <button type="button" class="cat-nav-btn js-slider-prev" title="Khóa học trước" aria-label="Khóa học trước" disabled><i class="bi bi-chevron-left"></i></button>
                        <button type="button" class="cat-nav-btn js-slider-next" title="Khóa học tiếp theo" aria-label="Khóa học tiếp theo"><i class="bi bi-chevron-right"></i></button>
                    </div>
                }
                <a href="@Url.Action("Index", "Recommendation")" class="btn btn-outline btn-sm" style="text-decoration: none;">Xem tất cả khóa học</a>
            </div>
        </div>

        @if (recommendations.Count > 0)
        {
            // Ít hơn 5 khóa: thẻ giãn ra lấp đầy hàng (is-fill); <= 3 khóa: chữ cỡ thường (is-roomy); 1 khóa: thẻ nằm ngang
            int soGoiY = recommendations.Count;
            string kieuHienThi = soGoiY >= 5 ? "" : " is-fill" + (soGoiY <= 3 ? " is-roomy" : "") + (soGoiY == 1 ? " is-single" : "");
            <div class="course-slider@(kieuHienThi)" id="recommend-slider" style="--count: @soGoiY;">
                <div class="course-slider-track">
                    @foreach (var item in recommendations)
                    {
                        <div class="course-slide">
                            @Html.Partial("_RecommendedCourseCard", item)
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @* Chỉ còn trống khi học viên đã sở hữu mọi khóa đang mở bán, hoặc chưa chạy migration 005 *@
            bool chuaKhoiTao = ViewBag.HomeRecommendation == null;
            <div style="text-align: center; color: var(--text-secondary); padding: 24px; background: #FFFFFF; border-radius: 16px; border: 1px dashed var(--border-color, #E2E8F0);">
                @if (chuaKhoiTao)
                {
                    <i class="bi bi-hourglass-split me-1" style="color: var(--primary, #434CE8);"></i>
                    @:Chức năng gợi ý khóa học chưa sẵn sàng.
                    <a href="@Url.Action("Index", "Course")" style="font-weight: 600; margin-left: 6px;">Khám phá khóa học</a>
                }
                else
                {
                    <i class="bi bi-check2-circle me-1" style="color: var(--primary, #434CE8);"></i>
                    @:Bạn đã đăng ký tất cả khóa học hiện có.
                    <a href="@Url.Action("MyCourses", "Learning")" style="font-weight: 600; margin-left: 6px;">Vào Khóa học của tôi</a>
                }
            </div>
        }
    </div>
</section>

@* Đang ở trong khối @if (isLoggedIn) nên viết "if" không có "@" *@
if (interestPicker != null)
{
    @Html.Partial("_InterestPicker", interestPicker)
}

<!-- Section: Danh Sách Khóa Học Nổi Bật / Bán Chạy -->
<section id="courses-section" style="padding: 60px 0; background: var(--bg-canvas, #F8FAFC);">
    <div class="safe-container">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px;">
            <div>
                <span class="badge badge-warning" style="margin-bottom: 8px;">Top Bán Chạy & Xu Hướng</span>
                <h2 class="h2">Khóa học nổi bật nhất tuần</h2>
            </div>
            @if (courses != null && courses.Count > 1)
            {
                @* Mũi tên chỉ hiện khi số khóa nhiều hơn số thẻ hiển thị một lượt (JS bật/tắt theo bề rộng màn hình) *@
                <div class="course-slider-nav" data-slider-nav="featured-slider" style="display: flex; gap: 10px; align-items: center;" hidden>
                    <button type="button" class="cat-nav-btn js-slider-prev" title="Khóa học trước" aria-label="Khóa học trước" disabled><i class="bi bi-chevron-left"></i></button>
                    <button type="button" class="cat-nav-btn js-slider-next" title="Khóa học tiếp theo" aria-label="Khóa học tiếp theo"><i class="bi bi-chevron-right"></i></button>
                </div>
            }
        </div>

        @if (courses != null && courses.Count > 0)
        {

            <div class="course-slider" id="featured-slider">
                <div class="course-slider-track">
                @foreach (var course in courses)
                {
                    string thumbUrl = string.IsNullOrEmpty(course.anhBia) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80" : course.anhBia;
                    string teacherName = course.NguoiDung != null ? course.NguoiDung.hoTen : "ThS. Nguyễn Văn An";
                    string categoryName = course.DanhMuc != null ? course.DanhMuc.tenDanhMuc : "Lập trình Web & CNTT";
                    decimal actualPrice = course.giaKhuyenMai.HasValue ? course.giaKhuyenMai.Value : course.giaBan;
                    decimal oldPrice = course.giaBan;
                    bool hasRatings = course.DanhGiaKhoaHoc != null && course.DanhGiaKhoaHoc.Count > 0;
                    int enrollCount;
                    enrollCounts.TryGetValue(course.maKhoaHoc, out enrollCount);
                    double avgStars = hasRatings ? course.DanhGiaKhoaHoc.Average(d => d.soSao) : 0;
                    bool isTopTrending = enrollCount >= 3;
                    bool isHighRated = hasRatings && avgStars >= 4.5;

                    <div class="course-slide">
                        <div class="course-card" onclick="window.open('@Url.Action("Details", "Course", new { id = course.maKhoaHoc })', '_blank', 'noopener')" style="cursor: pointer;">
                            <div class="course-thumb">
                                <img src="@thumbUrl" alt="@course.tenKhoaHoc" loading="lazy" decoding="async" />
                                @Html.Partial("_FavoriteButton", new ECOLearning.ViewModels.FavoriteButtonModel { CourseId = course.maKhoaHoc, TeacherId = course.maGiaoVien })
                                @if (isTopTrending)
                                {
                                    <span class="badge badge-primary" style="position: absolute; top: 12px; left: 12px; background: #434CE8; color: #FFFFFF;"><i class="bi bi-fire me-1"></i> Top Trending</span>
                                }
                                else if (isHighRated)
                                {
                                    <span class="badge badge-success" style="position: absolute; top: 12px; left: 12px; background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0;"><i class="bi bi-star-fill me-1"></i> Đánh giá cao</span>
                                }
                            </div>
                            <div class="course-body">
                                <div class="course-category">
                                    <span class="caption" style="color: var(--primary); font-weight: 700;">@categoryName</span>
                                </div>
                                <h3 class="course-title" title="@course.tenKhoaHoc">@course.tenKhoaHoc</h3>
                                <div class="course-instructor">
                                    <i class="bi bi-person me-1"></i>
                                    @teacherName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(course.mucTieuDauRa))
                                {
                                    var cardOutcomes = course.mucTieuDauRa
                                        .Split(new[] { "\r\n", "\r", "\n", ";", "," }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(s => s.Trim().TrimStart('-', '•', '*').Trim())
                                        .Where(s => !string.IsNullOrEmpty(s))
                                        .Take(2)
                                        .ToList();

                                    if (cardOutcomes.Any())
                                    {
                                        <div class="course-card-outcomes" style="margin: 8px 0 10px 0; display: flex; flex-direction: column; gap: 4px; border-top: 1px dashed var(--border-color, #E2E8F0); padding-top: 8px;">
                                            @foreach (var oc in cardOutcomes)
                                            {
                                                <div style="font-size: 12px; color: var(--text-secondary, #64748B); display: flex; align-items: flex-start; gap: 6px; line-height: 1.4;">
                                                    <i class="bi bi-check2 text-primary" style="font-size: 14px; flex-shrink: 0; margin-top: 1px;"></i>
                                                    <span style="display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;" title="@oc">@oc</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }

                                <div class="course-rating">
                                    @if (hasRatings)
                                    {
                                        double avgRating = course.DanhGiaKhoaHoc.Average(d => d.soSao);
                                        int ratingCount = course.DanhGiaKhoaHoc.Count;
                                        <span class="rating-score">@avgRating.ToString("0.00")</span>
                                        <div class="stars" style="color: #F59E0B;"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></div>
                                        <span class="rating-count">(@ratingCount)</span>
                                    }
                                    else
                                    {
                                        <span class="rating-score" style="color: var(--text-muted, #94A3B8); font-size: 13px; font-weight: 500;">Chưa có đánh giá</span>
                                        <div class="stars" style="color: #CBD5E1; opacity: 0.7;"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></div>
                                    }
                                </div>

                                <div class="course-footer">
                                    <div class="course-pricing">
                                        <span class="price-current">@actualPrice.ToString("N0") đ</span>
                                        @if (actualPrice < oldPrice)
                                        {
                                            <span class="price-original">@oldPrice.ToString("N0") đ</span>
                                        }
                                    </div>
                                    <a href="@Url.Action("Details", "Course", new { id = course.maKhoaHoc })" target="_blank" rel="noopener" class="btn btn-outline btn-sm" onclick="event.stopPropagation();" style="border-radius: var(--radius-xl, 10px); font-weight: 600; text-decoration: none;">
                                        Chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                </div>
            </div>
        }
        else
        {
            <div style="text-align: center; color: var(--text-secondary); padding: 24px; background: #FFFFFF; border-radius: 16px; border: 1px dashed var(--border-color, #E2E8F0);">
                <i class="bi bi-check2-circle me-1" style="color: var(--primary, #434CE8);"></i>
                Bạn đã đăng ký tất cả khóa học hiện có.
                <a href="@Url.Action("MyCourses", "Learning")" style="font-weight: 600; margin-left: 6px;">Vào Khóa học của tôi</a>
            </div>
        }
    </div>
</section>
}
else
{
    <!-- TRANG CHÀO MỪNG KHI CHƯA ĐĂNG NHẬP: TUYỆT ĐỐI KHÔNG HIỂN THỊ KHÓA HỌC -->

    <style>
        /* ===== Hiệu ứng xuất hiện khi cuộn tới (chỉ ẩn trước khi JS chạy được, tránh mất nội dung nếu JS lỗi) ===== */
        .js-reveal .reveal-group:not(.is-visible) .value-card,
        .js-reveal .reveal-group:not(.is-visible) .step-card {
            opacity: 0;
        }

        /* --- Section "Giá trị cốt lõi": thẻ trồi lên từ dưới, icon bật nảy --- */
        .value-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .value-card {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            padding: 32px 24px;
            border-radius: 18px;
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.04);
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s ease, border-color 0.35s ease;
        }

        /* Thanh màu trên đầu thẻ, dài ra khi hover */
        .value-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 4px;
            width: 40%;
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
            border-radius: 0 0 4px 0;
            transition: width 0.4s ease;
        }

        .value-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: var(--soft);
            color: var(--accent);
            border: 1px solid #E2E8F0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            margin-bottom: 22px;
            transition: background 0.35s ease, color 0.35s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .value-card h3 {
            font-size: 18px;
            font-weight: 700;
            color: #0F172A;
            margin-bottom: 12px;
            transition: color 0.3s ease;
        }

        .value-card p {
            font-size: 14px;
            color: #64748B;
            line-height: 1.6;
            margin: 0;
            flex-grow: 1;
        }

        .value-card:hover {
            transform: translateY(-8px);
            border-color: #CBD5E1;
            box-shadow: 0 18px 36px -16px rgba(15, 23, 42, 0.16);
        }

        .value-card:hover::before {
            width: 100%;
        }

        .value-card:hover .value-icon {
            background: var(--accent);
            color: #FFFFFF;
            border-color: transparent;
            transform: rotate(-8deg) scale(1.1);
        }

        .value-card:hover h3 {
            color: var(--accent);
        }

        .reveal-group.is-visible .value-card {
            animation: value-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
            animation-delay: calc(var(--i) * 130ms);
        }

        .reveal-group.is-visible .value-icon {
            animation: value-icon-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
            animation-delay: calc(var(--i) * 130ms + 300ms);
        }

        @@keyframes value-rise {
            from { opacity: 0; transform: translateY(48px); }
            to { opacity: 1; transform: none; }
        }

        @@keyframes value-icon-pop {
            from { opacity: 0; transform: scale(0.3) rotate(-30deg); }
            to { opacity: 1; transform: none; }
        }

        /* --- Section "4 bước": thẻ lật 3D lần lượt từ trái sang phải như các bước nối tiếp --- */
        .step-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            perspective: 1200px;
        }

        .step-card {
            position: relative;
            overflow: hidden;
            padding: 28px 22px;
            border-radius: 18px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-left: 3px solid var(--accent);
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s ease, background 0.35s ease;
        }

        .step-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .step-number {
            font-size: 34px;
            font-weight: 900;
            line-height: 1;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            transition: transform 0.35s ease;
            transform-origin: left center;
        }

        .step-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--soft);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            border: 1px solid #E2E8F0;
            transition: transform 0.35s ease, background 0.35s ease, color 0.35s ease;
        }

        .step-card h4 {
            font-size: 16px;
            font-weight: 700;
            color: #0F172A;
            margin-bottom: 8px;
        }

        .step-card p {
            font-size: 13.5px;
            color: #475569;
            line-height: 1.5;
            margin: 0;
        }

        .step-card:hover {
            transform: translateY(-6px);
            background: #FFFFFF;
            box-shadow: 0 16px 32px -16px rgba(15, 23, 42, 0.16);
        }

        .step-card:hover .step-number {
            transform: scale(1.15);
        }

        .step-card:hover .step-icon {
            background: var(--accent);
            color: #FFFFFF;
            transform: rotate(12deg) scale(1.1);
        }

        .reveal-group.is-visible .step-card {
            animation: step-flip 0.8s cubic-bezier(0.22, 1, 0.36, 1) backwards;
            animation-delay: calc(var(--i) * 200ms);
            transform-origin: left center;
        }

        @@keyframes step-flip {
            from { opacity: 0; transform: rotateY(-80deg) translateX(-24px); }
            to { opacity: 1; transform: none; }
        }

        @@media (max-width: 991px) {
            .value-grid,
            .step-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575px) {
            .value-grid,
            .step-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .js-reveal .reveal-group:not(.is-visible) .value-card,
            .js-reveal .reveal-group:not(.is-visible) .step-card {
                opacity: 1;
            }

            .reveal-group.is-visible .value-card,
            .reveal-group.is-visible .value-icon,
            .reveal-group.is-visible .step-card {
                animation: none;
            }
        }
    </style>
    <script>document.documentElement.classList.add('js-reveal');</script>

    <!-- Section 1: Ưu điểm & Giá trị vượt trội của nền tảng -->
    <section style="padding: 72px 0; background: var(--bg-canvas, #F8FAFC); border-bottom: 1px solid var(--border-color, #E2E8F0);">
        <div class="safe-container">
            <div style="text-align: center; max-width: 720px; margin: 0 auto 52px;">
                <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; font-size: 12.5px; font-weight: 700; border-radius: 9999px; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">
                    <i class="bi bi-patch-check-fill"></i> Giá trị cốt lõi
                </div>
                <h2 style="font-size: 32px; font-weight: 800; color: #0F172A; margin-bottom: 16px; line-height: 1.3;">
                    Tại sao E-Learning là điểm khởi đầu lý tưởng cho sự nghiệp của bạn?
                </h2>
                <p style="font-size: 16px; color: #64748B; line-height: 1.6; margin: 0;">
