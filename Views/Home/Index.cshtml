    <!-- Section 2: Thống kê ấn tượng (Platform Stats) -->
    <section id="platform-stats-section" style="padding: 60px 0; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF; position: relative; overflow: hidden;">
        <div class="safe-container">
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; text-align: center;">
                <div style="padding: 10px;">
