@{
    ViewBag.Title = "Chứng chỉ tốt nghiệp - E-Learning";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var course = ViewBag.Course as ECOLearning.Models.KhoaHoc;
    var student = ViewBag.Student as ECOLearning.Models.NguoiDung;
    string certCode = ViewBag.CertificateCode as string ?? "CERT-2026-ELN-8849";
    string studentName = student != null ? student.hoTen : "Học viên";
    string courseName = course != null ? course.tenKhoaHoc : "Khóa học E-Learning";
    string teacherName = (course != null && course.NguoiDung != null) ? course.NguoiDung.hoTen : "Hội đồng Giảng viên";
}

<style>
    .cert-frame {
        background: #FFFFFF;
        border: 12px solid #1E1B4B;
        outline: 2px solid #C7D2FE;
        border-radius: var(--radius-2xl, 16px);
        padding: 60px 48px;
        max-width: 900px;
        margin: 0 auto 30px;
        box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.15);
        text-align: center;
        position: relative;
    }

    .cert-seal {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
        color: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
    }

    @@media print {
        header, footer, .no-print {
            display: none !important;
        }
        main {
            padding: 0 !important;
            background: #fff !important;
        }
        .cert-frame {
            box-shadow: none !important;
            border-width: 8px !important;
            padding: 40px !important;
            margin: 0 auto !important;
            page-break-inside: avoid;
        }
    }
</style>

<main style="padding: 40px 20px 80px; background: var(--bg-canvas, #F8FAFC); min-height: 80vh;">
    <div class="safe-container">

        <div class="no-print" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 12px;">
            <a href="@Url.Action("MyCourses", "Learning")" class="btn btn-outline btn-sm" style="text-decoration: none;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại Khóa học của tôi
            </a>
            <div style="display: flex; gap: 10px;">
                <button type="button" class="btn btn-primary btn-sm" onclick="downloadCertificate()" style="background: #434CE8; border-color: #434CE8; font-weight: 600;">
                    <i class="bi bi-printer me-1"></i> Tải xuống / In PDF
                </button>
            </div>
        </div>

        <div style="text-align: center; margin-bottom: 24px;" class="no-print">
            <span class="badge" style="background: #ECFDF5; color: #059669; font-size: 13px; font-weight: 700; padding: 6px 14px; border-radius: 9999px; border: 1px solid #A7F3D0;">
                <i class="bi bi-patch-check-fill me-1"></i> Chứng chỉ số được xác thực
            </span>
            <h1 class="h2" style="margin-top: 10px; font-weight: 800; color: #0F172A; font-size: 26px;">Chứng Chỉ Hoàn Thành Khóa Học</h1>
            <p class="caption" style="color: #64748B; font-size: 14px;">Mã xác thực trực tuyến: <strong style="color: #1E293B;">@certCode</strong></p>
        </div>

        <!-- CERTIFICATE PDF CANVAS (100% Matching Design Project) -->
        <div class="cert-frame" id="certificate-print-area">
            <div style="font-size: 13px; font-weight: 800; letter-spacing: 0.15em; color: #434CE8; text-transform: uppercase; margin-bottom: 16px;">
                HỆ THỐNG ĐÀO TẠO TRỰC TUYẾN ECO LEARNING
            </div>

            <h2 style="font-size: 34px; font-weight: 800; color: #0F172A; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 14px;">
                CHỨNG NHẬN TỐT NGHIỆP
            </h2>

            <p style="font-size: 16px; color: #64748B; margin-bottom: 20px;">
                Chứng nhận này được trân trọng trao cho học viên
            </p>

            <div style="font-size: 30px; font-weight: 800; color: #434CE8; border-bottom: 2px solid #E2E8F0; display: inline-block; padding: 0 40px 10px; margin-bottom: 24px; text-transform: uppercase;">
                @studentName
            </div>

            <p style="font-size: 15px; color: #334155; max-width: 640px; margin: 0 auto 28px; line-height: 26px;">
                Đã hoàn thành xuất sắc 100% nội dung và các bài kiểm tra thực hành của khóa học:<br />
                <strong style="color: #0F172A; font-size: 18px; display: inline-block; margin-top: 6px;">@courseName</strong>
            </p>

            <!-- Seal & Signatures -->
            <div style="display: flex; justify-content: space-between; align-items: flex-end; max-width: 700px; margin: 40px auto 0; flex-wrap: wrap; gap: 24px;">
                <div style="text-align: center; width: 180px;">
                    <div style="font-family: cursive; font-size: 20px; color: #1E1B4B; margin-bottom: 4px;">@teacherName</div>
                    <div style="height: 1px; background: #0F172A; margin-bottom: 6px;"></div>
                    <strong style="font-size: 13px; color: #0F172A;">@teacherName</strong>
                    <div class="caption" style="font-size: 12px; color: #64748B;">Giảng viên phụ trách</div>
                </div>

                <div class="cert-seal">
                    <span>OFFICIAL</span>
                    <span>★ VERIFIED ★</span>
                    <span>@DateTime.Now.Year</span>
                </div>

                <div style="text-align: center; width: 180px;">
                    <div style="font-family: cursive; font-size: 20px; color: #1E1B4B; margin-bottom: 4px;">ECO Board</div>
                    <div style="height: 1px; background: #0F172A; margin-bottom: 6px;"></div>
                    <strong style="font-size: 13px; color: #0F172A;">Hội đồng Học thuật</strong>
                    <div class="caption" style="font-size: 12px; color: #64748B;">E-Learning Director</div>
                </div>
            </div>
        </div>

        <div style="text-align: center;" class="no-print">
            <button class="btn btn-primary" onclick="downloadCertificate()" style="background: #434CE8; border-color: #434CE8; padding: 12px 28px; font-weight: 700; border-radius: 12px;">
                <i class="bi bi-download me-2"></i> Tải xuống chứng chỉ PDF
            </button>
        </div>

    </div>
</main>

@section scripts {
<script>
    function downloadCertificate() {
        if (typeof showToast === 'function') {
            showToast('Đang kết xuất tệp tin PDF chuẩn in ấn...', 'info');
        }
        setTimeout(() => {
            window.print();
        }, 500);
    }
</script>
}
