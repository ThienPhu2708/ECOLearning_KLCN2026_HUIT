<!-- SLIDE-OUT PANEL: HỎI GIÁO VIÊN TRONG KHÔNG GIAN HỌC TẬP -->
<div class="study-chat-backdrop" id="study-chat-backdrop" onclick="closeStudyChat()"></div>

<div class="study-chat-panel" id="study-chat-panel">
    <div class="study-chat-header">
        <h3><i class="bi bi-chat-dots-fill"></i> Trao đổi với Giáo viên</h3>
        <button type="button" class="study-chat-close-btn" onclick="closeStudyChat()" aria-label="Đóng">&times;</button>
    </div>

    <div class="chat-alert-banner">
        <i class="bi bi-info-circle-fill"></i>
        <span>Giáo viên phụ trách khóa học sẽ nhận được câu hỏi và giải đáp cho bạn.</span>
    </div>

    <!-- Khung tin nhắn -->
    <div class="chat-messages-body" id="study-chat-messages" style="flex: 1; overflow-y: auto;">
        <div class="text-center text-muted py-4" id="study-chat-loading">
            <div class="spinner-border spinner-border-sm text-teal mb-2" role="status"></div>
            <div>Đang tải cuộc trò chuyện...</div>
        </div>
    </div>

    <div class="chat-typing-indicator" id="study-chat-typing" style="display: none; padding: 6px 16px; font-size: 12px; color: #64748B;">
        <i class="bi bi-pencil-fill"></i> Giáo viên đang soạn tin...
    </div>

    <!-- Ô gửi tin -->
    <div class="chat-footer">
        <textarea class="chat-input" id="study-chat-input" rows="1" placeholder="Nhập câu hỏi của bạn cho bài học này..."></textarea>
        <button type="button" class="chat-send-btn" id="study-chat-send-btn" title="Gửi câu hỏi">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
</div>

