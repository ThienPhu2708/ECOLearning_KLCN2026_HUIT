<!-- SLIDE-OUT PANEL: HỎI GIÁO VIÊN TRONG KHÔNG GIAN HỌC TẬP -->
<div class="study-chat-backdrop" id="study-chat-backdrop" onclick="closeStudyChat()"></div>

<div class="study-chat-panel" id="study-chat-panel" role="dialog" aria-modal="true" aria-labelledby="study-chat-title" tabindex="-1">
    <div class="study-chat-header">
        <div class="study-chat-heading">
            <span class="study-chat-icon"><i class="bi bi-chat-dots"></i></span>
            <div><h3 id="study-chat-title">Hỏi giáo viên</h3><p>Trao đổi về bài học của bạn</p></div>
        </div>
        <button type="button" class="study-chat-close-btn" onclick="closeStudyChat()" aria-label="Đóng">&times;</button>
    </div>

    <div class="chat-alert-banner">
        <i class="bi bi-info-circle-fill"></i>
        <span>Câu hỏi được gửi riêng đến giáo viên phụ trách khóa học.</span>
    </div>

    <!-- Khung tin nhắn -->
    <div class="chat-messages-body" id="study-chat-messages" role="log" aria-live="polite" aria-label="Tin nhắn với giáo viên">
        <div class="eco-chat-state" id="study-chat-loading">
            <div class="eco-spinner"></div>
            <div>Đang tải cuộc trò chuyện...</div>
        </div>
    </div>

    <div class="chat-typing-indicator" id="study-chat-typing" style="display: none; padding: 6px 16px; font-size: 12px; color: #64748B;">
        <i class="bi bi-pencil-fill"></i> Giáo viên đang soạn tin...
    </div>

    <!-- Ô gửi tin -->
    <div class="chat-footer">
        <textarea class="chat-input" id="study-chat-input" rows="1" maxlength="2000" aria-label="Nội dung câu hỏi" placeholder="Nhập câu hỏi cho giáo viên..."></textarea>
        <button type="button" class="chat-send-btn" id="study-chat-send-btn" title="Gửi câu hỏi" aria-label="Gửi câu hỏi">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
</div>

