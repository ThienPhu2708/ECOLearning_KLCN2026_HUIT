@model ECOLearning.ViewModels.StudentProfileViewModel

@{
    ViewBag.Title = "Quản lý Hồ sơ cá nhân | E-Learning Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string birthDateStr = Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/assets/css/bank-picker.css?v=1.0")" />
    <style>
        .profile-header-banner {
            height: 160px;
            background: linear-gradient(135deg, var(--primary, #434CE8) 0%, #1E1B4B 100%);
            border-radius: var(--radius-3xl, 24px) var(--radius-3xl, 24px) 0 0;
            position: relative;
        }

        .profile-avatar-wrap {
            position: relative;
            margin-top: -60px;
            margin-bottom: 20px;
            display: inline-block;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: var(--radius-full, 9999px);
            border: 4px solid var(--bg-surface, #FFFFFF);
            object-fit: cover;
            box-shadow: var(--shadow-card, 0 4px 12px rgba(0, 0, 0, 0.08));
            background-color: #cbd5e1;
        }

        .avatar-upload-btn {
            position: absolute;
            bottom: 6px;
            right: 6px;
            background: var(--primary, #434CE8);
            color: #fff;
            width: 36px;
            height: 36px;
            border-radius: var(--radius-full, 9999px);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 2px solid #fff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
            transition: background var(--transition-fast, 0.2s);
        }

        .avatar-upload-btn:hover {
            background: var(--primary-hover, #3538CD);
        }

        .grid-12 {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 20px;
        }

        .col-6 {
            grid-column: span 6;
        }

        .tab-btn {
            padding: 12px 20px;
            font-weight: 600;
            font-size: 15px;
            color: #64748B;
            border: none;
            background: none;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .tab-btn:hover {
            color: #434CE8;
        }

        .tab-btn.active {
            color: #434CE8 !important;
            border-bottom-color: #434CE8 !important;
        }
    </style>
}

<main style="padding: 40px 0 80px;">
    <div class="safe-container">
        <div style="margin-bottom: 15px;">
            <h1 class="h2" style="margin-top: 8px; font-size: 28px; font-weight: 800; color: #0F172A;">Quản lý Hồ sơ Cá nhân</h1>
        </div>

        @if (Session[ECOLearning.AccountStatusFilter.KeyCanDoiMatKhau] as bool? == true)
        {
            <div id="temp-password-banner" style="display: flex; gap: 12px; align-items: flex-start; background: #FFFBEB; border: 1px solid #FCD34D; border-radius: 14px; padding: 14px 18px; margin-bottom: 20px; color: #92400E;">
                <i class="bi bi-shield-exclamation" style="font-size: 22px; line-height: 1;"></i>
                <div>
                    <strong>Bạn đang dùng mật khẩu tạm do Ban quản trị cấp.</strong>
                    <div style="font-size: 14px; margin-top: 2px;">Nhập mật khẩu tạm ở ô "Mật khẩu hiện tại" và đặt mật khẩu mới để tiếp tục sử dụng hệ thống.</div>
                </div>
            </div>
        }

        <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 30px; background: #FFFFFF; border: 1px solid var(--border-color, #E2E8F0); border-radius: var(--radius-3xl, 24px); box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);">
            <!-- Top Banner -->
            <div class="profile-header-banner"></div>

            <div style="padding: 0 40px 30px;">

                <!-- Avatar Upload Wrap -->
                <div class="profile-avatar-wrap">
                    <img id="avatar-preview" src="@Model.AvatarUrl" alt="Avatar" class="profile-avatar">
                    <label class="avatar-upload-btn" title="Tải ảnh mới">
                        <i class="bi bi-camera-fill" style="font-size: 16px;"></i>
                        <input type="file" id="avatar-input" accept="image/*" style="display: none;" onchange="uploadAvatarFile(this)">
                    </label>
                </div>

                <!-- Tab Navigation -->
                <div class="tab-nav" style="display: flex; gap: 8px; border-bottom: 2px solid #F1F5F9; margin-bottom: 30px; flex-wrap: wrap;">
                    <button class="tab-btn active" id="tab-btn-info" data-tab="tab-info" onclick="switchProfileTab('info')">
                        <i class="bi bi-person-circle"></i> Cập nhật thông tin cá nhân
                    </button>
                    @if (Model.IsTeacher)
                    {
                        <button class="tab-btn" id="tab-btn-teacher" data-tab="tab-teacher" onclick="switchProfileTab('teacher')">
                            <i class="bi bi-mortarboard-fill"></i> Hồ sơ giáo viên
                        </button>
                    }
                    <button class="tab-btn" id="tab-btn-password" data-tab="tab-password" onclick="switchProfileTab('password')">
                        <i class="bi bi-shield-lock-fill"></i> Đổi mật khẩu bảo vệ
                    </button>
                </div>

                <!-- TAB 1: CẬP NHẬT THÔNG TIN CÁ NHÂN -->
                <div id="tab-info" class="tab-content" style="display: block;">
                    <form id="form-update-profile" onsubmit="handleSaveProfile(event)" style="max-width: 680px;">
                        <div class="grid-12" style="margin-bottom: 20px;">
                            <div class="col-6">
                                <label class="form-label" for="prof-fullname">Họ và tên <span class="required" style="color: #EF4444;">*</span></label>
                                <input type="text" id="prof-fullname" class="form-control" value="@Model.FullName" required placeholder="Nguyễn Văn A">
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="prof-gender">Giới tính</label>
                                <select class="form-control" id="prof-gender">
                                    <option value="Nữ" @(Model.Gender == "Nữ" || Model.Gender == "female" ? "selected" : "")>Nữ</option>
                                    <option value="Nam" @(Model.Gender == "Nam" || Model.Gender == "male" ? "selected" : "")>Nam</option>
                                    <option value="Khác" @(Model.Gender == "Khác" || Model.Gender == "other" ? "selected" : "")>Khác</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid-12" style="margin-bottom: 20px;">
                            <div class="col-6">
                                <label class="form-label" for="prof-dob">Ngày sinh</label>
                                <input type="date" id="prof-dob" class="form-control" value="@birthDateStr">
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="prof-phone">Số điện thoại <span class="required" style="color: #EF4444;">*</span></label>
                                <input type="tel" id="prof-phone" class="form-control" value="@Model.Phone" placeholder="09xxxxxxxx">
                                <div id="phone-error" class="form-feedback-error" style="display: none; color: #EF4444; font-size: 12px; margin-top: 6px;">
                                    Số điện thoại sai định dạng (Cần 10 chữ số).
                                </div>
                            </div>
                        </div>

                        <div class="form-group" style="margin-bottom: 20px;">
                            <label class="form-label">Email tài khoản</label>
                            <input type="email" class="form-control" value="@Model.Email" disabled style="background-color: var(--bg-canvas, #F8FAFC); cursor: not-allowed; color: #64748B;">
                            <span class="caption" style="display: block; font-size: 13px; color: #64748B; margin-top: 6px;">Email tài khoản dùng cho các thông báo giao dịch và cấp quyền</span>
                        </div>

                        <div style="display: flex; gap: 12px; margin-top: 30px;">
                            <button type="submit" id="btn-save-profile" class="btn btn-primary" style="background: #434CE8; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; border: none; cursor: pointer;">Lưu thay đổi</button>
                            <button type="reset" class="btn btn-secondary" style="background: #F1F5F9; color: #475569; padding: 12px 24px; border-radius: 12px; font-weight: 600; border: 1px solid #CBD5E1; cursor: pointer;">Đặt lại ban đầu</button>
                        </div>
                    </form>
                </div>

                <!-- TAB 2: HỒ SƠ GIÁO VIÊN (DÀNH RIÊNG CHO GIẢNG VIÊN) -->
                @if (Model.IsTeacher)
                {
                    <div id="tab-teacher" class="tab-content" style="display: none;">
                        <div style="max-width: 760px; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 18px; padding: 32px; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; border-bottom: 1px solid #F1F5F9; padding-bottom: 16px;">
                                <div>
                                    <h3 style="font-size: 18px; font-weight: 700; color: #0F172A; margin: 0 0 6px 0; display: flex; align-items: center; gap: 8px;">
                                        <i class="bi bi-mortarboard-fill" style="color: #434CE8; font-size: 22px;"></i> Hồ sơ giáo viên
                                    </h3>
                                    <p style="font-size: 13px; color: #64748B; margin: 0;">Thông tin năng lực chuyên môn và tài khoản chi trả thù lao giảng dạy</p>
                                </div>
                            </div>

                            <form id="form-teacher-profile" onsubmit="event.preventDefault(); handleSaveTeacherProfile();">
                                <div class="form-group" style="margin-bottom: 20px;">
                                    <label class="form-label" for="teacher-specialization">Lĩnh vực giảng dạy đã được duyệt</label>
                                    <input type="text" id="teacher-specialization" class="form-control" value="@(ViewBag.LegacySpecialtyAccess == true ? "Giữ quyền giảng dạy hiện tại" : Model.Specialization)" readonly>
                                    <a href="@Url.Action("Index", "Specialty", new { area = "Instructor" })" style="display:inline-block;margin-top:8px;font-size:12px;">Xem lĩnh vực giảng dạy</a>
                                </div>

                                <div class="form-group" style="margin-bottom: 20px;">
                                    <label class="form-label" for="teacher-experience">Kinh nghiệm & Giới thiệu năng lực <span class="required" style="color: #EF4444;">*</span></label>
                                    <textarea id="teacher-experience" class="form-control" rows="4" placeholder="VD: Đã có 5+ năm kinh nghiệm giảng dạy và làm việc tại các công ty công nghệ..." style="resize: vertical;">@Model.BioExperience</textarea>
                                </div>

                                <div class="form-group" style="margin-bottom: 24px;">
                                    <label class="form-label">Chứng chỉ / Bằng cấp chuyên môn</label>
                                    @if (!string.IsNullOrEmpty(Model.CertificateFilePath))
                                    {
                                        <div id="cert-preview-box" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; margin-bottom: 10px;">
                                            <div style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
                                                <i class="bi bi-file-earmark-check-fill" style="color: #434CE8; font-size: 22px;"></i>
                                                <span id="current-cert-name" style="font-size: 13px; font-weight: 600; color: #1E293B; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
                                                    @(string.IsNullOrEmpty(Model.CertificateFileName) ? "Xem tệp chứng chỉ hiện tại" : Model.CertificateFileName)
                                                </span>
                                            </div>
                                            <a id="current-cert-link" href="@Model.CertificateFilePath" target="_blank" class="btn btn-sm" style="background: #EEF2FF; color: #434CE8; font-weight: 600; font-size: 13px; padding: 6px 14px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                                <i class="bi bi-box-arrow-up-right"></i> Xem tệp
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="cert-preview-box" style="display: none; align-items: center; justify-content: space-between; padding: 12px 16px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; margin-bottom: 10px;">
                                            <div style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
                                                <i class="bi bi-file-earmark-check-fill" style="color: #434CE8; font-size: 22px;"></i>
                                                <span id="current-cert-name" style="font-size: 13px; font-weight: 600; color: #1E293B;"></span>
                                            </div>
                                            <a id="current-cert-link" href="#" target="_blank" class="btn btn-sm" style="background: #EEF2FF; color: #434CE8; font-weight: 600; font-size: 13px; padding: 6px 14px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                                <i class="bi bi-box-arrow-up-right"></i> Xem tệp
                                            </a>
                                        </div>
                                    }
                                    <input type="file" id="teacher-cert-file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" style="font-size: 13px;">
                                    <span style="display: block; font-size: 12px; color: #64748B; margin-top: 6px;">Tải lên tệp mới nếu muốn thay đổi chứng chỉ (Hỗ trợ PDF, JPG, PNG, DOCX, tối đa 10MB)</span>
                                </div>

                                <div style="font-size: 15px; font-weight: 700; color: #1E293B; margin: 28px 0 16px; display: flex; align-items: center; gap: 8px; border-top: 1px solid #F1F5F9; padding-top: 20px;">
                                    <i class="bi bi-credit-card-2-front-fill" style="color: #434CE8; font-size: 18px;"></i> Thông tin nhận thù lao giảng dạy
                                </div>

                                @{
                                    // Tên ngân hàng cũ có thể gõ tự do: nhận ra ngân hàng trong danh mục để chọn sẵn, nhắc kiểm tra lại
                                    var nganHangCu = ECOLearning.Services.BankDirectory.DoanNganHang(Model.BankName);
                                }
                                <div class="form-group" style="margin-bottom: 16px;">
                                    <label class="form-label" for="teacher-bank-search">Ngân hàng thụ hưởng</label>
                                    @Html.Partial("_BankPicker", new ECOLearning.ViewModels.BankPickerViewModel
                                    {
                                        Id = "teacher-bank-search",
                                        Name = "bankCode",
                                        SelectedCode = nganHangCu != null ? nganHangCu.Code : null,
                                        InputClass = "form-control",
                                        Note = ECOLearning.Services.BankDirectory.GhiChuTenCu(Model.BankName, nganHangCu),
                                        NextFieldId = "teacher-account-number"
                                    })
                                    <span style="display: block; font-size: 12px; color: #64748B; margin-top: 6px;">Chọn trong danh sách ngân hàng (không nhập tay) để tránh sai sót khi chuyển thù lao.</span>
                                </div>

                                <div class="grid-12" style="margin-bottom: 24px;">
                                    <div class="col-6">
                                        <label class="form-label" for="teacher-account-number">Số tài khoản</label>
                                        <input type="text" id="teacher-account-number" class="form-control" value="@Model.AccountNumber" placeholder="VD: 0123456789" inputmode="numeric" autocomplete="off" maxlength="19" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                        <span style="display: block; font-size: 12px; color: #64748B; margin-top: 6px;">Chỉ gồm chữ số (6–19 số).</span>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label" for="teacher-account-name">Tên chủ tài khoản</label>
                                        <input type="text" id="teacher-account-name" class="form-control" value="@Model.AccountName" placeholder="VD: NGUYEN VAN A" autocomplete="off" maxlength="100" onblur="this.value = BankPicker.tenChuTaiKhoan(this.value)">
                                        <span style="display: block; font-size: 12px; color: #64748B; margin-top: 6px;">In hoa, không dấu, đúng như trên ứng dụng ngân hàng.</span>
                                    </div>
                                </div>

                                <div style="display: flex; gap: 12px; margin-top: 30px;">
                                    <button type="submit" id="btn-save-teacher" class="btn btn-primary" style="background: #434CE8; color: #fff; padding: 12px 28px; border-radius: 12px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
                                        <i class="bi bi-check2-circle" style="font-size: 18px;"></i> Cập nhật hồ sơ giáo viên
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                <!-- TAB 3: ĐỔI MẬT KHẨU BẢO VỆ -->
                <div id="tab-password" class="tab-content" style="display: none;">
                    <form id="form-change-password" onsubmit="handleChangePassword(event)" style="max-width: 500px;">
                        <div class="form-group" style="margin-bottom: 20px;">
                            <label class="form-label" for="pass-current">Mật khẩu hiện tại <span class="required" style="color: #EF4444;">*</span></label>
                            <input type="password" id="pass-current" class="form-control" placeholder="••••••••" required>
                            <div id="pass-current-error" class="form-feedback-error" style="display: none; color: #EF4444; font-size: 12px; margin-top: 6px;">Mật khẩu hiện tại không chính xác!</div>
                        </div>

                        <div class="form-group" style="margin-bottom: 20px;">
                            <label class="form-label" for="pass-new">Mật khẩu mới <span class="required" style="color: #EF4444;">*</span></label>
                            <input type="password" id="pass-new" class="form-control" placeholder="Tối thiểu 8 ký tự, có số và ký tự đặc biệt" required oninput="checkProfilePassStrength(this.value)">
                            <div class="strength-meter" style="height: 6px; background: #E2E8F0; border-radius: 9999px; margin-top: 8px; overflow: hidden;">
                                <div id="profile-strength-bar" class="strength-fill" style="height: 100%; width: 0%; transition: all 0.3s ease;"></div>
                            </div>
                            <div id="profile-strength-text" style="font-size: 12px; color: #64748B; margin-top: 6px; font-weight: 600;">Độ mạnh: Chưa nhập</div>
                            <div id="pass-new-error" class="form-feedback-error" style="display: none; color: #EF4444; font-size: 12px; margin-top: 6px;">Mật khẩu mới quá yếu hoặc dưới 8 ký tự!</div>
                        </div>

                        <div class="form-group" style="margin-bottom: 20px;">
                            <label class="form-label" for="pass-confirm">Xác nhận mật khẩu mới <span class="required" style="color: #EF4444;">*</span></label>
                            <input type="password" id="pass-confirm" class="form-control" placeholder="Nhập lại mật khẩu mới" required>
                            <div id="pass-confirm-error" class="form-feedback-error" style="display: none; color: #EF4444; font-size: 12px; margin-top: 6px;">Mật khẩu xác nhận không khớp!</div>
                        </div>

                        <div style="display: flex; gap: 12px; margin-top: 30px;">
                            <button type="submit" id="btn-change-pass" class="btn btn-primary" style="background: #434CE8; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; border: none; cursor: pointer;">Cập nhật mật khẩu</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>

    </div>
</main>

@section scripts {
    <script src="@Url.Content("~/assets/js/bank-picker.js?v=1.0")"></script>
    <script>
        // Switch Profile Tabs
        function switchProfileTab(tabName) {
            const tabInfoBtn = document.getElementById('tab-btn-info');
            const tabTeacherBtn = document.getElementById('tab-btn-teacher');
            const tabPassBtn = document.getElementById('tab-btn-password');
            const tabInfoContent = document.getElementById('tab-info');
            const tabTeacherContent = document.getElementById('tab-teacher');
            const tabPassContent = document.getElementById('tab-password');

            // Reset tab button active class
            if (tabInfoBtn) tabInfoBtn.classList.remove('active');
            if (tabTeacherBtn) tabTeacherBtn.classList.remove('active');
            if (tabPassBtn) tabPassBtn.classList.remove('active');

            // Hide all tab contents
            if (tabInfoContent) tabInfoContent.style.display = 'none';
            if (tabTeacherContent) tabTeacherContent.style.display = 'none';
            if (tabPassContent) tabPassContent.style.display = 'none';

            // Show selected tab content and highlight button
            if (tabName === 'info') {
                if (tabInfoBtn) tabInfoBtn.classList.add('active');
                if (tabInfoContent) tabInfoContent.style.display = 'block';
            } else if (tabName === 'teacher') {
                if (tabTeacherBtn) tabTeacherBtn.classList.add('active');
                if (tabTeacherContent) tabTeacherContent.style.display = 'block';
            } else if (tabName === 'password') {
                if (tabPassBtn) tabPassBtn.classList.add('active');
                if (tabPassContent) tabPassContent.style.display = 'block';
            }
        }

        // Mở thẳng tab đổi mật khẩu khi được chuyển đến từ yêu cầu đổi mật khẩu tạm (?tab=password)
        document.addEventListener('DOMContentLoaded', function () {
            if (new URLSearchParams(window.location.search).get('tab') === 'password' || document.getElementById('temp-password-banner')) {
                switchProfileTab('password');
            }
        });

        // AJAX Update Teacher Profile
        function handleSaveTeacherProfile() {
            const bioExperience = document.getElementById('teacher-experience') ? document.getElementById('teacher-experience').value.trim() : '';
            // Ngân hàng chỉ chọn trong danh mục (assets/js/bank-picker.js); số TK chỉ gồm chữ số; tên chủ TK in hoa không dấu
            const bankPicker = BankPicker.get(document.getElementById('teacher-bank-search'));
            const bankCode = bankPicker ? bankPicker.value() : '';
            const accountNumberEl = document.getElementById('teacher-account-number');
            const accountNameEl = document.getElementById('teacher-account-name');
            const accountNumber = accountNumberEl ? BankPicker.chiSo(accountNumberEl.value) : '';
            if (accountNameEl) accountNameEl.value = BankPicker.tenChuTaiKhoan(accountNameEl.value);
            const accountName = accountNameEl ? accountNameEl.value : '';
            const certInput = document.getElementById('teacher-cert-file');

            if (bankPicker && !bankPicker.validate()) {
                showToast('Vui lòng chọn ngân hàng thụ hưởng trong danh sách!', 'error');
                return;
            }
            if (accountNumber.length < 6 || accountNumber.length > 19) {
                showToast('Số tài khoản chỉ gồm chữ số, dài từ 6 đến 19 số!', 'error');
                if (accountNumberEl) accountNumberEl.focus();
                return;
            }
            if (accountName.length < 2) {
                showToast('Vui lòng nhập tên chủ tài khoản (in hoa, không dấu)!', 'error');
                if (accountNameEl) accountNameEl.focus();
                return;
            }

            const btn = document.getElementById('btn-save-teacher');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang lưu...';
            }

            const formData = new FormData();
            formData.append('bioExperience', bioExperience);
            formData.append('bankCode', bankCode);
            formData.append('accountNumber', accountNumber);
            formData.append('accountName', accountName);

            if (certInput && certInput.files && certInput.files[0]) {
                formData.append('certificateFile', certInput.files[0]);
            }

            $.ajax({
                url: '@Url.Action("UpdateTeacherProfile", "Profile")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-check2-circle" style="font-size: 18px;"></i> Cập nhật hồ sơ giáo viên';
                    }
                    if (res.success) {
                        showToast(res.message, 'success');
                        if (res.certificateUrl) {
                            const certBox = document.getElementById('cert-preview-box');
                            const certName = document.getElementById('current-cert-name');
                            const certLink = document.getElementById('current-cert-link');
                            if (certName) certName.innerText = res.certificateName || 'Tệp chứng chỉ mới';
                            if (certLink) certLink.href = res.certificateUrl;
                            if (certBox) certBox.style.display = 'flex';
                            if (certInput) certInput.value = '';
                        }
                    } else {
                        showToast(res.message, 'error');
                    }
                },
                error: function () {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-check2-circle" style="font-size: 18px;"></i> Cập nhật hồ sơ giáo viên';
                    }
                    showToast('Lỗi kết nối máy chủ khi lưu hồ sơ giáo viên!', 'error');
                }
            });
        }

        // AJAX Avatar File Upload
        function uploadAvatarFile(input) {
            if (!input.files || !input.files[0]) return;

            const file = input.files[0];
            if (!file.type.startsWith('image/')) {
                showToast('Tệp tin không đúng định dạng hình ảnh!', 'error');
                return;
            }

            const formData = new FormData();
            formData.append('avatarFile', file);

            showToast('Đang tải ảnh đại diện mới...', 'info');

            $.ajax({
                url: '@Url.Action("UploadAvatar", "Profile")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.success) {
                        document.getElementById('avatar-preview').src = res.avatarUrl;
                        document.querySelectorAll('[data-current-user-avatar]').forEach(function (avatar) {
                            avatar.src = res.avatarUrl;
                        });
                        showToast(res.message, 'success');
                    } else {
                        showToast(res.message, 'error');
                    }
                },
                error: function () {
                    showToast('Có lỗi xảy ra khi tải ảnh lên!', 'error');
                }
            });
        }

        // Save Profile Info
        function handleSaveProfile(e) {
            e.preventDefault();

            const fullName = document.getElementById('prof-fullname').value.trim();
            const gender = document.getElementById('prof-gender').value;
            const dob = document.getElementById('prof-dob').value;
            const phone = document.getElementById('prof-phone').value.trim();
            const phoneError = document.getElementById('phone-error');

            if (phone && !/^(0[3|5|7|8|9])[0-9]{8}$/.test(phone)) {
                phoneError.style.display = 'block';
                showToast('Vui lòng kiểm tra lại số điện thoại (Cần 10 chữ số)!', 'error');
                return;
            }
            phoneError.style.display = 'none';

            const btn = document.getElementById('btn-save-profile');
            btn.disabled = true;
            btn.innerText = 'Đang lưu...';

            $.ajax({
                url: '@Url.Action("UpdateInfo", "Profile")',
                type: 'POST',
                data: { fullName: fullName, phone: phone, gender: gender, birthDate: dob },
                success: function (res) {
                    btn.disabled = false;
                    btn.innerText = 'Lưu thay đổi';
                    if (res.success) {
                        showToast(res.message, 'success');
                    } else {
                        showToast(res.message, 'error');
                    }
                },
                error: function () {
                    btn.disabled = false;
                    btn.innerText = 'Lưu thay đổi';
                    showToast('Lỗi kết nối máy chủ khi lưu thông tin!', 'error');
                }
            });
        }

        // Change Password
        function handleChangePassword(e) {
            e.preventDefault();

            const curPass = document.getElementById('pass-current').value;
            const newPass = document.getElementById('pass-new').value;
            const confirmPass = document.getElementById('pass-confirm').value;

            if (newPass.length < 8) {
                document.getElementById('pass-new-error').style.display = 'block';
                showToast('Mật khẩu mới phải từ 8 ký tự trở lên!', 'error');
                return;
            }
            document.getElementById('pass-new-error').style.display = 'none';

            if (newPass !== confirmPass) {
                document.getElementById('pass-confirm-error').style.display = 'block';
                showToast('Mật khẩu xác nhận không khớp!', 'error');
                return;
            }
            document.getElementById('pass-confirm-error').style.display = 'none';

            const btn = document.getElementById('btn-change-pass');
            btn.disabled = true;
            btn.innerText = 'Đang cập nhật...';

            $.ajax({
                url: '@Url.Action("ChangePassword", "Profile")',
                type: 'POST',
                data: { currentPassword: curPass, newPassword: newPass, confirmPassword: confirmPass },
                success: function (res) {
                    btn.disabled = false;
                    btn.innerText = 'Cập nhật mật khẩu';
                    if (res.success) {
                        showToast(res.message, 'success');
                        if (res.redirectUrl) {
                            setTimeout(function () { window.location.href = res.redirectUrl; }, 1200);
                            return;
                        }
                        document.getElementById('form-change-password').reset();
                        document.getElementById('profile-strength-bar').style.width = '0%';
                        document.getElementById('profile-strength-text').innerText = 'Độ mạnh: Chưa nhập';
                    } else {
                        document.getElementById('pass-current-error').innerText = res.message;
                        document.getElementById('pass-current-error').style.display = 'block';
                        showToast(res.message, 'error');
                    }
                },
                error: function () {
                    btn.disabled = false;
                    btn.innerText = 'Cập nhật mật khẩu';
                    showToast('Lỗi kết nối máy chủ khi đổi mật khẩu!', 'error');
                }
            });
        }

        // Password strength meter
        function checkProfilePassStrength(val) {
            const bar = document.getElementById('profile-strength-bar');
            const txt = document.getElementById('profile-strength-text');
            let score = 0;
            if (val.length >= 8) score += 35;
            if (/[A-Z]/.test(val)) score += 25;
            if (/[0-9]/.test(val)) score += 20;
            if (/[^A-Za-z0-9]/.test(val)) score += 20;

            bar.style.width = score + '%';
            if (score < 40) {
                bar.style.backgroundColor = '#EF4444';
                txt.innerText = 'Độ mạnh: Yếu (< 8 ký tự)';
                txt.style.color = '#EF4444';
            } else if (score < 75) {
                bar.style.backgroundColor = '#F59E0B';
                txt.innerText = 'Độ mạnh: Trung bình';
                txt.style.color = '#F59E0B';
            } else {
                bar.style.backgroundColor = '#10B981';
                txt.innerText = 'Độ mạnh: Rất mạnh (An toàn)';
                txt.style.color = '#10B981';
            }
        }
    </script>
}
