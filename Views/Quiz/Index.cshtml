@model ECOLearning.ViewModels.QuizOverview
@{
    ViewBag.Title = "Quiz cuối khóa";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var c = Model.Config;
    var s = Model.Student;
    var integrityCases = ViewBag.RetakeCases as List<ECOLearning.Services.QuizRetakeRequest> ?? new List<ECOLearning.Services.QuizRetakeRequest>();
    var integrityActions = integrityCases.Count(r => r.CanRetake);
    var active = Model.Attempts.FirstOrDefault(a => !a.SubmittedAt.HasValue);
}
<style>
.lq-page{max-width:1180px;margin:36px auto 60px;padding:0 24px;color:#202b43}.lq-back{display:inline-flex;gap:8px;align-items:center;font-size:13px;color:#69758b;text-decoration:none;margin-bottom:22px}.lq-header{margin-bottom:28px}.lq-header>span{font-size:11px;letter-spacing:1.2px;font-weight:700;color:#6558d8}.lq-header h1{font-size:30px;letter-spacing:-.8px;margin:9px 0 10px;font-weight:700}.lq-header p{font-size:15px;color:#6b7588;margin:0}.lq-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-bottom:24px}.lq-stat,.lq-exam,.lq-history{background:#fff;border:1px solid #e5e9f2;border-radius:18px;box-shadow:0 3px 14px #24345b04}.lq-stat{padding:22px}.lq-stat-top{display:flex;align-items:center;justify-content:space-between;font-size:13px;font-weight:600;color:#6c778c;gap:12px}.lq-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:#f0eeff;color:#6554da;font-size:20px}.lq-icon.green{background:#eaf7f1;color:#388a6c}.lq-icon.gold{background:#fff5e5;color:#b7873b}.lq-value{font-size:29px;font-weight:700;line-height:1.4;letter-spacing:-.7px;margin:9px 0 5px}.lq-value small{font-size:14px;font-weight:500;color:#8390a3;letter-spacing:0}.lq-stat p{font-size:12px;color:#758096;line-height:1.7;margin:7px 0 0}.lq-progress{height:5px;background:#eef2f6;border-radius:9px;margin-top:13px;overflow:hidden}.lq-progress>span{height:100%;display:block;background:#43998a;border-radius:inherit}.lq-badge{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;font-size:12px;border-radius:7px;background:#f2f4f8;color:#69768c}.lq-badge.success{background:#eaf7f1;color:#2d8062}.lq-cert{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:18px}.lq-cert a,.lq-cert button{font:inherit;font-size:12px;font-weight:600;border:0;background:none;color:#5846d8;cursor:pointer;padding:0;text-decoration:none}.lq-cert form{margin:0}.lq-exam{padding:28px;margin-bottom:28px;border-top:3px solid #6654e8}.lq-exam-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:22px}.lq-exam-heading h2,.lq-history h2{font-size:19px;font-weight:700;margin:0}.lq-exam-heading>span{font-size:11px;color:#807998;background:#f4f1ff;padding:6px 9px;border-radius:6px;white-space:nowrap}.lq-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;padding:20px;background:#f8f9fd;border:1px solid #edf0f6;border-radius:12px}.lq-metrics>div{display:flex;gap:10px;align-items:flex-start}.lq-metrics i{color:#8a80bb;font-size:18px;margin-top:3px}.lq-metrics strong{display:block;font-size:18px;font-weight:700}.lq-metrics small{display:block;font-size:12px;color:#79849a;margin-top:5px;line-height:1.5}.lq-start{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:24px}.lq-start strong{font-size:14px}.lq-start p{font-size:12px;line-height:1.8;color:#778397;margin:6px 0 0}.lq-start form{margin:0;flex-shrink:0}.lq-page .btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:10px;font-size:13px;padding:12px 18px;text-decoration:none;white-space:nowrap}.lq-notice{display:flex;align-items:flex-start;gap:10px;padding:15px 18px;border-radius:11px;background:#f3f2ff;border:1px solid #e8e4fb;color:#685a9a;font-size:13px;line-height:1.8;margin:18px 0}.lq-notice.success{background:#eff9f3;border-color:#daeddf;color:#38805c}.lq-notice>i{margin-top:3px}.lq-notice .btn{margin-right:10px}.lq-history{overflow:hidden}.lq-history-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 26px;border-bottom:1px solid #e9edf4}.lq-history-heading>span{font-size:12px;color:#8590a2}.lq-empty{padding:34px 20px;text-align:center}.lq-empty>i{display:inline-grid;place-items:center;width:48px;height:48px;border-radius:14px;background:#f4f2fc;color:#a196cb;font-size:23px;margin-bottom:12px}.lq-empty strong{display:block;font-size:14px;font-weight:600}.lq-empty p{font-size:12px;color:#8b95a5;margin:8px 0 0}.lq-table-wrap{overflow:auto}.lq-history table{width:100%;min-width:640px;border-collapse:collapse;font-size:13px}.lq-history th{text-align:left;padding:14px 24px;font-size:11px;font-weight:600;color:#7c889b;background:#fafbfe}.lq-history td{padding:17px 24px;border-top:1px solid #edf0f6;white-space:nowrap}.lq-history td a{color:#6554da;text-decoration:none;font-weight:500}.lq-page a:focus-visible,.lq-page button:focus-visible{outline:2px solid #9888e9;outline-offset:4px}
@@media(max-width:800px){.lq-metrics{grid-template-columns:1fr 1fr}.lq-stat{padding:18px}.lq-start{align-items:flex-start;flex-direction:column}.lq-start form,.lq-start .btn{width:100%}.lq-header h1{font-size:26px}}
@@media(max-width:576px){.lq-page{padding:0 16px;margin-top:24px}.lq-stats{grid-template-columns:1fr;gap:12px}.lq-exam{padding:20px}.lq-exam-heading{align-items:flex-start}.lq-history-heading{padding:20px}.lq-metrics{padding:16px}.lq-header p{font-size:14px;line-height:1.7}}

/* Focus the learner page on the exam, with supporting status in one side panel. */
.lq-page{max-width:1160px;margin-top:28px}.lq-back{margin-bottom:18px}.lq-header{margin-bottom:26px}.lq-header>span{display:none}.lq-header h1{font-size:32px;margin:0 0 10px}.lq-header p{font-size:15px}.lq-content{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start;margin-bottom:28px}.lq-content>.lq-notice{grid-column:1/-1;order:0;margin:0}.lq-stats{grid-column:2;grid-row:1;display:flex;flex-direction:column;gap:0;margin:0;border:1px solid #e5e9f2;border-radius:18px;background:#fff;overflow:hidden}.lq-stat{padding:20px 22px;border:0;border-radius:0;box-shadow:none}.lq-stat+.lq-stat{border-top:1px solid #edf0f6}.lq-stat-top{color:#59677e}.lq-icon{width:32px;height:32px;font-size:17px;border-radius:9px}.lq-value{font-size:27px;margin:6px 0}.lq-stat p{font-size:12px;margin-top:6px}.lq-cert{margin-top:12px}.lq-exam{grid-column:1;grid-row:1;margin:0;padding:30px;border:1px solid #dedcf2;border-radius:18px;background:linear-gradient(150deg,#f7f5ff 0%,#fff 53%);box-shadow:0 5px 22px #44338706}.lq-exam-heading{display:block;margin-bottom:26px}.lq-exam-heading h2{font-size:25px;line-height:1.5;letter-spacing:-.5px;margin-bottom:9px}.lq-exam-heading>span{padding:0;background:none;letter-spacing:1px;color:#887ca8;font-size:10px}.lq-metrics{grid-template-columns:1fr 1fr;background:#ffffffc9;border:1px solid #e8e5f3;gap:0;padding:0;overflow:hidden}.lq-metrics>div{padding:20px;gap:12px}.lq-metrics>div:nth-child(odd){border-right:1px solid #eeebf5}.lq-metrics>div:nth-child(-n+2){border-bottom:1px solid #eeebf5}.lq-metrics i{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:#f2effd;color:#8474bd;font-size:17px;flex-shrink:0;margin-top:0}.lq-metrics strong{font-size:19px}.lq-metrics small{font-size:12px;margin-top:4px}.lq-start{display:block;padding-top:24px;margin-top:0}.lq-start strong{font-size:14px;color:#3d6f60}.lq-start strong:before{content:'✓';display:inline-block;margin-right:7px;color:#43998a}.lq-start p{margin:9px 0 22px;line-height:1.85}.lq-start form{width:100%}.lq-start .btn{width:100%;min-height:48px;font-size:14px;border-radius:11px;box-shadow:0 5px 12px #5946d526}.lq-history{box-shadow:none}.lq-history-heading{padding:20px 24px}.lq-history h2{font-size:17px}.lq-empty{padding:28px 20px}.lq-empty>i{width:40px;height:40px;font-size:20px;margin-bottom:10px}.lq-content:has(>.lq-notice) .lq-exam,.lq-content:has(>.lq-notice) .lq-stats{grid-row:2}.lq-content:not(:has(.lq-exam)) .lq-stats{grid-column:1/-1;grid-row:auto;display:grid;grid-template-columns:repeat(3,1fr)}
@@media(max-width:850px){.lq-content{grid-template-columns:1fr}.lq-exam{grid-column:1;grid-row:1}.lq-stats{grid-column:1;grid-row:2;display:grid;grid-template-columns:repeat(3,1fr)}.lq-stat+.lq-stat{border-top:0;border-left:1px solid #edf0f6}.lq-content:has(>.lq-notice) .lq-stats{grid-row:3}.lq-content:not(:has(.lq-exam)) .lq-stats{grid-row:auto}}
@@media(max-width:576px){.lq-header h1{font-size:27px}.lq-exam{padding:22px}.lq-exam-heading h2{font-size:22px}.lq-metrics>div{padding:15px 12px;gap:8px}.lq-metrics i{width:26px;height:26px;font-size:14px}.lq-metrics strong{font-size:16px}.lq-metrics small{font-size:11px}.lq-stats,.lq-content:not(:has(.lq-exam)) .lq-stats{display:flex}.lq-stat+.lq-stat{border-left:0;border-top:1px solid #edf0f6}.lq-content{gap:18px}}

.lq-start-dialog{width:min(460px,calc(100vw - 32px));box-sizing:border-box;border:1px solid #e8e5f2;border-radius:20px;padding:30px;background:#fff;color:#263247;box-shadow:0 24px 80px #19143130;position:fixed;inset:0;margin:auto;max-height:calc(100dvh - 32px);overflow-y:auto}.lq-start-dialog::backdrop{background:#17203370;backdrop-filter:blur(3px)}.lq-start-dialog>form{margin:0}.lq-dialog-close{position:absolute;right:14px;top:12px;border:0;background:transparent;color:#9299a9;font-size:26px;cursor:pointer;width:32px;height:32px;border-radius:8px}.lq-dialog-close:hover{background:#f3f4f8}.lq-dialog-icon{display:grid;place-items:center;width:54px;height:54px;border-radius:16px;background:#f0edff;color:#6854d9;font-size:26px;margin-bottom:20px}.lq-start-dialog h2{font-size:23px;font-weight:700;letter-spacing:-.4px;margin:0 0 12px}.lq-start-dialog>p{font-size:14px;line-height:1.85;color:#778297;margin:0 0 20px}.lq-start-dialog strong{font-weight:600;color:#344159}.lq-dialog-note{display:flex;align-items:flex-start;gap:10px;padding:14px;background:#f7f6fc;border-radius:10px;font-size:12px;line-height:1.8;color:#7c7298}.lq-dialog-note>i{margin-top:3px;color:#8e7ec0}.lq-dialog-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:26px}.lq-dialog-actions .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:13px;padding:12px 16px;border-radius:10px}.lq-dialog-actions button:disabled{opacity:.7;cursor:wait}.lq-start-dialog button:focus-visible{outline:2px solid #a092e9;outline-offset:3px}
.lq-header p{font-size:22px;font-weight:700;line-height:1.5;color:var(--text-heading,#0F172A);margin-top:12px;overflow-wrap:anywhere}
@@media(max-width:576px){.lq-header p{font-size:19px}}
</style>
<div class="lq-page">
    <header class="lq-header"><span>KIỂM TRA CUỐI KHÓA</span><h1>Quiz cuối khóa</h1><p>@Model.CourseName</p></header>
    @if (TempData["QuizMessage"] != null) {<div class="lq-notice" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i> @TempData["QuizMessage"]</div>}
    @if (integrityCases.Any()) {<div class="lq-notice" role="status"><i class="bi bi-chat-left-text" aria-hidden="true"></i><span>@(integrityActions > 0 ? "Giáo viên yêu cầu làm lại. Kết quả cũ hết hiệu lực; cần đạt bài làm lại mới được nhận chứng chỉ." : "Bạn có yêu cầu làm lại bài quiz từ giáo viên.") <a href="@Url.Action("Retakes", new { courseId = Model.CourseId })">Xem yêu cầu làm lại</a></span></div>}
    <div class="lq-content">
    <div class="lq-stats">
        <section class="lq-stat"><div class="lq-stat-top">Tiến độ học tập<span class="lq-icon green"><i class="bi bi-journal-check" aria-hidden="true"></i></span></div><div class="lq-value">@s.Progress<small>%</small></div><p>@s.CompletedLessons/@s.TotalLessons bài học đã hoàn thành</p><div class="lq-progress" role="progressbar" aria-label="Tiến độ học tập" aria-valuenow="@s.Progress" aria-valuemin="0" aria-valuemax="100"><span style="width:@(s.Progress)%"></span></div></section>
        <section class="lq-stat"><div class="lq-stat-top">Kết quả quiz<span class="lq-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span></div><div class="lq-value">@(s.BestScore?.ToString("0.##") ?? "—")<small>/10</small></div><span class="lq-badge @(s.Passed ? "success" : "")">@s.QuizStatus</span></section>
        <section class="lq-stat"><div class="lq-stat-top">Chứng chỉ khóa học<span class="lq-icon gold"><i class="bi bi-award" aria-hidden="true"></i></span></div><div class="lq-cert"><span class="lq-badge @(s.IssuedAt.HasValue || (s.LessonsDone && s.Passed) ? "success" : "")">@s.CertificateStatus</span>
        @if (s.IssuedAt.HasValue) {<a href="@Url.Action("Certificate", "Learning", new { courseId = Model.CourseId })">Xem chứng chỉ <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>} else if (s.LessonsDone && s.Passed) {using (Html.BeginForm("ClaimCertificate", "Quiz")) {@Html.AntiForgeryToken()<input type="hidden" name="courseId" value="@Model.CourseId" /><button type="submit">Nhận chứng chỉ <i class="bi bi-arrow-right" aria-hidden="true"></i></button>}}
        </div><p>@(s.IssuedAt.HasValue ? "Bạn đã nhận chứng chỉ của khóa học này." : "Hoàn thành bài học và đạt quiz để nhận chứng chỉ.")</p></section>
    </div>
    @if (active != null) {<div class="lq-notice"><i class="bi bi-clock-history" aria-hidden="true"></i><div><a class="btn btn-primary" href="@Url.Action("Take", new { id = active.Id })">Tiếp tục lượt đang làm</a> Đề và thời gian của lượt đang làm được giữ nguyên.</div></div>}
    @if (c == null || !c.Published) {<div class="lq-notice"><i class="bi bi-info-circle" aria-hidden="true"></i> Giáo viên chưa mở quiz cuối khóa. Kết quả đã đạt vẫn được lưu.</div>}
    else
    {
        <section class="lq-exam"><div class="lq-exam-heading"><h2>@c.Title</h2><span>BÀI KIỂM TRA CUỐI KHÓA</span></div><div class="lq-metrics"><div><i class="bi bi-list-check" aria-hidden="true"></i><span><strong>@c.Total câu</strong><small>Trắc nghiệm một đáp án</small></span></div><div><i class="bi bi-clock" aria-hidden="true"></i><span><strong>@c.Minutes phút</strong><small>Thời gian làm bài</small></span></div><div><i class="bi bi-check-circle" aria-hidden="true"></i><span><strong>Đạt từ @c.PassPercent%</strong><small>Ít nhất @((int)Math.Ceiling(c.Total * c.PassPercent / 100.0))/@c.Total câu đúng</small></span></div><div><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span><strong>@Model.RegularAttempts/@Model.AllowedAttempts lượt</strong><small>Đã sử dụng / tối đa</small></span></div></div>
        @if (active != null) {<div class="lq-notice">Bạn có một lượt đang làm. Bấm “Tiếp tục lượt đang làm” để trở lại bài thi.</div>}
        else if (!s.LessonsDone) {<div class="lq-notice">Hoàn thành 100% bài học để mở quiz cuối khóa.</div>}
        else if (s.PendingReview) {<div class="lq-notice"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Bạn đã rời màn hình từ 3 lần. Kết quả chờ giáo viên xem xét, chưa được công nhận và chưa thể nhận chứng chỉ.</div>}
        else if (s.RetakeRequired) {<div class="lq-notice">Kết quả cũ đã hết hiệu lực. <a href="@Url.Action("Retakes", new { courseId = Model.CourseId })">Mở bài làm lại</a>. Chứng chỉ được xét theo kết quả mới.</div>}
        else if (s.Passed) {<div class="lq-notice success"><i class="bi bi-check-circle" aria-hidden="true"></i> @(s.IssuedAt.HasValue ? "Bạn đã đạt quiz và được cấp chứng chỉ. Chúc mừng bạn hoàn thành khóa học!" : "Bạn đã đạt quiz. Bấm Nhận chứng chỉ để được cấp ngay.")</div>}
        else if (Model.RegularAttempts >= Model.AllowedAttempts) {<div class="lq-notice">Bạn đã hết lượt làm. Liên hệ giáo viên để được xem xét cấp thêm lượt.</div>}
        else
        {
            <div class="lq-start"><div><strong>Bạn đã đủ điều kiện làm quiz</strong><p>Ghi nhận kết quả cao nhất. Thời gian bắt đầu tính khi vào bài thi.<br />Lượt bắt đầu được tính vào giới hạn, kể cả khi hết giờ. Rời màn hình từ 3 lần thì kết quả chờ giáo viên xem xét.@(s.ExtraAttempts > 0 ? " Bạn được cấp thêm " + s.ExtraAttempts + " lượt." : "")</p></div>@using (Html.BeginForm("Start", "Quiz", FormMethod.Post, new { id = "quiz-start-form" })) {@Html.AntiForgeryToken()<input type="hidden" name="courseId" value="@Model.CourseId" /><button type="submit" class="btn btn-primary">Bắt đầu quiz <i class="bi bi-arrow-right" aria-hidden="true"></i></button>}</div>
        }
        </section>
    }
    </div>
    <section class="lq-history"><div class="lq-history-heading"><h2>Lịch sử làm bài</h2><span>@Model.Attempts.Count lượt thi</span></div>
    @if (!Model.Attempts.Any()) {<div class="lq-empty"><i class="bi bi-clock-history" aria-hidden="true"></i><strong>Bạn chưa có lượt làm bài nào</strong><p>Kết quả sẽ xuất hiện tại đây sau khi bạn bắt đầu quiz.</p></div>}
    else
    {
        <div class="lq-table-wrap"><table><thead><tr><th>Lượt</th><th>Ngày làm</th><th>Số câu đúng</th><th>Điểm /10</th><th>Kết quả</th><th></th></tr></thead><tbody>@foreach (var a in Model.Attempts) {<tr><td>#@a.Id @if(a.IsVerification){<small style="display:block;color:#8d7cb2">Làm lại</small>}</td><td>@a.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(a.SubmittedAt.HasValue && !a.ReviewPending ? a.Correct + "/" + a.Total : "—")</td><td>@(a.ReviewPending ? "—" : a.Score?.ToString("0.##") ?? "—")</td><td><span class="lq-badge @(!a.IsVoided && !a.ReviewPending && a.Passed == true ? "success" : "")">@(!a.SubmittedAt.HasValue ? "Đang làm" : a.IsVoided ? "Hết hiệu lực" : a.ReviewPending ? "Chờ xem xét" : a.Passed == true ? "Đạt" : "Chưa đạt")</span></td><td><a href="@Url.Action("Take", new { id = a.Id })">@(!a.SubmittedAt.HasValue ? "Tiếp tục" : "Xem kết quả") <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></td></tr>}</tbody></table></div>
    }
    </section>
</div>

@if (c != null && c.Published && active == null && s.LessonsDone && !s.Passed && !s.RetakeRequired && !s.PendingReview && Model.RegularAttempts < Model.AllowedAttempts)
{
    <dialog id="quiz-start-dialog" class="lq-start-dialog" aria-labelledby="quiz-start-title" aria-describedby="quiz-start-description">
        <form method="dialog"><button class="lq-dialog-close" aria-label="Đóng">×</button></form>
        <span class="lq-dialog-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span>
        <h2 id="quiz-start-title">Bắt đầu làm quiz?</h2>
        <p id="quiz-start-description">Bạn có <strong>@c.Minutes phút</strong> để hoàn thành <strong>@c.Total câu hỏi</strong>. Đồng hồ sẽ chạy ngay sau khi bắt đầu. Rời màn hình từ 3 lần thì kết quả sẽ chờ giáo viên xem xét trước khi công nhận.</p>
        <div class="lq-dialog-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Lần bắt đầu này được tính là một lượt thi. Bạn còn <strong>@(Model.AllowedAttempts - Model.RegularAttempts) lượt</strong>.</span></div>
        <div class="lq-dialog-actions"><button type="button" id="quiz-start-cancel" class="btn btn-outline">Để sau</button><button type="button" id="quiz-start-confirm" class="btn btn-primary">Bắt đầu làm bài <i class="bi bi-arrow-right" aria-hidden="true"></i></button></div>
    </dialog>
    <script>
    (function () {
        const form = document.getElementById('quiz-start-form'), dialog = document.getElementById('quiz-start-dialog');
        const cancel = document.getElementById('quiz-start-cancel'), confirm = document.getElementById('quiz-start-confirm');
        if (!form || !dialog || !dialog.showModal) return;
        let starting = false;
        form.addEventListener('submit', function (event) {
            if (starting) return;
            event.preventDefault(); dialog.showModal(); cancel.focus();
        });
        cancel.addEventListener('click', function () {dialog.close();});
        dialog.addEventListener('click', function (event) {
            if (event.target !== dialog) return;
            const rect = dialog.getBoundingClientRect();
            if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
        });
        confirm.addEventListener('click', function () {
            if (starting) return;
            starting = true; confirm.disabled = true; confirm.textContent = 'Đang mở bài thi…';
            if (form.requestSubmit) form.requestSubmit(); else form.submit();
        });
    })();
    </script>
}

<div style="max-width:1120px;margin:18px auto">
@if (Model.HasQuestionReports || Model.CanAppeal) {
    <nav aria-label="Phản hồi bài quiz" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px">
        @if (Model.HasQuestionReports) {<a class="btn btn-outline" href="@Url.Action("Reports", "Quiz", new { courseId = Model.CourseId })"><i class="bi bi-flag" aria-hidden="true"></i> Báo lỗi của tôi</a>}
        @if (Model.CanAppeal) {<a class="btn btn-outline" href="@Url.Action("Appeals", "Quiz", new { courseId = Model.CourseId })">Phúc khảo &amp; thông báo điều chỉnh điểm</a>}
    </nav>
}
@if(Model.Config!=null&&Model.Config.UseMatrix){<section style="padding:22px;margin:18px 0;background:#fff;border:1px solid #e2e8f0;border-radius:14px"><h2 style="font-size:18px">Kỹ năng và điều kiện đạt cho lượt thi mới</h2><p style="margin:12px 0">Cần đạt tổng điểm từ @Model.Config.PassPercent% và các kỹ năng bắt buộc bên dưới. Lượt đã bắt đầu giữ ngưỡng riêng đã công bố.</p><ul style="padding-left:20px;line-height:2">@foreach(var r in Newtonsoft.Json.JsonConvert.DeserializeObject<List<ECOLearning.ViewModels.QuizSkillRule>>(Model.Config.MatrixJson??"[]")){<li>@r.Name · @r.Total câu · Ngưỡng @r.PassPercent% · @(r.Required?"Bắt buộc":"Tham khảo")</li>}</ul></section>}</div>
