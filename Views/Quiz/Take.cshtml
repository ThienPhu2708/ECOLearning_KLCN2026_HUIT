    <div class="qt-submit-actions"><button type="button" id="qt-submit-cancel" class="btn btn-outline">Làm tiếp</button><button type="button" id="qt-submit-confirm" class="btn btn-primary">Xác nhận nộp bài <i class="bi bi-check2" aria-hidden="true"></i></button></div>
</dialog>
<script>
(function(){
const form=document.getElementById('quiz-form');
const end=performance.now()+@((long)Math.Max(0,(Model.Attempt.ExpiresAt-DateTime.UtcNow).TotalMilliseconds));
let queue=Promise.resolve();function saveDraft(){const body=new URLSearchParams(new FormData(form));document.getElementById('quiz-save-status').textContent='Đang lưu…';queue=queue.catch(function(){}).then(function(){return fetch('@Url.Action("SaveDraft","Quiz",new{area=""})',{method:'POST',body:body,credentials:'same-origin'}).then(function(r){if(!r.ok){if(r.status===403 && window.quizWriterLost)window.quizWriterLost(body.get("writerToken"));throw new Error();}return r.json();}).then(function(data){document.getElementById('quiz-save-status').textContent=data.saved?'Đã lưu.':'Lượt làm đã kết thúc.';}).catch(function(){document.getElementById('quiz-save-status').textContent='Chưa lưu lên máy chủ. Kiểm tra kết nối trước khi hết giờ.';});});}
document.querySelectorAll('input[data-question]').forEach(function(r){const i=r.dataset.question;r.addEventListener('change',function(){document.getElementById('answer-'+i).value=r.value;saveDraft();});});
let sent=false;function tick(){const remain=Math.max(0,Math.ceil((end-performance.now())/1000));document.getElementById('quiz-time').textContent=Math.floor(remain/60)+':'+String(remain%60).padStart(2,'0');if(remain===0&&!sent){sent=true;form.submit();}}
const submitDialog=document.getElementById('quiz-submit-dialog');
const submitConfirm=document.getElementById('qt-submit-confirm');
form.addEventListener('submit',function(e){
    if(sent){e.preventDefault();return;}
    e.preventDefault();
    const missing=[...form.querySelectorAll('input[name^="answers["]')].filter(function(input){return input.value==='-1';}).length;
    document.getElementById('qt-submit-description').textContent=missing ? 'Bạn còn '+missing+' câu chưa trả lời. Bạn có muốn nộp bài ngay không?' : 'Bạn đã trả lời đầy đủ '+@Model.Questions.Count+' câu. Nộp bài để xem kết quả của bạn.';
    submitDialog.showModal();document.getElementById('qt-submit-cancel').focus();
});
document.getElementById('qt-submit-cancel').addEventListener('click',function(){submitDialog.close();});
submitDialog.addEventListener('click',function(event){if(event.target!==submitDialog)return;const r=submitDialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)submitDialog.close();});
submitConfirm.addEventListener('click',function(){if(sent)return;sent=true;submitConfirm.disabled=true;submitConfirm.textContent='Đang nộp bài…';form.submit();});
tick();setInterval(tick,1000);
})();
</script>
}
</div>

@Html.Partial("~/Views/Quiz/_ReportQuestion.cshtml",Model)

@if(!Model.Review && ViewContext.RouteData.DataTokens["area"] as string!="Instructor"){
<div id="quiz-visibility-notice" role="status" aria-live="polite" hidden style="position:fixed;bottom:20px;right:20px;max-width:calc(100% - 40px);width:400px;padding:16px;background:#fff7e9;border:1px solid #efd7a0;border-radius:12px;z-index:90;color:#694c12;box-shadow:0 6px 24px #0002"><span></span><button type="button" aria-label="Đóng nhắc nhở" style="float:right;border:0;background:none;font-size:20px;cursor:pointer">×</button></div>
<p style="max-width:1100px;margin:12px auto;color:#64748b;font-size:12px">Từ 3 lần rời màn hình, kết quả sẽ chờ giáo viên xem xét trước khi được công nhận và xét chứng chỉ. Đồng hồ vẫn chạy khi rời trang.</p>
<script>
(function(){
const id=@Model.Attempt.Id, endpoint='@Url.Action("Visibility","Quiz",new{area=""})';
const token=document.querySelector('#quiz-form input[name="__RequestVerificationToken"]').value;
const end=Date.now()+@((long)Math.Max(0,(Model.Attempt.ExpiresAt-DateTime.UtcNow).TotalMilliseconds));
const key='quiz-visibility-'+id;
let current=null,count=0,queue=[],sending=false,submitting=false;
try{const saved=JSON.parse(sessionStorage.getItem(key)||'{}');current=saved.current||null;count=saved.count||0;queue=saved.queue||[];}catch(_){}
function persist(){try{sessionStorage.setItem(key,JSON.stringify({current:current,count:count,queue:queue}));}catch(_){}}
function body(event){return new URLSearchParams({__RequestVerificationToken:token,id:id,eventKey:event.key,returned:String(event.returned)});}
async function flush(){if(sending||!queue.length)return;sending=true;try{while(queue.length){const response=await fetch(endpoint,{method:'POST',body:body(queue[0]),credentials:'same-origin',keepalive:true});if(!response.ok)break;queue.shift();persist();}}catch(_){}finally{sending=false;}}
function hide(){if(current||submitting||Date.now()>=end)return;current=crypto.randomUUID();count++;queue.push({key:current,returned:false});persist();flush();}
function show(){if(!current)return;queue.push({key:current,returned:true});current=null;persist();flush();const notice=document.getElementById('quiz-visibility-notice');notice.querySelector('span').textContent='Bạn vừa rời màn hình làm bài. Đã ghi nhận '+count+' lần.'+(count>=3?' Khi nộp, kết quả sẽ chờ giáo viên xem xét; chưa được nhận chứng chỉ.':'');notice.hidden=false;}
document.getElementById('quiz-visibility-notice').querySelector('button').onclick=function(){document.getElementById('quiz-visibility-notice').hidden=true;};
document.addEventListener('visibilitychange',function(){if(document.hidden)hide();else show();});
window.addEventListener('pagehide',function(){hide();queue.forEach(function(event){navigator.sendBeacon(endpoint,body(event));});});
window.addEventListener('pageshow',function(){if(!document.hidden)show();});
window.addEventListener('online',flush);
// Suppress leaving caused by submission; the server still caps any open interval at submission time.
document.getElementById('qt-submit-confirm').addEventListener('click',function(){submitting=true;});
if(document.hidden)hide();else show();flush();setInterval(flush,10000);
})();
</script>}

@if(!Model.Review){
<div id="quiz-writer-banner" role="status" style="position:sticky;bottom:0;background:#eef2ff;border:1px solid #c7d2fe;padding:16px;border-radius:12px;z-index:60"><span>Đang kiểm tra phiên làm bài…</span><button type="button" class="btn btn-primary" id="quiz-takeover" hidden>Chuyển sang đây</button><button type="button" class="btn btn-outline" id="quiz-writer-retry" hidden>Thử lại</button></div>
<script>
(function(){
const form=document.getElementById('quiz-form'),banner=document.getElementById('quiz-writer-banner'),label=banner.querySelector('span'),transfer=document.getElementById('quiz-takeover'),retry=document.getElementById('quiz-writer-retry');
const key=crypto.randomUUID();let token='',busy=false;
const hidden=document.createElement('input');hidden.type='hidden';hidden.name='writerToken';form.appendChild(hidden);
const controls=[...form.querySelectorAll('input[type=radio],button[type=submit]')];function enable(value){controls.forEach(c=>c.disabled=!value);}
enable(false);
window.quizWriterLost=function(expected){if(expected && expected!==token)return;enable(false);token='';hidden.value='';banner.hidden=false;label.textContent='Phiên làm bài đã chuyển sang nơi khác. Các thay đổi chưa lưu ở đây sẽ không được gửi.';transfer.hidden=false;};
async function acquire(takeover){if(busy)return;busy=true;enable(false);transfer.disabled=true;retry.hidden=true;
try{const data=new URLSearchParams({__RequestVerificationToken:form.querySelector('[name=__RequestVerificationToken]').value,id:'@Model.Attempt.Id',clientKey:key,takeover:String(takeover)});
const response=await fetch('@Url.Action("AcquireWriter","Quiz",new{area=""})',{method:'POST',body:data,credentials:'same-origin'});const result=await response.json();
if(!result.success){label.textContent=result.message;transfer.hidden=!result.conflict;retry.hidden=false;return;}
token=result.token;hidden.value=token;const answers=result.answers||[];
form.querySelectorAll('input[data-question]').forEach(input=>{input.checked=Number(input.value)===(answers[Number(input.dataset.question)]??-1);});
form.querySelectorAll('input[name^="answers["]').forEach((input,index)=>input.value=answers[index]??-1);
form.dispatchEvent(new Event('change'));banner.hidden=true;enable(true);
}catch(_){banner.hidden=false;label.textContent='Chưa xác nhận được phiên. Thời gian vẫn tiếp tục chạy; hãy thử lại.';retry.hidden=false;}
finally{busy=false;transfer.disabled=false;}}
transfer.onclick=function(){if(confirm('Chuyển lượt thi sang đây? Phiên cũ sẽ mất quyền sửa. Đáp án đã lưu và thời gian được giữ nguyên.'))acquire(true);};retry.onclick=()=>acquire(false);
async function check(){if(!token||busy)return;try{const r=await fetch('@Url.Action("CheckWriter","Quiz",new{area=""})',{method:'POST',body:new URLSearchParams({__RequestVerificationToken:form.querySelector('[name=__RequestVerificationToken]').value,id:'@Model.Attempt.Id',writerToken:token}),credentials:'same-origin'});if(!r.ok)return;const state=await r.json();if(state.finished){location.reload();return;}if(!state.active)window.quizWriterLost();}catch(_){}}
setInterval(check,5000);document.addEventListener('visibilitychange',function(){if(!document.hidden)check();});acquire(false);
})();</script>}
