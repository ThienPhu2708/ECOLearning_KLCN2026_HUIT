@model ECOLearning.ViewModels.QuizTakeViewModel
@{ViewBag.Title=Model.Attempt.Title;if(ViewContext.RouteData.DataTokens["area"] as string=="Instructor"){Layout="~/Areas/Instructor/Views/Shared/_LayoutInstructor.cshtml";}else{Layout="~/Views/Shared/_Layout.cshtml";}bool solutions=ViewBag.ShowSolutions==true;}
@Html.Partial("~/Views/Quiz/_Style.cshtml")
<style>
.quiz-taking{margin-top:24px}.qt-header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:22px 26px;border:1px solid #e4e7f1;border-radius:16px;background:#fff;margin-bottom:20px;box-shadow:0 3px 16px #24345b04}.qt-header-main{min-width:0}.qt-eyebrow{display:block;font-size:11px;font-weight:700;color:#8c83ad;letter-spacing:.8px;margin-bottom:8px}.quiz-taking .qt-header h1{font-size:24px;line-height:1.5;letter-spacing:-.5px;margin:0 0 10px}.qt-meta{display:flex;align-items:center;gap:16px;flex-wrap:wrap;font-size:12px;color:#7e899c}.qt-meta>span{display:inline-flex;gap:6px;align-items:center}.qt-meta i{color:#9a91b8}.qt-timer{display:flex;align-items:center;gap:13px;background:#f5f3ff;border:1px solid #e7e1fa;border-radius:12px;padding:13px 18px;flex-shrink:0}.qt-timer>i{font-size:24px;color:#9583cf}.qt-timer span{display:block;font-size:11px;color:#8a7eaa;margin-bottom:3px}.qt-timer strong{font-size:27px;font-weight:700;letter-spacing:.5px;color:#6550ad;font-variant-numeric:tabular-nums;line-height:1.2}.qt-help{display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px;color:#8390a3;line-height:1.7;padding:0 4px;margin-bottom:22px}.qt-help>span{display:inline-flex;align-items:center;gap:7px}.quiz-taking fieldset.quiz-card{padding:22px 26px 26px;border-radius:16px;margin-bottom:22px}.quiz-taking fieldset legend{font-size:13px;color:#6553ae;letter-spacing:.2px;background:#f3f0fd;padding:5px 11px;border-radius:7px}.quiz-taking fieldset>p:first-of-type{font-size:16px;font-weight:600;line-height:1.8;margin:5px 0 18px}.quiz-taking .quiz-option{border:1px solid #e8ecf3;background:#fff;padding:14px 16px;margin:10px 0;border-radius:10px;font-size:14px;font-weight:400;line-height:1.8}.quiz-taking .quiz-option:has(input:checked){border-color:#b1a1ec;background:#f7f4ff}.quiz-taking .quiz-option input{accent-color:#7154cb;flex-shrink:0}.quiz-taking .quiz-correct{border-color:#b5dfc7;background:#eff9f3}.quiz-taking #quiz-for