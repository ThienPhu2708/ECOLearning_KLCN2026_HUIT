    if (!solutions && !pendingForStudent) {<p class="qt-review-note">Đáp án đúng và giải thích sẽ hiển thị khi bạn đạt quiz. Giáo viên có thể xem xét cấp thêm lượt nếu bạn đã hết lượt.</p>}
}
else{<div class="qt-help"><span><i class="bi bi-cloud-check" aria-hidden="true"></i> Tự lưu lựa chọn <span id="quiz-save-status" role="status"></span></span><span>Hết giờ, hệ thống tự nộp bài.</span></div>}
@if(Model.Review && !pendingForStudent){<div style="margin:20px 0">@Html.Partial("~/Views/Quiz/_SkillResults.cshtml",Newtonsoft.Json.JsonConvert.DeserializeObject<List<ECOLearning.ViewModels.QuizSkillResult>>(Model.Attempt.SkillResultsJson??"[]"))
@if(ViewContext.RouteData.DataTokens["area"] as string!="Instructor"){<a class="btn btn-outline" href="@Url.Action("Appeals","Quiz",new{area="",courseId=Model.Attempt.CourseId})">Phúc khảo &amp; thông báo điểm</a>}</div>}
@if(Model.Attempt.IsVoided){<div class="qt-help" role="status">Kết quả này đã hết hiệu lực do giáo viên yêu cầu làm lại. Điểm và đáp án được giữ trong lịch sử, không dùng xét chứng chỉ.</div>}
@if(Model.Attempt.IsVerification){<div class="qt-help"><span><i class="bi bi-shield-check" aria-hidden="true"></i> Lượt làm lại: kết quả mới thay thế kết quả cũ và được dùng để xét chứng chỉ.</span></div>}
<div class="qt-workspace">
<form id="quiz-form" method="post" action="@Url.Action("Submit","Quiz",new{area=""})">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Attempt.Id"/>
@for(int i=0;i<Model.Questions.Count;i++) {var q=Model.Questions[i];int chosen=Model.Answers.Length>i?Model.Answers[i]:-1;
<fieldset class="quiz-card" id="quiz-question-@i" tabindex="-1"><legend>Câu @(i+1)</legend><p style="white-space:pre-wrap">@q.Text</p>
@if(!Model.Review){<input type="hidden" name="answers[@i]" id="answer-@i" value="@chosen"/>}
@for(int j=0;j<q.Options.Length;j++){<label class="quiz-option @(Model.Review && chosen==j?"quiz-selected":"") @(solutions && q.CorrectOption==j?"quiz-correct":"") @(Model.Review && solutions && chosen==j && q.CorrectOption!=j ? "quiz-wrong" : "")"><input type="radio" name="choice-@i" value="@j" checked="@(chosen==j)" disabled="@Model.Review" data-question="@i"/> <span>@((char)('A'+j)). @q.Options[j] @(solutions && q.CorrectOption==j?"✓":"")</span></label>}
@if(Model.Review && chosen<0){<p>Chưa chọn đáp án.</p>}
@if(solutions && !string.IsNullOrWhiteSpace(q.Explanation)){<div class="qt-review-explanation"><i class="bi bi-lightbulb" aria-hidden="true"></i><div><strong>Giải thích</strong><p>@q.Explanation</p></div></div>}
@if(Model.Review){var correction=(ViewBag.Corrections as List<ECOLearning.Services.QuizCorrection>??new List<ECOLearning.Services.QuizCorrection>()).FirstOrDefault(r=>r.QuestionId==q.Id&&r.VersionKey==ECOLearning.Services.QuizAssessmentService.Version(q));if(correction!=null){<div style="margin:14px 0;padding:14px;background:#eef2ff;border-radius:10px"><strong>Câu đã được điều chỉnh</strong><p style="white-space:pre-wrap">@correction.Reason</p>@if(solutions){<p>@(correction.AllCredit?"Mọi học viên gặp câu này được công nhận điểm câu.":"Đáp án được chấp nhận thêm theo quy tắc: "+string.Join("; ",Newtonsoft.Json.JsonConvert.DeserializeObject<string[]>(correction.AcceptedJson)))</p>}<p style="font-size:12px">Nội dung và đáp án gốc được giữ để đối chiếu. Điểm công nhận không bị giảm do lỗi đề.</p></div>}}
<button type="button" class="btn btn-outline btn-sm" data-report-question="@q.Id" data-report-number="@(i+1)"><i class="bi bi-flag"></i> Báo lỗi câu hỏi</button>
</fieldset>}
@if(!Model.Review){<button class="btn btn-primary" type="submit">Nộp bài</button>}
</form>
<aside class="qt-navigation"><details id="quiz-navigation" open><summary><span><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Câu hỏi</span><i class="bi bi-chevron-down" aria-hidden="true"></i></summary><div class="qt-navigation-body"><p id="quiz-answer-count" role="status"></p><nav class="qt-number-grid" aria-label="Đi đến câu hỏi">
@for (int i = 0; i < Model.Questions.Count; i++)
{
    <a href="#quiz-question-@i" data-question-link="@i" aria-label="Đi đến câu @(i + 1)">@(i + 1)</a>
}
</nav><div class="qt-nav-key"><span><b class="answered"></b> Đã trả lời</span><span><b></b> Chưa trả lời</span></div></div></details></aside>
</div>
<script>
(function () {
    const form = document.getElementById('quiz-form');
    const links = [...document.querySelectorAll('[data-question-link]')];
    const sections = links.map(function (link) {return document.getElementById('quiz-question-' + link.dataset.questionLink);});
    const count = document.getElementById('quiz-answer-count');
    const panel = document.getElementById('quiz-navigation');
    if (window.matchMedia('(max-width:800px)').matches) panel.open = false;
    function refresh() {
        let answered = 0;
        links.forEach(function (link, index) {
            const done = !!sections[index].querySelector('input[type=radio]:checked');
            link.classList.toggle('is-answered', done);
            link.setAttribute('aria-label', 'Câu ' + (index + 1) + (done ? ', đã trả lời' : ', chưa trả lời'));
            if (done) answered++;
        });
        count.textContent = 'Đã trả lời ' + answered + '/' + links.length + ' câu';
    }
    function markCurrent(index) {
        links.forEach(function (link, i) {if (i === index) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');});
    }
    links.forEach(function (link, index) {
        link.addEventListener('click', function (event) {
            event.preventDefault(); markCurrent(index);
            sections[index].focus({preventScroll:true});
            sections[index].scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',block:'start'});
        });
    });
    form.addEventListener('change', refresh);
    let scheduled = false;
    window.addEventListener('scroll', function () {
        if (scheduled) return; scheduled = true;
        requestAnimationFrame(function () {
            scheduled = false; let index = 0;
            sections.forEach(function (section, i) {if (section.getBoundingClientRect().top <= 180) index = i;});
            markCurrent(index);
        });
    }, {passive:true});
    refresh(); markCurrent(0);
})();
</script>
