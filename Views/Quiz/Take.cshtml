.qt-workspace{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:24px;align-items:start}.qt-workspace #quiz-form{min-width:0}.quiz-taking fieldset[id]{scroll-margin-top:100px}.quiz-taking fieldset[id]:focus{outline:none}.quiz-taking fieldset[id]:focus-visible{outline:2px solid #b3a4ec;outline-offset:3px}.qt-navigation{position:sticky;top:92px;margin-top:18px;background:#fff;border:1px solid #e4e7f1;border-radius:14px;box-shadow:0 3px 14px #24345b04;max-height:calc(100dvh - 112px);overflow:auto}.qt-navigation summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px;list-style:none;cursor:pointer;font-size:14px;font-weight:600;color:#344159}.qt-navigation summary>span{display:flex;align-items:center;gap:9px}.qt-navigation summary>i{font-size:12px;color:#9a91b5}.qt-navigation summary::-webkit-details-marker{display:none}.qt-navigation details[open] summary>i{transform:rotate(180deg)}.qt-navigation-body{padding:0 18px 18px}.qt-navigation-body>p:first-child{font-size:12px;color:#8290a3;margin:0 0 16px}.qt-number-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.qt-number-grid a{display:grid;place-items:center;aspect-ratio:1;min-height:34px;border:1px solid #e0e5ef;border-radius:9px;color:#768297;text-decoration:none;font-size:13px;font-weight:600;background:#fff}.qt-number-grid a.is-answered{background:#7154cb;color:#fff;border-color:#7154cb}.qt-number-grid a[aria-current]{outline:2px solid #b2a0ea;outline-offset:2px}.qt-number-grid a:hover{border-color:#7154cb}.qt-number-grid a:focus-visible{outline:2px solid #7154cb;outline-offset:3px}.qt-nav-key{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px;padding-top:16px;border-top:1px solid #edf0f6;font-size:10px;color:#8590a2}.qt-nav-key>span{display:flex;align-items:center;gap:6px}.qt-nav-key b{width:9px;height:9px;border-radius:3px;border:1px solid #dbe0eb}.qt-nav-key b.answered{background:#7154cb;border-color:#7154cb}.qt-navigation-body .qt-nav-hint{font-