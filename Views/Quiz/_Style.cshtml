<style>
.quiz-page{max-width:1180px;margin:24px auto;padding:0 20px;color:#243047}.quiz-page h1{font-size:28px;margin-bottom:12px}.quiz-page h2{font-size:21px;margin:12px 0}.quiz-muted{color:#64748b}.quiz-toolbar{display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin:20px 0}.quiz-page label{display:block;font-weight:600;margin:10px 0}.quiz-page input:not([type=checkbox]):not([type=radio]):not([type=hidden]),.quiz-page select,.quiz-page textarea{display:block;width:100%;padding:10px;border:1px solid #cbd5e1;border-radius:8px;background:white;color:#243047}.quiz-toolbar select{min-width:230px;max-width:500px}.quiz-page textarea{min-height:100px}.quiz-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}.quiz-card{padding:22px;border:1px solid #e2e8f0;border-radius:14px;background:#fff;margin:18px 0}.quiz-card legend{font-size:17px;font-weight:700;padding:0 8px}.quiz-notice{padding:14px 18px;border-radius:10px;background:#eff6ff;color:#1e40af;margin:16px 0}.quiz-error,.validation-summary-errors{background:#fef2f2;color:#991b1b;padding:16px;margin:16px 0;border-radius:10px}.quiz-table{overflow-x:auto}.quiz-table td{max-width:440px;white-space:normal;vertical-align:middle}.quiz-inline{display:inline-block;margin:5px}.quiz-stat{font-size:25px;font-weight:700;color:#4338ca}.quiz-option{display:flex!important;gap:12px;align-items:flex-start;padding:12px;background:#f8fafc;border-radius:8px;font-weight:400!important}.quiz-option input{margin-top:5px}.quiz-selected{border:1px solid #6366f1}.quiz-correct{background:#ecfdf5}.quiz-page .btn{white-space:normal}.quiz-timer{position:sticky;top:0;background:#fff7ed;color:#9a3412;padding:12px;z-index:5;border:1px solid #fed7aa;border-radius:8px}.quiz-check{font-weight:400!important}.quiz-check input{margin-right:8px}@@media(max-width:600px){.quiz-page{padding:0 12px}.quiz-toolbar>*{width:100%}}
</style>
