@model ECOLearning.ViewModels.RecommendationPageViewModel
@{
    ViewBag.Title = "Khóa học gợi ý cho bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool hopLe = Model.DaKhoiTao && string.IsNullOrEmpty(Model.ThongBaoLoi);
    bool coGoiY = hopLe && Model.Items.Count > 0;
}

@section styles {
    <style>
        .recommend-hero { padding: 48px 0 32px; background: #FFFFFF; border-bottom: 1px solid var(--border-color, #E2E8F0); }
        .recommend-hero-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
        .recommend-stats { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
        .recommend-stat { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--bg-canvas, #F8FAFC); border: 1px solid var(--border-color, #E2E8F0); border-radius: var(--radius-xl, 10px); font-size: 13px; color: var(--text-secondary, #475569); }
        .recommend-stat i { color: var(--primary, #434CE8); }.recommend-stat strong { color: var(--text-heading, #0F172A); }
        .recommend-notice { display: flex; gap: 12px; align-items: flex-start; padding: 14px 18px; border-radius: var(--radius-xl, 12px); margin-bottom: 28px; font-size: 14px; line-height: 1.55; }
        .recommend-notice.info { background: #EFF6FF; border: 1px solid #BFDBFE; color: #1E3A8A; }.recommend-notice.warning { background: #FFFBEB; border: 1px solid #FDE68A; color: #92400E; }
        .recommend-notice i { font-size: 18px; flex-shrink: 0; }
        .recommend-empty { text-align: center; padding: 48px 24px; background: #FFFFFF; border: 1px dashed var(--border-color, #E2E8F0); border-radius: var(--radius-2xl, 16px); color: var(--text-secondary, #64748B); }
        #btnRefreshRecommend.is-loading { pointer-events: none; opacity: .75; }#btnRefreshRecommend.is-loading i { display: inline-block; animation: recommend-spin .8s linear infinite; }
        @@keyframes recommend-spin { to { transform: rotate(360deg); } }
    </style>
}

<section class="recommend-hero">
    <div class="safe-container">
        <div class="recommend-hero-top">
            <div style="max-width: 720px;">
                <h1 class="h2" style="margin-bottom: 10px;">Khóa học gợi ý cho bạn</h1>
                <p class="body-2" style="color: var(--text-secondary); margin: 0;">Hệ thống chỉ hiển thị những khóa học phù hợp với tương tác của bạn.</p>
            </div>
            @using (Html.BeginForm("Refresh", "Recommendation", FormMethod.Post, new { id = "recommend-refresh-form", style = "margin: 0;" }))
            {
                @Html.AntiForgeryToken()
                <button id="btnRefreshRecommend" type="submit" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                    <i class="bi bi-arrow-repeat"></i> <span>Làm mới gợi ý</span>
                </button>
            }
        </div>

        @if (hopLe)
        {
            <div class="recommend-stats">
                <span class="recommend-stat"><i class="bi bi-journal-check"></i> Dựa trên <strong>@Model.SoKhoaDaTuongTac</strong> khóa học bạn đã tương tác</span>
                <span class="recommend-stat"><i class="bi bi-diagram-3"></i> <strong>@Model.Items.Count</strong> khóa học phù hợp với bạn</span>
            </div>
        }
    </div>
</section>

<section style="padding: 40px 0 64px; background: var(--bg-canvas, #F8FAFC);">
    <div class="safe-container">
        @if (!Model.DaKhoiTao)
        {
            <div class="recommend-notice warning"><i class="bi bi-exclamation-triangle"></i><div>Chức năng gợi ý chưa được khởi tạo. Quản trị viên cần chạy <strong>Database/Migrations/005_GoiY_LocCongTac.sql</strong> và job <strong>Recommender/build_recommendations.py</strong>.</div></div>
        }
        else if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
        {
            <div class="recommend-notice warning"><i class="bi bi-exclamation-triangle"></i><div>@Model.ThongBaoLoi</div></div>
        }
        else if (coGoiY)
        {
            <div class="grid-12">
                @foreach (var item in Model.Items)
                {
                    <div class="col-4">
                        @Html.Partial("_RecommendedCourseCard", item)
                    </div>
                }
            </div>
        }
        else
        {
            <div class="recommend-empty">
                <i class="bi bi-lightbulb" style="font-size: 36px; color: #A5B4FC;"></i>
                <p style="margin: 12px 0 6px; font-size: 16px; font-weight: 700; color: var(--text-heading, #0F172A);">Chưa có khóa học phù hợp để gợi ý.</p>
                <p style="margin: 0 auto; max-width: 520px; font-size: 14px;">Hãy xem, yêu thích hoặc học thêm khóa học rồi bấm “Làm mới gợi ý”. Danh sách này sẽ không tự thêm khóa phổ biến.</p>
            </div>
        }
    </div>
</section>

@section scripts {
    <script>
        (function () {
            var form = document.getElementById('recommend-refresh-form');
            var btn = document.getElementById('btnRefreshRecommend');
            if (!form || !btn) return;
            form.addEventListener('submit', function () {
                btn.classList.add('is-loading');
                btn.disabled = true;
                btn.querySelector('span').textContent = 'Đang làm mới...';
            });
        })();
    </script>
}
