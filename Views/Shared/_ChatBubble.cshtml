@* Bong bóng Trợ lý Elearning (góc phải dưới, cửa sổ chat kiểu Dialogflow Messenger). Logic: assets/js/chat-bubble.js.
   Chỉ hiện khi Chatbot:Enabled = true và không ở chế độ chỉ xem của Admin / Marketing. *@
@helper Robot(string cssClass)
{
    <svg class="@cssClass" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <line x1="24" y1="5" x2="24" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        <circle class="eco-cb-ant" cx="24" cy="5" r="3" fill="currentColor" />
        <rect x="4" y="20" width="5" height="10" rx="2.5" fill="currentColor" />
        <rect x="39" y="20" width="5" height="10" rx="2.5" fill="currentColor" />
        <rect x="8" y="11" width="32" height="27" rx="10" fill="currentColor" />
        <rect class="eco-cb-screen" x="12.5" y="16.5" width="23" height="15" rx="6" />
        <circle class="eco-cb-eye" cx="19.5" cy="24" r="2.7" />
        <circle class="eco-cb-eye" cx="28.5" cy="24" r="2.7" />
        <path class="eco-cb-mouth" d="M21 28.6 q3 2 6 0" fill="none" stroke-width="1.6" stroke-linecap="round" />
    </svg>
}
@if (ECOLearning.Controllers.ChatbotController.DangBat && !ECOLearning.Services.StaffViewMode.LaChiXem(Session))
{
    <link rel="stylesheet" href="@Url.Content("~/assets/css/chat-bubble.css?v=1.1")" />

    <div class="eco-cb" id="eco-cb"
         data-url-hoi="@Url.Action("Hoi", "Chatbot", new { area = "" })"
         data-url-xoa="@Url.Action("Xoa", "Chatbot", new { area = "" })"
         data-url-lich-su="@Url.Action("LichSu", "Chatbot", new { area = "" })">

        <section class="eco-cb-window" id="eco-cb-window" role="dialog" aria-label="Trợ lý Elearning" aria-hidden="true">
            <header class="eco-cb-head">
                <span class="eco-cb-avatar">@Robot("eco-cb-robot")</span>
                <div class="eco-cb-title">
                    <strong>Trợ lý Elearning <span class="eco-cb-ai"><i class="bi bi-stars"></i> AI</span></strong>
                    <span class="eco-cb-status"><i></i> Đang hoạt động</span>
                </div>
                <button type="button" class="eco-cb-icon" data-cb="xoa" title="Bắt đầu cuộc trò chuyện mới" aria-label="Bắt đầu cuộc trò chuyện mới"><i class="bi bi-arrow-counterclockwise"></i></button>
                <button type="button" class="eco-cb-icon" data-cb="dong" title="Thu nhỏ" aria-label="Thu nhỏ"><i class="bi bi-chevron-down"></i></button>
            </header>

            <div class="eco-cb-log" id="eco-cb-log" aria-live="polite"></div>

            <div class="eco-cb-chips" id="eco-cb-chips">
                <button type="button">Mình mới học lập trình, nên bắt đầu từ khóa nào?</button>
                <button type="button">Có khóa Python nào dưới 300.000đ không?</button>
                <button type="button">Khóa học miễn phí nào đáng học?</button>
                <button type="button">Khóa nào được đánh giá cao nhất?</button>
            </div>

            <form class="eco-cb-form" id="eco-cb-form" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="text" id="eco-cb-input" maxlength="500" placeholder="Nhập câu hỏi của bạn…" aria-label="Câu hỏi" />
                <button type="submit" class="eco-cb-send" id="eco-cb-send" aria-label="Gửi"><i class="bi bi-send-fill"></i></button>
            </form>
            <div class="eco-cb-foot">Trợ lý AI có thể nhầm lẫn, hãy kiểm tra lại thông tin quan trọng.</div>
        </section>

        <div class="eco-cb-teaser" id="eco-cb-teaser" hidden>
            <button type="button" class="eco-cb-teaser-x" aria-label="Ẩn lời chào"><i class="bi bi-x"></i></button>
            <strong>Xin chào! 👋</strong>
            <span>Mình là Trợ lý Elearning. Bạn cần tìm khóa học nào?</span>
        </div>

        <button type="button" class="eco-cb-bubble" id="eco-cb-bubble" aria-label="Mở Trợ lý Elearning" aria-expanded="false" aria-controls="eco-cb-window">
            @Robot("eco-cb-robot")
            <i class="bi bi-x-lg eco-cb-close-ic" aria-hidden="true"></i>
            <span class="eco-cb-online" title="Đang hoạt động"></span>
            <span class="eco-cb-badge" id="eco-cb-badge" hidden>1</span>
        </button>
    </div>

    <script src="@Url.Content("~/assets/js/chat-bubble.js?v=1.1")" defer></script>
}
