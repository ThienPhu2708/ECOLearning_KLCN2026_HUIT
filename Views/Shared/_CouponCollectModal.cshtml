@* Hộp thoại xác nhận lưu mã giảm giá (assets/js/coupon-wallet.js). Chỉ render cho học viên / giáo viên đã đăng nhập. *@
<div id="coupon-collect-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="cpn-confirm-title">
    <div class="modal-container cpn-confirm" tabindex="-1">
        <div class="cpn-confirm-icon"><i class="bi bi-ticket-perforated"></i></div>
        <h3 id="cpn-confirm-title">Lưu mã giảm giá?</h3>
        <p>
            Mã <strong class="cpn-code" data-cpn-code></strong> (<span data-cpn-label></span>) sẽ được thêm vào
            <strong>Mã giảm giá của tôi</strong> để dùng ở bước thanh toán.
        </p>
        <div class="cpn-confirm-note">
            <i class="bi bi-info-circle-fill"></i>
            <span>Sau khi lưu, mã <strong>không thể xóa</strong> khỏi danh sách và thao tác này <strong>không thể hoàn tác</strong>.</span>
        </div>
        <div class="cpn-confirm-error" data-cpn-error role="alert"></div>
        @Html.AntiForgeryToken()
        <div class="cpn-confirm-actions">
            <button type="button" class="btn btn-secondary" data-cpn-cancel>Hủy</button>
            <button type="button" class="btn btn-primary" data-cpn-ok>Lưu mã</button>
        </div>
    </div>
</div>
