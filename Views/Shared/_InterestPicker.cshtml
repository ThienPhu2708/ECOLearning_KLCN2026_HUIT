@model ECOLearning.ViewModels.InterestPickerViewModel
@*
    Hộp thoại "Bạn quan tâm lĩnh vực nào?" (cold-start của gợi ý khóa học, InterestController).
    - Tự mở một lần với học viên mới (Model.TuDongMo). Đóng / bỏ qua thì ghi nhận để không hỏi lại.
    - Phần tử bất kỳ có thuộc tính data-open-interest mở lại hộp thoại để đổi lựa chọn.
    Lưu xong tải lại trang để mục gợi ý dùng lĩnh vực mới.
*@
@{
    int toiDa = Model.SoLuaChonToiDa;
}

<style>
    .interest-dialog {
        position: fixed;
        inset: 0;
        z-index: 1080;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .interest-dialog[hidden] {
        display: none;
    }

    .interest-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        animation: interest-fade 0.2s ease;
    }

    .interest-panel {
        position: relative;
        width: 100%;
        max-width: 580px;
        max-height: calc(100vh - 32px);
        overflow-y: auto;
        background: #FFFFFF;
        border-radius: 16px;
        box-shadow: 0 24px 48px rgba(15, 23, 42, 0.25);
        padding: 28px 28px 24px;
        animation: interest-rise 0.25s ease;
    }

    .interest-close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 10px;
        background: transparent;
        color: #64748B;
        font-size: 18px;
        cursor: pointer;
    }

    .interest-close:hover {
        background: #F1F5F9;
        color: #0F172A;
    }

    .interest-eyebrow {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 9999px;
        background: #EEF2FF;
        color: #434CE8;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .interest-title {
        margin: 0 0 6px;
        font-size: 22px;
        font-weight: 800;
        color: #0F172A;
    }

    .interest-desc {
        margin: 0 0 20px;
        font-size: 14.5px;
        line-height: 1.55;
        color: #475569;
    }

    .interest-options {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .interest-option {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 14px 14px;
        border: 1.5px solid #E2E8F0;
        border-radius: 12px;
        background: #FFFFFF;
        text-align: left;
        cursor: pointer;
        font: inherit;
        transition: border-color 0.15s ease, background 0.15s ease, opacity 0.15s ease;
    }

    .interest-option:hover:not(:disabled) {
        border-color: #A5B4FC;
        background: #F8FAFF;
    }

    .interest-option.is-selected {
        border-color: #434CE8;
        background: #EEF2FF;
    }

    .interest-option:focus {
        outline: none;
    }

    .interest-option:focus-visible {
        outline: 2px solid #A5B4FC;
        outline-offset: 2px;
    }

    .interest-panel:focus {
        outline: none;
    }

    .interest-option:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .interest-check {
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        border: 1.5px solid #CBD5E1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: transparent;
        font-size: 14px;
        background: #FFFFFF;
    }

    .interest-option.is-selected .interest-check {
        border-color: #434CE8;
        background: #434CE8;
        color: #FFFFFF;
    }

    .interest-name {
        display: block;
        font-size: 14.5px;
        font-weight: 700;
        color: #0F172A;
        line-height: 1.35;
    }

    .interest-count {
        display: block;
        font-size: 12.5px;
        color: #64748B;
        margin-top: 2px;
    }

    .interest-status {
        margin: 14px 0 0;
        font-size: 13px;
        color: #64748B;
    }

    .interest-error {
        margin: 8px 0 0;
        font-size: 13px;
        color: #DC2626;
    }

    .interest-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
    }

    .interest-actions .btn {
        border-radius: 10px;
        font-weight: 600;
        min-width: 120px;
    }

    @@keyframes interest-fade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes interest-rise {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
    }

    @@media (max-width: 560px) {
        .interest-panel { padding: 24px 18px 18px; }
        .interest-options { grid-template-columns: 1fr; }
        .interest-actions { flex-direction: column-reverse; }
        .interest-actions .btn { width: 100%; }
    }
</style>

<div class="interest-dialog" id="interest-dialog" role="dialog" aria-modal="true" aria-labelledby="interest-title"
     data-auto-open="@(Model.TuDongMo ? "true" : "false")" data-max="@toiDa"
     data-save-url="@Url.Action("Save", "Interest", new { area = "" })"
     data-skip-url="@Url.Action("Skip", "Interest", new { area = "" })" hidden>
    <div class="interest-backdrop" data-interest-dismiss></div>
    <div class="interest-panel" tabindex="-1">
        <button type="button" class="interest-close" data-interest-dismiss aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
        <span class="interest-eyebrow">Cá nhân hóa gợi ý</span>
        <h2 class="interest-title" id="interest-title">Bạn quan tâm lĩnh vực nào?</h2>
        <p class="interest-desc">Chọn tối đa @toiDa lĩnh vực để nhận gợi ý khóa học phù hợp ngay. Bạn có thể đổi lại bất cứ lúc nào.</p>

        @Html.AntiForgeryToken()
        <div class="interest-options" role="group" aria-label="Lĩnh vực quan tâm">
            @foreach (var item in Model.LuaChon)
            {
                bool chon = Model.DaChon.Contains(item.MaDanhMuc);
                <button type="button" class="interest-option@(chon ? " is-selected" : "")" data-id="@item.MaDanhMuc" aria-pressed="@(chon ? "true" : "false")">
                    <span class="interest-check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    <span>
                        <span class="interest-name">@item.TenDanhMuc</span>
                        <span class="interest-count">@item.SoKhoaHoc khóa học</span>
                    </span>
                </button>
            }
        </div>

        <p class="interest-status" aria-live="polite"></p>
        <p class="interest-error" role="alert" hidden></p>

        <div class="interest-actions">
            <button type="button" class="btn btn-outline" data-interest-dismiss>@(Model.TuDongMo ? "Bỏ qua" : "Hủy")</button>
            <button type="button" class="btn btn-primary" data-interest-save disabled>Lưu lựa chọn</button>
        </div>
    </div>
</div>

<script>
    (function () {
        var dialog = document.getElementById('interest-dialog');
        if (!dialog) return;

        var max = parseInt(dialog.getAttribute('data-max'), 10) || 3;
        var autoOpen = dialog.getAttribute('data-auto-open') === 'true';
        var options = Array.prototype.slice.call(dialog.querySelectorAll('.interest-option'));
        var status = dialog.querySelector('.interest-status');
        var errorBox = dialog.querySelector('.interest-error');
        var saveBtn = dialog.querySelector('[data-interest-save]');
        var lastFocus = null;
        var skipped = false;

        function token() {
            var input = dialog.querySelector('input[name="__RequestVerificationToken"]')
                || document.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        function selectedIds() {
            return options.filter(function (o) { return o.classList.contains('is-selected'); })
                .map(function (o) { return o.getAttribute('data-id'); });
        }

        function refresh() {
            var count = selectedIds().length;
            options.forEach(function (o) {
                o.disabled = count >= max && !o.classList.contains('is-selected');
            });
            saveBtn.disabled = count === 0;
            status.textContent = count === 0
                ? 'Chưa chọn lĩnh vực nào.'
                : 'Đã chọn ' + count + '/' + max + ' lĩnh vực.';
        }

        function showError(message) {
            errorBox.textContent = message;
            errorBox.hidden = !message;
        }

        function post(url, ids) {
            var body = new URLSearchParams();
            body.append('__RequestVerificationToken', token());
            (ids || []).forEach(function (id) { body.append('categoryIds', id); });
            return fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'X-Requested-With': 'XMLHttpRequest' },
                body: body.toString()
            }).then(function (res) { return res.json(); });
        }

        function open() {
            lastFocus = document.activeElement;
            showError('');
            refresh();
            dialog.hidden = false;
            document.body.style.overflow = 'hidden';
            // Đưa focus vào hộp thoại (để phím Esc / Tab hoạt động) mà không tô viền một lựa chọn nào
            dialog.querySelector('.interest-panel').focus();
        }

        function close() {
            dialog.hidden = true;
            document.body.style.overflow = '';
            if (lastFocus && lastFocus.focus) lastFocus.focus();
        }

        // Hộp thoại tự mở: đóng bằng bất kỳ cách nào cũng tính là bỏ qua, để không hỏi lại ở lần sau
        function dismiss() {
            if (autoOpen && !skipped) {
                skipped = true;
                post(dialog.getAttribute('data-skip-url')).catch(function () { });
            }
            close();
        }

        options.forEach(function (o) {
            o.addEventListener('click', function () {
                var selected = o.classList.toggle('is-selected');
                o.setAttribute('aria-pressed', selected ? 'true' : 'false');
                showError('');
                refresh();
            });
        });

        dialog.querySelectorAll('[data-interest-dismiss]').forEach(function (el) {
            el.addEventListener('click', dismiss);
        });

        dialog.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                e.preventDefault();
                dismiss();
            }
        });

        saveBtn.addEventListener('click', function () {
            var ids = selectedIds();
            if (ids.length === 0) return;
            saveBtn.disabled = true;
            saveBtn.textContent = 'Đang lưu...';
            post(dialog.getAttribute('data-save-url'), ids)
                .then(function (data) {
                    if (data && data.success) {
                        window.location.reload();
                        return;
                    }
                    if (data && data.requireLogin) {
                        window.location.href = '@Url.Action("Login", "Account", new { area = "" })';
                        return;
                    }
                    showError((data && data.message) || 'Chưa lưu được lựa chọn. Vui lòng thử lại.');
                    saveBtn.textContent = 'Lưu lựa chọn';
                    refresh();
                })
                .catch(function () {
                    showError('Không kết nối được máy chủ. Vui lòng thử lại.');
                    saveBtn.textContent = 'Lưu lựa chọn';
                    refresh();
                });
        });

        document.addEventListener('click', function (e) {
            var trigger = e.target.closest ? e.target.closest('[data-open-interest]') : null;
            if (trigger) {
                e.preventDefault();
                open();
            }
        });

        if (autoOpen) {
            open();
        }
    })();
</script>
