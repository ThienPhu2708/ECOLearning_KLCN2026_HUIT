<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@(ViewBag.Title != null ? ViewBag.Title + " | " : "")E-Learning - Nền tảng Đào tạo Trực tuyến</title>

        <!-- Google Fonts Preconnect & Stylesheet (Plus Jakarta Sans & Be Vietnam Pro chuẩn 100% tiếng Việt) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />

        <!-- Bootstrap Icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

        <!-- Design System CSS (Cache Busting v=2.0) -->
        <link rel="stylesheet" href="@Url.Content("~/assets/css/variables.css?v=2.0")" />
        <link rel="stylesheet" href="@Url.Content("~/assets/css/base.css?v=2.0")" />
        <link rel="stylesheet" href="@Url.Content("~/assets/css/components.css?v=2.1")" />

        <style>
            .btn-nav-portal {
                background: #FFFFFF !important;
                color: #0F172A !important;
                border: 1px solid #E2E8F0 !important;
                box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04) !important;
                font-weight: 600 !important;
                font-size: 13.5px !important;
                border-radius: 10px !important;
                text-decoration: none !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 6px !important;
                height: 38px !important;
                padding: 0 16px !important;
                transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
                cursor: pointer !important;
                white-space: nowrap !important;
                box-sizing: border-box !important;
            }
            .btn-nav-portal:hover {
                background-color: #F8FAFC !important;
                color: #000000 !important;
                border-color: #CBD5E1 !important;
                box-shadow: 0 4px 8px -1px rgba(15, 23, 42, 0.1), 0 2px 4px -2px rgba(15, 23, 42, 0.06) !important;
                transform: translateY(-1px) !important;
            }
            .btn-nav-portal:active {
                transform: translateY(0) !important;
                box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05) !important;
            }
        </style>

        @RenderSection("styles", required: false)
    </head>
    <body style="margin: 0; padding: 0; background-color: #FFFFFF;">
        <!-- Header Navigation (76px, Sticky) -->
        <header class="main-header" style="height: 76px; min-height: 76px; background: #FFFFFF; border-bottom: none; box-shadow: 0 2px 12px 0 rgba(15, 23, 42, 0.04); position: sticky; top: 0; z-index: 50; margin: 0; padding: 0;">
            <div class="safe-container header-inner">
                <div class="header-left">
                    <a href="@Url.Action("Index", "Home", new { area = "" })" class="brand-logo" title="E-Learning Trang Chủ">
                        <div class="logo-icon" style="display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-book-half" style="font-size: 20px;"></i>
                        </div>
                        <span class="logo-text">E-Learning<span>.</span></span>
                    </a>
                    <nav class="nav-links">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">Trang chủ</a>
                        <a href="#" class="nav-link">Khám phá</a>
                        <a href="@Url.Action("MyCourses", "Learning", new { area = "" })" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Learning" ? "active" : "")">Khóa học của tôi</a>
                    </nav>
                </div>

                <!-- Search Bar -->
                <div class="header-search">
                    <form action="@Url.Action("Index", "Course", new { area = "" })" method="get" style="display: flex; align-items: center; width: 100%;">
                        <i class="bi bi-search search-icon" style="font-size: 16px;"></i>
                        <input type="text" name="search" placeholder="Tìm kiếm khóa học, kỹ năng hoặc giảng viên..." value="@Request.QueryString["search"]" />
                    </form>
                </div>

                <!-- Header Actions -->
                <div class="header-actions">
                    @{
                    var cartList = Session["Cart"] as List<ECOLearning.ViewModels.CartItemViewModel>;
                    int cartBadgeCount = cartList != null ? cartList.Count : 0;
                }
                <!-- Giỏ hàng -->
                <a href="@Url.Action("Index", "Cart", new { area = "" })" class="btn btn-icon btn-secondary" title="Giỏ hàng" style="position: relative; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="bi bi-cart3" style="font-size: 18px;"></i>
                    <span id="header-cart-badge" style="position: absolute; top: -4px; right: -4px; background: #434CE8; color: #FFFFFF; font-size: 10px; font-weight: 800; width: 18px; height: 18px; border-radius: 50%; display: @(cartBadgeCount > 0 ? "flex" : "none"); align-items: center; justify-content: center; border: 2px solid #FFFFFF;">@(cartBadgeCount > 0 ? cartBadgeCount.ToString() : "")</span>
                </a>

                @if (User.Identity.IsAuthenticated || Session["UserId"] != null)
                {
                    string userRole = Session["Role"]?.ToString() ?? "HocVien";
                    string userName = Session["FullName"]?.ToString() ?? User.Identity.Name;
                    string userAvatar = Session["Avatar"]?.ToString() ?? "assets/images/avatars/avatar_default.jpg";

                    if (string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="btn-nav-portal" title="Quản trị hệ thống">
                            Admin
                        </a>
                    }
                    else if (string.Equals(userRole, "GiaoVien", StringComparison.OrdinalIgnoreCase) || string.Equals(userRole, "Giáo viên", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="@Url.Action("Index", "Dashboard", new { area = "Instructor" })" class="btn-nav-portal" title="Kênh giảng viên">
                            Giáo viên
                        </a>
                    }
                    else if (string.Equals(userRole, "Marketing", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="@Url.Action("Index", "Dashboard", new { area = "Marketing" })" class="btn-nav-portal" title="Kênh Marketing">
                            Marketing
                        </a>
                    }
                    else
                    {
                        int currentUserId = (Session["UserId"] as int?) ?? 0;
                        var teacherApp = currentUserId > 0 ? ECOLearning.Services.TeacherApplicationService.GetByUserId(currentUserId) : null;

                        if (teacherApp != null && teacherApp.Status == "Pending")
                        {
                            <a href="@Url.Action("Status", "TeacherApplication", new { area = "Instructor" })" class="btn-nav-portal" title="Hồ sơ giảng viên đang chờ duyệt">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background-color: #F59E0B; display: inline-block;"></span>
                                Giáo viên
                            </a>
                        }
                        else if (teacherApp != null && teacherApp.Status == "Approved")
                        {
                            <a href="@Url.Action("Index", "Dashboard", new { area = "Instructor" })" class="btn-nav-portal" title="Kênh giảng viên">
                                Giáo viên
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Register", "TeacherApplication", new { area = "Instructor" })" class="btn-nav-portal" title="Đăng ký làm giáo viên">
                                Giáo viên
                            </a>
                        }
                    }


                    <div style="display: flex; align-items: center; gap: 10px; padding-left: 10px; border-left: 1px solid var(--border-color);">
                        <a href="@Url.Action("Index", "Profile", new { area = "" })" style="display: flex; align-items: center; gap: 8px; text-decoration: none; color: inherit;">
                            <img src="@userAvatar"
                            alt="Avatar"
                            style="width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 2px solid var(--primary);" />
                            <div style="line-height: 1.2;">
                                <div style="font-size: 13px; font-weight: 700; color: var(--text-heading);">@userName</div>
                                <div style="font-size: 11px; color: var(--status-success); font-weight: 600;"><i class="bi bi-circle-fill" style="font-size: 7px; vertical-align: middle;"></i> Đang hoạt động</div>
                            </div>
                        </a>

                        <button type="button" class="btn btn-danger btn-sm" data-modal-target="logout-modal" style="display: inline-flex; align-items: center; gap: 6px;" title="Đăng xuất">
                            <i class="bi bi-box-arrow-right" style="font-size: 15px;"></i>
                            Đăng xuất
                        </button>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account", new { area = "" })" class="btn btn-primary btn-sm" style="background: #434CE8; color: #fff; font-weight: 600; border-radius: 10px;">Đăng ký / Đăng nhập</a>
                }
            </div>
        </div>
    </header>

    <!-- Main Dynamic Content -->
    <main class="main-content" style="flex: 1 0 auto; margin: 0 !important; padding: 0 !important; background-color: #FFFFFF;">
        @RenderBody()
    </main>

    <!-- Footer Hệ Thống -->
    <footer style="background: #0F172A; color: #94A3B8; padding: 60px 0 32px; margin-top: auto;">
        <div class="safe-container">
            <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 48px;">
                <div>
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
                        <div class="logo-icon" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-book-half" style="font-size: 20px;"></i>
                        </div>
                        <span style="color: #fff; font-weight: 800; font-size: 18px; letter-spacing: -0.02em;">E-Learning<span>.</span></span>
                    </div>
                    <p style="font-size: 14px; line-height: 24px; color: #94A3B8; max-width: 320px;">
                        Nền tảng đào tạo trực tuyến chuẩn mực, cung cấp các khóa học thực chiến từ giảng viên chuyên gia hàng đầu.
                    </p>
                </div>

                <div>
                    <h4 style="color: #FFFFFF; font-size: 15px; font-weight: 700; margin-bottom: 18px;">Khám Phá</h4>
                    <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
                        <li><a href="@Url.Action("Index", "Course", new { area = "" })" style="color: #94A3B8; text-decoration: none;">Tất cả khóa học</a></li>
                        <li><a href="@Url.Action("Index", "Course", new { area = "", category = "CNTT" })" style="color: #94A3B8; text-decoration: none;">Công nghệ thông tin</a></li>
                        <li><a href="@Url.Action("Index", "Course", new { area = "", category = "Design" })" style="color: #94A3B8; text-decoration: none;">Thiết kế & Đồ họa</a></li>
                        <li><a href="@Url.Action("Index", "Course", new { area = "", category = "Business" })" style="color: #94A3B8; text-decoration: none;">Kinh doanh & Marketing</a></li>
                    </ul>
                </div>

                <div>
                    <h4 style="color: #FFFFFF; font-size: 15px; font-weight: 700; margin-bottom: 18px;">Dành Cho Giảng Viên</h4>
                    <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
                        <li><a href="@Url.Action("Index", "Dashboard", new { area = "Instructor" })" style="color: #94A3B8; text-decoration: none;">Cổng giảng viên</a></li>
                        <li><a href="@Url.Action("Create", "Course", new { area = "Instructor" })" style="color: #94A3B8; text-decoration: none;">Tạo khóa học mới</a></li>
                        <li><a href="@Url.Action("Payouts", "Instructor", new { area = "Instructor" })" style="color: #94A3B8; text-decoration: none;">Chính sách phân chia doanh thu</a></li>
                    </ul>
                </div>

                <div>
                    <h4 style="color: #FFFFFF; font-size: 15px; font-weight: 700; margin-bottom: 18px;">Hỗ Trợ & Điều Khoản</h4>
                    <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
                        <li><a href="@Url.Action("About", "Home", new { area = "" })" style="color: #94A3B8; text-decoration: none;">Về E-Learning</a></li>
                        <li><a href="@Url.Action("Contact", "Home", new { area = "" })" style="color: #94A3B8; text-decoration: none;">Liên hệ trợ giúp</a></li>
                        <li><a href="#" style="color: #94A3B8; text-decoration: none;">Điều khoản sử dụng</a></li>
                        <li><a href="#" style="color: #94A3B8; text-decoration: none;">Chính sách bảo mật</a></li>
                    </ul>
                </div>
            </div>

            <div style="border-top: 1px solid #1E293B; padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 13px;">
                <p>&copy; @DateTime.Now.Year E-Learning Platform. All rights reserved.</p>
                <div style="display: flex; gap: 20px;">
                    <span>Hệ thống quản lý và cung cấp khóa học trực tuyến</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Modal Xác Nhận Đăng Xuất Popup (UC2) -->
    <div id="logout-modal" class="modal-overlay">
        <div class="modal-container" style="max-width: 460px; text-align: center; padding: 36px 32px; border-radius: 24px; background: #FFFFFF;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(239, 68, 68, 0.1); color: #EF4444; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px;">
                <i class="bi bi-box-arrow-right" style="font-size: 26px;"></i>
            </div>
            <h3 style="font-size: 20px; font-weight: 800; color: #0F172A; margin-bottom: 6px;">Xác nhận đăng xuất</h3>
            <p style="font-size: 14px; color: #475569; margin: 0 auto 20px; line-height: 22px;">
                Bạn có chắc chắn muốn kết thúc phiên làm việc hiện tại?
            </p>

            @if (User.Identity.IsAuthenticated || Session["UserId"] != null)
            {
                <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 16px; padding: 14px 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 14px; text-align: left;">
                    <img src="@(Session["Avatar"]?.ToString() ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80")" alt="Avatar" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #434CE8; flex-shrink: 0;" />
                    <div style="flex: 1; line-height: 1.3;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 2px;">
                            <strong style="font-size: 14px; color: #0F172A;">@(Session["FullName"]?.ToString() ?? User.Identity.Name)</strong>
                            <span class="badge badge-success" style="font-size: 11px; padding: 2px 8px; background: #ECFDF5; color: #10B981; border-radius: 9999px;">Học viên</span>
                        </div>
                        <div style="font-size: 12px; color: #64748B;">@(Session["Email"]?.ToString() ?? "")</div>
                    </div>
                </div>
            }

            <div style="background: rgba(67, 76, 232, 0.05); border: 1px dashed rgba(67, 76, 232, 0.25); border-radius: 12px; padding: 12px 14px; font-size: 13px; color: #475569; line-height: 20px; text-align: left; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 8px;">
                <i class="bi bi-info-circle-fill text-primary" style="font-size: 15px; margin-top: 2px;"></i>
                <span>Hệ thống đã tự động lưu toàn bộ tiến độ video và khóa học của bạn. Khi đăng xuất, bạn sẽ được đưa về <strong>Trang chủ</strong> an toàn.</span>
            </div>

            @using (Html.BeginForm("Logout", "Account", new { area = "" }, FormMethod.Post, new { id = "logout-form" }))
            {
                @Html.AntiForgeryToken()
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <button type="submit" class="btn btn-danger btn-md" style="width: 100%; height: 48px; background: #EF4444; border-radius: 12px; font-weight: 700; font-size: 15px; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
                        <i class="bi bi-box-arrow-right" style="font-size: 18px;"></i>
                        <span>Đăng xuất</span>
                    </button>
                    <button type="button" class="btn btn-outline btn-md" data-modal-close style="width: 100%; height: 44px; border-radius: 12px; font-weight: 600;">Hủy và tiếp tục học</button>
                </div>
            }
        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container"></div>

    <!-- Core Scripts -->
    <script src="@Url.Content("~/Scripts/jquery-3.7.0.min.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/assets/js/app.js?v=3.0")"></script>
    <script>
        function updateHeaderCartBadge(count) {
        var $badge = $('#header-cart-badge');
        if ($badge.length) {
        if (count > 0) {
        $badge.text(count).css('display', 'flex');
    }
    else
    {
        $badge.text('').css('display', 'none');
    }
}
}
window.updateHeaderCartBadge = updateHeaderCartBadge;
</script>
@RenderSection("scripts", required: false)
</body>
</html>