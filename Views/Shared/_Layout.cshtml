    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/assets/js/app.js?v=3.0")"></script>
    <script>
        function updateHeaderCartBadge(count) {
        var $badge = $('#header-cart-badge');
        if ($badge.length) {
        if (count > 0) {
        $badge.text(count).css('display', 'flex');
    }
    else
    {
        $badge.text('').css('display', 'none');
    }
}
}
window.updateHeaderCartBadge = updateHeaderCartBadge;
