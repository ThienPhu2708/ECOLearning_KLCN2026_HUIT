@model ECOLearning.ViewModels.PhanTrangViewModel
@*
    Thanh phân trang dùng chung (PhanTrangViewModel). Link giữ nguyên mọi tham số lọc / sắp xếp đang có trên
    query string, chỉ thay số trang; trang 1 bỏ hẳn tham số để URL gọn và trùng với link không phân trang.
*@
@{
    if (Model == null || !Model.CoNhieuTrang)
    {
        return;
    }

    // Đọc Request.Url.Query (không qua request validation) để từ khóa có ký tự đặc biệt không làm lỗi trang
    var duongDan = Request.Url.AbsolutePath;
    var thamSoGoc = Request.Url.Query;
    string neo = string.IsNullOrEmpty(Model.Neo) ? "" : "#" + Model.Neo;
    Func<int, string> link = t =>
    {
        var qs = HttpUtility.ParseQueryString(thamSoGoc);
        if (t > 1) { qs[Model.ThamSo] = t.ToString(); } else { qs.Remove(Model.ThamSo); }
        string chuoi = qs.ToString();
        return duongDan + (chuoi.Length > 0 ? "?" + chuoi : "") + neo;
    };
}
<nav class="pg" aria-label="Phân trang">
    @if (Model.Trang > 1)
    {
        <a class="pg-item pg-step" href="@link(Model.Trang - 1)" rel="prev"><i class="bi bi-chevron-left"></i><span class="pg-step-text">Trước</span></a>
    }
    else
    {
        <span class="pg-item pg-step is-disabled" aria-disabled="true"><i class="bi bi-chevron-left"></i><span class="pg-step-text">Trước</span></span>
    }

    @foreach (int t in Model.DaySoTrang())
    {
        if (t == 0)
        {
            <span class="pg-item pg-gap" aria-hidden="true">…</span>
        }
        else if (t == Model.Trang)
        {
            <span class="pg-item is-current" aria-current="page">@t</span>
        }
        else
        {
            <a class="pg-item" href="@link(t)" aria-label="Trang @t">@t</a>
        }
    }

    @if (Model.Trang < Model.TongSoTrang)
    {
        <a class="pg-item pg-step" href="@link(Model.Trang + 1)" rel="next"><span class="pg-step-text">Sau</span><i class="bi bi-chevron-right"></i></a>
    }
    else
    {
        <span class="pg-item pg-step is-disabled" aria-disabled="true"><span class="pg-step-text">Sau</span><i class="bi bi-chevron-right"></i></span>
    }
</nav>
<p class="pg-summary">Hiển thị <strong>@Model.TuSo–@Model.DenSo</strong> trong <strong>@Model.TongSo</strong> @Model.DonVi</p>
