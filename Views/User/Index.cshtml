@model ECOLearning.ViewModels.InstructorProfileViewModel
@{
    ViewBag.Title = Model.HoTen + " - Thông tin Giáo viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string defaultAvatar = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80";
    string avatarUrl = string.IsNullOrEmpty(Model.AnhDaiDien) ? defaultAvatar : Model.AnhDaiDien;
    if (!avatarUrl.StartsWith("http") && !avatarUrl.StartsWith("/"))
    {
        avatarUrl = Url.Content("~/" + avatarUrl);
    }
}

@section styles {
<style>
    .instructor-header-section {
        background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
        color: #FFFFFF;
        padding: 44px 0 52px;
        position: relative;
        overflow: hidden;
    }

    .instructor-header-section::before {
        content: '';
        position: absolute;
        top: -80px;
        right: -80px;
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, rgba(67, 76, 232, 0.25) 0%, rgba(67, 76, 232, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .stat-card-custom {
        background: #FFFFFF;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 16px;
        padding: 24px 20px;
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .stat-card-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.08);
    }

    .stat-icon-wrap {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .info-card-custom {
        background: #FFFFFF;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 28px;
        box-shadow: 0 2px 4px rgba(15, 23, 42, 0.02);
    }

    .info-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border-color, #E2E8F0);
    }

    .info-card-header h3 {
        font-size: 18px;
        font-weight: 700;
        color: #0F172A;
        margin: 0;
    }

    .certificate-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 18px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        text-decoration: none;
        color: #0F172A;
        transition: all 0.2s ease;
    }

    .certificate-pill:hover {
        background: #EEF2FF;
        border-color: #C7D2FE;
        color: #434CE8;
    }

    /* Mục thông tin giáo viên: bấm tiêu đề để mở, bấm lại để thu gọn */
    .info-toggle {
        padding: 0;
        margin-bottom: 16px;
    }

    .info-toggle-btn {
        width: 100%;
        margin: 0;
        padding: 22px 28px;
        border: none;
        border-radius: 16px;
        background: none;
        text-align: left;
        cursor: pointer;
        font: inherit;
    }

    .info-toggle-btn:hover h3,
    .info-toggle-btn:focus-visible h3 {
        color: var(--primary, #434CE8);
    }

    .info-toggle-btn:focus-visible {
        outline: 2px solid var(--primary, #434CE8);
        outline-offset: -2px;
    }

    .info-toggle-icon {
        margin-left: auto;
        font-size: 16px;
        color: #64748B;
        transition: transform 0.3s ease;
    }

    .info-toggle.is-open .info-toggle-icon {
        transform: rotate(180deg);
    }

    /* Chiều cao chuyển từ 0 sang vừa nội dung: grid 0fr -> 1fr */
    .info-toggle-panel {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s ease;
    }

    .info-toggle.is-open .info-toggle-panel {
        grid-template-rows: 1fr;
    }

    .info-toggle-inner {
        overflow: hidden;
        min-height: 0;
    }

    .info-toggle-body {
        margin: 0 28px 28px;
        padding-top: 18px;
        border-top: 1px solid var(--border-color, #E2E8F0);
    }

    /* Hơn 5 khóa học: hiện 5 khóa dạng dòng rút gọn + nút "Xem tất cả" */
    .teacher-course-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 10px;
    }

    .teacher-course-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        background: #FFFFFF;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .teacher-course-row:hover {
        border-color: #C7D2FE;
        box-shadow: 0 8px 18px -10px rgba(67, 76, 232, 0.35);
        transform: translateY(-1px);
    }

    .teacher-course-row img {
        width: 104px;
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
        flex-shrink: 0;
        background: #E2E8F0;
    }

    .teacher-course-row-title {
        font-size: 14.5px;
        font-weight: 700;
        color: #0F172A;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .teacher-course-row:hover .teacher-course-row-title {
        color: var(--primary, #434CE8);
    }

    .teacher-course-row-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 4px;
        font-size: 12.5px;
        color: #64748B;
    }

    .teacher-course-row-price {
        margin-left: auto;
        padding-left: 8px;
        font-size: 15px;
        font-weight: 800;
        color: #0F172A;
        white-space: nowrap;
    }

    .teacher-course-more {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
        padding: 12px;
        border: 1px dashed #C7D2FE;
        border-radius: 12px;
        background: #F8FAFF;
        color: var(--primary, #434CE8);
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .teacher-course-more:hover {
        background: #EEF2FF;
        color: var(--primary, #434CE8);
    }

    @@media (prefers-reduced-motion: reduce) {
        .info-toggle-panel,
        .info-toggle-icon {
            transition: none;
        }
    }
</style>
}
<!-- Header Thông Tin Giáo Viên -->
<section class="instructor-header-section">
    <div class="safe-container">
        <div style="display: flex; align-items: center; gap: 32px; flex-wrap: wrap;">
            <!-- Avatar -->
            <div style="position: relative;">
                <img src="@avatarUrl" alt="@Model.HoTen"
                     style="width: 110px; height: 110px; border-radius: 50%; object-fit: cover; border: 4px solid rgba(255, 255, 255, 0.2); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);" />
                <span style="position: absolute; bottom: 4px; right: 4px; width: 20px; height: 20px; background: #10B981; border: 3px solid #0F172A; border-radius: 50%;" title="Đang hoạt động"></span>
            </div>

            <!-- Tên & Thông tin cơ bản -->
            <div style="flex: 1; min-width: 280px;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: rgba(67, 76, 232, 0.3); border: 1px solid rgba(99, 102, 241, 0.4); border-radius: 9999px; font-size: 12px; font-weight: 700; color: #C7D2FE; letter-spacing: 0.05em; text-transform: uppercase;">
                        <i class="bi bi-patch-check-fill" style="color: #818CF8;"></i> Giáo viên chính thức
                    </span>
                    @if (Model.NgayDuyet.HasValue)
                    {
                        <span style="font-size: 12.5px; color: #94A3B8;">
                            <i class="bi bi-calendar-check me-1"></i> Tham gia từ @Model.NgayDuyet.Value.ToString("MM/yyyy")
                        </span>
                    }
                    else if (Model.NgayGui.HasValue)
                    {
                        <span style="font-size: 12.5px; color: #94A3B8;">
                            <i class="bi bi-calendar-check me-1"></i> Tham gia từ @Model.NgayGui.Value.ToString("MM/yyyy")
                        </span>
                    }
                </div>

                <h1 style="font-size: 32px; font-weight: 800; margin: 0 0 10px 0; color: #FFFFFF; letter-spacing: -0.01em;">
                    @Model.HoTen
                </h1>

                <p style="font-size: 16px; color: #CBD5E1; margin: 0 0 16px 0; max-width: 720px; line-height: 1.5; font-weight: 500;">
                    <i class="bi bi-briefcase-fill text-primary me-2" style="color: #818CF8 !important;"></i>@Model.ChuyenMon
                </p>

                <!-- Liên hệ & Thông tin bổ sung -->
                <div style="display: flex; align-items: center; gap: 20px; font-size: 13.5px; color: #94A3B8; flex-wrap: wrap;">
                    @* Email / số điện thoại chỉ hiện khi đã đăng nhập (hồ sơ mở công khai cho khách từ trang tìm kiếm) *@
                    @if (Session["UserId"] != null)
                    {
                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                            <i class="bi bi-envelope-at" style="color: #818CF8;"></i>
                            <span>@Model.Email</span>
                        </div>
                    }
                    @if (Session["UserId"] != null && !string.IsNullOrEmpty(Model.SoDienThoai))
                    {
                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                            <i class="bi bi-telephone" style="color: #818CF8;"></i>
                            <span>@Model.SoDienThoai</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.GioiTinh))
                    {
                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                            <i class="bi bi-gender-ambiguous" style="color: #818CF8;"></i>
                            <span>Giới tính: @Model.GioiTinh</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Content Section -->
<div style="background: #F8FAFC; padding: 40px 0 80px;">
    <div class="safe-container">

        <!-- HÀNG THỐNG KÊ (4 THẺ CHỈ SỐ THEO YÊU CẦU CSDL) -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 36px;">
            <!-- 1. Tổng số học viên (User request) -->
            <div class="stat-card-custom">
                <div class="stat-icon-wrap" style="background: #EEF2FF; color: #434CE8;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1.1;">
                        @Model.TongSoHocVien.ToString("N0")
                    </div>
                    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
                        Tổng số học viên
                    </div>
                </div>
            </div>

            <!-- 2. Tổng lượt đánh giá (User request) -->
            <div class="stat-card-custom">
                <div class="stat-icon-wrap" style="background: #FFFBEB; color: #F59E0B;">
                    <i class="bi bi-chat-heart-fill"></i>
                </div>
                <div>
                    <div style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1.1;">
                        @Model.TongLuotDanhGia.ToString("N0")
                    </div>
                    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
                        Tổng lượt đánh giá
                    </div>
                </div>
            </div>

            <!-- 3. Đánh giá trung bình -->
            <div class="stat-card-custom">
                <div class="stat-icon-wrap" style="background: @(Model.TongLuotDanhGia > 0 && Model.DiemDanhGiaTrungBinh > 0 ? "#ECFDF5" : "#F8FAFC"); color: @(Model.TongLuotDanhGia > 0 && Model.DiemDanhGiaTrungBinh > 0 ? "#10B981" : "#94A3B8");">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div>
                    @if (Model.TongLuotDanhGia > 0 && Model.DiemDanhGiaTrungBinh > 0)
                    {
                        <div style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1.1;">
                            @Model.DiemDanhGiaTrungBinh.ToString("0.0") <span style="font-size: 14px; font-weight: 600; color: #64748B;">/ 5.0</span>
                        </div>
                        <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
                            Đánh giá chất lượng
                        </div>
                    }
                    else
                    {
                        <div style="font-size: 22px; font-weight: 800; color: #64748B; line-height: 1.1;">
                            Chưa có
                        </div>
                        <div style="font-size: 13px; color: #94A3B8; font-weight: 500; margin-top: 4px;">
                            Đánh giá chất lượng
                        </div>
                    }
                </div>
            </div>

            <!-- 4. Tổng số khóa học -->
            <div class="stat-card-custom">
                <div class="stat-icon-wrap" style="background: #F3E8FF; color: #9333EA;">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div>
                    <div style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1.1;">
                        @Model.TongSoKhoaHoc
                    </div>
                    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
                        Khóa học giảng dạy
                    </div>
                </div>
            </div>
        </div>

        <!-- Layout 2 cột: Cột trái (Nội dung chi tiết), Cột phải (Cam kết đào tạo) -->
        <div style="display: grid; grid-template-columns: 1fr 340px; gap: 32px; align-items: start;">
            
            <!-- CỘT TRÁI -->
            <div>
                <!-- Khối 1-3: thông tin giáo viên, mặc định thu gọn; bấm tiêu đề để mở, bấm lại để thu gọn -->
                <!-- Khối 1: Tiểu sử & Kinh nghiệm giảng dạy (kinhNghiem từ DangKyGiaoVien) -->
                <div class="info-card-custom info-toggle">
                    <button type="button" class="info-card-header info-toggle-btn" aria-expanded="false" aria-controls="panel-kinh-nghiem">
                        <i class="bi bi-person-lines-fill text-primary" style="font-size: 20px;"></i>
                        <h3>Giới thiệu & Kinh nghiệm làm việc</h3>
                        <i class="bi bi-chevron-down info-toggle-icon"></i>
                    </button>
                    <div class="info-toggle-panel" id="panel-kinh-nghiem">
                        <div class="info-toggle-inner">
                            <div class="info-toggle-body" style="font-size: 15px; line-height: 1.75; color: #334155; white-space: pre-line;">@Model.KinhNghiem</div>
                        </div>
                    </div>
                </div>

                <!-- Khối 2: Chuyên môn & Lĩnh vực đào tạo (chuyenMon từ DangKyGiaoVien) -->
                <div class="info-card-custom info-toggle">
                    <button type="button" class="info-card-header info-toggle-btn" aria-expanded="false" aria-controls="panel-chuyen-mon">
                        <i class="bi bi-award text-primary" style="font-size: 20px;"></i>
                        <h3>Lĩnh vực chuyên môn</h3>
                        <i class="bi bi-chevron-down info-toggle-icon"></i>
                    </button>
                    <div class="info-toggle-panel" id="panel-chuyen-mon">
                        <div class="info-toggle-inner">
                            <div class="info-toggle-body" style="display: flex; flex-wrap: wrap; gap: 10px;">
                                @{
                                    var specializations = (Model.ChuyenMon ?? "")
                                        .Split(new[] { ",", ";", "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(s => s.Trim())
                                        .Where(s => !string.IsNullOrEmpty(s))
                                        .ToList();
                                }
                                @if (specializations.Any())
                                {
                                    foreach (var spec in specializations)
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; border-radius: 9999px; font-size: 13.5px; font-weight: 600;">
                                            <i class="bi bi-check-circle-fill" style="font-size: 12px;"></i> @spec
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span style="color: #64748B; font-size: 14px;">@Model.ChuyenMon</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Khối 3: Hồ sơ chứng chỉ chuyên môn (nếu có từ DangKyGiaoVien) -->
                @if (!string.IsNullOrEmpty(Model.TenTepChungChi) || !string.IsNullOrEmpty(Model.TepChungChi))
                {
                    <div class="info-card-custom info-toggle">
                        <button type="button" class="info-card-header info-toggle-btn" aria-expanded="false" aria-controls="panel-chung-chi">
                            <i class="bi bi-shield-check text-primary" style="font-size: 20px;"></i>
                            <h3>Hồ sơ & Chứng chỉ chuyên môn đã xác thực</h3>
                            <i class="bi bi-chevron-down info-toggle-icon"></i>
                        </button>
                        <div class="info-toggle-panel" id="panel-chung-chi">
                            <div class="info-toggle-inner">
                                <div class="info-toggle-body" style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                                    <div class="certificate-pill">
                                        <i class="bi bi-file-earmark-pdf-fill" style="font-size: 24px; color: #EF4444;"></i>
                                        <div>
                                            <div style="font-weight: 700; font-size: 14px;">@(string.IsNullOrEmpty(Model.TenTepChungChi) ? "Chứng chỉ chuyên môn" : Model.TenTepChungChi)</div>
                                            <div style="font-size: 12px; color: #10B981; font-weight: 600;">
                                                <i class="bi bi-check-all"></i> Đã được kiểm duyệt và công nhận bởi hệ thống
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Khối 4: Danh sách các khóa học do giáo viên phụ trách -->
                @{
                    int soKhoaHoc = Model.DanhSachKhoaHoc.Count;
                    bool rutGon = soKhoaHoc > ECOLearning.ViewModels.InstructorProfileViewModel.SoKhoaHocTrenTrangHoSo;
                    string xemTatCaUrl = Url.Action("Courses", "User", new { id = Model.MaNguoiDung });
                }
                <div class="info-card-custom" style="padding-bottom: @(rutGon ? "24px" : "12px");">
                    <div class="info-card-header" style="justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <i class="bi bi-collection-play text-primary" style="font-size: 20px;"></i>
                            <h3>Các khóa học của giáo viên (@soKhoaHoc)</h3>
                        </div>
                    </div>

                    @if (soKhoaHoc == 0)
                    {
                        <div style="text-align: center; padding: 36px 20px; color: #64748B;">
                            <i class="bi bi-inbox" style="font-size: 32px; color: #94A3B8; display: block; margin-bottom: 10px;"></i>
                            <div style="font-size: 15px; font-weight: 600; color: #0F172A;">Chưa có khóa học nào được xuất bản</div>
                            <div style="font-size: 13px; margin-top: 4px;">Giáo viên đang chuẩn bị các bài giảng mới nhất cho học viên.</div>
                        </div>
                    }
                    else if (!rutGon)
                    {
                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 10px;">
                            @foreach (var item in Model.DanhSachKhoaHoc)
                            {
                                @Html.Partial("_TeacherCourseCard", item)
                            }
                        </div>
                    }
                    else
                    {
                        <div class="teacher-course-list">
                            @foreach (var item in Model.DanhSachKhoaHoc.Take(ECOLearning.ViewModels.InstructorProfileViewModel.SoKhoaHocTrenTrangHoSo))
                            {
                                var course = item.Course;
                                string thumb = string.IsNullOrEmpty(course.anhBia) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80" : course.anhBia;
                                <a class="teacher-course-row" href="@Url.Action("Details", "Course", new { id = course.maKhoaHoc })" target="_blank" rel="noopener" title="@course.tenKhoaHoc">
                                    <img src="@thumb" alt="" loading="lazy" decoding="async" />
                                    <div style="min-width: 0;">
                                        <div class="teacher-course-row-title">@course.tenKhoaHoc</div>
                                        <div class="teacher-course-row-meta">
                                            @if (item.SoDanhGia > 0)
                                            {
                                                <span style="color: #F59E0B; font-weight: 700;"><i class="bi bi-star-fill"></i> @item.DiemDanhGia.ToString("0.0")</span>
                                            }
                                            else
                                            {
                                                <span><i class="bi bi-star"></i> Chưa có đánh giá</span>
                                            }
                                            <span><i class="bi bi-people me-1"></i>@item.SoHocVien học viên</span>
                                        </div>
                                    </div>
                                    <div class="teacher-course-row-price" style="@(item.GiaHienTai <= 0 ? "color: #10B981;" : "")">
                                        @(item.GiaHienTai <= 0 ? "Miễn phí" : item.GiaHienTai.ToString("N0") + " đ")
                                    </div>
                                </a>
                            }
                        </div>
                        <a href="@xemTatCaUrl" class="teacher-course-more">
                            Xem tất cả @soKhoaHoc khóa học <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                </div>
            </div>

            <!-- CỘT PHẢI (SIDEBAR) -->
            <div>
                <!-- Thẻ Cam Kết Đào Tạo -->
