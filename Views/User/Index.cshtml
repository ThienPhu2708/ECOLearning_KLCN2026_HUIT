@model ECOLearning.ViewModels.InstructorProfileViewModel
@{
    ViewBag.Title = Model.HoTen + " - Thông tin Giáo viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string defaultAvatar = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80";
    string avatarUrl = string.IsNullOrEmpty(Model.AnhDaiDien) ? defaultAvatar : Model.AnhDaiDien;
    if (!avatarUrl.StartsWith("http") && !avatarUrl.StartsWith("/"))
    {
        avatarUrl = Url.Content("~/" + avatarUrl);
    }
}

@section styles {
<style>
    .instructor-header-section {
        background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
        color: #FFFFFF;
        padding: 44px 0 52px;
        position: relative;
        overflow: hidden;
    }

    .instructor-header-section::before {
        content: '';
        position: absolute;
        top: -80px;
        right: -80px;
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, rgba(67, 76, 232, 0.25) 0%, rgba(67, 76, 232, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .stat-card-custom {
        background: #FFFFFF;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 16px;
        padding: 24px 20px;
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .stat-card-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.08);
    }

    .stat-icon-wrap {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .info-card-custom {
        background: #FFFFFF;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 28px;
        box-shadow: 0 2px 4px rgba(15, 23, 42, 0.02);
    }

    .info-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border-color, #E2E8F0);
    }

    .info-card-header h3 {
        font-size: 18px;
        font-weight: 700;
        color: #0F172A;
        margin: 0;
    }

    .certificate-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 18px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        text-decoration: none;
        color: #0F172A;
        transition: all 0.2s ease;
    }

    .certificate-pill:hover {
        background: #EEF2FF;
        border-color: #C7D2FE;
        color: #434CE8;
    }
</style>
}
<!-- Header Thông Tin Giáo Viên -->
<section class="instructor-header-section">
    <div class="safe-container">
        <div style="display: flex; align-items: center; gap: 32px; flex-wrap: wrap;">
            <!-- Avatar -->
            <div style="position: relative;">
                <img src="@avatarUrl" alt="@Model.HoTen"
                     style="width: 110px; height: 110px; border-radius: 50%; object-fit: cover; border: 4px solid rgba(255, 255, 255, 0.2); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);" />
                <span style="position: absolute; bottom: 4px; right: 4px; width: 20px; height: 20px; background: #10B981; border: 3px solid #0F172A; border-radius: 50%;" title="Đang hoạt động"></span>
            </div>

            <!-- Tên & Thông tin cơ bản -->
            <div style="flex: 1; min-width: 280px;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: rgba(67, 76, 232, 0.3); border: 1px solid rgba(99, 102, 241, 0.4); border-radius: 9999px; font-size: 12px; font-weight: 700; color: #C7D2FE; letter-spacing: 0.05em; text-transform: uppercase;">
                        <i class="bi bi-patch-check-fill" style="color: #818CF8;"></i> Giáo viên chính thức
                    </span>
                    @if (Model.NgayDuyet.HasValue)
                    {
                        <span style="font-size: 12.5px; color: #94A3B8;">
                            <i class="bi bi-calendar-check me-1"></i> Tham gia từ @Model.NgayDuyet.Value.ToString("MM/yyyy")
                        </span>
                    }
                    else if (Model.NgayGui.HasValue)
                    {
                        <span style="font-size: 12.5px; color: #94A3B8;">
                            <i class="bi bi-calendar-check me-1"></i> Tham gia từ @Model.NgayGui.Value.ToString("MM/yyyy")
                        </span>
                    }
                </div>

                <h1 style="font-size: 32px; font-weight: 800; margin: 0 0 10px 0; color: #FFFFFF; letter-spacing: -0.01em;">
                    @Model.HoTen
                </h1>

                <p style="font-size: 16px; color: #CBD5E1; margin: 0 0 16px 0; max-width: 720px; line-height: 1.5; font-weight: 500;">
                    <i class="bi bi-briefcase-fill text-primary me-2" style="color: #818CF8 !important;"></i>@Model.ChuyenMon
                </p>

                <!-- Liên hệ & Thông tin bổ sung -->
                <div style="display: flex; align-items: center; gap: 20px; font-size: 13.5px; color: #94A3B8; flex-wrap: wrap;">
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                        <i class="bi bi-envelope-at" style="color: #818CF8;"></i>
                        <span>@Model.Email</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.SoDienThoai))
                    {
                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                            <i class="bi bi-telephone" style="color: #818CF8;"></i>
                            <span>@Model.SoDienThoai</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.GioiTinh))
                    {
                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                            <i class="bi bi-gender-ambiguous" style="color: #818CF8;"></i>
                            <span>Giới tính: @Model.GioiTinh</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Content Section -->
<div style="background: #F8FAFC; padding: 40px 0 80px;">
    <div class="safe-container">

        <!-- HÀNG THỐNG KÊ (4 THẺ CHỈ SỐ THEO YÊU CẦU CSDL) -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 36px;">
            <!-- 1. Tổng số học viên (User request) -->
            <div class="stat-card-custom">
                <div class="stat-icon-wrap" style="background: #EEF2FF; color: #434CE8;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1.1;">
                        @Model.TongSoHocVien.ToString("N0")
                    </div>
                    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
                        Tổng số học viên
                    </div>
                </div>
            </div>

            <!-- 2. Tổng lượt đánh giá (User request) -->
            <div class="stat-card-custom">
                <div class="stat-icon-wrap" style="background: #FFFBEB; color: #F59E0B;">
                    <i class="bi bi-chat-heart-fill"></i>
                </div>
                <div>
                    <div style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1.1;">
                        @Model.TongLuotDanhGia.ToString("N0")
                    </div>
                    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
                        Tổng lượt đánh giá
                    </div>
                </div>
            </div>

            <!-- 3. Đánh giá trung bình -->
            <div class="stat-card-custom">
                <div class="stat-icon-wrap" style="background: @(Model.TongLuotDanhGia > 0 && Model.DiemDanhGiaTrungBinh > 0 ? "#ECFDF5" : "#F8FAFC"); color: @(Model.TongLuotDanhGia > 0 && Model.DiemDanhGiaTrungBinh > 0 ? "#10B981" : "#94A3B8");">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div>
                    @if (Model.TongLuotDanhGia > 0 && Model.DiemDanhGiaTrungBinh > 0)
                    {
                        <div style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1.1;">
                            @Model.DiemDanhGiaTrungBinh.ToString("0.0") <span style="font-size: 14px; font-weight: 600; color: #64748B;">/ 5.0</span>
                        </div>
                        <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
                            Đánh giá chất lượng
                        </div>
                    }
                    else
                    {
                        <div style="font-size: 22px; font-weight: 800; color: #64748B; line-height: 1.1;">
                            Chưa có
                        </div>
                        <div style="font-size: 13px; color: #94A3B8; font-weight: 500; margin-top: 4px;">
                            Đánh giá chất lượng
                        </div>
                    }
                </div>
            </div>

            <!-- 4. Tổng số khóa học -->
            <div class="stat-card-custom">
                <div class="stat-icon-wrap" style="background: #F3E8FF; color: #9333EA;">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div>
                    <div style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1.1;">
                        @Model.TongSoKhoaHoc
                    </div>
                    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
                        Khóa học giảng dạy
                    </div>
                </div>
            </div>
        </div>

        <!-- Layout 2 cột: Cột trái (Nội dung chi tiết), Cột phải (Thông tin hồ sơ CSDL) -->
        <div style="display: grid; grid-template-columns: 1fr 340px; gap: 32px; align-items: start;">
            
            <!-- CỘT TRÁI -->
            <div>
                <!-- Khối 1: Tiểu sử & Kinh nghiệm giảng dạy (kinhNghiem từ DangKyGiaoVien) -->
                <div class="info-card-custom">
                    <div class="info-card-header">
                        <i class="bi bi-person-lines-fill text-primary" style="font-size: 20px;"></i>
                        <h3>Giới thiệu & Kinh nghiệm làm việc</h3>
                    </div>
                    <div style="font-size: 15px; line-height: 1.75; color: #334155; white-space: pre-line;">
                        @Model.KinhNghiem
                    </div>
                </div>

                <!-- Khối 2: Chuyên môn & Lĩnh vực đào tạo (chuyenMon từ DangKyGiaoVien) -->
                <div class="info-card-custom">
                    <div class="info-card-header">
                        <i class="bi bi-award text-primary" style="font-size: 20px;"></i>
                        <h3>Lĩnh vực chuyên môn</h3>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                        @{
                            var specializations = (Model.ChuyenMon ?? "")
                                .Split(new[] { ",", ";", "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                                .Select(s => s.Trim())
                                .Where(s => !string.IsNullOrEmpty(s))
                                .ToList();
                        }
                        @if (specializations.Any())
                        {
                            foreach (var spec in specializations)
                            {
                                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #EEF2FF; color: #434CE8; border: 1px solid #C7D2FE; border-radius: 9999px; font-size: 13.5px; font-weight: 600;">
                                    <i class="bi bi-check-circle-fill" style="font-size: 12px;"></i> @spec
                                </span>
                            }
                        }
                        else
                        {
                            <span style="color: #64748B; font-size: 14px;">@Model.ChuyenMon</span>
                        }
                    </div>
                </div>

                <!-- Khối 3: Hồ sơ chứng chỉ chuyên môn (nếu có từ DangKyGiaoVien) -->
                @if (!string.IsNullOrEmpty(Model.TenTepChungChi) || !string.IsNullOrEmpty(Model.TepChungChi))
                {
                    <div class="info-card-custom">
                        <div class="info-card-header">
                            <i class="bi bi-shield-check text-primary" style="font-size: 20px;"></i>
                            <h3>Hồ sơ & Chứng chỉ chuyên môn đã xác thực</h3>
                        </div>
                        <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                            <div class="certificate-pill">
                                <i class="bi bi-file-earmark-pdf-fill" style="font-size: 24px; color: #EF4444;"></i>
                                <div>
                                    <div style="font-weight: 700; font-size: 14px;">@(string.IsNullOrEmpty(Model.TenTepChungChi) ? "Chứng chỉ chuyên môn" : Model.TenTepChungChi)</div>
                                    <div style="font-size: 12px; color: #10B981; font-weight: 600;">
                                        <i class="bi bi-check-all"></i> Đã được kiểm duyệt và công nhận bởi hệ thống
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Khối 4: Danh sách các khóa học do giáo viên phụ trách -->
                <div class="info-card-custom" style="padding-bottom: 12px;">
                    <div class="info-card-header" style="justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <i class="bi bi-collection-play text-primary" style="font-size: 20px;"></i>
                            <h3>Các khóa học của giáo viên (@Model.DanhSachKhoaHoc.Count)</h3>
                        </div>
                    </div>

                    @if (Model.DanhSachKhoaHoc != null && Model.DanhSachKhoaHoc.Count > 0)
                    {
                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 10px;">
                            @foreach (var course in Model.DanhSachKhoaHoc)
                            {
                                string thumb = string.IsNullOrEmpty(course.anhBia) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80" : course.anhBia;
                                string catName = course.DanhMuc != null ? course.DanhMuc.tenDanhMuc : "Công nghệ & Kỹ năng";
                                decimal curPrice = course.giaKhuyenMai.HasValue ? course.giaKhuyenMai.Value : course.giaBan;
                                decimal rawPrice = course.giaBan;
                                int cEnrollCount = course.DangKyKhoaHoc != null ? course.DangKyKhoaHoc.Count : 0;
                                bool hasRev = course.DanhGiaKhoaHoc != null && course.DanhGiaKhoaHoc.Count > 0;
                                double cStars = hasRev ? Math.Round(course.DanhGiaKhoaHoc.Average(d => (double)d.soSao), 1) : 0;

                                <div class="course-card" onclick="window.location.href='@Url.Action("Details", "Course", new { id = course.maKhoaHoc })'" style="cursor: pointer; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column;">
                                    <div style="position: relative; width: 100%; height: 160px; overflow: hidden; background: #000;">
                                        <img src="@thumb" alt="@course.tenKhoaHoc" style="width: 100%; height: 100%; object-fit: cover;" />
                                        <span class="badge" style="position: absolute; top: 10px; left: 10px; background: rgba(15, 23, 42, 0.75); color: #fff; backdrop-filter: blur(4px); font-size: 11px;">
                                            @catName
                                        </span>
                                    </div>
                                    <div style="padding: 16px; flex-grow: 1; display: flex; flex-direction: column;">
                                        <h4 style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0 0 10px 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@course.tenKhoaHoc">
                                            @course.tenKhoaHoc
                                        </h4>

                                        <div style="display: flex; align-items: center; gap: 12px; font-size: 12.5px; color: #64748B; margin-bottom: 12px;">
                                            @if (hasRev)
                                            {
                                                <div style="display: flex; align-items: center; gap: 4px; color: #F59E0B; font-weight: 700;">
                                                    <i class="bi bi-star-fill"></i>
                                                    <span>@cStars.ToString("0.0")</span>
                                                    <span style="color: #64748B; font-weight: 500; font-size: 11.5px;">(@course.DanhGiaKhoaHoc.Count)</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="display: flex; align-items: center; gap: 4px; color: #94A3B8;">
                                                    <i class="bi bi-star"></i>
                                                    <span>Chưa có đánh giá</span>
                                                </div>
                                            }
                                            <span>•</span>
                                            <div>
                                                <i class="bi bi-people me-1"></i>@cEnrollCount học viên
                                            </div>
                                        </div>

                                        <div style="margin-top: auto; padding-top: 12px; border-top: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;">
                                            <div>
                                                @if (curPrice <= 0)
                                                {
                                                    <span style="font-size: 16px; font-weight: 800; color: #10B981;">Miễn phí</span>
                                                }
                                                else
                                                {
                                                    <span style="font-size: 16px; font-weight: 800; color: #0F172A;">@curPrice.ToString("N0") đ</span>
                                                    if (curPrice < rawPrice)
                                                    {
                                                        <span style="font-size: 12px; color: #94A3B8; text-decoration: line-through; margin-left: 4px;">@rawPrice.ToString("N0") đ</span>
                                                    }
                                                }
                                            </div>
                                            <a href="@Url.Action("Details", "Course", new { id = course.maKhoaHoc })" class="btn btn-outline btn-sm" onclick="event.stopPropagation();" style="border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none;">
                                                Xem khóa học
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 36px 20px; color: #64748B;">
                            <i class="bi bi-inbox" style="font-size: 32px; color: #94A3B8; display: block; margin-bottom: 10px;"></i>
                            <div style="font-size: 15px; font-weight: 600; color: #0F172A;">Chưa có khóa học nào được xuất bản</div>
                            <div style="font-size: 13px; margin-top: 4px;">Giáo viên đang chuẩn bị các bài giảng mới nhất cho học viên.</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CỘT PHẢI (SIDEBAR THÔNG TIN HỒ SƠ) -->
            <div>
                <!-- Thẻ Tóm Tắt Hồ Sơ CSDL -->
                <div class="info-card-custom" style="padding: 24px;">
                    <div class="info-card-header" style="margin-bottom: 16px;">
                        <i class="bi bi-file-earmark-person text-primary" style="font-size: 20px;"></i>
                        <h3>Thông tin hồ sơ</h3>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 14px; font-size: 14px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #E2E8F0; padding-bottom: 10px;">
                            <span style="color: #64748B;">Mã giáo viên:</span>
                            <span style="font-weight: 700; color: #0F172A;">#GV-@Model.MaNguoiDung.ToString("D4")</span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.MaDon))
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #E2E8F0; padding-bottom: 10px;">
                                <span style="color: #64748B;">Mã đơn đăng ký:</span>
                                <span style="font-weight: 600; color: #434CE8; font-family: monospace;">@Model.MaDon</span>
                            </div>
                        }

                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #E2E8F0; padding-bottom: 10px;">
                            <span style="color: #64748B;">Trạng thái:</span>
                            <span style="display: inline-flex; align-items: center; gap: 4px; color: #059669; background: #ECFDF5; padding: 2px 8px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                <i class="bi bi-check-circle-fill"></i> @(string.Equals(Model.TrangThaiGiaoVien, "Approved", StringComparison.OrdinalIgnoreCase) ? "Đã phê duyệt" : Model.TrangThaiGiaoVien)
                            </span>
                        </div>

                        @if (Model.NgayGui.HasValue)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #E2E8F0; padding-bottom: 10px;">
                                <span style="color: #64748B;">Ngày gửi hồ sơ:</span>
                                <span style="font-weight: 600; color: #0F172A;">@Model.NgayGui.Value.ToString("dd/MM/yyyy")</span>
                            </div>
                        }

                        @if (Model.NgayDuyet.HasValue)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #E2E8F0; padding-bottom: 10px;">
                                <span style="color: #64748B;">Ngày phê duyệt:</span>
                                <span style="font-weight: 600; color: #0F172A;">@Model.NgayDuyet.Value.ToString("dd/MM/yyyy")</span>
                            </div>
                        }

                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #64748B;">Email liên hệ:</span>
                            <span style="font-weight: 600; color: #0F172A; text-align: right; max-width: 170px; word-break: break-all;">@Model.Email</span>
                        </div>
                    </div>
                </div>

                <!-- Thẻ Cam Kết Đào Tạo -->
                <div style="background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%); border: 1px solid #C7D2FE; border-radius: 16px; padding: 24px;">
                    <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: #434CE8; margin-bottom: 12px; font-size: 15px;">
                        <i class="bi bi-shield-lock-fill"></i> Cam kết chất lượng đào tạo
                    </div>
                    <p style="font-size: 13px; line-height: 1.6; color: #334155; margin-bottom: 14px;">
                        Toàn bộ thông tin hồ sơ, chuyên môn và kinh nghiệm của giáo viên đều được kiểm duyệt xác thực theo quy chuẩn của ECOLearning.
                    </p>
