@model ECOLearning.ViewModels.KhoaHocCuaGiaoVienItem
@* Thẻ khóa học trên trang giáo viên (trang hồ sơ và trang "Tất cả khóa học") *@
@{
    var course = Model.Course;
    string thumb = string.IsNullOrEmpty(course.anhBia) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80" : course.anhBia;
    string catName = course.DanhMuc != null ? course.DanhMuc.tenDanhMuc : "Công nghệ & Kỹ năng";
    decimal curPrice = Model.GiaHienTai;
    decimal rawPrice = course.giaBan;
    string detailUrl = Url.Action("Details", "Course", new { id = course.maKhoaHoc });
}

<div class="course-card" onclick="window.open('@detailUrl', '_blank', 'noopener')" style="cursor: pointer; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; height: 100%;">
    <div style="position: relative; width: 100%; height: 160px; overflow: hidden; background: #000;">
        <img src="@thumb" alt="@course.tenKhoaHoc" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover;" />
        <span class="badge" style="position: absolute; top: 10px; left: 10px; background: rgba(15, 23, 42, 0.75); color: #fff; backdrop-filter: blur(4px); font-size: 11px;">
            @catName
        </span>
    </div>
    <div style="padding: 16px; flex-grow: 1; display: flex; flex-direction: column;">
        <h4 style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0 0 10px 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@course.tenKhoaHoc">
            @course.tenKhoaHoc
        </h4>

        <div style="display: flex; align-items: center; gap: 12px; font-size: 12.5px; color: #64748B; margin-bottom: 12px;">
            @if (Model.SoDanhGia > 0)
            {
                <div style="display: flex; align-items: center; gap: 4px; color: #F59E0B; font-weight: 700;">
                    <i class="bi bi-star-fill"></i>
                    <span>@Model.DiemDanhGia.ToString("0.0")</span>
                    <span style="color: #64748B; font-weight: 500; font-size: 11.5px;">(@Model.SoDanhGia)</span>
                </div>
            }
            else
            {
                <div style="display: flex; align-items: center; gap: 4px; color: #94A3B8;">
                    <i class="bi bi-star"></i>
                    <span>Chưa có đánh giá</span>
                </div>
            }
            <span>•</span>
            <div>
                <i class="bi bi-people me-1"></i>@Model.SoHocVien học viên
            </div>
        </div>

        <div style="margin-top: auto; padding-top: 12px; border-top: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
            <div>
                @if (curPrice <= 0)
                {
                    <span style="font-size: 16px; font-weight: 800; color: #10B981;">Miễn phí</span>
                }
                else
                {
                    <span style="font-size: 16px; font-weight: 800; color: #0F172A; white-space: nowrap;">@curPrice.ToString("N0") đ</span>
                    if (curPrice < rawPrice)
                    {
                        <span style="font-size: 12px; color: #94A3B8; text-decoration: line-through; margin-left: 4px; white-space: nowrap; display: inline-block;">@rawPrice.ToString("N0") đ</span>
                    }
                }
            </div>
            <a href="@detailUrl" target="_blank" rel="noopener" class="btn btn-outline btn-sm" onclick="event.stopPropagation();" style="border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none; flex-shrink: 0;">
                Xem khóa học
            </a>
        </div>
    </div>
</div>
