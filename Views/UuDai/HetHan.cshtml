@{
    ViewBag.Title = "Ưu đãi không còn hiệu lực";
}

<main style="padding: 80px 0; background: var(--bg-canvas, #F8FAFC);">
    <div class="safe-container" style="text-align: center; max-width: 560px;">
        <i class="bi bi-calendar-x" style="font-size: 48px; color: var(--primary, #434CE8);"></i>
        <h1 class="h2" style="margin: 14px 0 8px;">Ưu đãi này không còn hiệu lực</h1>
        <p style="color: var(--text-secondary, #475569);">Chương trình đã kết thúc hoặc đang tạm dừng. Bạn có thể xem các khóa học đang mở bán trên hệ thống.</p>
        <a href="@Url.Action("Index", "Course")" class="btn btn-primary" style="margin-top: 12px;">Xem khóa học</a>
    </div>
</main>
